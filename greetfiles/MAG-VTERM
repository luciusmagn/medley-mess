(MAG-GHOSTTY-DRAW-CURSOR
  [LAMBDA (WINDOW STATE CHAN BUFFER ROWS COLS RGB WIDE COLORED STYLED SEGMENTED PLAIN)
    (LET (LEN CX CY OLDX OLDY MOVED)
      (SETQ LEN (MAG-UNIX-HANDLECOMM3 20 CHAN BUFFER))
      (SETQ OLDX (ffetch (CHAT.STATE TEXTSTREAM) of STATE))
      (SETQ OLDY (ffetch (CHAT.STATE TYPESCRIPTSTREAM) of STATE))
      (COND
        ((AND LEN (EQ (\GETBASEBYTE BUFFER 8) 1))
         (SETQ CX (+ (\GETBASEBYTE BUFFER 4)
                     (ITIMES 256 (\GETBASEBYTE BUFFER 5))))
         (SETQ CY (+ (\GETBASEBYTE BUFFER 6)
                              (ITIMES 256 (\GETBASEBYTE BUFFER 7))))
                  (SETQ CX (IMIN (SUB1 COLS) (IMAX 0 CX)))
                  (SETQ CY (IMIN (SUB1 ROWS) (IMAX 0 CY)))
                  (SETQ MOVED (OR (NEQ OLDX CX) (NEQ OLDY CY)))
                  (COND
                    ((AND MOVED
                          OLDY
                          (IGEQ OLDY 0)
                          (ILESSP OLDY ROWS))
                     (MAG-GHOSTTY-DRAW-REFRESH-ROW WINDOW STATE CHAN OLDY BUFFER COLS
                                                   RGB WIDE COLORED STYLED SEGMENTED PLAIN)))
	                  (COND
	                    ((AND MOVED
	                          (NEQ OLDY CY)
	                          (IGEQ CY 0)
	                          (ILESSP CY ROWS))
	                     (MAG-GHOSTTY-DRAW-REFRESH-ROW WINDOW STATE CHAN CY BUFFER COLS
	                                                   RGB WIDE COLORED STYLED SEGMENTED PLAIN)))
	                  (freplace (CHAT.STATE TEXTSTREAM) of STATE with CX)
	                  (freplace (CHAT.STATE TYPESCRIPTSTREAM) of STATE with CY)
	                  (COND
	                    ((OR MOVED MAG-GHOSTTY-CURSOR-ROW-REDRAWN)
	                     (MAG-VTERM-RENDER-STAT
                       WINDOW 'MAG-GHOSTTY-CURSOR-INVERT-COUNT)
                     (MAG-GHOSTTY-INVERT-CURSOR-CELL WINDOW STATE CX CY))))
                 (T
                  (COND
	                    ((AND OLDY
	                 (IGEQ OLDY 0)
	                 (ILESSP OLDY ROWS))
		            (MAG-GHOSTTY-DRAW-REFRESH-ROW WINDOW STATE CHAN OLDY BUFFER COLS
		                                          RGB WIDE COLORED STYLED SEGMENTED PLAIN)))
		         (freplace (CHAT.STATE TEXTSTREAM) of STATE with NIL)
		         (freplace (CHAT.STATE TYPESCRIPTSTREAM) of STATE with NIL)))
		      NIL)])

(MAG-GHOSTTY-DRAW-REFRESH-ROW
  [LAMBDA (WINDOW STATE CHAN ROW BUFFER COLS RGB WIDE COLORED STYLED SEGMENTED PLAIN)
      (LET (LEN)
        (MAG-VTERM-RENDER-STAT WINDOW 'MAG-GHOSTTY-ROW-DRAW-COUNT)
      (AND (EQ ROW (ffetch (CHAT.STATE TYPESCRIPTSTREAM) of STATE))
           (SETQ MAG-GHOSTTY-CURSOR-ROW-REDRAWN T))
      (COND
        ((MAG-GHOSTTY-ASCII-ROWP WINDOW)
         (SETQ LEN (MAG-UNIX-HANDLECOMM4 54 CHAN ROW BUFFER))
         (AND LEN
              (MAG-GHOSTTY-DRAW-ASCII-ROW WINDOW STATE ROW BUFFER LEN)))
        (PLAIN
         (SETQ LEN (MAG-UNIX-HANDLECOMM4 36 CHAN ROW BUFFER))
         (AND LEN
              (MAG-GHOSTTY-DRAW-WIDE-PLAIN-ROW WINDOW STATE ROW BUFFER LEN)))
        (RGB
         (MAG-GHOSTTY-DRAW-RGB-SEGMENTS WINDOW STATE CHAN ROW BUFFER COLS))
        ((AND WIDE SEGMENTED)
         (MAG-GHOSTTY-DRAW-WIDE-COLORED-SEGMENTS WINDOW STATE CHAN ROW BUFFER COLS))
        (T
         (SETQ LEN (MAG-UNIX-HANDLECOMM4
                               (COND (WIDE 27) (COLORED 26) (STYLED 22) (T 19))
                               CHAN ROW BUFFER))
         (AND LEN
              (COND
                (WIDE
                 (MAG-GHOSTTY-DRAW-WIDE-COLORED-ROW WINDOW STATE ROW BUFFER LEN))
                (COLORED
                 (MAG-GHOSTTY-DRAW-COLORED-ROW WINDOW STATE ROW BUFFER LEN))
                (STYLED
                 (MAG-GHOSTTY-DRAW-STYLED-ROW WINDOW STATE ROW BUFFER LEN))
                (T
                 (MAG-GHOSTTY-DRAW-ROW STATE ROW BUFFER LEN)))))))])

(MAG-GHOSTTY-REFRESH
  [LAMBDA (WINDOW STATE)
    (LET ((CHAN (MAG-GHOSTTY-CHANNEL STATE))
          (ROWS (IQUOTIENT (ffetch (CHAT.STATE TTYHEIGHT) of STATE)
                           (ffetch (CHAT.STATE FONTHEIGHT) of STATE)))
          (COLS (IQUOTIENT (ffetch (CHAT.STATE TTYWIDTH) of STATE)
                           (ffetch (CHAT.STATE FONTWIDTH) of STATE)))
                   (BUFFER (MAG-GHOSTTY-BUFFER WINDOW))
                   (ROWBUFFER (MAG-GHOSTTY-ROWLIST-BUFFER WINDOW))
                   (OLDWRAP (ffetch (CHAT.STATE WRAPMODE) of STATE))
                   DIRTY FORCE USECHANGED DIRTYCOUNT ROW MAXCOMMAND
                   WIDE COLORED STYLED SEGMENTED RGB PLAIN)
               (AND CHAN
                    (SETQ DIRTY (MAG-UNIX-HANDLECOMM2 18 CHAN))
	                    (OR (ffetch (CHAT.STATE CHATINEMACS) of STATE)
	                        (AND DIRTY (IGREATERP DIRTY 0))
	                        (WINDOWPROP WINDOW 'MAG-GHOSTTY-FORCE-REFRESH))
                    (PROGN
                                  (SETQ MAXCOMMAND (MAG-GHOSTTY-MAXCOMMAND WINDOW))
                      (SETQ RGB NIL)
                      (SETQ PLAIN NIL)
                      (SETQ WIDE (IGEQ MAXCOMMAND 27))
                      (SETQ COLORED (AND (NULL WIDE) (IGEQ MAXCOMMAND 26)))
                      (SETQ STYLED (AND (NULL WIDE) (NULL COLORED) (IGEQ MAXCOMMAND 22)))
                      (SETQ SEGMENTED NIL)
                      (SETQ FORCE (WINDOWPROP WINDOW 'MAG-GHOSTTY-FORCE-REFRESH))
                      (SETQ USECHANGED (AND (NULL FORCE) (IGEQ MAXCOMMAND 37)))
                      (MAG-VTERM-RENDER-STAT WINDOW 'MAG-GHOSTTY-REFRESH-COUNT)
                      (AND FORCE
                           (MAG-VTERM-RENDER-STAT
                             WINDOW 'MAG-GHOSTTY-FORCE-REFRESH-COUNT))
	                      (AND FORCE
	                           (REMWINDOWPROP WINDOW 'MAG-GHOSTTY-FORCE-REFRESH))
	                      (freplace (CHAT.STATE CHATINEMACS) of STATE with NIL)
                                  (SETQ MAG-GHOSTTY-CURSOR-ROW-REDRAWN NIL)
                      (freplace (CHAT.STATE WRAPMODE) of STATE with NIL)
                         (COND
                                    ((AND USECHANGED
                                          (NEQ (SETQ DIRTYCOUNT
                                                     (MAG-UNIX-HANDLECOMM3 37 CHAN ROWBUFFER))
                                               NIL))
                                     (MAG-VTERM-RENDER-STAT
                                       WINDOW 'MAG-GHOSTTY-CHANGED-REFRESH-COUNT)
                                     (AND (IGREATERP DIRTYCOUNT 0)
                                          (PROG ((I 0))
                                          DIRTYLP
                                            (COND
                                              ((NOT (ILESSP I DIRTYCOUNT))
                                               (RETURN T)))
                                            (SETQ ROW (\GETBASEBYTE ROWBUFFER I))
                                            (AND (ILESSP ROW ROWS)
                                                 (MAG-GHOSTTY-DRAW-REFRESH-ROW
                                                   WINDOW STATE CHAN ROW BUFFER COLS
                                                   RGB WIDE COLORED STYLED SEGMENTED PLAIN))
                                            (SETQ I (ADD1 I))
                                            (GO DIRTYLP))))
                           (T
                         (MAG-VTERM-RENDER-STAT
                           WINDOW 'MAG-GHOSTTY-FULL-REFRESH-COUNT)
                         (PROG NIL
                           (SETQ ROW 0)
                         FULLLP
                           (COND
                             ((NOT (ILESSP ROW ROWS))
                              (RETURN T)))
	                           (MAG-GHOSTTY-DRAW-REFRESH-ROW
	                             WINDOW STATE CHAN ROW BUFFER COLS
	                             RGB WIDE COLORED STYLED SEGMENTED PLAIN)
	                           (SETQ ROW (ADD1 ROW))
	                           (GO FULLLP))))
		                      (freplace (CHAT.STATE WRAPMODE) of STATE with OLDWRAP)
                      (MAG-GHOSTTY-DRAW-CURSOR WINDOW STATE CHAN BUFFER ROWS COLS
                                               RGB WIDE COLORED STYLED SEGMENTED PLAIN)
                 (AND (IGEQ MAXCOMMAND 33)
                      (MAG-UNIX-HANDLECOMM2 33 CHAN)))))])

(MAG-VTERM-CSI-RESET
  [LAMBDA (WINDOW)
