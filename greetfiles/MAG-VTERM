        (PATH
         (FLASHWINDOW WINDOW)
         NIL)))])

(MAG-VTERM-SAVE-SCROLLBACK
  [LAMBDA (WINDOW)
    (LET ((PATH (MAG-PROMPT-LINE "save terminal scrollback file" NIL))
          (TEXT (MAG-VTERM-SCROLLBACK-TEXT WINDOW)))
