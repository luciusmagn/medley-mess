    LP
      (COND
        ((NULL PARAMS)
         (RETURN T)))
      (SETQ P (CAR PARAMS))
      (SELECTQ P
        (0 (TERM.MODIFY.ATTRIBUTES STATE '(NORMAL)))
        (1 (TERM.MODIFY.ATTRIBUTES STATE '(BRIGHT)))
        ((3 23) (TERM.MODIFY.ATTRIBUTES STATE '(NORMAL)))
        ((4 24) (TERM.MODIFY.ATTRIBUTES STATE '(NORMAL)))
        ((7 27) (TERM.MODIFY.ATTRIBUTES STATE '(INVERSE) (EQ P 27)))
