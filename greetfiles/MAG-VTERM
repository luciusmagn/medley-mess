        ((OR (NULL LEN) (NOT (ILESSP I LEN)))
         (RETURN T)))
      (SETQ TAG (\GETBASEBYTE BUFFER POS))
      (COND
        ((EQ TAG 255)
         (SETQ CODE (+ (\GETBASEBYTE BUFFER (ADD1 POS))
                       (ITIMES 256 (\GETBASEBYTE BUFFER (IPLUS POS 2)))))
         (SETQ FLAGS (\GETBASEBYTE BUFFER (IPLUS POS 3)))
         (SETQ FGR (\GETBASEBYTE BUFFER (IPLUS POS 4)))
         (SETQ FGG (\GETBASEBYTE BUFFER (IPLUS POS 5)))
         (SETQ FGB (\GETBASEBYTE BUFFER (IPLUS POS 6)))
         (SETQ BGR (\GETBASEBYTE BUFFER (IPLUS POS 7)))
         (SETQ BGG (\GETBASEBYTE BUFFER (IPLUS POS 8)))
         (SETQ BGB (\GETBASEBYTE BUFFER (IPLUS POS 9)))
         (SETQ POS (IPLUS POS 10)))
        (T
         (SETQ CODE TAG)
         (SETQ FLAGS (\GETBASEBYTE BUFFER (ADD1 POS)))
         (SETQ FGR (\GETBASEBYTE BUFFER (IPLUS POS 2)))
         (SETQ FGG (\GETBASEBYTE BUFFER (IPLUS POS 3)))
         (SETQ FGB (\GETBASEBYTE BUFFER (IPLUS POS 4)))
         (SETQ BGR (\GETBASEBYTE BUFFER (IPLUS POS 5)))
         (SETQ BGG (\GETBASEBYTE BUFFER (IPLUS POS 6)))
         (SETQ BGB (\GETBASEBYTE BUFFER (IPLUS POS 7)))
         (SETQ POS (IPLUS POS 8))))
      (MAG-GHOSTTY-SET-FLAGS WINDOW STATE FLAGS)
      (MAG-GHOSTTY-SET-RGB-COLORS WINDOW STATE FGR FGG FGB BGR BGG BGB)
      (MAG-GHOSTTY-PRINT-CODE WINDOW STATE CODE FLAGS)
      (SETQ I (ADD1 I))
      (GO LP))])

