                               (CONCAT "Saved " (NCHARS TEXT)
                                       " chars of scrollback"))
         T)
        (PATH
         (FLASHWINDOW WINDOW)
         NIL)))])

(MAG-VTERM-SET-STATUS
  [LAMBDA (WINDOW TEXT)
    (WINDOWPROP WINDOW 'TITLE
                (CONCAT (OR (WINDOWPROP WINDOW 'MAG-VTERM-BASE-TITLE)
                            "Mag Terminal")
                        "  "
                        TEXT))])

(MAG-VTERM-FIND-IN-LINE
  [LAMBDA (NEEDLE LINE START)
    (PROG ((POS (OR START 1))
           PART FOUND)
      (COND
        ((OR (NULL NEEDLE) (EQ (NCHARS NEEDLE) 0) (NULL LINE))
         (RETURN NIL)))
      (COND
        ((ILESSP POS 1)
         (SETQ POS 1)))
      (COND
        ((IGREATERP POS (NCHARS LINE))
         (RETURN NIL)))
      (SETQ PART (COND
                   ((EQ POS 1) LINE)
                   (T (OR (SUBSTRING LINE POS) ""))))
      (SETQ FOUND (STRPOS NEEDLE PART))
      (RETURN (AND FOUND (IPLUS POS (SUB1 FOUND)))))])

(MAG-VTERM-FIND-FROM
  [LAMBDA (WINDOW NEEDLE STARTROW STARTCOL)
    (PROG ((STATE (WINDOWPROP WINDOW 'MAG-VTERM-STATE))
           CHAN ROWS COLS BUFFER ROW COL LINE POS)
      (COND
        ((OR (NULL STATE) (NULL NEEDLE) (EQ (NCHARS NEEDLE) 0))
         (RETURN NIL)))
      (SETQ CHAN (MAG-GHOSTTY-CHANNEL STATE))
      (COND
        ((NULL CHAN)
         (RETURN NIL)))
      (SETQ ROWS (IQUOTIENT (ffetch (CHAT.STATE TTYHEIGHT) of STATE)
                            (ffetch (CHAT.STATE FONTHEIGHT) of STATE)))
      (SETQ COLS (IQUOTIENT (ffetch (CHAT.STATE TTYWIDTH) of STATE)
                            (ffetch (CHAT.STATE FONTWIDTH) of STATE)))
      (SETQ BUFFER (MAG-GHOSTTY-BUFFER WINDOW))
      (MAG-UNIX-HANDLECOMM2 18 CHAN)
      (SETQ ROW (OR STARTROW 0))
      (COND
        ((ILESSP ROW 0)
         (SETQ ROW 0)))
    LP
      (COND
        ((NOT (ILESSP ROW ROWS))
         (RETURN NIL)))
      (SETQ COL (COND ((EQ ROW (OR STARTROW 0)) (OR STARTCOL 1)) (T 1)))
      (SETQ LINE (MAG-STRING-RTRIM-SPACES
                   (MAG-GHOSTTY-ROW-STRING CHAN ROW BUFFER COLS)))
      (SETQ POS (MAG-VTERM-FIND-IN-LINE NEEDLE LINE COL))
      (COND
        (POS
         (RETURN (LIST ROW (SUB1 POS)))))
      (SETQ ROW (ADD1 ROW))
      (GO LP))])

(MAG-VTERM-FIND-TEXT
  [LAMBDA (WINDOW NEEDLE STARTROW STARTCOL)
    (PROG ((STATE (WINDOWPROP WINDOW 'MAG-VTERM-STATE))
           (ROWS 0)
           RESULT ROW COL)
      (COND
        ((OR (NULL NEEDLE) (EQ (NCHARS NEEDLE) 0))
         (MAG-VTERM-SET-STATUS WINDOW "No find text")
         (RETURN NIL)))
      (COND
        (STATE
         (SETQ ROWS (IQUOTIENT (ffetch (CHAT.STATE TTYHEIGHT) of STATE)
                               (ffetch (CHAT.STATE FONTHEIGHT) of STATE)))))
      (WINDOWPROP WINDOW 'MAG-VTERM-FIND-TEXT NEEDLE)
      (SETQ RESULT (MAG-VTERM-FIND-FROM WINDOW NEEDLE (OR STARTROW 0) (OR STARTCOL 1)))
      (COND
        ((NULL RESULT)
         (SETQ RESULT (MAG-VTERM-FIND-FROM WINDOW NEEDLE 0 1))))
      (COND
        (RESULT
         (SETQ ROW (CAR RESULT))
         (SETQ COL (CADR RESULT))
         (WINDOWPROP WINDOW 'MAG-VTERM-FIND-ROW ROW)
         (WINDOWPROP WINDOW 'MAG-VTERM-FIND-COL COL)
         (AND STATE (NOT (WINDOWPROP WINDOW 'MAG-VTERM-GHOSTTY)) (TERM.MOVETO STATE COL ROW))
         (MAG-VTERM-SET-STATUS WINDOW
                               (CONCAT "Found " NEEDLE
                                       " at "
                                       (ADD1 ROW)
                                       "/"
                                       ROWS
                                       ":"
                                       (ADD1 COL)))
         (RETURN RESULT))
        (T
         (MAG-VTERM-SET-STATUS WINDOW (CONCAT "Not found: " NEEDLE))
         (RETURN NIL))))])

(MAG-VTERM-FIND-SCROLLBACK-TEXT
  [LAMBDA (WINDOW NEEDLE)
    (PROG ((LIMIT 11000)
           (STEPS 0)
           (PAGE (IMAX 1 (SUB1 (MAG-VTERM-PAGE-ROWS WINDOW))))
           (STATE (WINDOWPROP WINDOW 'MAG-VTERM-STATE))
           (ROWS 0)
           CURRENTTEXT NEXTTEXT RESULT ROW COL)
      (COND
        ((OR (NULL NEEDLE) (EQ (NCHARS NEEDLE) 0))
         (MAG-VTERM-SET-STATUS WINDOW "No find text")
         (RETURN NIL)))
      (COND
        ((NOT (MAG-GHOSTTY-SCROLLP))
         (RETURN (MAG-VTERM-FIND-TEXT WINDOW NEEDLE 0 1))))
      (COND
        (STATE
         (SETQ ROWS (IQUOTIENT (ffetch (CHAT.STATE TTYHEIGHT) of STATE)
                               (ffetch (CHAT.STATE FONTHEIGHT) of STATE)))))
      (WINDOWPROP WINDOW 'MAG-VTERM-FIND-TEXT NEEDLE)
      (MAG-GHOSTTY-SCROLL-RAW WINDOW 0 0)
      (SETQ CURRENTTEXT (MAG-VTERM-VISIBLE-TEXT WINDOW))
    LP
      (SETQ RESULT (MAG-VTERM-FIND-FROM WINDOW NEEDLE 0 1))
      (COND
        (RESULT
         (SETQ ROW (CAR RESULT))
         (SETQ COL (CADR RESULT))
         (WINDOWPROP WINDOW 'MAG-VTERM-FIND-ROW ROW)
         (WINDOWPROP WINDOW 'MAG-VTERM-FIND-COL COL)
         (AND STATE (MAG-GHOSTTY-REFRESH WINDOW STATE))
         (AND STATE (NOT (WINDOWPROP WINDOW 'MAG-VTERM-GHOSTTY)) (TERM.MOVETO STATE COL ROW))
         (MAG-VTERM-SET-STATUS WINDOW
                               (CONCAT "Found in scrollback "
                                       NEEDLE
                                       " at "
                                       (ADD1 ROW)
                                       "/"
                                       ROWS
                                       ":"
                                       (ADD1 COL)))
         (RETURN RESULT)))
      (COND
        ((IGREATERP STEPS LIMIT)
         (GO MISS)))
      (MAG-GHOSTTY-SCROLL-RAW WINDOW 2 PAGE)
      (SETQ NEXTTEXT (MAG-VTERM-VISIBLE-TEXT WINDOW))
      (COND
        ((STREQUAL CURRENTTEXT NEXTTEXT)
         (GO MISS)))
      (SETQ CURRENTTEXT NEXTTEXT)
      (SETQ STEPS (ADD1 STEPS))
      (GO LP)
    MISS
      (MAG-GHOSTTY-SCROLL-RAW WINDOW 1 0)
      (MAG-VTERM-REFRESH WINDOW)
      (MAG-VTERM-SET-STATUS WINDOW (CONCAT "Not found in scrollback: " NEEDLE))
      (RETURN NIL))])

(MAG-VTERM-FIND-SCROLLBACK-PROMPT
  [LAMBDA (WINDOW)
    (LET ((NEEDLE (MAG-PROMPT-LINE "find terminal scrollback"
                                   (WINDOWPROP WINDOW 'MAG-VTERM-FIND-TEXT))))
      (AND NEEDLE (MAG-VTERM-FIND-SCROLLBACK-TEXT WINDOW NEEDLE)))])

(MAG-VTERM-FIND-PROMPT
  [LAMBDA (WINDOW)
    (LET ((NEEDLE (MAG-PROMPT-LINE "find terminal visible text"
                                   (WINDOWPROP WINDOW 'MAG-VTERM-FIND-TEXT))))
      (AND NEEDLE
           (MAG-VTERM-FIND-TEXT WINDOW NEEDLE 0 1)))])

(MAG-VTERM-FIND-AGAIN
  [LAMBDA (WINDOW)
    (LET ((NEEDLE (WINDOWPROP WINDOW 'MAG-VTERM-FIND-TEXT)))
      (COND
        ((AND NEEDLE (IGREATERP (NCHARS NEEDLE) 0))
         (MAG-VTERM-FIND-TEXT WINDOW NEEDLE
                              (OR (WINDOWPROP WINDOW 'MAG-VTERM-FIND-ROW) 0)
                              (IPLUS 2 (OR (WINDOWPROP WINDOW 'MAG-VTERM-FIND-COL) 0))))
        (T
         (MAG-VTERM-FIND-PROMPT WINDOW))))])

(MAG-VTERM-REFRESH
  [LAMBDA (WINDOW)
    (LET ((STATE (WINDOWPROP WINDOW 'MAG-VTERM-STATE)))
      (COND
         (STATE
          (MAG-WINDOW-CLEAR WINDOW)
          (TERM.RESET.DISPLAY.PARMS STATE)
          (MAG-VTERM-APPLY-ROW-GEOMETRY STATE)
          (MAG-GHOSTTY-SAVE-DEFAULT-COLORS WINDOW STATE)
          (MAG-VTERM-TABS STATE)
          (AND (NOT (WINDOWPROP WINDOW 'MAG-VTERM-GHOSTTY)) (TERM.HOME STATE))
          (MAG-VTERM-SCREENPARAMS STATE)
          (AND (WINDOWPROP WINDOW 'MAG-VTERM-GHOSTTY)
               (WINDOWPROP WINDOW 'MAG-GHOSTTY-FORCE-REFRESH T)
               (MAG-GHOSTTY-REFRESH WINDOW STATE)))))])

(MAG-VTERM-PAGE-ROWS
  [LAMBDA (WINDOW)
    (LET ((STATE (WINDOWPROP WINDOW 'MAG-VTERM-STATE)))
      (COND
         (STATE (IMAX 1 (IQUOTIENT (ffetch (CHAT.STATE TTYHEIGHT) of STATE)
                                    (ffetch (CHAT.STATE FONTHEIGHT) of STATE))))
         (T 24)))])

