      (10 (MAG-VTERM-WRITE-BYTES OUTSTREAM '(27 91 50 126)))
      (11 (MAG-VTERM-WRITE-BYTES OUTSTREAM '(127)))
      (12 (MAG-VTERM-WRITE-BYTES OUTSTREAM '(13)))
      (13 (MAG-VTERM-WRITE-BYTES OUTSTREAM '(27)))
      (14 (MAG-VTERM-WRITE-BYTES OUTSTREAM '(9)))
      (21 (MAG-VTERM-WRITE-BYTES OUTSTREAM '(27 79 80)))
