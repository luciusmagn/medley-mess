(MAG-VTERM-TYPEIN
  [LAMBDA (WINDOW STATE)
    (PROG ((OUTSTREAM (OR (WINDOWPROP WINDOW 'MAG-VTERM-CHANNEL)
                           (ffetch (CHAT.STATE OUTSTREAM) of STATE)))
            CH)
      (AND (NOT (WINDOWPROP WINDOW 'MAG-VTERM-GHOSTTY))
           (TTYDISPLAYSTREAM WINDOW))
      (while (EQ (ffetch (CHAT.STATE RUNNING?) of STATE) T)
        do (OR (TTY.PROCESSP)
               (\WAIT.FOR.TTY))
            (COND
              ((\SYSBUFP)
               (do (SETQ CH (MTOUCODE (\GETKEY)))
           (COND
             ((MAG-VTERM-SEND-INPUT-KEY WINDOW OUTSTREAM CH)
              NIL)
             (T (FLASHWINDOW WINDOW)))
         repeatwhile (\SYSBUFP))
                       (AND (NOT (SMALLP OUTSTREAM)) (FORCEOUTPUT OUTSTREAM))))
                    (COND
                      ((WINDOWPROP WINDOW 'MAG-VTERM-GHOSTTY)
                       (BLOCK))
                      (T (\TTYBACKGROUND))))
      (BLOCK))])

(MAG-VTERM-BUTTONFN
  [LAMBDA (WINDOW)
    (PROG (STATE LASTCOL LASTROW COL ROW)
      (TOTOPW WINDOW)
      (COND
        ((PROCESSP (WINDOWPROP WINDOW 'PROCESS))
         (TTY.PROCESS (WINDOWPROP WINDOW 'PROCESS))))
      (COND
        ((LASTMOUSESTATE MIDDLE)
         (MAG-VTERM-MENU WINDOW))
        ((LASTMOUSESTATE RIGHT)
         (MAG-VTERM-REFRESH WINDOW))
        ((LASTMOUSESTATE LEFT)
         T)))])

(MAG-VTERM-RESHAPEFN
  [LAMBDA (WINDOW OLDIMAGE IMAGEREGION OLDSCREENREGION)
    (RESHAPEBYREPAINTFN WINDOW OLDIMAGE IMAGEREGION)
    (MAG-VTERM-REFRESH WINDOW)])

(MAG-VTERM-CLOSEFN
  [LAMBDA (WINDOW)
    (PROG ((STATE (WINDOWPROP WINDOW 'MAG-VTERM-STATE))
           (CHAN (WINDOWPROP WINDOW 'MAG-VTERM-CHANNEL))
           PROC)
      (AND (EQ MAG-VTERM-LAST-WINDOW WINDOW)
           (SETQ MAG-VTERM-LAST-WINDOW NIL))
      (COND
        (STATE
	         (freplace (CHAT.STATE RUNNING?) of STATE with NIL)
	         (AND CHAN (MAG-UNIX-HANDLECOMM3 3 CHAN 0))
	         (COND
	           ((SETQ PROC (ffetch (CHAT.STATE TYPEOUTPROC) of STATE))
	            (AND (PROCESSP PROC)
	                 (DEL.PROCESS PROC))))
	         (freplace (CHAT.STATE TYPEOUTPROC) of STATE with NIL)
	         (freplace (CHAT.STATE TEXTSTREAM) of STATE with NIL)
	         (freplace (CHAT.STATE TYPESCRIPTSTREAM) of STATE with NIL)
	         (freplace (CHAT.STATE WINDOW) of STATE with NIL)
	         (freplace (CHAT.STATE DSP) of STATE with NIL))))
      (COND
        ((SETQ PROC (WINDOWPROP WINDOW 'PROCESS))
         (AND (TTY.PROCESSP PROC)
              (TTY.PROCESS T))
         (AND (PROCESSP PROC)
              (DEL.PROCESS PROC))))
      (WINDOWDELPROP WINDOW 'CLOSEFN (FUNCTION MAG-VTERM-CLOSEFN))
      (for PROP in '(PROCESS
                     CURSORMOVEDFN
                     RESHAPEFN
                     BUTTONEVENTFN
                     WINDOWENTRYFN
                     RIGHTBUTTONFN
                     REPAINTFN)
           do (WINDOWPROP WINDOW PROP NIL))
      (for PROP in '(MAG-VTERM-STATE
                     MAG-VTERM-CHANNEL
                     MAG-VTERM-BUFFER
                     MAG-VTERM-READ-BUFFER
                     MAG-GHOSTTY-ROWLIST-BUFFER
                     MAG-VTERM-GHOSTTY
                     MAG-GHOSTTY-MAXCOMMAND
                     MAG-GHOSTTY-CHECK-ROWS
                     MAG-GHOSTTY-FORCE-REFRESH
                     MAG-GHOSTTY-CURSOR-X
                     MAG-GHOSTTY-CURSOR-Y
                     MAG-GHOSTTY-DEFAULT-FG
                     MAG-GHOSTTY-DEFAULT-BG
                     MAG-GHOSTTY-REFRESH-COUNT
                     MAG-GHOSTTY-CHANGED-REFRESH-COUNT
                     MAG-GHOSTTY-FULL-REFRESH-COUNT
                     MAG-GHOSTTY-FORCE-REFRESH-COUNT
                     MAG-GHOSTTY-ROW-DRAW-COUNT
                     MAG-GHOSTTY-CURSOR-INVERT-COUNT
	                     MAG-GHOSTTY-BOX-DRAW-COUNT
	                     MAG-VTERM-TYPEOUT-LOOP-COUNT
	                     MAG-VTERM-TYPEOUT-SEEN-COUNT
	                     MAG-VTERM-TYPEOUT-LAST
	                     MAG-VTERM-PUMP-COUNT
	                     MAG-VTERM-PUMP-SEEN-COUNT
	                     MAG-VTERM-PUMP-LAST
	                     MAG-VTERM-PUMP-NO-REFRESH
	                     MAG-VTERM-RENDER-STATS-ENABLED
	                     MAG-VTERM-BASE-TITLE
	                     MAG-VTERM-PARAMS
	                     MAG-VTERM-CURRENT-PARAM
	                     MAG-VTERM-PRIVATE
	                     MAG-VTERM-MODE
	                     MAG-VTERM-INPUT-MODE
	                     MAG-VTERM-CSI-PARAM
	                     MAG-VTERM-FIND-TEXT
	                     MAG-VTERM-FIND-ROW
	                     MAG-VTERM-FIND-COL)
           do (REMWINDOWPROP WINDOW PROP))])

(MAG-VTERM
  [LAMBDA (TITLE COMMAND)
    (MAG-VTERM-ENSURE)
    (LET* ((WINDOW (MAG-CHAT-CREATE-WINDOW TITLE))
           (CHAN (FORK-SHELL "xterm-256color" COMMAND))
           STATE INPROC OUTPROC)
      (COND
        ((NULL CHAN)
         (CLOSEW WINDOW)
         (ERROR "Could not create shell stream" COMMAND))
        (T
         (SETQ STATE (create CHAT.STATE
                       RUNNING? _ T
                       WRAPMODE _ T
                       ROLLMODE _ T
                       INSTREAM _ NIL
                       OUTSTREAM _ NIL
                       WINDOW _ WINDOW
                       DSP _ (WINDOWPROP WINDOW 'DSP)))
         (WINDOWPROP WINDOW 'MAG-VTERM-STATE STATE)
         (WINDOWPROP WINDOW 'MAG-VTERM-CHANNEL CHAN)
         (SETQ MAG-VTERM-LAST-WINDOW WINDOW)
         (WINDOWPROP WINDOW 'MAG-VTERM-BASE-TITLE TITLE)
         (WINDOWPROP WINDOW 'MAG-GHOSTTY-MAXCOMMAND
                     (OR (MAG-UNIX-HANDLECOMM1 8) 0))
         (WINDOWPROP WINDOW 'MAG-VTERM-GHOSTTY (MAG-GHOSTTY-AVAILABLEP))
         (AND MAG-VTERM-RENDER-STATS-DEFAULT
              (MAG-VTERM-RESET-RENDER-STATS WINDOW))
         (WINDOWPROP WINDOW 'CURSORMOVEDFN NIL)
         (WINDOWPROP WINDOW 'RESHAPEFN (FUNCTION MAG-VTERM-RESHAPEFN))
         (WINDOWPROP WINDOW 'BUTTONEVENTFN (FUNCTION MAG-VTERM-BUTTONFN))
         (WINDOWPROP WINDOW 'WINDOWENTRYFN 'GIVE.TTY.PROCESS)
         (WINDOWPROP WINDOW 'RIGHTBUTTONFN NIL)
         (WINDOWPROP WINDOW 'REPAINTFN NIL)
         (WINDOWADDPROP WINDOW 'CLOSEFN (FUNCTION MAG-VTERM-CLOSEFN))
         (MODERNWINDOW WINDOW)
         (MAG-WINDOW-SET-BACKGROUND WINDOW)
         (TERM.RESET.DISPLAY.PARMS STATE)
         (MAG-VTERM-APPLY-ROW-GEOMETRY STATE)
         (MAG-GHOSTTY-SAVE-DEFAULT-COLORS WINDOW STATE)
         (MAG-VTERM-TABS STATE)
         (AND (NOT (WINDOWPROP WINDOW 'MAG-VTERM-GHOSTTY)) (TERM.HOME STATE))
         (MAG-VTERM-SCREENPARAMS STATE)
	         (SETQ OUTPROC (ADD.PROCESS (LIST (FUNCTION MAG-VTERM-TYPEOUT) WINDOW STATE)
	                                     'NAME
	                                     'MAG-VTERM-TYPEOUT
	                                     'RESTARTABLE
	                                     'NO
	                                     'SCHEDULE
	                                     T))
         (freplace (CHAT.STATE TYPEOUTPROC) of STATE with OUTPROC)
         (AND OUTPROC (WAKE.PROCESS OUTPROC))
         (SETQ INPROC (ADD.PROCESS (LIST (FUNCTION MAG-VTERM-TYPEIN) WINDOW STATE)
                                    'NAME 'MAG-VTERM-TYPEIN))
         (WINDOWPROP WINDOW 'PROCESS INPROC)
         (TTY.PROCESS INPROC)
         WINDOW)))])

(MAG-SHELL
  [LAMBDA NIL
    (MAG-VTERM "Mag Shell" NIL)])

(MAG-CODEX
  [LAMBDA NIL
    (MAG-VTERM "Mag Codex" "medley-codex")])

(MAG-RUN-COMMAND
  [LAMBDA (COMMAND)
    (AND COMMAND
         (IGREATERP (NCHARS COMMAND) 0)
         (MAG-VTERM (CONCAT "Mag Run  " COMMAND) COMMAND))])

(MAG-RUN
  [LAMBDA NIL
    (MAG-RUN-COMMAND (MAG-PROMPT-LINE "terminal command" NIL))])

(MAG-VTERM-APPLY-BACKGROUND-OPEN-WINDOWS
  [LAMBDA NIL
    (for W in (OPENWINDOWS) do
      (AND (WINDOWPROP W 'MAG-VTERM-STATE)
           (CAR (NLSETQ (MAG-VTERM-REFRESH W)))))
    T])
)

(NLSETQ (MAG-VTERM-APPLY-BACKGROUND-OPEN-WINDOWS))

STOP
