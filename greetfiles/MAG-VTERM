(MAG-VTERM-STATE-REPORT
  [LAMBDA NIL
    (LET ((WINDOW (MAG-VTERM-ACTIVE-WINDOW)))
      (COND
        ((NULL WINDOW)
         "No active Mag terminal window")
        (T
         (LET* ((STATE (WINDOWPROP WINDOW 'MAG-VTERM-STATE))
                (CHAN (AND STATE (WINDOWPROP WINDOW 'MAG-VTERM-CHANNEL)))
                (MAXCOMMAND (OR (MAG-UNIX-HANDLECOMM1 8) 0))
                (BUFFER (MAG-GHOSTTY-BUFFER WINDOW))
                LEN)
           (COND
             ((NULL CHAN)
              "Active Mag terminal has no channel")
             ((ILESSP MAXCOMMAND 40)
              (CONCAT "Mag terminal state\nslot=" CHAN
                      "\nunix-handlecomm-max=" MAXCOMMAND
                      "\ncommand40=unavailable; restart into rebuilt Maiko"))
             (T
              (SETQ LEN (MAG-UNIX-HANDLECOMM3 40 CHAN BUFFER))
              (COND
                ((AND LEN (IGREATERP LEN 0))
                 (LET ((OUT (CL:MAKE-STRING-OUTPUT-STREAM)))
                   (MAG-STRING-OUTPUT (MAG-GHOSTTY-BUFFER-STRING BUFFER LEN) OUT)
                   (MAG-STRING-OUTPUT
                     (CONCAT "lisp-ghostty="
                             (COND ((WINDOWPROP WINDOW 'MAG-VTERM-GHOSTTY) "yes")
                                   (T "no"))) OUT)
                   (CL:WRITE-CHAR (CL:CODE-CHAR 10) OUT)
                   (MAG-STRING-OUTPUT
                     (CONCAT "lisp-max-command="
                             (OR (WINDOWPROP WINDOW 'MAG-GHOSTTY-MAXCOMMAND) "nil")) OUT)
                   (CL:WRITE-CHAR (CL:CODE-CHAR 10) OUT)
                   (MAG-STRING-OUTPUT (CONCAT "baseline-pad=" (MAG-VTERM-BASELINE-PAD)) OUT)
                   (CL:WRITE-CHAR (CL:CODE-CHAR 10) OUT)
                   (MAG-STRING-OUTPUT
                     (CONCAT "font-height=" (ffetch (CHAT.STATE FONTHEIGHT) of STATE)) OUT)
                   (CL:WRITE-CHAR (CL:CODE-CHAR 10) OUT)
                   (MAG-STRING-OUTPUT
                     (CONCAT "font-descent=" (ffetch (CHAT.STATE FONTDESCENT) of STATE)) OUT)
                   (CL:WRITE-CHAR (CL:CODE-CHAR 10) OUT)
                   (MAG-STRING-OUTPUT
                     (CONCAT "tty-height=" (ffetch (CHAT.STATE TTYHEIGHT) of STATE)) OUT)
                   (CL:WRITE-CHAR (CL:CODE-CHAR 10) OUT)
                   (MAG-STRING-OUTPUT
                     (CONCAT "home-pos=" (ffetch (CHAT.STATE HOMEPOS) of STATE)) OUT)
                   (CL:WRITE-CHAR (CL:CODE-CHAR 10) OUT)
                   (MAG-STRING-OUTPUT (MAG-VTERM-RENDER-STATS-LINE WINDOW) OUT)
                   (CL:WRITE-CHAR (CL:CODE-CHAR 10) OUT)
                   (CL:GET-OUTPUT-STREAM-STRING OUT)))
                (T "Mag terminal state unavailable"))))))))])

	(MAG-VTERM-RPC-DRAIN-ONCE
	  [LAMBDA NIL
    (LET ((WINDOW (MAG-VTERM-ACTIVE-WINDOW)))
      (COND
        ((NULL WINDOW)
         "No active Mag terminal window")
        (T
         (PROG ((STATE (WINDOWPROP WINDOW 'MAG-VTERM-STATE))
                CHAN BUFFER LEN READS SEEN DONE OUT)
           (SETQ CHAN (AND STATE (WINDOWPROP WINDOW 'MAG-VTERM-CHANNEL)))
           (COND
             ((NULL CHAN)
              (RETURN "Active Mag terminal has no channel")))
           (SETQ BUFFER (MAG-VTERM-READ-BUFFER WINDOW))
           (SETQ READS 0)
         DRAIN
           (COND
             ((IGEQ READS 64)
              (SETQ DONE 'LIMIT)
              (GO REPORT)))
	           (SETQ LEN (MAG-GHOSTTY-DRAIN-CHANNEL CHAN WINDOW BUFFER))
           (COND
             ((AND LEN (NEQ LEN T))
              (SETQ SEEN T)
              (SETQ READS (ADD1 READS))
              (GO DRAIN))
             ((EQ LEN T)
              (SETQ DONE 'NO-DATA))
             (T
              (SETQ DONE 'EOF)))
	         REPORT
	           (AND SEEN
	                (PROGN
	                  (freplace (CHAT.STATE CHATINEMACS) of STATE with T)
	                  (MAG-GHOSTTY-REFRESH WINDOW STATE)))
           (SETQ OUT (CL:MAKE-STRING-OUTPUT-STREAM))
           (MAG-STRING-OUTPUT
             (CONCAT "drain-reads=" READS " final=" (OR DONE "unknown")
                     " seen=" (COND (SEEN "yes") (T "no")))
             OUT)
           (CL:WRITE-CHAR (CL:CODE-CHAR 10) OUT)
           (MAG-STRING-OUTPUT (MAG-VTERM-RENDER-STATS-LINE WINDOW) OUT)
           (CL:WRITE-CHAR (CL:CODE-CHAR 10) OUT)
           (MAG-STRING-OUTPUT (MAG-VTERM-STATE-REPORT) OUT)
	           (RETURN (CL:GET-OUTPUT-STREAM-STRING OUT))))))])

	(MAG-VTERM-PUMP-WINDOW
	  [LAMBDA (WINDOW MAXREADS)
	    (PROG (STATE CHAN BUFFER LEN READS SEEN)
	      (COND
	        ((NULL WINDOW)
	         (RETURN NIL)))
	      (SETQ STATE (WINDOWPROP WINDOW 'MAG-VTERM-STATE))
	      (COND
	        ((OR (NULL STATE)
	             (NOT (EQ (ffetch (CHAT.STATE RUNNING?) of STATE) T)))
	         (RETURN NIL)))
	      (SETQ CHAN (MAG-GHOSTTY-CHANNEL STATE))
	      (COND
	        ((OR (NULL CHAN)
	             (NOT (WINDOWPROP WINDOW 'MAG-VTERM-GHOSTTY)))
	         (RETURN NIL))
	        ((NOT (MAG-GHOSTTY-READYP CHAN WINDOW))
	         (MAG-VTERM-RENDER-STAT WINDOW 'MAG-VTERM-PUMP-COUNT)
	         (MAG-VTERM-DEBUG-PROP WINDOW 'MAG-VTERM-PUMP-LAST "not-ready")
	         (RETURN NIL)))
	      (SETQ BUFFER (MAG-VTERM-READ-BUFFER WINDOW))
	      (SETQ READS 0)
	    DRAIN
	      (COND
	        ((IGEQ READS (OR MAXREADS 16))
	         (GO REPORT)))
	      (SETQ LEN (MAG-GHOSTTY-DRAIN-CHANNEL CHAN WINDOW BUFFER))
	      (COND
	        ((AND LEN (NEQ LEN T))
	         (SETQ SEEN T)
	         (SETQ READS (ADD1 READS))
	         (GO DRAIN))
	        ((EQ LEN T)
	         (GO REPORT))
	        (T
	         (freplace (CHAT.STATE RUNNING?) of STATE with NIL)
	         (AND (OPENWP WINDOW)
	              (WINDOWPROP WINDOW 'TITLE
	                                   (CONCAT (WINDOWPROP WINDOW 'TITLE)
	                                           ", closed")))
	         (MAG-VTERM-DEBUG-PROP WINDOW 'MAG-VTERM-PUMP-LAST "eof")
	         (RETURN NIL)))
	    REPORT
	      (MAG-VTERM-RENDER-STAT WINDOW 'MAG-VTERM-PUMP-COUNT)
	      (COND
		 (SEEN
		  (MAG-VTERM-RENDER-STAT WINDOW 'MAG-VTERM-PUMP-SEEN-COUNT)
		  (MAG-VTERM-DEBUG-PROP WINDOW 'MAG-VTERM-PUMP-LAST "bytes")
		  (COND
			    ((WINDOWPROP WINDOW 'MAG-VTERM-PUMP-NO-REFRESH)
			     NIL)
			    (T
			     (freplace (CHAT.STATE CHATINEMACS) of STATE with T)
			     (MAG-GHOSTTY-REFRESH WINDOW STATE)))
		  (RETURN T))
	        (T
	         (MAG-VTERM-DEBUG-PROP WINDOW 'MAG-VTERM-PUMP-LAST "no-data")
	         (RETURN NIL))))])

