      (COND
        ((AND TEXT (MAG-CLIPBOARD-PUT TEXT))
         T)
        (T (FLASHWINDOW WINDOW)
           NIL)))])

(MAG-VTERM-COPY-SCROLLBACK
  [LAMBDA (WINDOW)
    (LET ((TEXT (MAG-VTERM-SCROLLBACK-TEXT WINDOW)))
      (COND
        ((AND TEXT (MAG-CLIPBOARD-PUT TEXT))
         (MAG-VTERM-SET-STATUS WINDOW
                               (CONCAT "Copied " (NCHARS TEXT)
                                       " chars of scrollback"))
         T)
        (T (FLASHWINDOW WINDOW)
           NIL)))])

(MAG-VTERM-SAVE-VISIBLE
  [LAMBDA (WINDOW)
    (LET ((PATH (MAG-PROMPT-LINE "save terminal visible file" NIL))
