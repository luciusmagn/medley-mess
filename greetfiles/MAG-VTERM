(MAG-WRITE-UTF8-TEXT-FILE
  [LAMBDA (PATH TEXT)
    (PROG (STREAM BYTES SOURCE)
      (COND
        ((OR (NULL PATH) (EQ (NCHARS PATH) 0))
         (RETURN NIL)))
      (SETQ SOURCE (OR TEXT ""))
      (SETQ STREAM (CAR (NLSETQ (OPENSTREAM PATH 'OUTPUT 'NEW))))
      (COND
        ((NULL STREAM)
         (RETURN NIL)))
      (for I from 1 to (NCHARS SOURCE) do
        (SETQ BYTES (MAG-VTERM-UTF8-BYTES (NTHCHARCODE SOURCE I)))
        (for BYTE in BYTES do
          (BOUT STREAM BYTE)))
      (CLOSEF STREAM)
      (RETURN T))])

