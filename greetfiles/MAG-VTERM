(MAG-VTERM-CSI-FINAL-KEYID
  [LAMBDA (CH PARAM)
    (SELECTQ CH
      (65 1)
      (66 2)
      (67 3)
      (68 4)
      (72 5)
      (70 6)
      (126 (SELECTQ PARAM
             (3 9)
             NIL))
      NIL)])

(MAG-VTERM-SEND-INPUT-KEY
  [LAMBDA (WINDOW OUTSTREAM CH)
    (PROG ((MODE (WINDOWPROP WINDOW 'MAG-VTERM-INPUT-MODE))
           (PARAM (OR (WINDOWPROP WINDOW 'MAG-VTERM-CSI-PARAM) 0))
           KEYID)
      (COND
        ((EQ MODE 'CSI)
         (COND
           ((AND (IGEQ CH 48) (ILEQ CH 57))
            (WINDOWPROP WINDOW 'MAG-VTERM-CSI-PARAM
                        (IPLUS (ITIMES PARAM 10) (IDIFFERENCE CH 48)))
            (RETURN T))
           ((EQ CH 59)
            (RETURN T))
           ((SETQ KEYID (MAG-VTERM-CSI-FINAL-KEYID CH PARAM))
            (WINDOWPROP WINDOW 'MAG-VTERM-INPUT-MODE NIL)
            (WINDOWPROP WINDOW 'MAG-VTERM-CSI-PARAM NIL)
            (RETURN (MAG-VTERM-SEND-KEYID WINDOW OUTSTREAM KEYID)))
           (T
            (WINDOWPROP WINDOW 'MAG-VTERM-INPUT-MODE NIL)
            (WINDOWPROP WINDOW 'MAG-VTERM-CSI-PARAM NIL)
            (MAG-VTERM-WRITE-BYTES OUTSTREAM '(27 91))
            (RETURN (MAG-VTERM-SEND-KEY WINDOW OUTSTREAM CH)))))
        ((EQ MODE 'ESC)
         (WINDOWPROP WINDOW 'MAG-VTERM-INPUT-MODE NIL)
         (COND
           ((EQ CH 91)
            (WINDOWPROP WINDOW 'MAG-VTERM-INPUT-MODE 'CSI)
            (WINDOWPROP WINDOW 'MAG-VTERM-CSI-PARAM 0)
            (RETURN T))
           (T
            (MAG-VTERM-SEND-KEYID WINDOW OUTSTREAM 13)
            (RETURN (MAG-VTERM-SEND-KEY WINDOW OUTSTREAM CH)))))
        ((EQ CH 27)
         (WINDOWPROP WINDOW 'MAG-VTERM-INPUT-MODE 'ESC)
         (RETURN T))
        (T
         (RETURN (MAG-VTERM-SEND-KEY WINDOW OUTSTREAM CH)))))])

(MAG-VTERM-SEND-KEY
  [LAMBDA (WINDOW OUTSTREAM CH)
    (PROG (KEYID BYTES)
      (COND
        ((SETQ KEYID (MAG-VTERM-SPECIAL-KEYID CH))
         (RETURN (MAG-VTERM-SEND-KEYID WINDOW OUTSTREAM KEYID)))
        ((EQ (LRSH CH 8) 1)
         (RETURN (MAG-VTERM-WRITE-BYTES
                   OUTSTREAM
                   (LIST (LOGOR 128 (LOGAND CH 127))))))
        ((SETQ BYTES (MAG-VTERM-UTF8-BYTES CH))
         (RETURN (MAG-VTERM-WRITE-BYTES OUTSTREAM BYTES)))
        (T (RETURN NIL))))])

(MAG-VTERM-SEND-BYTES
  [LAMBDA (WINDOW BYTES)
    (LET* ((STATE (WINDOWPROP WINDOW 'MAG-VTERM-STATE))
            (OUTSTREAM (OR (WINDOWPROP WINDOW 'MAG-VTERM-CHANNEL)
                           (AND STATE (ffetch (CHAT.STATE OUTSTREAM) of STATE)))))
      (COND
         (OUTSTREAM
          (AND (MAG-VTERM-WRITE-BYTES OUTSTREAM BYTES)
               (PROGN
                 (AND (NOT (SMALLP OUTSTREAM)) (FORCEOUTPUT OUTSTREAM))
                 T)))
         (T NIL)))])

(MAG-VTERM-SEND-STRING
  [LAMBDA (WINDOW TEXT LINEP)
    (PROG (BYTES)
      (COND
        ((OR (NULL TEXT) (EQ (NCHARS TEXT) 0))
         (RETURN NIL)))
      (for I from 1 to (NCHARS TEXT) do
        (for BYTE in (MAG-VTERM-UTF8-BYTES (NTHCHARCODE TEXT I)) do
          (SETQ BYTES (CONS BYTE BYTES))))
      (SETQ BYTES (DREVERSE BYTES))
      (AND LINEP (SETQ BYTES (NCONC BYTES '(13))))
      (RETURN (MAG-VTERM-SEND-BYTES WINDOW BYTES)))])

(MAG-VTERM-PASTE-BUFFER
  [LAMBDA (WINDOW BUFFER LEN)
    (LET* ((STATE (WINDOWPROP WINDOW 'MAG-VTERM-STATE))
           (CHAN (AND STATE (MAG-GHOSTTY-CHANNEL STATE)))
           WROTE)
      (AND CHAN
           (MAG-GHOSTTY-PASTEP)
           (SETQ WROTE (MAG-UNIX-HANDLECOMM4 30 CHAN BUFFER LEN))
           (SMALLP WROTE)
           WROTE))])

(MAG-VTERM-PASTE-STRING
  [LAMBDA (WINDOW TEXT)
    (PROG ((BUFFER (MAG-GHOSTTY-BUFFER WINDOW))
           (LEN 0)
           (TOTAL 0)
           BYTES WROTE)
      (COND
        ((OR (NULL TEXT) (EQ (NCHARS TEXT) 0))
         (RETURN NIL)))
      (for I from 1 to (NCHARS TEXT) do
        (SETQ BYTES (MAG-VTERM-UTF8-BYTES (NTHCHARCODE TEXT I)))
        (for BYTE in BYTES do
          (COND
            ((IGEQ LEN 480)
             (OR (SETQ WROTE (MAG-VTERM-PASTE-BUFFER WINDOW BUFFER LEN))
                 (RETURN NIL))
             (SETQ TOTAL (IPLUS TOTAL WROTE))
             (SETQ LEN 0)))
          (\PUTBASEBYTE BUFFER LEN BYTE)
          (SETQ LEN (ADD1 LEN))))
      (COND
        ((IGREATERP LEN 0)
         (OR (SETQ WROTE (MAG-VTERM-PASTE-BUFFER WINDOW BUFFER LEN))
             (RETURN NIL))
         (SETQ TOTAL (IPLUS TOTAL WROTE))))
      (RETURN TOTAL))])

(MAG-VTERM-PROMPT-SEND
  [LAMBDA (WINDOW LINEP)
    (LET ((TEXT (MAG-PROMPT-LINE
                  (COND (LINEP "terminal line") (T "terminal text"))
                  NIL)))
      (AND TEXT (MAG-VTERM-SEND-STRING WINDOW TEXT LINEP)))])

(MAG-VTERM-PASTE-CLIPBOARD
  [LAMBDA (WINDOW)
    (LET ((TEXT (MAG-CLIPBOARD-GET)))
      (COND
        ((AND TEXT (IGREATERP (NCHARS TEXT) 0))
         (OR (AND (MAG-GHOSTTY-PASTEP)
                  (MAG-VTERM-PASTE-STRING WINDOW TEXT))
             (MAG-VTERM-SEND-STRING WINDOW TEXT NIL)))
        (T (FLASHWINDOW WINDOW)
           NIL)))])

(MAG-VTERM-VISIBLE-TEXT
  [LAMBDA (WINDOW)
    (LET* ((STATE (WINDOWPROP WINDOW 'MAG-VTERM-STATE))
           (CHAN (AND STATE (MAG-GHOSTTY-CHANNEL STATE)))
           (ROWS (AND STATE
                      (IQUOTIENT (ffetch (CHAT.STATE TTYHEIGHT) of STATE)
                                 (ffetch (CHAT.STATE FONTHEIGHT) of STATE))))
           (COLS (AND STATE
                      (IQUOTIENT (ffetch (CHAT.STATE TTYWIDTH) of STATE)
                                 (ffetch (CHAT.STATE FONTWIDTH) of STATE))))
           (BUFFER (MAG-GHOSTTY-BUFFER WINDOW))
           (OUT (CL:MAKE-STRING-OUTPUT-STREAM))
           LINE)
      (AND CHAN
           (MAG-UNIX-HANDLECOMM2 18 CHAN)
           (PROGN
             (for ROW from 0 to (SUB1 ROWS) do
               (SETQ LINE (MAG-STRING-RTRIM-SPACES
                            (MAG-GHOSTTY-ROW-STRING CHAN ROW BUFFER COLS)))
               (MAG-STRING-OUTPUT LINE OUT)
               (AND (ILESSP ROW (SUB1 ROWS))
                    (CL:WRITE-CHAR (CL:CODE-CHAR 10) OUT)))
             (CL:GET-OUTPUT-STREAM-STRING OUT))))])

(MAG-VTERM-VISIBLE-LINES
  [LAMBDA (WINDOW)
    (LET* ((STATE (WINDOWPROP WINDOW 'MAG-VTERM-STATE))
           (CHAN (AND STATE (MAG-GHOSTTY-CHANNEL STATE)))
           (ROWS (AND STATE
                      (IQUOTIENT (ffetch (CHAT.STATE TTYHEIGHT) of STATE)
                                 (ffetch (CHAT.STATE FONTHEIGHT) of STATE))))
           (COLS (AND STATE
                      (IQUOTIENT (ffetch (CHAT.STATE TTYWIDTH) of STATE)
                                 (ffetch (CHAT.STATE FONTWIDTH) of STATE))))
           (BUFFER (MAG-GHOSTTY-BUFFER WINDOW))
           LINES LINE)
      (AND CHAN
           (MAG-UNIX-HANDLECOMM2 18 CHAN)
           (PROGN
             (for ROW from 0 to (SUB1 ROWS) do
               (SETQ LINE (MAG-STRING-RTRIM-SPACES
                            (MAG-GHOSTTY-ROW-STRING CHAN ROW BUFFER COLS)))
               (SETQ LINES (CONS LINE LINES)))
             (DREVERSE LINES))))])

(MAG-VTERM-LINES-TEXT
  [LAMBDA (LINES)
    (PROG ((OUT (CL:MAKE-STRING-OUTPUT-STREAM)))
    LP
      (COND
        ((NULL LINES)
         (RETURN (CL:GET-OUTPUT-STREAM-STRING OUT))))
      (MAG-STRING-OUTPUT (CAR LINES) OUT)
      (SETQ LINES (CDR LINES))
      (AND LINES (CL:WRITE-CHAR (CL:CODE-CHAR 10) OUT))
      (GO LP))])

(MAG-VTERM-TRIM-REVERSED-BLANK-LINES
  [LAMBDA (LINES)
    (PROG NIL
    LP
      (COND
        ((AND LINES (STREQUAL (CAR LINES) ""))
         (SETQ LINES (CDR LINES))
         (GO LP)))
      (RETURN LINES))])

(MAG-VTERM-LINES-PREFIX-EQUAL
  [LAMBDA (A B COUNT)
    (PROG ((N 0))
    LP
      (COND
        ((IGEQ N COUNT)
         (RETURN T))
        ((OR (NULL A) (NULL B) (NOT (STREQUAL (CAR A) (CAR B))))
         (RETURN NIL)))
      (SETQ A (CDR A))
      (SETQ B (CDR B))
      (SETQ N (ADD1 N))
      (GO LP))])

(MAG-VTERM-DROP-LINES
  [LAMBDA (LINES COUNT)
    (PROG ((N 0))
    LP
      (COND
        ((OR (IGEQ N COUNT) (NULL LINES))
         (RETURN LINES)))
      (SETQ LINES (CDR LINES))
      (SETQ N (ADD1 N))
      (GO LP))])

(MAG-VTERM-LINE-OVERLAP
  [LAMBDA (A B)
    (PROG ((LEN-A (LENGTH A))
           (LEN-B (LENGTH B))
           K SUFFIX)
      (SETQ K (IMIN LEN-A LEN-B))
    LP
      (COND
        ((ILEQ K 0)
         (RETURN 0)))
      (SETQ SUFFIX (NTH A (ADD1 (IDIFFERENCE LEN-A K))))
      (COND
        ((MAG-VTERM-LINES-PREFIX-EQUAL SUFFIX B K)
         (RETURN K)))
      (SETQ K (SUB1 K))
      (GO LP))])

(MAG-VTERM-REVERSE-APPEND-LINES
  [LAMBDA (REVERSED LINES)
    (PROG NIL
    LP
      (COND
        ((NULL LINES)
         (RETURN REVERSED)))
      (SETQ REVERSED (CONS (CAR LINES) REVERSED))
      (SETQ LINES (CDR LINES))
      (GO LP))])

(MAG-VTERM-SCROLLBACK-LINES
  [LAMBDA (WINDOW)
    (PROG ((LIMIT 11000)
           (STEPS 0)
           (PAGE (IMAX 1 (SUB1 (MAG-VTERM-PAGE-ROWS WINDOW))))
           LINES CURRENTLINES CURRENTTEXT NEXTLINES NEXTTEXT OVERLAP)
      (COND
        ((NOT (MAG-GHOSTTY-SCROLLP))
         (RETURN (MAG-VTERM-VISIBLE-LINES WINDOW))))
      (MAG-GHOSTTY-SCROLL-RAW WINDOW 0 0)
      (SETQ CURRENTLINES (MAG-VTERM-VISIBLE-LINES WINDOW))
      (SETQ CURRENTTEXT (MAG-VTERM-LINES-TEXT CURRENTLINES))
      (SETQ LINES (MAG-VTERM-REVERSE-APPEND-LINES LINES CURRENTLINES))
    LP
      (COND
        ((IGREATERP STEPS LIMIT)
         (GO DONE)))
      (MAG-GHOSTTY-SCROLL-RAW WINDOW 2 PAGE)
      (SETQ NEXTLINES (MAG-VTERM-VISIBLE-LINES WINDOW))
      (SETQ NEXTTEXT (MAG-VTERM-LINES-TEXT NEXTLINES))
      (COND
        ((STREQUAL CURRENTTEXT NEXTTEXT)
         (GO DONE)))
      (SETQ OVERLAP (MAG-VTERM-LINE-OVERLAP CURRENTLINES NEXTLINES))
      (SETQ LINES (MAG-VTERM-REVERSE-APPEND-LINES
                    LINES
                    (MAG-VTERM-DROP-LINES NEXTLINES OVERLAP)))
      (SETQ CURRENTLINES NEXTLINES)
      (SETQ CURRENTTEXT NEXTTEXT)
      (SETQ STEPS (ADD1 STEPS))
      (GO LP)
    DONE
      (SETQ LINES (MAG-VTERM-TRIM-REVERSED-BLANK-LINES LINES))
      (MAG-GHOSTTY-SCROLL-RAW WINDOW 1 0)
      (MAG-VTERM-REFRESH WINDOW)
      (RETURN (DREVERSE LINES)))])

(MAG-VTERM-SCROLLBACK-TEXT
  [LAMBDA (WINDOW)
    (MAG-VTERM-LINES-TEXT (MAG-VTERM-SCROLLBACK-LINES WINDOW))])

(MAG-VTERM-COPY-VISIBLE
  [LAMBDA (WINDOW)
