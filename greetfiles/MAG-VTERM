    (LET ((PARAMS (DREVERSE (WINDOWPROP WINDOW 'MAG-VTERM-PARAMS))))
      (SELECTQ FINAL
        (65 (TERM.UP STATE (MAG-VTERM-FIRST PARAMS 1)))
        (66 (TERM.DOWN STATE (MAG-VTERM-FIRST PARAMS 1)))
        (67 (TERM.RIGHT STATE (MAG-VTERM-FIRST PARAMS 1)))
        (68 (TERM.LEFT STATE (MAG-VTERM-FIRST PARAMS 1)))
        ((72 102)
         (TERM.MOVETO STATE
                      (SUB1 (MAG-VTERM-SECOND PARAMS 1))
                      (SUB1 (MAG-VTERM-FIRST PARAMS 1))))
        (74 (TERM.ERASE.IN.DISPLAY STATE (MAG-VTERM-FIRST PARAMS 0)))
        (75 (TERM.ERASE.IN.LINE STATE (MAG-VTERM-FIRST PARAMS 0)))
        (109 (MAG-VTERM-SGR STATE PARAMS))
        NIL))
    (MAG-VTERM-CSI-RESET WINDOW)
    (WINDOWPROP WINDOW 'MAG-VTERM-MODE NIL)])

(MAG-VTERM-NORMAL-CHAR
  [LAMBDA (WINDOW STATE CH)
    (SELECTQ CH
      (7 NIL)
      (8 (TERM.LEFT STATE))
      (9 (TERM.TAB STATE))
      (10 (TERM.DOWN STATE))
      (13 (MAG-VTERM-CR STATE))
      (27 (WINDOWPROP WINDOW 'MAG-VTERM-MODE 'ESC))
      (36 (WINDOWPROP WINDOW 'MAG-VTERM-MODE 'DOLLAR))
      (127 (TERM.LEFT STATE))
      (COND
        ((AND (IGEQ CH 32) (ILESSP CH 127))
         (TERM.PRINTCHAR STATE CH NIL))
        ((IGEQ CH 160)
         (TERM.PRINTCHAR STATE CH NIL))
        (T NIL)))])

(MAG-VTERM-HANDLE-CHAR
  [LAMBDA (WINDOW STATE CH)
    (LET ((MODE (WINDOWPROP WINDOW 'MAG-VTERM-MODE)))
      (SELECTQ MODE
        (NIL (MAG-VTERM-NORMAL-CHAR WINDOW STATE CH))
        (DOLLAR
         (COND
           ((EQ CH 60)
            (WINDOWPROP WINDOW 'MAG-VTERM-MODE 'PAD))
           (T
            (WINDOWPROP WINDOW 'MAG-VTERM-MODE NIL)
            (TERM.PRINTCHAR STATE 36 NIL)
            (MAG-VTERM-HANDLE-CHAR WINDOW STATE CH))))
        (PAD
         (COND
           ((EQ CH 62)
            (WINDOWPROP WINDOW 'MAG-VTERM-MODE NIL))))
        (ESC
         (SELECTQ CH
           (91
            (MAG-VTERM-CSI-RESET WINDOW)
            (WINDOWPROP WINDOW 'MAG-VTERM-MODE 'CSI))
           (93
            (WINDOWPROP WINDOW 'MAG-VTERM-MODE 'OSC))
           (99
            (MAG-WINDOW-CLEAR WINDOW)
            (TERM.RESET.DISPLAY.PARMS STATE)
            (MAG-VTERM-APPLY-ROW-GEOMETRY STATE)
            (MAG-VTERM-TABS STATE)
            (AND (NOT (WINDOWPROP WINDOW 'MAG-VTERM-GHOSTTY)) (TERM.HOME STATE))
            (WINDOWPROP WINDOW 'MAG-VTERM-MODE NIL))
           (WINDOWPROP WINDOW 'MAG-VTERM-MODE NIL)))
        (OSC
         (SELECTQ CH
           (7 (WINDOWPROP WINDOW 'MAG-VTERM-MODE NIL))
           (27 (WINDOWPROP WINDOW 'MAG-VTERM-MODE 'OSC-ESC))
           NIL))
        (OSC-ESC
         (COND
           ((OR (EQ CH 92) (EQ CH 7))
            (WINDOWPROP WINDOW 'MAG-VTERM-MODE NIL))
           ((EQ CH 27)
            (WINDOWPROP WINDOW 'MAG-VTERM-MODE 'OSC-ESC))
           (T
            (WINDOWPROP WINDOW 'MAG-VTERM-MODE 'OSC))))
        (CSI
         (COND
           ((AND (IGEQ CH 48) (ILEQ CH 57))
            (WINDOWPROP WINDOW 'MAG-VTERM-CURRENT-PARAM
                        (+ (ITIMES 10 (OR (WINDOWPROP WINDOW 'MAG-VTERM-CURRENT-PARAM) 0))
                           (IDIFFERENCE CH 48))))
           ((EQ CH 59)
            (MAG-VTERM-CSI-PUSH WINDOW))
           ((EQ CH 63)
            (WINDOWPROP WINDOW 'MAG-VTERM-PRIVATE T))
           ((AND (IGEQ CH 64) (ILEQ CH 126))
            (MAG-VTERM-FINISH-CSI WINDOW STATE CH))
           (T NIL)))
        (WINDOWPROP WINDOW 'MAG-VTERM-MODE NIL)))])

(MAG-VTERM-TYPEOUT
  [LAMBDA (WINDOW STATE)
    (PROG ((CHAN (MAG-GHOSTTY-CHANNEL STATE))
           BUFFER CH SEEN)
      (SETQ BUFFER (MAG-VTERM-READ-BUFFER WINDOW))
    LOOP
      (COND
        ((NOT (AND CHAN (EQ (ffetch (CHAT.STATE RUNNING?) of STATE) T)))
         (GO DONE)))
      (MAG-VTERM-RENDER-STAT WINDOW 'MAG-VTERM-TYPEOUT-LOOP-COUNT)
	      (COND
	        ((WINDOWPROP WINDOW 'MAG-VTERM-GHOSTTY)
	         (SETQ SEEN NIL)
	         (PROG NIL
	         DRAIN
	           (COND
		             ((AND (SETQ CH (MAG-GHOSTTY-DRAIN-CHANNEL CHAN WINDOW BUFFER))
	                   (NEQ CH T))
              (MAG-VTERM-DEBUG-PROP WINDOW 'MAG-VTERM-TYPEOUT-LAST "bytes")
              (SETQ SEEN T)
              (GO DRAIN))))
         (COND
         (SEEN
           (MAG-VTERM-RENDER-STAT WINDOW 'MAG-VTERM-TYPEOUT-SEEN-COUNT)
           (COND
	             ((WINDOWPROP WINDOW 'MAG-VTERM-PUMP-NO-REFRESH)
	              NIL)
	             (T
	              (freplace (CHAT.STATE CHATINEMACS) of STATE with T)
	              (MAG-GHOSTTY-REFRESH WINDOW STATE)))
            (DISMISS 50))
          ((EQ CH T)
           (MAG-VTERM-DEBUG-PROP WINDOW 'MAG-VTERM-TYPEOUT-LAST "no-data")
            (DISMISS 100))
          (T
           (MAG-VTERM-DEBUG-PROP WINDOW 'MAG-VTERM-TYPEOUT-LAST "eof")
           (GO DONE))))
        (T
         (SETQ CH (MAG-UNIX-HANDLECOMM2 2 CHAN))
         (COND
           ((EQ CH T)
            (MAG-VTERM-DEBUG-PROP WINDOW 'MAG-VTERM-TYPEOUT-LAST "no-data")
            (BLOCK))
           ((NULL CH)
            (MAG-VTERM-DEBUG-PROP WINDOW 'MAG-VTERM-TYPEOUT-LAST "eof")
            (GO DONE))
           (T
            (MAG-VTERM-DEBUG-PROP WINDOW 'MAG-VTERM-TYPEOUT-LAST "byte")
            (MAG-VTERM-HANDLE-CHAR WINDOW STATE (LOGAND CH 255))))))
      (GO LOOP)
    DONE
      (freplace (CHAT.STATE RUNNING?) of STATE with NIL)
      (AND (OPENWP WINDOW)
           (WINDOWPROP WINDOW 'TITLE
                                (CONCAT (WINDOWPROP WINDOW 'TITLE) ", closed")))
      (BLOCK))])

(MAG-VTERM-WRITE-BYTES-CHANNEL
