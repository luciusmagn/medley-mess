(MAG-VTERM-NATIVE-KEY-DECODE-P
  [LAMBDA NIL
    (COND
      ((EQ MAG-VTERM-NATIVE-KEY-DECODE-AVAILABLE 'YES)
       T)
      ((EQ MAG-VTERM-NATIVE-KEY-DECODE-AVAILABLE 'NO)
       NIL)
      ((IGEQ (OR (MAG-UNIX-HANDLECOMM1 8) 0) 59)
       (SETQ MAG-VTERM-NATIVE-KEY-DECODE-AVAILABLE 'YES)
       T)
      (T
       (SETQ MAG-VTERM-NATIVE-KEY-DECODE-AVAILABLE 'NO)
       NIL))])

(MAG-VTERM-SEND-GHOSTTY-KEYID
  [LAMBDA (WINDOW KEYID)
    (LET* ((STATE (WINDOWPROP WINDOW 'MAG-VTERM-STATE))
            (CHAN (AND STATE (MAG-GHOSTTY-CHANNEL STATE)))
            WROTE)
               (AND CHAN
            KEYID
            (MAG-GHOSTTY-KEYP)
            (SETQ WROTE (MAG-UNIX-HANDLECOMM5 25 CHAN KEYID 0 0))
            (AND (SMALLP WROTE)
                 (IGREATERP WROTE 0)
                 WROTE)))])

(MAG-VTERM-NAV-KEYIDP
  [LAMBDA (KEYID)
    (AND KEYID (IGEQ KEYID 1) (ILEQ KEYID 10))])

(MAG-VTERM-SEND-GHOSTTY-KEY
  [LAMBDA (WINDOW CH)
    (LET ((KEYID (MAG-VTERM-SPECIAL-KEYID CH)))
      (AND KEYID
           (MAG-VTERM-SEND-GHOSTTY-KEYID WINDOW KEYID)))])

(MAG-VTERM-WRITE-KEYID-FALLBACK
