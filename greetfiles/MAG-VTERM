	(MAG-GHOSTTY-DRAIN-CHANNEL
	  [LAMBDA (CHAN WINDOW BUFFER)
	    (COND
	      ((MAG-GHOSTTY-DRAIN-MANYP WINDOW)
	       (MAG-UNIX-HANDLECOMM3 56 CHAN 64))
	      ((MAG-GHOSTTY-DRAIN-NO-COPYP WINDOW)
	       (MAG-UNIX-HANDLECOMM2 53 CHAN))
	      (T
	       (MAG-UNIX-HANDLECOMM3 9 CHAN BUFFER)))])

	(MAG-GHOSTTY-BUFFER-STRING
  [LAMBDA (BUFFER LEN)
    (PROG ((OUT (CL:MAKE-STRING-OUTPUT-STREAM))
           (I 0))
    LP
      (COND
        ((OR (NULL LEN) (NOT (ILESSP I LEN)))
         (RETURN (CL:GET-OUTPUT-STREAM-STRING OUT))))
      (CL:WRITE-CHAR (CL:CODE-CHAR (\GETBASEBYTE BUFFER I)) OUT)
      (SETQ I (ADD1 I))
      (GO LP))])

(MAG-GHOSTTY-WIDE-ROW-STRING
  [LAMBDA (BUFFER LEN)
    (PROG ((OUT (CL:MAKE-STRING-OUTPUT-STREAM))
           (I 0)
           (POS 0)
