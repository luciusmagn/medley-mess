(MAG-VTERM-APPLY-ROW-GEOMETRY
  [LAMBDA (STATE)
    (LET* ((WINDOW (ffetch (CHAT.STATE WINDOW) of STATE))
           (PAD (MAG-VTERM-BASELINE-PAD))
           (BASEHEIGHT (ffetch (CHAT.STATE FONTHEIGHT) of STATE))
           (FONTDESCENT (ffetch (CHAT.STATE FONTDESCENT) of STATE))
           (FONTWIDTH (ffetch (CHAT.STATE FONTWIDTH) of STATE))
           LINEHEIGHT TTYHEIGHT)
      (COND
        ((AND (SMALLP PAD) (IGREATERP PAD 0))
         (SETQ LINEHEIGHT (IPLUS BASEHEIGHT PAD))
         (SETQ TTYHEIGHT
               (IPLUS (ITIMES (IQUOTIENT (WINDOWPROP WINDOW 'HEIGHT)
                                          LINEHEIGHT)
                               LINEHEIGHT)
                      (IPLUS FONTDESCENT PAD)))
         (freplace (CHAT.STATE FONTHEIGHT) of STATE with LINEHEIGHT)
         (freplace (CHAT.STATE TTYHEIGHT) of STATE
                   with (freplace (CHAT.STATE TOPMARGIN) of STATE
                                  with TTYHEIGHT))
         (freplace (CHAT.STATE BOTTOMMARGIN) of STATE with 0)
         (freplace (CHAT.STATE HOMEPOS) of STATE
                   with (IDIFFERENCE TTYHEIGHT LINEHEIGHT))
         (freplace (CHAT.STATE TTYWIDTH) of STATE
                   with (ITIMES (IQUOTIENT (WINDOWPROP WINDOW 'WIDTH)
                                           FONTWIDTH)
                                FONTWIDTH))))
      STATE)])

(MAG-VTERM-SCREENPARAMS
  [LAMBDA (STATE)
    (LET ((CHAN (MAG-GHOSTTY-CHANNEL STATE))
          (HEIGHT (IQUOTIENT (ffetch (CHAT.STATE TTYHEIGHT) of STATE)
                             (ffetch (CHAT.STATE FONTHEIGHT) of STATE)))
          (WIDTH (IQUOTIENT (ffetch (CHAT.STATE TTYWIDTH) of STATE)
                            (ffetch (CHAT.STATE FONTWIDTH) of STATE))))
      (AND CHAN
           (PROGN
             (MAG-UNIX-HANDLECOMM4 10 CHAN HEIGHT WIDTH)
             (AND (GETD 'MAG-GHOSTTY-RESIZE)
                  (MAG-GHOSTTY-RESIZE STATE HEIGHT WIDTH)))))])

