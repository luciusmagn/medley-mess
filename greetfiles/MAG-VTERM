           (X (DSPXPOSITION NIL DSP))
           (Y (DSPYPOSITION NIL DSP))
           (FONTWIDTH (ffetch (CHAT.STATE FONTWIDTH) of STATE))
           (FONTHEIGHT (ffetch (CHAT.STATE FONTHEIGHT) of STATE))
           (FONTDESCENT (ffetch (CHAT.STATE FONTDESCENT) of STATE))
           (BOTTOM (IDIFFERENCE Y (IPLUS FONTDESCENT
                                          (MAG-VTERM-BASELINE-PAD))))
           (TOP (IPLUS BOTTOM (SUB1 FONTHEIGHT)))
           (LEFT X)
           (RIGHT (IPLUS X (SUB1 FONTWIDTH)))
           (MIDX (IPLUS X (IQUOTIENT FONTWIDTH 2)))
           (MIDY (IPLUS BOTTOM (IQUOTIENT FONTHEIGHT 2)))
           (WIDTH 1)
           L R U D)
      (SETQ FLAGS (LOGAND (OR FLAGS 0) 240))
      (SETQ L (NEQ (LOGAND FLAGS 16) 0))
      (SETQ R (NEQ (LOGAND FLAGS 32) 0))
      (SETQ U (NEQ (LOGAND FLAGS 64) 0))
      (SETQ D (NEQ (LOGAND FLAGS 128) 0))
      (COND
        ((NOT (OR L R U D))
         (SETQ L T R T U T D T)))
      (MAG-GHOSTTY-BLT-CODE STATE 32)
      (MAG-VTERM-RENDER-STAT WINDOW 'MAG-GHOSTTY-BOX-DRAW-COUNT)
      (COND (L (DRAWLINE LEFT MIDY MIDX MIDY WIDTH 'PAINT DSP)))
      (COND (R (DRAWLINE MIDX MIDY RIGHT MIDY WIDTH 'PAINT DSP)))
      (COND (U (DRAWLINE MIDX MIDY MIDX TOP WIDTH 'PAINT DSP)))
      (COND (D (DRAWLINE MIDX BOTTOM MIDX MIDY WIDTH 'PAINT DSP)))
      (DSPXPOSITION (IPLUS X FONTWIDTH) DSP)
      (DSPYPOSITION Y DSP)
      T)])

