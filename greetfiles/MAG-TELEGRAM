(MAG-TELEGRAM-CANCEL-COMPOSE
  [LAMBDA (WINDOW)
    (WINDOWPROP WINDOW 'MAG-TELEGRAM-COMPOSING NIL)
    (WINDOWPROP WINDOW 'MAG-TELEGRAM-DRAFT "")
    (MAG-TELEGRAM-REDRAW-COMPOSE WINDOW)])

(MAG-TELEGRAM-SEND-DRAFT
  [LAMBDA (WINDOW)
    (PROG ((CHAT-ID (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-ID))
           (TEXT (OR (WINDOWPROP WINDOW 'MAG-TELEGRAM-DRAFT) ""))
           RESULT)
      (COND
        ((OR (NULL CHAT-ID) (EQ (NCHARS TEXT) 0))
         (MAG-TELEGRAM-CANCEL-COMPOSE WINDOW)
         (RETURN NIL)))
      (WINDOWPROP WINDOW 'MAG-TELEGRAM-COMPOSING NIL)
      (WINDOWPROP WINDOW 'MAG-TELEGRAM-DRAFT "")
      (MAG-TELEGRAM-REDRAW-COMPOSE WINDOW)
      (SETQ RESULT (MAG-TELEGRAM-BRIDGE (CONCAT "send " CHAT-ID " " TEXT)))
      (BLOCK 300)
      (MAG-TELEGRAM-SHOW-MESSAGES WINDOW CHAT-ID
                                  (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-LINE))
      (MAG-TELEGRAM-DRAW-CHATS WINDOW)
      (RETURN RESULT))])

(MAG-TELEGRAM-HANDLE-COMPOSE-KEY
  [LAMBDA (WINDOW CH)
    (COND
      ((NOT (WINDOWPROP WINDOW 'MAG-TELEGRAM-COMPOSING))
       NIL)
      ((OR (EQ CH 10) (EQ CH 13))
       (MAG-TELEGRAM-SEND-DRAFT WINDOW)
       T)
      ((EQ CH 27)
       (MAG-TELEGRAM-CANCEL-COMPOSE WINDOW)
       T)
      ((OR (EQ CH 8) (EQ CH 127))
       (LET ((DRAFT (OR (WINDOWPROP WINDOW 'MAG-TELEGRAM-DRAFT) "")))
         (COND
           ((EQ (NCHARS DRAFT) 1)
            (WINDOWPROP WINDOW 'MAG-TELEGRAM-DRAFT ""))
           ((IGREATERP (NCHARS DRAFT) 1)
            (WINDOWPROP WINDOW 'MAG-TELEGRAM-DRAFT
                        (SUBSTRING DRAFT 1 (SUB1 (NCHARS DRAFT)))))))
       (MAG-TELEGRAM-REDRAW-COMPOSE WINDOW)
       T)
      ((AND (IGEQ CH 32) (ILEQ CH 126))
       (WINDOWPROP WINDOW 'MAG-TELEGRAM-DRAFT
                   (CONCAT (OR (WINDOWPROP WINDOW 'MAG-TELEGRAM-DRAFT) "")
                           (MAG-TELEGRAM-CHAR-STRING CH)))
       (MAG-TELEGRAM-REDRAW-COMPOSE WINDOW)
       T)
      (T T))])

