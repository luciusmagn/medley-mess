(DEFINE-FILE-INFO PACKAGE "INTERLISP" READTABLE "INTERLISP" BASE 10)

(FILESLOAD RECORD)
(FILESLOAD CHATDECLS)
(RPAQQ MAG-TELEGRAM-BRIDGE-COMMAND "/home/mag/.local/bin/mag-telegram-bridge")
(RPAQQ MAG-TELEGRAM-REQUEST-FILE-PATH "/tmp/mag-telegram-medley-request")
(RPAQ? MAG-TELEGRAM-LAST-WINDOW NIL)
(RPAQ? MAG-TELEGRAM-MESSAGE-WINDOW NIL)
(RPAQ? MAG-TELEGRAM-COMPOSE-WINDOW NIL)
(RPAQ? MAG-TELEGRAM-COMPOSE-CONTROL-WINDOW NIL)
(RPAQ? MAG-TELEGRAM-REFRESH-PROCESS NIL)
(RPAQ? MAG-TELEGRAM-ORIGINAL-TEDIT-DOOPERATION NIL)
(RPAQQ MAG-TELEGRAM-REFRESH-INTERVAL-MS 10000)
(RPAQQ MAG-TELEGRAM-COMPOSE-HEIGHT 96)
(RPAQQ MAG-TELEGRAM-COMPOSE-CONTROL-HEIGHT 42)

(DEFINEQ

(MAG-TELEGRAM-LF
  [LAMBDA NIL
    (CONCATCODES '(10))])

(MAG-TELEGRAM-LF2
  [LAMBDA NIL
    (CONCAT (MAG-TELEGRAM-LF) (MAG-TELEGRAM-LF))])

(MAG-TELEGRAM-TAB
  [LAMBDA NIL
    (CONCATCODES '(9))])

(MAG-TELEGRAM-CHAR-STRING
  [LAMBDA (CH)
    (LET ((OUT (CL:MAKE-STRING-OUTPUT-STREAM)))
      (CL:WRITE-CHAR (CL:CODE-CHAR CH) OUT)
      (CL:GET-OUTPUT-STREAM-STRING OUT))])

(MAG-TELEGRAM-SPLIT-LINES
  [LAMBDA (TEXT)
    (PROG ((I 1)
           (START 1)
           (LEN (AND TEXT (NCHARS TEXT)))
           (LINES NIL)
           CH)
      (COND
        ((NULL TEXT)
         (RETURN '(""))))
    LP
      (COND
        ((IGREATERP I LEN)
         (RETURN (DREVERSE (CONS (COND
                                    ((ILEQ START LEN)
                                     (SUBSTRING TEXT START LEN))
                                    (T ""))
                                  LINES)))))
      (SETQ CH (NTHCHARCODE TEXT I))
      (COND
        ((OR (EQ CH 10) (EQ CH 13))
         (SETQ LINES (CONS (COND
                              ((ILESSP START I)
                               (SUBSTRING TEXT START (SUB1 I)))
                              (T ""))
                            LINES))
         (COND
           ((AND (EQ CH 13)
                 (ILESSP I LEN)
                 (EQ (NTHCHARCODE TEXT (ADD1 I)) 10))
            (SETQ I (ADD1 I))))
         (SETQ START (ADD1 I))))
      (SETQ I (ADD1 I))
      (GO LP))])

(MAG-TELEGRAM-META-VALUE
  [LAMBDA (TEXT KEY)
    (PROG ((NEEDLE (CONCAT KEY "="))
           POS START END LEN CH)
      (SETQ POS (AND TEXT (STRPOS NEEDLE TEXT)))
      (COND
        ((NULL POS)
         (RETURN NIL)))
      (SETQ START (IPLUS POS (NCHARS NEEDLE)))
      (SETQ END START)
      (SETQ LEN (NCHARS TEXT))
    LP
      (COND
        ((IGREATERP END LEN)
         (RETURN (COND
                   ((ILEQ START LEN)
                    (SUBSTRING TEXT START LEN))
                   (T "")))))
      (SETQ CH (NTHCHARCODE TEXT END))
      (COND
        ((OR (EQ CH 32) (EQ CH 9) (EQ CH 10) (EQ CH 13))
         (RETURN (COND
                   ((ILESSP START END)
                    (SUBSTRING TEXT START (SUB1 END)))
                   (T "")))))
      (SETQ END (ADD1 END))
      (GO LP))])

(MAG-TELEGRAM-META-LINE-VALUE
  [LAMBDA (TEXT KEY)
    (PROG ((NEEDLE (CONCAT KEY "="))
           POS START END LEN CH)
      (SETQ POS (AND TEXT (STRPOS NEEDLE TEXT)))
      (COND
        ((NULL POS)
         (RETURN NIL)))
      (SETQ START (IPLUS POS (NCHARS NEEDLE)))
      (SETQ END START)
      (SETQ LEN (NCHARS TEXT))
    LP
      (COND
        ((IGREATERP END LEN)
         (RETURN (COND
                   ((ILEQ START LEN)
                    (SUBSTRING TEXT START LEN))
                   (T "")))))
      (SETQ CH (NTHCHARCODE TEXT END))
      (COND
        ((OR (EQ CH 10) (EQ CH 13))
         (RETURN (COND
                   ((ILESSP START END)
                    (SUBSTRING TEXT START (SUB1 END)))
                   (T "")))))
      (SETQ END (ADD1 END))
      (GO LP))])

(MAG-TELEGRAM-TO-INTEGER
  [LAMBDA (TEXT DEFAULT)
    (PROG ((I 1)
           (LEN (AND TEXT (NCHARS TEXT)))
           (N 0)
           (NEG NIL)
           CH)
      (COND
        ((OR (NULL TEXT) (EQ LEN 0))
         (RETURN DEFAULT)))
      (COND
        ((EQ (NTHCHARCODE TEXT 1) 45)
         (SETQ NEG T)
         (SETQ I 2)))
    LP
      (COND
        ((IGREATERP I LEN)
         (RETURN (COND (NEG (IMINUS N)) (T N)))))
      (SETQ CH (NTHCHARCODE TEXT I))
      (COND
        ((OR (ILESSP CH 48) (IGREATERP CH 57))
         (RETURN DEFAULT)))
      (SETQ N (IPLUS (ITIMES N 10) (IDIFFERENCE CH 48)))
      (SETQ I (ADD1 I))
      (GO LP))])

(MAG-TELEGRAM-VISIBLE-CHAT-ROWS
  [LAMBDA (WINDOW)
    (IMAX 1
          (IDIFFERENCE
            (IQUOTIENT (WINDOWPROP WINDOW 'HEIGHT)
                       (MAG-WINDOW-LINEHEIGHT WINDOW))
            4))])

(MAG-TELEGRAM-DROP-LINES
  [LAMBDA (LINES N)
    (COND
      ((OR (NULL LINES) (ILEQ N 0))
       LINES)
      (T (MAG-TELEGRAM-DROP-LINES (CDR LINES) (SUB1 N))))])

(MAG-TELEGRAM-TAKE-LAST-LINES
  [LAMBDA (LINES N)
    (LET ((COUNT (LENGTH LINES)))
      (COND
        ((OR (NULL LINES) (ILEQ N 0))
         NIL)
        ((IGREATERP COUNT N)
         (MAG-TELEGRAM-DROP-LINES LINES (IDIFFERENCE COUNT N)))
        (T LINES)))])

(MAG-TELEGRAM-TAB-POS
  [LAMBDA (TEXT)
    (AND TEXT (STRPOS (MAG-TELEGRAM-TAB) TEXT))])

(MAG-TELEGRAM-DIGITS-P
  [LAMBDA (TEXT)
    (PROG ((I 1)
           (LEN (AND TEXT (NCHARS TEXT)))
           CH)
      (COND
        ((OR (NULL TEXT) (EQ LEN 0))
         (RETURN NIL)))
    LP
      (COND
        ((IGREATERP I LEN)
         (RETURN T)))
      (SETQ CH (NTHCHARCODE TEXT I))
      (COND
        ((OR (ILESSP CH 48) (IGREATERP CH 57))
         (RETURN NIL)))
      (SETQ I (ADD1 I))
      (GO LP))])

(MAG-TELEGRAM-LAST-SPACE-POS
  [LAMBDA (TEXT)
    (PROG ((I (AND TEXT (NCHARS TEXT))))
      (COND
        ((NULL I)
         (RETURN NIL)))
    LP
      (COND
        ((ILEQ I 0)
         (RETURN NIL))
        ((EQ (NTHCHARCODE TEXT I) 32)
         (RETURN I)))
      (SETQ I (SUB1 I))
      (GO LP))])

(MAG-TELEGRAM-ROW-PREFIX-P
  [LAMBDA (LINE)
    (AND LINE
         (IGEQ (NCHARS LINE) 2)
         (EQ (NTHCHARCODE LINE 2) 32)
         (OR (EQ (NTHCHARCODE LINE 1) 62)
             (EQ (NTHCHARCODE LINE 1) 32)))])

(MAG-TELEGRAM-ROW-SELECTED-P
  [LAMBDA (LINE)
    (AND (MAG-TELEGRAM-ROW-PREFIX-P LINE)
         (EQ (NTHCHARCODE LINE 1) 62))])

(MAG-TELEGRAM-ROW-PAYLOAD
  [LAMBDA (LINE)
    (COND
      ((MAG-TELEGRAM-ROW-PREFIX-P LINE)
       (OR (SUBSTRING LINE 3) ""))
      (T (OR LINE "")))])

(MAG-TELEGRAM-ROW-NAME
  [LAMBDA (LINE)
    (LET* ((PAYLOAD (MAG-TELEGRAM-ROW-PAYLOAD LINE))
           (POS (MAG-TELEGRAM-TAB-POS PAYLOAD))
           SPACE TAIL)
      (COND
        ((AND POS (IGREATERP POS 1))
         (SUBSTRING PAYLOAD 1 (SUB1 POS)))
        ((AND POS (EQ POS 1))
         "")
        ((AND (SETQ SPACE (MAG-TELEGRAM-LAST-SPACE-POS PAYLOAD))
              (ILESSP SPACE (NCHARS PAYLOAD))
              (SETQ TAIL (SUBSTRING PAYLOAD (ADD1 SPACE)))
              (MAG-TELEGRAM-DIGITS-P TAIL))
         (SUBSTRING PAYLOAD 1 (SUB1 SPACE)))
        (T PAYLOAD)))])

(MAG-TELEGRAM-ROW-UNREAD
  [LAMBDA (LINE)
    (LET* ((PAYLOAD (MAG-TELEGRAM-ROW-PAYLOAD LINE))
           (POS (MAG-TELEGRAM-TAB-POS PAYLOAD))
           SPACE TAIL)
      (COND
        (POS (OR (SUBSTRING PAYLOAD (ADD1 POS)) ""))
        ((AND (SETQ SPACE (MAG-TELEGRAM-LAST-SPACE-POS PAYLOAD))
              (ILESSP SPACE (NCHARS PAYLOAD))
              (SETQ TAIL (SUBSTRING PAYLOAD (ADD1 SPACE)))
              (MAG-TELEGRAM-DIGITS-P TAIL))
         TAIL)
        (T NIL)))])

(MAG-TELEGRAM-MESSAGE-SENDER
  [LAMBDA (LINE)
    (LET ((POS (MAG-TELEGRAM-TAB-POS LINE)))
      (COND
        ((AND POS (IGREATERP POS 1))
         (SUBSTRING LINE 1 (SUB1 POS)))
        ((AND POS (EQ POS 1))
         "")
        (T (OR LINE ""))))])

(MAG-TELEGRAM-MESSAGE-BODY
  [LAMBDA (LINE)
    (LET ((POS (MAG-TELEGRAM-TAB-POS LINE)))
      (COND
        (POS (OR (SUBSTRING LINE (ADD1 POS)) ""))
        (T "")))])

(MAG-TELEGRAM-CHAT-ROW-LINE-P
  [LAMBDA (LINE)
    (MAG-TELEGRAM-ROW-PREFIX-P LINE)])

(MAG-TELEGRAM-CHAT-ROWS
  [LAMBDA (LINES)
    (COND
      ((NULL LINES)
       NIL)
      ((MAG-TELEGRAM-CHAT-ROW-LINE-P (CAR LINES))
       (CONS (CAR LINES) (MAG-TELEGRAM-CHAT-ROWS (CDR LINES))))
      (T (MAG-TELEGRAM-CHAT-ROWS (CDR LINES))))])

(MAG-TELEGRAM-CHATS-UI-LINES
  [LAMBDA (TEXT)
    (PROG ((LINES (MAG-TELEGRAM-SPLIT-LINES TEXT))
           ROWS)
      (SETQ ROWS (MAG-TELEGRAM-CHAT-ROWS LINES))
      (RETURN
        (COND
          (ROWS ROWS)
          (T (APPEND (LIST "No chats loaded from bridge output:" "")
                     LINES)))))])

(MAG-TELEGRAM-MESSAGES-UI-LINES
  [LAMBDA (TEXT CHAT-LINE)
    (MAG-TELEGRAM-DROP-LINES (MAG-TELEGRAM-SPLIT-LINES TEXT) 2)])

(MAG-TELEGRAM-BOLD-FONT
  [LAMBDA (WINDOW)
    (OR (WINDOWPROP WINDOW 'MAG-TELEGRAM-BOLD-FONT)
        (LET ((FONT (DSPFONT NIL WINDOW)))
          (WINDOWPROP WINDOW 'MAG-TELEGRAM-BOLD-FONT
                      (OR (CAR
                            (NLSETQ
                              (FONTCREATE (OR (FONTPROP FONT 'FAMILY)
                                              'GACHA)
                                          (OR (FONTPROP FONT 'SIZE) 10)
                                          'BOLD)))
                          FONT))))])

(MAG-TELEGRAM-DRAW-HINT
  [LAMBDA (WINDOW BOLD PLAIN KEY TEXT)
    (DSPFONT BOLD WINDOW)
    (PRIN1 KEY WINDOW)
    (DSPFONT PLAIN WINDOW)
    (PRIN1 (CONCAT " " TEXT "  ") WINDOW)])

(MAG-TELEGRAM-DRAW-HEADER
  [LAMBDA (WINDOW TITLE DETAIL)
    (LET ((PLAIN (DSPFONT NIL WINDOW))
          (BOLD (MAG-TELEGRAM-BOLD-FONT WINDOW))
          (Y (MAG-WINDOW-ROW-Y WINDOW 0)))
      (MAG-WINDOW-CLEAR-LINE WINDOW 0)
      (MOVETO 8 Y WINDOW)
      (DSPFONT BOLD WINDOW)
      (PRIN1 TITLE WINDOW)
      (DSPFONT PLAIN WINDOW)
      (AND DETAIL (PRIN1 (CONCAT "  " DETAIL) WINDOW))
      (DSPFONT PLAIN WINDOW))])

(MAG-TELEGRAM-DRAW-STATUS-LINE
  [LAMBDA (WINDOW MODE)
    (LET ((PLAIN (DSPFONT NIL WINDOW))
          (BOLD (MAG-TELEGRAM-BOLD-FONT WINDOW))
          (Y (MAG-WINDOW-ROW-Y WINDOW 1)))
      (MAG-WINDOW-CLEAR-LINE WINDOW 1)
      (MOVETO 8 Y WINDOW)
      (DSPFONT BOLD WINDOW)
      (PRIN1 "Keys " WINDOW)
      (DSPFONT PLAIN WINDOW)
      (SELECTQ MODE
        (MESSAGES
          (MAG-TELEGRAM-DRAW-HINT WINDOW BOLD PLAIN "s" "reply")
          (MAG-TELEGRAM-DRAW-HINT WINDOW BOLD PLAIN "o" "older")
          (MAG-TELEGRAM-DRAW-HINT WINDOW BOLD PLAIN "n" "latest"))
        (PROGN
          (MAG-TELEGRAM-DRAW-HINT WINDOW BOLD PLAIN "arrows" "move")
          (MAG-TELEGRAM-DRAW-HINT WINDOW BOLD PLAIN "RET/right" "open")
          (MAG-TELEGRAM-DRAW-HINT WINDOW BOLD PLAIN "s" "reply")
          (MAG-TELEGRAM-DRAW-HINT WINDOW BOLD PLAIN "q" "close")))
      (DSPFONT PLAIN WINDOW))])

(MAG-TELEGRAM-DRAW-DIVIDER
  [LAMBDA (WINDOW)
    (LET ((Y (IPLUS (MAG-WINDOW-ROW-BOTTOM WINDOW 2)
                    (IQUOTIENT (MAG-WINDOW-LINEHEIGHT WINDOW) 2)))
          (WIDTH (IMAX 1 (IDIFFERENCE (WINDOWPROP WINDOW 'WIDTH) 16))))
      (MAG-WINDOW-CLEAR-LINE WINDOW 2)
      (BLTSHADE BLACKSHADE WINDOW 8 Y WIDTH 1 'REPLACE))])

(MAG-TELEGRAM-DRAW-CHROME
  [LAMBDA (WINDOW TITLE DETAIL MODE)
    (MAG-TELEGRAM-DRAW-HEADER WINDOW TITLE DETAIL)
    (MAG-TELEGRAM-DRAW-STATUS-LINE WINDOW MODE)
    (MAG-TELEGRAM-DRAW-DIVIDER WINDOW)])

(MAG-TELEGRAM-DRAW-CONTENT-LINES
  [LAMBDA (WINDOW LINES)
    (PROG ((ROW 3))
    LP
      (COND
        ((NULL LINES)
         (RETURN T)))
      (MAG-WINDOW-CLEAR-LINE WINDOW ROW)
      (MAG-WINDOW-DRAW-LINE WINDOW ROW (CAR LINES))
      (SETQ ROW (ADD1 ROW))
      (SETQ LINES (CDR LINES))
      (GO LP))])

(MAG-TELEGRAM-WINDOW-ROWS
  [LAMBDA (WINDOW)
    (IMAX 1
          (IQUOTIENT (WINDOWPROP WINDOW 'HEIGHT)
                     (MAG-WINDOW-LINEHEIGHT WINDOW)))])

(MAG-TELEGRAM-INVERT-RECT
  [LAMBDA (WINDOW X Y WIDTH HEIGHT)
    (AND WINDOW
         (IGREATERP WIDTH 0)
         (IGREATERP HEIGHT 0)
         (BITBLT WINDOW X Y WINDOW X Y WIDTH HEIGHT 'INVERT 'REPLACE NIL))])

(MAG-TELEGRAM-INVERT-ROW
  [LAMBDA (WINDOW ROW)
    (MAG-TELEGRAM-INVERT-RECT WINDOW
                              0
                              (MAG-WINDOW-ROW-BOTTOM WINDOW ROW)
                              (WINDOWPROP WINDOW 'WIDTH)
                              (MAG-WINDOW-LINEHEIGHT WINDOW))])

(MAG-TELEGRAM-DRAW-CHAT-ROW
  [LAMBDA (WINDOW ROW LINE)
    (LET* ((PLAIN (DSPFONT NIL WINDOW))
           (BOLD (MAG-TELEGRAM-BOLD-FONT WINDOW))
           (Y (MAG-WINDOW-ROW-Y WINDOW ROW))
           (BOTTOM (MAG-WINDOW-ROW-BOTTOM WINDOW ROW))
           (LINEHEIGHT (MAG-WINDOW-LINEHEIGHT WINDOW))
           (SELECTED (MAG-TELEGRAM-ROW-SELECTED-P LINE))
           (NAME (MAG-TELEGRAM-ROW-NAME LINE))
           (UNREAD (MAG-TELEGRAM-ROW-UNREAD LINE))
           (COUNT (MAG-TELEGRAM-TO-INTEGER UNREAD 0))
           (NAMEWIDTH (STRINGWIDTH NAME BOLD))
           (COUNTX (IPLUS 8 NAMEWIDTH 16))
           (COUNTWIDTH (AND (IGREATERP COUNT 0)
                            (STRINGWIDTH UNREAD BOLD))))
      (MAG-WINDOW-CLEAR-LINE WINDOW ROW)
      (MOVETO 8 Y WINDOW)
      (DSPFONT BOLD WINDOW)
      (PRIN1 NAME WINDOW)
      (COND
        ((IGREATERP COUNT 0)
         (MOVETO COUNTX Y WINDOW)
         (PRIN1 UNREAD WINDOW)))
      (DSPFONT PLAIN WINDOW)
      (COND
        (SELECTED
         (MAG-TELEGRAM-INVERT-ROW WINDOW ROW)
         (AND (IGREATERP COUNT 0)
              (MAG-TELEGRAM-INVERT-RECT WINDOW
                                        (IDIFFERENCE COUNTX 3)
                                        BOTTOM
                                        (IPLUS COUNTWIDTH 6)
                                        LINEHEIGHT)))
        ((IGREATERP COUNT 0)
         (MAG-TELEGRAM-INVERT-RECT WINDOW
                                   (IDIFFERENCE COUNTX 3)
                                   BOTTOM
                                   (IPLUS COUNTWIDTH 6)
                                   LINEHEIGHT)))
      (DSPFONT PLAIN WINDOW))])

(MAG-TELEGRAM-DRAW-CHAT-ROWS
  [LAMBDA (WINDOW LINES)
    (PROG ((ROW 3))
    LP
      (COND
        ((NULL LINES)
         (RETURN T)))
      (MAG-TELEGRAM-DRAW-CHAT-ROW WINDOW ROW (CAR LINES))
      (SETQ ROW (ADD1 ROW))
      (SETQ LINES (CDR LINES))
      (GO LP))])

(MAG-TELEGRAM-DRAW-MESSAGE-ROW
  [LAMBDA (WINDOW ROW LINE)
    (LET ((PLAIN (DSPFONT NIL WINDOW))
          (BOLD (MAG-TELEGRAM-BOLD-FONT WINDOW))
          (SENDER (MAG-TELEGRAM-MESSAGE-SENDER LINE))
          (BODY (MAG-TELEGRAM-MESSAGE-BODY LINE)))
      (MAG-WINDOW-CLEAR-LINE WINDOW ROW)
      (MAG-WINDOW-CLEAR-LINE WINDOW (ADD1 ROW))
      (MAG-WINDOW-CLEAR-LINE WINDOW (IPLUS ROW 2))
      (MOVETO 8 (MAG-WINDOW-ROW-Y WINDOW ROW) WINDOW)
      (DSPFONT BOLD WINDOW)
      (PRIN1 SENDER WINDOW)
      (DSPFONT PLAIN WINDOW)
      (MOVETO 8 (MAG-WINDOW-ROW-Y WINDOW (ADD1 ROW)) WINDOW)
      (PRIN1 BODY WINDOW)
      (DSPFONT PLAIN WINDOW))])

(MAG-TELEGRAM-DRAW-MESSAGE-ROWS
  [LAMBDA (WINDOW LINES)
    (PROG ((LIMIT (SUB1 (MAG-TELEGRAM-WINDOW-ROWS WINDOW)))
           CAPACITY COUNT ROW)
      (SETQ CAPACITY (IMAX 1 (IQUOTIENT (IMAX 0 (IDIFFERENCE LIMIT 2)) 3)))
      (SETQ LINES (MAG-TELEGRAM-TAKE-LAST-LINES LINES CAPACITY))
      (SETQ COUNT (LENGTH LINES))
      (SETQ ROW (IMAX 3 (IDIFFERENCE (ADD1 LIMIT) (ITIMES COUNT 3))))
    LP
      (COND
        ((OR (NULL LINES)
             (IGREATERP (IPLUS ROW 2) LIMIT))
         (RETURN T)))
      (MAG-TELEGRAM-DRAW-MESSAGE-ROW WINDOW ROW (CAR LINES))
      (SETQ ROW (IPLUS ROW 3))
      (SETQ LINES (CDR LINES))
      (GO LP))])

(MAG-TELEGRAM-COMPOSE-COLUMNS
  [LAMBDA (WINDOW)
    (LET ((FONT (DSPFONT NIL WINDOW)))
      (IMAX 8
            (IQUOTIENT (IMAX 1 (IDIFFERENCE (WINDOWPROP WINDOW 'WIDTH) 16))
                       (IMAX 1 (STRINGWIDTH "M" FONT)))))])

(MAG-TELEGRAM-FIXED-WRAP-LINE
  [LAMBDA (TEXT WIDTH)
    (PROG ((START 1)
           (LEN (AND TEXT (NCHARS TEXT)))
           END LINES)
      (SETQ WIDTH (IMAX 1 WIDTH))
      (COND
        ((OR (NULL TEXT) (EQ LEN 0))
         (RETURN '(""))))
    LP
      (COND
        ((IGREATERP START LEN)
         (RETURN (DREVERSE LINES))))
      (SETQ END (IMIN LEN (IDIFFERENCE (IPLUS START WIDTH) 1)))
      (SETQ LINES (CONS (SUBSTRING TEXT START END) LINES))
      (SETQ START (ADD1 END))
      (GO LP))])

(MAG-TELEGRAM-COMPOSE-DISPLAY-LINES
  [LAMBDA (WINDOW OWNER)
    (LET* ((COLUMNS (MAG-TELEGRAM-COMPOSE-COLUMNS WINDOW))
           (MAXLINES (IMAX 1 (IDIFFERENCE (MAG-TELEGRAM-WINDOW-ROWS WINDOW) 1)))
           (DRAFT (OR (AND OWNER (WINDOWPROP OWNER 'MAG-TELEGRAM-DRAFT)) ""))
           (TEXT (COND
                   ((AND OWNER (WINDOWPROP OWNER 'MAG-TELEGRAM-COMPOSING))
                    (CONCAT DRAFT "_"))
                   (T "press s in chat to compose")))
           (LINES (MAG-TELEGRAM-FIXED-WRAP-LINE TEXT COLUMNS)))
      (MAG-TELEGRAM-TAKE-LAST-LINES LINES MAXLINES))])

(MAG-TELEGRAM-DRAW-COMPOSE-WINDOW
  [LAMBDA (WINDOW OWNER)
    (PROG ((PLAIN (DSPFONT NIL WINDOW))
           (BOLD (MAG-TELEGRAM-BOLD-FONT WINDOW))
           (LINES (MAG-TELEGRAM-COMPOSE-DISPLAY-LINES WINDOW OWNER))
           (ROW 0))
      (WINDOWPROP WINDOW 'MAG-TELEGRAM-OWNER OWNER)
      (MAG-WINDOW-CLEAR WINDOW)
      (MOVETO 8 (MAG-WINDOW-ROW-Y WINDOW ROW) WINDOW)
      (DSPFONT BOLD WINDOW)
      (PRIN1 "Reply" WINDOW)
      (DSPFONT PLAIN WINDOW)
      (COND
        ((AND OWNER (WINDOWPROP OWNER 'MAG-TELEGRAM-COMPOSING))
         (PRIN1 "  Enter send  Esc cancel" WINDOW))
        (T
         (PRIN1 "  press s in chat to compose" WINDOW)))
      (SETQ ROW 1)
    LP
      (COND
        ((NULL LINES)
         (DSPFONT PLAIN WINDOW)
         (RETURN T))
        ((IGEQ ROW (MAG-TELEGRAM-WINDOW-ROWS WINDOW))
         (DSPFONT PLAIN WINDOW)
         (RETURN T)))
      (MAG-WINDOW-CLEAR-LINE WINDOW ROW)
      (MAG-WINDOW-DRAW-LINE WINDOW ROW (CAR LINES))
      (SETQ ROW (ADD1 ROW))
      (SETQ LINES (CDR LINES))
      (GO LP))])

(MAG-TELEGRAM-ENSURE-TEDIT
  [LAMBDA NIL
    (OR (AND (GETD 'TEDIT)
             (GETD 'OPENTEXTSTREAM))
        (CAR (NLSETQ (FILESLOAD TEDIT))))])

(MAG-TELEGRAM-COMPOSE-TEXTSTREAM
  [LAMBDA (WINDOW)
    (OR (AND WINDOW (WINDOWPROP WINDOW 'TEXTSTREAM))
        (AND WINDOW (WINDOWPROP WINDOW 'MAG-TELEGRAM-COMPOSE-STREAM)))])

(MAG-TELEGRAM-COMPOSE-TEXT
  [LAMBDA (WINDOW)
    (LET ((TSTREAM (MAG-TELEGRAM-COMPOSE-TEXTSTREAM WINDOW)))
      (OR (AND TSTREAM
               (CAR (NLSETQ (COERCETEXTSTREAM TSTREAM 'STRING))))
          ""))])

(MAG-TELEGRAM-NORMALIZE-COMPOSE-SELECTION
  [LAMBDA (WINDOW)
    (PROG ((TSTREAM (MAG-TELEGRAM-COMPOSE-TEXTSTREAM WINDOW))
           TEXTOBJ SEL OPERATION N)
      (COND
        ((NULL TSTREAM)
         (RETURN NIL)))
      (SETQ TSTREAM (CAR (NLSETQ (TEXTSTREAM TSTREAM))))
      (COND
        ((NULL TSTREAM)
         (RETURN NIL)))
      (SETQ TEXTOBJ (CAR (NLSETQ (FTEXTOBJ TSTREAM))))
      (SETQ SEL (AND TEXTOBJ (CAR (NLSETQ (TEXTSEL TEXTOBJ)))))
      (COND
        ((NULL SEL)
         (RETURN NIL)))
      (SETQ OPERATION (CAR (NLSETQ (FGETSEL SEL SELOPERATION))))
      (COND
        ((NULL OPERATION)
         (SETQ N (OR (CAR (NLSETQ (TEDIT.NCHARS TSTREAM))) 0))
         (CAR (NLSETQ (TEDIT.SETSEL TSTREAM (ADD1 N) 0 'RIGHT)))
         (SETQ SEL (CAR (NLSETQ (TEXTSEL TEXTOBJ))))
         (SETQ OPERATION (AND SEL
                              (CAR (NLSETQ (FGETSEL SEL SELOPERATION)))))
         (AND SEL
              (NULL OPERATION)
              (CAR (NLSETQ (\TEDIT.SET.SELOPERATION SEL 'NORMAL))))))
      (RETURN TSTREAM))])

(MAG-TELEGRAM-COMPOSE-STREAM-P
  [LAMBDA (TSTREAM)
    (PROG ((WINDOW (AND MAG-TELEGRAM-COMPOSE-WINDOW
                        (OPENWP MAG-TELEGRAM-COMPOSE-WINDOW)
                        MAG-TELEGRAM-COMPOSE-WINDOW))
           STREAM COMPOSESTREAM)
      (COND
        ((NULL WINDOW)
         (RETURN NIL)))
      (SETQ STREAM (CAR (NLSETQ (TEXTSTREAM TSTREAM))))
      (SETQ COMPOSESTREAM
            (CAR (NLSETQ (TEXTSTREAM
                           (MAG-TELEGRAM-COMPOSE-TEXTSTREAM WINDOW)))))
      (RETURN (AND STREAM COMPOSESTREAM (EQ STREAM COMPOSESTREAM))))])

(MAG-TELEGRAM-GUARDED-TEDIT-DOOPERATION
  [LAMBDA (CURSEL TSTREAM PANE TTYPROC)
    (COND
      ((MAG-TELEGRAM-COMPOSE-STREAM-P TSTREAM)
       (PROG (RESULT)
         (AND CURSEL
              (NULL (CAR (NLSETQ (FGETSEL CURSEL SELOPERATION))))
              (CAR (NLSETQ (\TEDIT.SET.SELOPERATION CURSEL 'NORMAL))))
         (MAG-TELEGRAM-NORMALIZE-COMPOSE-SELECTION
           MAG-TELEGRAM-COMPOSE-WINDOW)
         (SETQ RESULT
               (NLSETQ
                 (MAG-TELEGRAM-ORIGINAL-TEDIT-DOOPERATION
                   CURSEL
                   TSTREAM
                   PANE
                   TTYPROC)))
         (COND
           ((NULL RESULT)
            (MAG-TELEGRAM-NORMALIZE-COMPOSE-SELECTION
              MAG-TELEGRAM-COMPOSE-WINDOW)
            (RETURN NIL))
           (T (RETURN (CAR RESULT))))))
      (T (MAG-TELEGRAM-ORIGINAL-TEDIT-DOOPERATION
           CURSEL
           TSTREAM
           PANE
           TTYPROC)))])

(MAG-TELEGRAM-INSTALL-TEDIT-GUARD
  [LAMBDA NIL
    (COND
      ((AND (GETD '\TEDIT.BUTTONEVENTFN.DOOPERATION)
            (NOT (GETD 'MAG-TELEGRAM-ORIGINAL-TEDIT-DOOPERATION)))
       (MOVD '\TEDIT.BUTTONEVENTFN.DOOPERATION
             'MAG-TELEGRAM-ORIGINAL-TEDIT-DOOPERATION)))
    (AND (GETD 'MAG-TELEGRAM-ORIGINAL-TEDIT-DOOPERATION)
         (MOVD 'MAG-TELEGRAM-GUARDED-TEDIT-DOOPERATION
               '\TEDIT.BUTTONEVENTFN.DOOPERATION))
    T])

(MAG-TELEGRAM-CLEAR-COMPOSE-TEXT
  [LAMBDA (WINDOW)
    (PROG ((TSTREAM (MAG-TELEGRAM-COMPOSE-TEXTSTREAM WINDOW))
           N)
      (COND
        ((NULL TSTREAM)
         (RETURN NIL)))
      (SETQ TSTREAM (TEXTSTREAM TSTREAM))
      (SETQ N (TEDIT.NCHARS TSTREAM))
      (AND (IGREATERP N 0)
           (CAR (NLSETQ (TEDIT.DELETE TSTREAM 1 N))))
      (CAR (NLSETQ (TEDIT.SETSEL TSTREAM 1 0 'LEFT)))
      (MAG-TELEGRAM-NORMALIZE-COMPOSE-SELECTION WINDOW)
      (CAR (NLSETQ (PUTTEXTPROP TSTREAM 'DIRTY NIL)))
      (RETURN TSTREAM))])

(MAG-TELEGRAM-INSTALL-COMPOSE-EDITOR
  [LAMBDA (WINDOW)
    (PROG (PROPS PROC TSTREAM)
      (COND
        ((NULL WINDOW)
         (RETURN NIL)))
      (MAG-TELEGRAM-ENSURE-TEDIT)
      (MAG-TELEGRAM-INSTALL-TEDIT-GUARD)
      (SETQ PROPS '(HISTORY OFF PARABREAKCHARS NIL
                    TITLE "Reply" FONT DEFAULTFONT
                    SEL (1 0 LEFT)))
      (SETQ TSTREAM (MAG-TELEGRAM-COMPOSE-TEXTSTREAM WINDOW))
      (COND
        ((NULL TSTREAM)
         (SETQ TSTREAM
               (CAR (NLSETQ (OPENTEXTSTREAM (OPENSTRINGSTREAM "" 'BOTH)
                                             NIL
                                             NIL
                                             NIL
                                             PROPS))))
         (AND TSTREAM
              (SETQ PROC
                    (CAR (NLSETQ (TEDIT TSTREAM WINDOW NIL PROPS)))))
         (AND PROC (PROCESSP PROC)
              (WINDOWPROP WINDOW 'MAG-TELEGRAM-TEDIT-PROCESS PROC))
         (AND PROC (PROCESSP PROC)
              (WINDOWPROP WINDOW 'PROCESS PROC))
         (SETQ TSTREAM (MAG-TELEGRAM-COMPOSE-TEXTSTREAM WINDOW))
         (AND TSTREAM
              (CAR (NLSETQ (TEDIT.SETSEL TSTREAM 1 0 'LEFT))))))
      (MAG-TELEGRAM-NORMALIZE-COMPOSE-SELECTION WINDOW)
      (AND TSTREAM
           (PROGN
             (WINDOWPROP WINDOW 'MAG-TELEGRAM-COMPOSE-STREAM TSTREAM)
             (WINDOWPROP WINDOW 'TEXTSTREAM TSTREAM)))
      (RETURN TSTREAM))])

(MAG-TELEGRAM-FOCUS-COMPOSE
  [LAMBDA (OWNER)
    (PROG ((WINDOW (AND MAG-TELEGRAM-COMPOSE-WINDOW
                        (OPENWP MAG-TELEGRAM-COMPOSE-WINDOW)
                        MAG-TELEGRAM-COMPOSE-WINDOW))
           PROC)
      (COND
        ((NULL WINDOW)
         (AND MAG-TELEGRAM-MESSAGE-WINDOW
              (OPENWP MAG-TELEGRAM-MESSAGE-WINDOW)
              (SETQ WINDOW
                    (MAG-TELEGRAM-ENSURE-COMPOSE-WINDOW
                      OWNER
                      MAG-TELEGRAM-MESSAGE-WINDOW)))))
      (COND
        ((NULL WINDOW)
         (RETURN NIL)))
      (MAG-TELEGRAM-INSTALL-COMPOSE-EDITOR WINDOW)
      (MAG-TELEGRAM-NORMALIZE-COMPOSE-SELECTION WINDOW)
      (SETQ PROC (OR (WINDOWPROP WINDOW 'MAG-TELEGRAM-TEDIT-PROCESS)
                     (WINDOWPROP WINDOW 'PROCESS)))
      (AND PROC (PROCESSP PROC) (TTY.PROCESS PROC))
      (TOTOPW WINDOW)
      (RETURN WINDOW))])

