      (SETQ INDEX (ADD1 INDEX))
      (GO LP))])

(MAG-TELEGRAM-CONTROL-ITEM-FROM-MOUSE
  [LAMBDA (WINDOW)
    (PROG ((X (LASTMOUSEX WINDOW))
           (Y (LASTMOUSEY WINDOW))
           (ACTIONS (MAG-TELEGRAM-CONTROL-ACTIONS))
           (INDEX 0)
           RECT)
    LP
      (COND
        ((NULL ACTIONS)
         (RETURN NIL)))
      (SETQ RECT (MAG-TELEGRAM-CONTROL-BUTTON-RECT WINDOW INDEX))
      (COND
        ((AND (IGEQ X (CAR RECT))
              (ILEQ X (IPLUS (CAR RECT) (CADDR RECT)))
              (IGEQ Y (CADR RECT))
              (ILEQ Y (IPLUS (CADR RECT) (CADDDR RECT))))
         (RETURN (CAR ACTIONS))))
      (SETQ ACTIONS (CDR ACTIONS))
      (SETQ INDEX (ADD1 INDEX))
      (GO LP))])

