                         ((AND FROM-ID (NOT (STREQUAL FROM-ID "0")))
                          (CONCAT "older " CHAT-ID " " FROM-ID))
                         (T (CONCAT "messages " CHAT-ID))))
              TEXT TARGET CHAT-TITLE)
         (SETQ TEXT (MAG-TELEGRAM-BRIDGE REQUEST))
         (SETQ TARGET (MAG-TELEGRAM-ENSURE-MESSAGE-WINDOW WINDOW))
         (SETQ CHAT-TITLE (MAG-TELEGRAM-ROW-NAME (OR CHAT-LINE CHAT-ID)))
         (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-ID CHAT-ID)
         (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-LINE CHAT-TITLE)
         (WINDOWPROP WINDOW 'MAG-TELEGRAM-FROM-ID FROM-ID)
         (WINDOWPROP WINDOW 'MAG-TELEGRAM-OLDEST-ID
                     (MAG-TELEGRAM-META-VALUE TEXT "oldest-id"))
         (WINDOWPROP WINDOW 'MAG-TELEGRAM-NEWEST-ID
                     (MAG-TELEGRAM-META-VALUE TEXT "newest-id"))
         (WINDOWPROP TARGET 'MAG-TELEGRAM-CHAT-ID CHAT-ID)
         (WINDOWPROP TARGET 'MAG-TELEGRAM-CHAT-LINE CHAT-TITLE)
         (WINDOWPROP TARGET 'MAG-TELEGRAM-OWNER WINDOW)
         (WINDOWPROP TARGET 'MAG-TELEGRAM-FROM-ID FROM-ID)
         (WINDOWPROP TARGET 'MAG-TELEGRAM-OLDEST-ID
                     (WINDOWPROP WINDOW 'MAG-TELEGRAM-OLDEST-ID))
         (WINDOWPROP TARGET 'MAG-TELEGRAM-NEWEST-ID
                     (WINDOWPROP WINDOW 'MAG-TELEGRAM-NEWEST-ID))
         (MAG-TELEGRAM-DRAW-MESSAGE-LINES
           TARGET
           (MAG-TELEGRAM-MESSAGES-UI-LINES TEXT (OR CHAT-LINE CHAT-ID))
