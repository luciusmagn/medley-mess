(MAG-TELEGRAM-DRAW-CHAT-LINES
  [LAMBDA (WINDOW LINES)
    (WINDOWPROP WINDOW 'MAG-TELEGRAM-LINES LINES)
    (MAG-WINDOW-CLEAR WINDOW)
    (MAG-TELEGRAM-DRAW-CHROME WINDOW "Mag Telegram Chats" NIL 'CHATS)
    (MAG-TELEGRAM-DRAW-CHAT-ROWS WINDOW LINES)])

(MAG-TELEGRAM-DRAW-MESSAGE-LINES
  [LAMBDA (WINDOW LINES CHAT-LINE)
    (LET ((OWNER (OR (WINDOWPROP WINDOW 'MAG-TELEGRAM-OWNER)
                     MAG-TELEGRAM-LAST-WINDOW)))
      (WINDOWPROP WINDOW 'MAG-TELEGRAM-LINES LINES)
      (MAG-WINDOW-CLEAR WINDOW)
      (MAG-TELEGRAM-DRAW-CHROME WINDOW "Mag Telegram Messages" CHAT-LINE 'MESSAGES)
      (MAG-TELEGRAM-DRAW-MESSAGE-ROWS WINDOW LINES)
      (MAG-TELEGRAM-ENSURE-COMPOSE-WINDOW OWNER WINDOW))])

(MAG-TELEGRAM-MESSAGE-CLOSEFN
  [LAMBDA (WINDOW)
    (AND MAG-TELEGRAM-COMPOSE-CONTROL-WINDOW
         (OPENWP MAG-TELEGRAM-COMPOSE-CONTROL-WINDOW)
         (NLSETQ (CLOSEW MAG-TELEGRAM-COMPOSE-CONTROL-WINDOW)))
    (AND MAG-TELEGRAM-COMPOSE-WINDOW
         (OPENWP MAG-TELEGRAM-COMPOSE-WINDOW)
         (NLSETQ (CLOSEW MAG-TELEGRAM-COMPOSE-WINDOW)))
    (AND (EQ MAG-TELEGRAM-MESSAGE-WINDOW WINDOW)
         (SETQ MAG-TELEGRAM-MESSAGE-WINDOW NIL))])

(MAG-TELEGRAM-ENSURE-MESSAGE-WINDOW
  [LAMBDA (OWNER)
    (PROG ((WINDOW (AND MAG-TELEGRAM-MESSAGE-WINDOW
                        (OPENWP MAG-TELEGRAM-MESSAGE-WINDOW)
                        MAG-TELEGRAM-MESSAGE-WINDOW)))
      (COND
        ((NULL WINDOW)
         (SETQ WINDOW (CREATEW NIL "Mag Telegram Messages"))
         (SETQ MAG-TELEGRAM-MESSAGE-WINDOW WINDOW)
         (WINDOWPROP WINDOW 'MAG-TELEGRAM-STATE T)
         (WINDOWPROP WINDOW 'MAG-TELEGRAM-MODE 'MESSAGES)
         (WINDOWPROP WINDOW 'RIGHTBUTTONFN (FUNCTION DOWINDOWCOM))
         (WINDOWPROP WINDOW 'WINDOWENTRYFN 'GIVE.TTY.PROCESS)
         (WINDOWPROP WINDOW 'RESHAPEFN (FUNCTION MAG-TELEGRAM-RESHAPEFN))
         (WINDOWADDPROP WINDOW 'CLOSEFN (FUNCTION MAG-TELEGRAM-MESSAGE-CLOSEFN))
         (MODERNWINDOW WINDOW)
         (MAG-WINDOW-SET-BACKGROUND WINDOW)))
      (AND OWNER
           (WINDOWPROP WINDOW 'PROCESS (WINDOWPROP OWNER 'PROCESS)))
      (RETURN WINDOW))])

(MAG-TELEGRAM-SHOW-DASHBOARD
  [LAMBDA (WINDOW)
    (AND WINDOW
         (WINDOWPROP WINDOW 'MAG-TELEGRAM-MODE 'DASHBOARD)
         (MAG-TELEGRAM-DRAW-TEXT WINDOW (MAG-TELEGRAM-DASHBOARD-TEXT)))])

(MAG-TELEGRAM-DRAW-CHATS
  [LAMBDA (WINDOW)
    (PROG ((TEXT (MAG-TELEGRAM-CHATS-VIEW-TEXT WINDOW))
           SELECTED TOP COUNT)
      (SETQ SELECTED (MAG-TELEGRAM-TO-INTEGER
                       (MAG-TELEGRAM-META-VALUE TEXT "selected")
                       (OR (WINDOWPROP WINDOW 'MAG-TELEGRAM-SELECTED) 0)))
      (SETQ TOP (MAG-TELEGRAM-TO-INTEGER
                  (MAG-TELEGRAM-META-VALUE TEXT "top")
                  (OR (WINDOWPROP WINDOW 'MAG-TELEGRAM-TOP) 0)))
      (SETQ COUNT (MAG-TELEGRAM-TO-INTEGER
                    (MAG-TELEGRAM-META-VALUE TEXT "count")
                    (OR (WINDOWPROP WINDOW 'MAG-TELEGRAM-COUNT) 0)))
      (WINDOWPROP WINDOW 'MAG-TELEGRAM-SELECTED SELECTED)
      (WINDOWPROP WINDOW 'MAG-TELEGRAM-TOP TOP)
      (WINDOWPROP WINDOW 'MAG-TELEGRAM-COUNT COUNT)
      (MAG-TELEGRAM-DRAW-CHAT-LINES WINDOW (MAG-TELEGRAM-CHATS-UI-LINES TEXT)))])

(MAG-TELEGRAM-SHOW-CHATS
  [LAMBDA (WINDOW)
    (COND
      (WINDOW
      (WINDOWPROP WINDOW 'MAG-TELEGRAM-MODE 'CHATS)
       (MAG-TELEGRAM-DRAW-CHATS WINDOW)))])

(MAG-TELEGRAM-SHOW-MESSAGES-FROM
  [LAMBDA (WINDOW CHAT-ID CHAT-LINE FROM-ID)
    (COND
      ((AND WINDOW CHAT-ID)
       (PROG ((REQUEST (COND
                         ((AND FROM-ID (NOT (STREQUAL FROM-ID "0")))
                          (CONCAT "older " CHAT-ID " " FROM-ID))
                         (T (CONCAT "messages " CHAT-ID))))
              TEXT TARGET CHAT-TITLE)
         (SETQ TEXT (MAG-TELEGRAM-BRIDGE REQUEST))
         (SETQ TARGET (MAG-TELEGRAM-ENSURE-MESSAGE-WINDOW WINDOW))
         (SETQ CHAT-TITLE (MAG-TELEGRAM-ROW-NAME (OR CHAT-LINE CHAT-ID)))
         (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-ID CHAT-ID)
         (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-LINE CHAT-TITLE)
         (WINDOWPROP WINDOW 'MAG-TELEGRAM-FROM-ID FROM-ID)
         (WINDOWPROP WINDOW 'MAG-TELEGRAM-OLDEST-ID
                     (MAG-TELEGRAM-META-VALUE TEXT "oldest-id"))
         (WINDOWPROP WINDOW 'MAG-TELEGRAM-NEWEST-ID
                     (MAG-TELEGRAM-META-VALUE TEXT "newest-id"))
         (WINDOWPROP TARGET 'MAG-TELEGRAM-CHAT-ID CHAT-ID)
         (WINDOWPROP TARGET 'MAG-TELEGRAM-CHAT-LINE CHAT-TITLE)
         (WINDOWPROP TARGET 'MAG-TELEGRAM-OWNER WINDOW)
         (WINDOWPROP TARGET 'MAG-TELEGRAM-FROM-ID FROM-ID)
         (WINDOWPROP TARGET 'MAG-TELEGRAM-OLDEST-ID
                     (WINDOWPROP WINDOW 'MAG-TELEGRAM-OLDEST-ID))
         (WINDOWPROP TARGET 'MAG-TELEGRAM-NEWEST-ID
                     (WINDOWPROP WINDOW 'MAG-TELEGRAM-NEWEST-ID))
         (MAG-TELEGRAM-DRAW-MESSAGE-LINES
           TARGET
           (MAG-TELEGRAM-MESSAGES-UI-LINES TEXT (OR CHAT-LINE CHAT-ID))
           CHAT-TITLE)))
      (T NIL))])

(MAG-TELEGRAM-SHOW-MESSAGES
  [LAMBDA (WINDOW CHAT-ID CHAT-LINE)
    (MAG-TELEGRAM-SHOW-MESSAGES-FROM WINDOW CHAT-ID CHAT-LINE NIL)])

(MAG-TELEGRAM-SHOW-OLDER-MESSAGES
  [LAMBDA (WINDOW)
    (PROG ((CHAT-ID (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-ID))
           (CHAT-LINE (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-LINE))
           (OLDEST-ID (WINDOWPROP WINDOW 'MAG-TELEGRAM-OLDEST-ID)))
      (COND
        ((AND CHAT-ID OLDEST-ID (NOT (STREQUAL OLDEST-ID "0")))
         (MAG-TELEGRAM-SHOW-MESSAGES-FROM WINDOW CHAT-ID CHAT-LINE OLDEST-ID))
        (T
         (MAG-TELEGRAM-DRAW-TEXT
           WINDOW
           (CONCAT "No older message cursor for this page."
                   (MAG-TELEGRAM-LF))))))])

(MAG-TELEGRAM-SHOW-LATEST-MESSAGES
  [LAMBDA (WINDOW)
    (PROG ((CHAT-ID (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-ID))
           (CHAT-LINE (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-LINE)))
      (AND CHAT-ID
           (MAG-TELEGRAM-SHOW-MESSAGES WINDOW CHAT-ID CHAT-LINE)))])

(MAG-TELEGRAM-OPEN-SELECTED-CHAT
  [LAMBDA (WINDOW)
    (PROG ((SELECTED (OR (WINDOWPROP WINDOW 'MAG-TELEGRAM-SELECTED) 0))
           TEXT CHAT-ID CHAT-LINE)
      (SETQ TEXT (MAG-TELEGRAM-BRIDGE (CONCAT "chat-at " SELECTED)))
      (SETQ CHAT-ID (MAG-TELEGRAM-META-VALUE TEXT "chat-id"))
      (SETQ CHAT-LINE (MAG-TELEGRAM-META-LINE-VALUE TEXT "line"))
      (COND
        ((AND CHAT-ID (NOT (STREQUAL CHAT-ID "0")))
         (MAG-TELEGRAM-SHOW-MESSAGES WINDOW CHAT-ID CHAT-LINE))
        (T
         (MAG-TELEGRAM-DRAW-MESSAGE-LINES
           (MAG-TELEGRAM-ENSURE-MESSAGE-WINDOW WINDOW)
           (LIST "No chat selected.")
           NIL))))])

(MAG-TELEGRAM-CHAT-INDEX-FROM-Y
  [LAMBDA (WINDOW Y)
    (LET* ((LINEHEIGHT (MAG-WINDOW-LINEHEIGHT WINDOW))
           (ROW (IQUOTIENT (IMAX 0
                                 (IDIFFERENCE
                                   (IDIFFERENCE (WINDOWPROP WINDOW 'HEIGHT) 8)
                                   Y))
                           LINEHEIGHT))
           (INDEX (IPLUS (OR (WINDOWPROP WINDOW 'MAG-TELEGRAM-TOP) 0)
                         (IDIFFERENCE ROW 3)))
           (COUNT (OR (WINDOWPROP WINDOW 'MAG-TELEGRAM-COUNT) 0)))
      (AND (IGEQ ROW 3)
           (IGEQ INDEX 0)
           (ILESSP INDEX COUNT)
           INDEX))])

(MAG-TELEGRAM-CLICK-CHAT
  [LAMBDA (WINDOW)
    (LET ((INDEX (MAG-TELEGRAM-CHAT-INDEX-FROM-Y WINDOW (LASTMOUSEY WINDOW))))
      (AND INDEX
           (PROGN
             (WINDOWPROP WINDOW 'MAG-TELEGRAM-SELECTED INDEX)
             (MAG-TELEGRAM-DRAW-CHATS WINDOW)
             (MAG-TELEGRAM-OPEN-SELECTED-CHAT WINDOW))))])

(MAG-TELEGRAM-MOVE-CHAT-SELECTION
  [LAMBDA (WINDOW DELTA)
    (AND (EQ (WINDOWPROP WINDOW 'MAG-TELEGRAM-MODE) 'CHATS)
         (PROG ((SELECTED (OR (WINDOWPROP WINDOW 'MAG-TELEGRAM-SELECTED) 0)))
           (SETQ SELECTED (IPLUS SELECTED DELTA))
           (WINDOWPROP WINDOW 'MAG-TELEGRAM-SELECTED SELECTED)
           (MAG-TELEGRAM-DRAW-CHATS WINDOW)))])

(MAG-TELEGRAM-REDRAW-COMPOSE
  [LAMBDA (WINDOW)
    (COND
      ((AND MAG-TELEGRAM-COMPOSE-WINDOW
            (OPENWP MAG-TELEGRAM-COMPOSE-WINDOW))
       (MAG-TELEGRAM-INSTALL-COMPOSE-EDITOR MAG-TELEGRAM-COMPOSE-WINDOW)
       (MAG-TELEGRAM-ENSURE-CONTROL-WINDOW
         WINDOW
         MAG-TELEGRAM-COMPOSE-WINDOW))
      ((AND MAG-TELEGRAM-MESSAGE-WINDOW
            (OPENWP MAG-TELEGRAM-MESSAGE-WINDOW))
       (MAG-TELEGRAM-ENSURE-COMPOSE-WINDOW
         WINDOW
         MAG-TELEGRAM-MESSAGE-WINDOW)))])

(MAG-TELEGRAM-START-COMPOSE
  [LAMBDA (WINDOW)
    (PROG ((MESSAGE-WINDOW (COND
                             ((EQ (WINDOWPROP WINDOW 'MAG-TELEGRAM-MODE)
                                  'MESSAGES)
                              WINDOW)
                             ((AND MAG-TELEGRAM-MESSAGE-WINDOW
                                   (OPENWP MAG-TELEGRAM-MESSAGE-WINDOW))
                              MAG-TELEGRAM-MESSAGE-WINDOW)))
           OWNER)
      (COND
        ((NULL (OR (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-ID)
                   (AND MESSAGE-WINDOW
                        (WINDOWPROP MESSAGE-WINDOW 'MAG-TELEGRAM-CHAT-ID))))
         (RETURN NIL)))
      (SETQ OWNER (COND
                    ((AND MESSAGE-WINDOW
                          (WINDOWPROP MESSAGE-WINDOW 'MAG-TELEGRAM-OWNER))
                     (WINDOWPROP MESSAGE-WINDOW 'MAG-TELEGRAM-OWNER))
                    (T WINDOW)))
      (WINDOWPROP WINDOW 'MAG-TELEGRAM-COMPOSING T)
      (AND MAG-TELEGRAM-LAST-WINDOW
           (OPENWP MAG-TELEGRAM-LAST-WINDOW)
           (WINDOWPROP MAG-TELEGRAM-LAST-WINDOW 'MAG-TELEGRAM-COMPOSING T))
      (AND MESSAGE-WINDOW
           (WINDOWPROP MESSAGE-WINDOW 'MAG-TELEGRAM-COMPOSING T))
      (AND MESSAGE-WINDOW
           (MAG-TELEGRAM-ENSURE-COMPOSE-WINDOW OWNER MESSAGE-WINDOW))
      (RETURN (MAG-TELEGRAM-FOCUS-COMPOSE OWNER)))])

(MAG-TELEGRAM-CANCEL-COMPOSE
  [LAMBDA (WINDOW)
    (WINDOWPROP WINDOW 'MAG-TELEGRAM-COMPOSING NIL)
    (AND MAG-TELEGRAM-LAST-WINDOW
         (OPENWP MAG-TELEGRAM-LAST-WINDOW)
         (WINDOWPROP MAG-TELEGRAM-LAST-WINDOW 'MAG-TELEGRAM-COMPOSING NIL))
    (AND MAG-TELEGRAM-MESSAGE-WINDOW
         (OPENWP MAG-TELEGRAM-MESSAGE-WINDOW)
         (WINDOWPROP MAG-TELEGRAM-MESSAGE-WINDOW 'MAG-TELEGRAM-COMPOSING NIL))
    (AND MAG-TELEGRAM-COMPOSE-WINDOW
         (OPENWP MAG-TELEGRAM-COMPOSE-WINDOW)
         (MAG-TELEGRAM-CLEAR-COMPOSE-TEXT MAG-TELEGRAM-COMPOSE-WINDOW))
    (MAG-TELEGRAM-REDRAW-COMPOSE WINDOW)])

(MAG-TELEGRAM-SEND-DRAFT
  [LAMBDA (WINDOW)
    (PROG ((COMPOSE (AND MAG-TELEGRAM-COMPOSE-WINDOW
                         (OPENWP MAG-TELEGRAM-COMPOSE-WINDOW)
                         MAG-TELEGRAM-COMPOSE-WINDOW))
           (MESSAGE-WINDOW (AND MAG-TELEGRAM-MESSAGE-WINDOW
                                (OPENWP MAG-TELEGRAM-MESSAGE-WINDOW)
                                MAG-TELEGRAM-MESSAGE-WINDOW))
           CHAT-ID CHAT-LINE TEXT TARGET RESULT)
      (SETQ TARGET (OR WINDOW MAG-TELEGRAM-LAST-WINDOW MESSAGE-WINDOW))
      (SETQ CHAT-ID (OR (AND WINDOW (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-ID))
                        (AND MESSAGE-WINDOW
                             (WINDOWPROP MESSAGE-WINDOW 'MAG-TELEGRAM-CHAT-ID))
                        (AND MAG-TELEGRAM-LAST-WINDOW
                             (WINDOWPROP MAG-TELEGRAM-LAST-WINDOW
                                         'MAG-TELEGRAM-CHAT-ID))))
      (SETQ CHAT-LINE (OR (AND WINDOW (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-LINE))
                          (AND MESSAGE-WINDOW
                               (WINDOWPROP MESSAGE-WINDOW
                                           'MAG-TELEGRAM-CHAT-LINE))
                          (AND MAG-TELEGRAM-LAST-WINDOW
                               (WINDOWPROP MAG-TELEGRAM-LAST-WINDOW
                                           'MAG-TELEGRAM-CHAT-LINE))))
      (SETQ TEXT (MAG-TELEGRAM-COMPOSE-TEXT COMPOSE))
      (COND
        ((OR (NULL CHAT-ID) (EQ (NCHARS TEXT) 0))
         (MAG-TELEGRAM-FOCUS-COMPOSE TARGET)
         (RETURN NIL)))
      (WINDOWPROP TARGET 'MAG-TELEGRAM-COMPOSING NIL)
      (AND MAG-TELEGRAM-LAST-WINDOW
           (OPENWP MAG-TELEGRAM-LAST-WINDOW)
           (WINDOWPROP MAG-TELEGRAM-LAST-WINDOW 'MAG-TELEGRAM-COMPOSING NIL))
      (AND MESSAGE-WINDOW
           (WINDOWPROP MESSAGE-WINDOW 'MAG-TELEGRAM-COMPOSING NIL))
      (AND COMPOSE (MAG-TELEGRAM-CLEAR-COMPOSE-TEXT COMPOSE))
      (SETQ RESULT (MAG-TELEGRAM-BRIDGE (CONCAT "send " CHAT-ID " " TEXT)))
      (BLOCK 300)
      (AND TARGET
           (MAG-TELEGRAM-SHOW-MESSAGES TARGET CHAT-ID CHAT-LINE))
      (AND MAG-TELEGRAM-LAST-WINDOW
           (OPENWP MAG-TELEGRAM-LAST-WINDOW)
           (MAG-TELEGRAM-DRAW-CHATS MAG-TELEGRAM-LAST-WINDOW))
      (RETURN RESULT))])

(MAG-TELEGRAM-HANDLE-COMPOSE-KEY
  [LAMBDA (WINDOW CH)
    (COND
      ((NOT (WINDOWPROP WINDOW 'MAG-TELEGRAM-COMPOSING))
       NIL)
      ((EQ CH 27)
       (MAG-TELEGRAM-CANCEL-COMPOSE WINDOW)
       T)
      (T NIL))])

(MAG-TELEGRAM-SEND-CURRENT
  [LAMBDA (WINDOW)
    (MAG-TELEGRAM-START-COMPOSE WINDOW)])

(MAG-TELEGRAM-AUTH-PROMPT
  [LAMBDA (KIND PROMPT)
    (LET ((VALUE (MAG-PROMPT-LINE PROMPT NIL)))
      (COND
        ((AND VALUE (IGREATERP (NCHARS VALUE) 0))
         (MAG-TELEGRAM-BRIDGE (CONCAT "auth-" KIND " " VALUE)))
        (T (CONCAT "auth cancelled" (MAG-TELEGRAM-LF)))))])

(MAG-TELEGRAM-AUTH-REGISTER-PROMPT
  [LAMBDA NIL
    (PROG (FIRST LAST)
      (SETQ FIRST (MAG-PROMPT-LINE "telegram first name" NIL))
      (COND
        ((OR (NULL FIRST) (EQ (NCHARS FIRST) 0))
         (RETURN (CONCAT "auth cancelled" (MAG-TELEGRAM-LF)))))
      (SETQ LAST (MAG-PROMPT-LINE "telegram last name" NIL))
      (RETURN
        (MAG-TELEGRAM-BRIDGE
          (CONCAT "auth-register " FIRST " " (OR LAST "")))))])

(MAG-TELEGRAM-REFRESH
  [LAMBDA (WINDOW)
    (AND WINDOW
         (SELECTQ (WINDOWPROP WINDOW 'MAG-TELEGRAM-MODE)
           (CHATS
             (MAG-TELEGRAM-SHOW-CHATS WINDOW)
             (AND (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-ID)
                  (MAG-TELEGRAM-SHOW-MESSAGES-FROM
                    WINDOW
                    (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-ID)
                    (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-LINE)
                    (WINDOWPROP WINDOW 'MAG-TELEGRAM-FROM-ID))))
           (MESSAGES (MAG-TELEGRAM-SHOW-MESSAGES-FROM
                       WINDOW
                       (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-ID)
                       (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-LINE)
                       (WINDOWPROP WINDOW 'MAG-TELEGRAM-FROM-ID)))
           (MAG-TELEGRAM-SHOW-DASHBOARD WINDOW)))])

(MAG-TELEGRAM-REFRESH-NEEDED-P
  [LAMBDA NIL
    (LET ((TEXT (MAG-TELEGRAM-BRIDGE "needs-refresh")))
      (STREQUAL (OR (MAG-TELEGRAM-META-VALUE TEXT "needed") "no")
                "yes"))])

(MAG-TELEGRAM-AUTO-REFRESH
  [LAMBDA (WINDOW)
    (AND WINDOW
         (SELECTQ (WINDOWPROP WINDOW 'MAG-TELEGRAM-MODE)
           (CHATS
             (MAG-TELEGRAM-SHOW-CHATS WINDOW)
             (AND MAG-TELEGRAM-MESSAGE-WINDOW
                  (OPENWP MAG-TELEGRAM-MESSAGE-WINDOW)
                  (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-ID)
                  (MAG-TELEGRAM-SHOW-MESSAGES-FROM
                    WINDOW
                    (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-ID)
                    (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-LINE)
                    (WINDOWPROP WINDOW 'MAG-TELEGRAM-FROM-ID))))
           (MESSAGES
             (MAG-TELEGRAM-SHOW-MESSAGES-FROM
               WINDOW
               (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-ID)
               (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-LINE)
               (WINDOWPROP WINDOW 'MAG-TELEGRAM-FROM-ID)))
           (MAG-TELEGRAM-SHOW-DASHBOARD WINDOW)))])

(MAG-TELEGRAM-ACTIVE-WINDOW
  [LAMBDA NIL
    (AND MAG-TELEGRAM-LAST-WINDOW
         (OPENWP MAG-TELEGRAM-LAST-WINDOW)
         MAG-TELEGRAM-LAST-WINDOW)])

(MAG-TELEGRAM-AUTOREFRESH-LOOP
  [LAMBDA NIL
    (PROG (WINDOW)
    LP
      (SETQ WINDOW (MAG-TELEGRAM-ACTIVE-WINDOW))
      (COND
        ((NULL WINDOW)
         (RETURN NIL)))
      (DISMISS MAG-TELEGRAM-REFRESH-INTERVAL-MS)
      (SETQ WINDOW (MAG-TELEGRAM-ACTIVE-WINDOW))
      (AND WINDOW
           (NOT (WINDOWPROP WINDOW 'MAG-TELEGRAM-COMPOSING))
           (MAG-TELEGRAM-REFRESH-NEEDED-P)
           (NLSETQ (MAG-TELEGRAM-AUTO-REFRESH WINDOW)))
      (GO LP))])

(MAG-TELEGRAM-START-AUTOREFRESH
  [LAMBDA NIL
    (COND
      ((AND MAG-TELEGRAM-REFRESH-PROCESS
            (PROCESSP MAG-TELEGRAM-REFRESH-PROCESS))
       MAG-TELEGRAM-REFRESH-PROCESS)
      (T
       (SETQ MAG-TELEGRAM-REFRESH-PROCESS
             (ADD.PROCESS (LIST (FUNCTION MAG-TELEGRAM-AUTOREFRESH-LOOP))
                          'NAME 'MAG-TELEGRAM-REFRESH))))])

(MAG-TELEGRAM-STOP-AUTOREFRESH
  [LAMBDA NIL
    (AND MAG-TELEGRAM-REFRESH-PROCESS
         (PROCESSP MAG-TELEGRAM-REFRESH-PROCESS)
         (DEL.PROCESS MAG-TELEGRAM-REFRESH-PROCESS))
    (SETQ MAG-TELEGRAM-REFRESH-PROCESS NIL)])

(MAG-TELEGRAM-RPC-STATUS
  [LAMBDA NIL
    (MAG-TELEGRAM-STATUS-TEXT)])

(MAG-TELEGRAM-RPC-CHATS
  [LAMBDA NIL
    (MAG-TELEGRAM-CHATS-TEXT)])

(MAG-TELEGRAM-RPC-AUTH
  [LAMBDA NIL
    (MAG-TELEGRAM-AUTH-TEXT)])

(MAG-TELEGRAM-RPC-DOCTOR
  [LAMBDA NIL
    (MAG-TELEGRAM-DOCTOR-TEXT)])

(MAG-TELEGRAM-RPC-OPEN
  [LAMBDA NIL
    (LET ((WINDOW (MAG-TELEGRAM)))
      (COND
        (WINDOW "opened Mag Telegram")
        (T "failed to open Mag Telegram")))])

(MAG-TELEGRAM-HANDLE-KEY
  [LAMBDA (WINDOW CH)
    (LET ((KEYID (MAG-TELEGRAM-KEYID CH))
          (MODE (WINDOWPROP WINDOW 'MAG-TELEGRAM-MODE)))
      (COND
        ((MAG-TELEGRAM-HANDLE-COMPOSE-KEY WINDOW CH)
         T)
        ((EQ KEYID 1)
         (MAG-TELEGRAM-MOVE-CHAT-SELECTION WINDOW -1))
        ((EQ KEYID 2)
         (MAG-TELEGRAM-MOVE-CHAT-SELECTION WINDOW 1))
        ((OR (EQ KEYID 3) (EQ KEYID 12))
         (AND (EQ MODE 'CHATS)
              (MAG-TELEGRAM-OPEN-SELECTED-CHAT WINDOW)))
        ((EQ KEYID 4)
         (SELECTQ MODE
           (MESSAGES (MAG-TELEGRAM-SHOW-CHATS WINDOW))
           (CHATS (MAG-TELEGRAM-SHOW-CHATS WINDOW))
           NIL))
        (T
         (SELECTQ CH
           (113
            (CLOSEW WINDOW))
           (115
            (COND
              ((WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-ID)
               (MAG-TELEGRAM-START-COMPOSE WINDOW))
              (T
               (MAG-TELEGRAM-START-BRIDGE)
               (BLOCK 500)
               (MAG-TELEGRAM-REFRESH WINDOW))))
           (99
            (MAG-TELEGRAM-SHOW-CHATS WINDOW))
           (111
            (AND (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-ID)
                 (MAG-TELEGRAM-SHOW-OLDER-MESSAGES WINDOW)))
           (112
            (MAG-TELEGRAM-AUTH-PROMPT "phone" "telegram phone")
            (MAG-TELEGRAM-REFRESH WINDOW))
           (118
            (MAG-TELEGRAM-AUTH-PROMPT "code" "telegram login code")
            (MAG-TELEGRAM-REFRESH WINDOW))
           (119
            (MAG-TELEGRAM-AUTH-PROMPT "password" "telegram 2fa password")
            (MAG-TELEGRAM-REFRESH WINDOW))
           (110
            (COND
              ((WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-ID)
               (MAG-TELEGRAM-SHOW-LATEST-MESSAGES WINDOW))
              (T
               (MAG-TELEGRAM-AUTH-REGISTER-PROMPT)
               (MAG-TELEGRAM-REFRESH WINDOW))))
           (100
            (MAG-TELEGRAM-DRAW-TEXT
              WINDOW
              (CONCAT "Mag Telegram doctor" (MAG-TELEGRAM-LF2)
                      (MAG-TELEGRAM-DOCTOR-TEXT))))
           NIL))))])

(MAG-TELEGRAM-TYPEIN
  [LAMBDA (WINDOW)
    (PROG (CH)
      (while (WINDOWPROP WINDOW 'MAG-TELEGRAM-RUNNING)
        do (OR (TTY.PROCESSP)
               (\WAIT.FOR.TTY))
           (COND
             ((\SYSBUFP)
              (do (SETQ CH (MTOUCODE (\GETKEY)))
                  (MAG-TELEGRAM-HANDLE-KEY WINDOW CH)
                repeatwhile (\SYSBUFP))))
           (BLOCK))
      (BLOCK))])

(MAG-TELEGRAM-BUTTONFN
  [LAMBDA (WINDOW)
    (TOTOPW WINDOW)
    (COND
      ((PROCESSP (WINDOWPROP WINDOW 'PROCESS))
       (TTY.PROCESS (WINDOWPROP WINDOW 'PROCESS))))
    (COND
      ((LASTMOUSESTATE LEFT)
       (SELECTQ (WINDOWPROP WINDOW 'MAG-TELEGRAM-MODE)
         (CHATS (MAG-TELEGRAM-CLICK-CHAT WINDOW))
         NIL)))])

(MAG-TELEGRAM-RESHAPEFN
  [LAMBDA (WINDOW OLDIMAGE IMAGEREGION OLDSCREENREGION)
    (RESHAPEBYREPAINTFN WINDOW OLDIMAGE IMAGEREGION)
    (COND
      ((WINDOWPROP WINDOW 'MAG-TELEGRAM-LINES)
       (SELECTQ (WINDOWPROP WINDOW 'MAG-TELEGRAM-MODE)
         (MESSAGES
           (MAG-TELEGRAM-DRAW-MESSAGE-LINES
             WINDOW
             (WINDOWPROP WINDOW 'MAG-TELEGRAM-LINES)
             (WINDOWPROP WINDOW 'MAG-TELEGRAM-CHAT-LINE)))
         ((COMPOSE COMPOSE-EDITOR)
           (MAG-TELEGRAM-INSTALL-COMPOSE-EDITOR WINDOW))
         (COMPOSE-CONTROL
           (MAG-TELEGRAM-DRAW-CONTROLS WINDOW))
         (CHATS
           (MAG-TELEGRAM-DRAW-CHAT-LINES
             WINDOW
             (WINDOWPROP WINDOW 'MAG-TELEGRAM-LINES)))
         (MAG-WINDOW-DRAW-LINES WINDOW
                                (WINDOWPROP WINDOW 'MAG-TELEGRAM-LINES))))
      (T
       (MAG-TELEGRAM-DRAW-TEXT WINDOW
                               (OR (WINDOWPROP WINDOW 'MAG-TELEGRAM-TEXT)
                                   (MAG-TELEGRAM-DASHBOARD-TEXT)))))])

(MAG-TELEGRAM-CLOSEFN
  [LAMBDA (WINDOW)
    (PROG ((PROC (WINDOWPROP WINDOW 'PROCESS NIL)))
      (AND (EQ MAG-TELEGRAM-LAST-WINDOW WINDOW)
           (PROGN
             (SETQ MAG-TELEGRAM-LAST-WINDOW NIL)
             (MAG-TELEGRAM-STOP-AUTOREFRESH)
             (AND MAG-TELEGRAM-COMPOSE-CONTROL-WINDOW
                  (OPENWP MAG-TELEGRAM-COMPOSE-CONTROL-WINDOW)
                  (NLSETQ (CLOSEW MAG-TELEGRAM-COMPOSE-CONTROL-WINDOW)))
             (AND MAG-TELEGRAM-MESSAGE-WINDOW
                  (OPENWP MAG-TELEGRAM-MESSAGE-WINDOW)
                  (NLSETQ (CLOSEW MAG-TELEGRAM-MESSAGE-WINDOW)))
             (AND MAG-TELEGRAM-COMPOSE-WINDOW
                  (OPENWP MAG-TELEGRAM-COMPOSE-WINDOW)
                  (NLSETQ (CLOSEW MAG-TELEGRAM-COMPOSE-WINDOW)))))
      (WINDOWPROP WINDOW 'MAG-TELEGRAM-RUNNING NIL)
      (AND PROC (DEL.PROCESS PROC)))])

(MAG-TELEGRAM
  [LAMBDA NIL
    (MAG-VTERM-ENSURE)
    (PROG ((WINDOW (CREATEW NIL "Mag Telegram Chats"))
           INPROC)
      (WINDOWPROP WINDOW 'MAG-TELEGRAM-STATE T)
      (WINDOWPROP WINDOW 'MAG-TELEGRAM-RUNNING T)
      (WINDOWPROP WINDOW 'BUTTONEVENTFN (FUNCTION MAG-TELEGRAM-BUTTONFN))
      (WINDOWPROP WINDOW 'RIGHTBUTTONFN (FUNCTION DOWINDOWCOM))
      (WINDOWPROP WINDOW 'WINDOWENTRYFN 'GIVE.TTY.PROCESS)
      (WINDOWPROP WINDOW 'RESHAPEFN (FUNCTION MAG-TELEGRAM-RESHAPEFN))
      (WINDOWADDPROP WINDOW 'CLOSEFN (FUNCTION MAG-TELEGRAM-CLOSEFN))
      (MODERNWINDOW WINDOW)
      (MAG-WINDOW-SET-BACKGROUND WINDOW)
      (SETQ MAG-TELEGRAM-LAST-WINDOW WINDOW)
      (MAG-TELEGRAM-ENSURE-BRIDGE)
      (BLOCK 500)
      (SETQ INPROC (ADD.PROCESS (LIST (FUNCTION MAG-TELEGRAM-TYPEIN) WINDOW)
                                'NAME 'MAG-TELEGRAM-TYPEIN))
      (WINDOWPROP WINDOW 'PROCESS INPROC)
      (MAG-TELEGRAM-SHOW-CHATS WINDOW)
      (MAG-TELEGRAM-START-AUTOREFRESH)
      (TTY.PROCESS INPROC)
      (RETURN WINDOW))])

(MAG-TELEGRAM-APPLY-BACKGROUND-OPEN-WINDOWS
  [LAMBDA NIL
    (for W in (OPENWINDOWS) do
      (AND (WINDOWPROP W 'MAG-TELEGRAM-STATE)
           (OPENWP W)
           (CAR (NLSETQ (MAG-TELEGRAM-REFRESH W)))))
    T])
)

(MOVD 'MAG-TELEGRAM-DRAW-TEXT 'MAG-TELEGRAM-DRAW-TEXT-UNWRAPPED)
