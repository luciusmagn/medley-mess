                                 (IDIFFERENCE
                                   (IDIFFERENCE (WINDOWPROP WINDOW 'HEIGHT) 8)
                                   Y))
                           LINEHEIGHT))
           (INDEX (IPLUS (OR (WINDOWPROP WINDOW 'MAG-TELEGRAM-TOP) 0)
                         (IDIFFERENCE ROW 3)))
           (COUNT (OR (WINDOWPROP WINDOW 'MAG-TELEGRAM-COUNT) 0)))
