(MAG-TELEGRAM-DRAW-CONTROL-BUTTON
  [LAMBDA (WINDOW ITEM INDEX)
    (LET* ((RECT (MAG-TELEGRAM-CONTROL-BUTTON-RECT WINDOW INDEX))
           (BOLD (MAG-TELEGRAM-BOLD-FONT WINDOW))
           (PLAIN (DSPFONT NIL WINDOW))
           (LABEL (CAR ITEM))
           (X (CAR RECT))
           (Y (CADR RECT))
           (W (CADDR RECT))
           (H (CADDDR RECT))
           (TW (STRINGWIDTH LABEL BOLD))
           (FH (FONTPROP BOLD 'HEIGHT))
           (DESC (OR (FONTPROP BOLD 'DESCENT) 0)))
      (MAG-TELEGRAM-DRAW-CONTROL-BOX WINDOW X Y W H)
      (DSPFONT BOLD WINDOW)
      (MOVETO (IPLUS X (IQUOTIENT (IMAX 0 (IDIFFERENCE W TW)) 2))
              (IPLUS Y (IQUOTIENT (IMAX 0 (IDIFFERENCE H FH)) 2) DESC)
              WINDOW)
