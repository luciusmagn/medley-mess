         (CAR (NLSETQ
                (COND
                  ((EQ (WINDOWPROP WINDOW 'MAINWINDOW) MESSAGE-WINDOW)
                   (MOVEATTACHEDWINDOWTOPLACE WINDOW MESSAGE-WINDOW))
