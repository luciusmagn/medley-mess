(MAG-TELEGRAM-ENSURE-COMPOSE-WINDOW
  [LAMBDA (OWNER MESSAGE-WINDOW)
    (PROG ((WINDOW (AND MAG-TELEGRAM-COMPOSE-WINDOW
                        (OPENWP MAG-TELEGRAM-COMPOSE-WINDOW)
                        MAG-TELEGRAM-COMPOSE-WINDOW)))
      (COND
        ((OR (NULL MESSAGE-WINDOW)
             (NOT (OPENWP MESSAGE-WINDOW)))
         (RETURN NIL)))
      (COND
        ((NULL WINDOW)
         (SETQ WINDOW (CREATEW (MAG-TELEGRAM-COMPOSE-REGION MESSAGE-WINDOW)
                               "Reply"))
         (SETQ MAG-TELEGRAM-COMPOSE-WINDOW WINDOW)
         (WINDOWPROP WINDOW 'MAG-TELEGRAM-STATE T)
         (WINDOWPROP WINDOW 'MAG-TELEGRAM-MODE 'COMPOSE)
         (WINDOWPROP WINDOW 'BUTTONEVENTFN
                     (FUNCTION MAG-TELEGRAM-COMPOSE-BUTTONFN))
         (WINDOWPROP WINDOW 'RIGHTBUTTONFN (FUNCTION DOWINDOWCOM))
         (WINDOWPROP WINDOW 'WINDOWENTRYFN 'GIVE.TTY.PROCESS)
         (WINDOWPROP WINDOW 'RESHAPEFN (FUNCTION MAG-TELEGRAM-RESHAPEFN))
         (WINDOWADDPROP WINDOW 'CLOSEFN
                        (FUNCTION MAG-TELEGRAM-COMPOSE-CLOSEFN))
         (MODERNWINDOW WINDOW)
         (MAG-WINDOW-SET-BACKGROUND WINDOW)
         (NLSETQ (ATTACHWINDOW WINDOW MESSAGE-WINDOW 'BOTTOM 'JUSTIFY))))
      (COND
        ((EQ (WINDOWPROP WINDOW 'MAINWINDOW) MESSAGE-WINDOW)
         (NLSETQ (MOVEATTACHEDWINDOWTOPLACE WINDOW MESSAGE-WINDOW))))
      (AND OWNER
           (WINDOWPROP WINDOW 'PROCESS (WINDOWPROP OWNER 'PROCESS)))
      (WINDOWPROP WINDOW 'MAG-TELEGRAM-OWNER OWNER)
      (WINDOWPROP WINDOW 'MAG-TELEGRAM-MESSAGE-WINDOW MESSAGE-WINDOW)
      (MAG-TELEGRAM-DRAW-COMPOSE-WINDOW WINDOW OWNER)
      (RETURN WINDOW))])

