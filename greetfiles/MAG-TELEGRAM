      (NLSETQ (DELFILE MAG-TELEGRAM-REQUEST-FILE-PATH))
      (COND
        ((NULL
           (MAG-WRITE-UTF8-TEXT-FILE
             MAG-TELEGRAM-REQUEST-FILE-PATH
             (OR REQUEST "status")))
         (RETURN (CONCAT "could not write Mag Telegram request file"
                         (MAG-TELEGRAM-LF)))))
      (SETQ TEXT
            (MAG-TELEGRAM-SHELL
              (CONCAT MAG-TELEGRAM-BRIDGE-COMMAND
                      " --request-file-ascii "
                      MAG-TELEGRAM-REQUEST-FILE-PATH)))
      (NLSETQ (DELFILE MAG-TELEGRAM-REQUEST-FILE-PATH))
      (RETURN TEXT))])

