(MAG-TELEGRAM-CONTINUATION-BYTEP
  [LAMBDA (BYTE)
    (AND (IGEQ BYTE 128)
         (ILEQ BYTE 191))])

(MAG-TELEGRAM-WRITE-CODE
  [LAMBDA (OUT CODE)
    (CL:WRITE-CHAR (OR (CL:CODE-CHAR CODE)
                       (CL:CODE-CHAR 63))
                   OUT)])

(MAG-TELEGRAM-READ-STREAM-TEXT
  [LAMBDA (STREAM)
    (PROG ((END (GETEOFPTR STREAM))
           (CODES NIL)
           CH)
      (SETFILEPTR STREAM 0)
      (for I from 1 to END do
        (SETQ CH (READCCODE STREAM))
        (AND CH (SETQ CODES (CONS CH CODES))))
      (RETURN (COND
                (CODES (CONCATCODES (DREVERSE CODES)))
                (T ""))))])

(MAG-TELEGRAM-READ-UTF8-STREAM
  [LAMBDA (STREAM)
    (PROG ((END (GETEOFPTR STREAM))
           (OUT (CL:MAKE-STRING-OUTPUT-STREAM))
           (I 0)
           BYTE B2 B3 B4 CODE)
      (SETFILEPTR STREAM 0)
    LP
      (COND
        ((IGEQ I END)
         (RETURN (CL:GET-OUTPUT-STREAM-STRING OUT))))
      (SETQ BYTE (BIN STREAM))
      (SETQ I (ADD1 I))
      (COND
        ((OR (NULL BYTE) (ILESSP BYTE 0))
         (RETURN (CL:GET-OUTPUT-STREAM-STRING OUT)))
        ((ILESSP BYTE 128)
         (MAG-TELEGRAM-WRITE-CODE OUT BYTE))
        ((AND (IGEQ BYTE 194)
              (ILEQ BYTE 223)
              (ILESSP I END)
              (MAG-TELEGRAM-CONTINUATION-BYTEP
                (SETQ B2 (BIN STREAM))))
         (SETQ I (ADD1 I))
         (SETQ CODE (IPLUS (LLSH (LOGAND BYTE 31) 6)
                           (LOGAND B2 63)))
         (MAG-TELEGRAM-WRITE-CODE OUT CODE))
        ((AND (IGEQ BYTE 224)
              (ILEQ BYTE 239)
              (ILESSP (ADD1 I) END)
              (MAG-TELEGRAM-CONTINUATION-BYTEP
                (SETQ B2 (BIN STREAM)))
              (MAG-TELEGRAM-CONTINUATION-BYTEP
                (SETQ B3 (BIN STREAM)))
              (OR (NEQ BYTE 224) (IGEQ B2 160))
              (OR (NEQ BYTE 237) (ILESSP B2 160)))
         (SETQ I (IPLUS I 2))
         (SETQ CODE (IPLUS (LLSH (LOGAND BYTE 15) 12)
                           (LLSH (LOGAND B2 63) 6)
                           (LOGAND B3 63)))
         (MAG-TELEGRAM-WRITE-CODE OUT CODE))
        ((AND (IGEQ BYTE 240)
              (ILEQ BYTE 244)
              (ILESSP (IPLUS I 2) END)
              (MAG-TELEGRAM-CONTINUATION-BYTEP
                (SETQ B2 (BIN STREAM)))
              (MAG-TELEGRAM-CONTINUATION-BYTEP
                (SETQ B3 (BIN STREAM)))
              (MAG-TELEGRAM-CONTINUATION-BYTEP
                (SETQ B4 (BIN STREAM)))
              (OR (NEQ BYTE 240) (IGEQ B2 144))
              (OR (NEQ BYTE 244) (ILESSP B2 144)))
         (SETQ I (IPLUS I 3))
         (SETQ CODE (IPLUS (LLSH (LOGAND BYTE 7) 18)
                           (LLSH (LOGAND B2 63) 12)
                           (LLSH (LOGAND B3 63) 6)
                           (LOGAND B4 63)))
         (MAG-TELEGRAM-WRITE-CODE OUT CODE))
        (T
         (MAG-TELEGRAM-WRITE-CODE OUT BYTE)))
      (GO LP))])

