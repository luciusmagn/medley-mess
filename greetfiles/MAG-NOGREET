(DEFINE-FILE-INFO PACKAGE "INTERLISP" READTABLE "INTERLISP" BASE 10)

(DEFINEQ

(MAG-EXEC-REGION
  [LAMBDA NIL
    (CREATEREGION 8 96 (IDIFFERENCE SCREENWIDTH 16)
                  (IDIFFERENCE SCREENHEIGHT 128))])

(MAG-PROMPT-REGION
  [LAMBDA NIL
    (CREATEREGION 8 8 (IDIFFERENCE SCREENWIDTH 16) 72)])

(MAG-CHAT-REGION
  [LAMBDA NIL
    (CREATEREGION 8 8 (IDIFFERENCE SCREENWIDTH 16)
                  (IDIFFERENCE SCREENHEIGHT 48))])

(MAG-LOCAL-SHELL-STREAM
  [LAMBDA (TERMTYPE COMMAND)
    (LET ((STR (CREATE-SHELL-STREAM TERMTYPE COMMAND)))
      (AND STR
           (PROGN
             (STREAMPROP STR 'SETDISPLAYTYPE (FUNCTION NILL))
             STR)))])

(MAG-VTCHAT.HANDLECHARACTER
  [LAMBDA (CHAR CHAT.STATE VT100.STATE)
    (PROG ((SEQ (fetch (VT100.STATE ESCAPESEQUENCE) of VT100.STATE)))
      (COND
        ((EQ SEQ 'MAG-OSC)
         (COND
           ((EQ CHAR (CHARCODE BELL))
            (replace (VT100.STATE ESCAPESEQUENCE) of VT100.STATE with NIL))
           ((EQ CHAR (CHARCODE ESC))
            (replace (VT100.STATE ESCAPESEQUENCE) of VT100.STATE with 'MAG-OSC-ESC)))
         (RETURN NIL))
        ((EQ SEQ 'MAG-OSC-ESC)
         (COND
           ((OR (EQ CHAR 92) (EQ CHAR (CHARCODE BELL)))
            (replace (VT100.STATE ESCAPESEQUENCE) of VT100.STATE with NIL))
           ((EQ CHAR (CHARCODE ESC))
            (replace (VT100.STATE ESCAPESEQUENCE) of VT100.STATE with 'MAG-OSC-ESC))
           (T
            (replace (VT100.STATE ESCAPESEQUENCE) of VT100.STATE with 'MAG-OSC)))
         (RETURN NIL))
        ((AND (EQ SEQ 0)
              (EQ CHAR 93))
         (replace (VT100.STATE ESCAPESEQUENCE) of VT100.STATE with 'MAG-OSC)
         (RETURN NIL)))
      (RETURN (MAG-VTCHAT.HANDLECHARACTER.ORIGINAL CHAR CHAT.STATE VT100.STATE)))])

(MAG-INSTALL-VTCHAT-PATCH
  [LAMBDA NIL
    [OR (GETD 'MAG-VTCHAT.HANDLECHARACTER.ORIGINAL)
        (MOVD 'VTCHAT.HANDLECHARACTER 'MAG-VTCHAT.HANDLECHARACTER.ORIGINAL)]
    (MOVD 'MAG-VTCHAT.HANDLECHARACTER 'VTCHAT.HANDLECHARACTER)])

(MAG-LAYOUT-WINDOWS
  [LAMBDA NIL
    (SETQ CHAT.WINDOW.REGION (MAG-CHAT-REGION))
    (SETQ CHAT.WINDOW.SIZE NIL)
    [MAPC (OPENWINDOWS)
          (FUNCTION
            (LAMBDA (W)
              (COND
                ((STREQUAL (WINDOWPROP W 'TITLE) "Prompt Window")
                 (PROGN
                   (SHAPEW W (MAG-PROMPT-REGION))
                   (CLEARW W)))
                ((AND (STRINGP (WINDOWPROP W 'TITLE))
                      (STRPOS "Exec" (WINDOWPROP W 'TITLE)))
                 (PROGN
                   (WINDOWPROP W 'TITLE "Exec  (INTERLISP)")
                   (SHAPEW W (MAG-EXEC-REGION))))
                ((WINDOWPROP W 'CHATSTATE)
                 (SHAPEW W (MAG-CHAT-REGION))))))]])

(MAG-ENSURE-VTCHAT
  [LAMBDA NIL
    (FILESLOAD UNIXCHAT)
    [OR (GETD 'VTCHAT.STATE)
        (FILESLOAD VTCHAT)]
    (MAG-INSTALL-VTCHAT-PATCH)
    [OR (ASSOC 'MSHELL CHAT.PROTOCOLTYPES)
        (SETQ CHAT.PROTOCOLTYPES
              (CONS '(MSHELL . MAG-MSHELL-HOST-FILTER)
                    CHAT.PROTOCOLTYPES))]
    [OR (ASSOC 'CODEX CHAT.PROTOCOLTYPES)
        (SETQ CHAT.PROTOCOLTYPES
              (CONS '(CODEX . MAG-CODEX-HOST-FILTER)
                    CHAT.PROTOCOLTYPES))]
    [OR (CL:ASSOC "MSHELL" CHAT.HOST.TO.PROTOCOL :TEST 'STRING-EQUAL)
        (SETQ CHAT.HOST.TO.PROTOCOL
              (CONS '(MSHELL . MSHELL) CHAT.HOST.TO.PROTOCOL))]
    [OR (CL:ASSOC "CODEX" CHAT.HOST.TO.PROTOCOL :TEST 'STRING-EQUAL)
        (SETQ CHAT.HOST.TO.PROTOCOL
              (CONS '(CODEX . CODEX) CHAT.HOST.TO.PROTOCOL))]
    (SETQ CHAT.DISPLAYTYPES '((SHELL NIL VT100) (MSHELL NIL VT100) (CODEX NIL VT100) (NIL NIL VT100)))
    (MAG-LAYOUT-WINDOWS)])

(MAG-MSHELL-HOST-FILTER
  [LAMBDA (HOST)
    (if (AND (EQ \MACHINETYPE \MAIKO)
             (STRING.EQUAL HOST "MSHELL"))
        then (QUOTE (MSHELL MAG-MSHELL-OPEN)))])

(MAG-MSHELL-OPEN
  [LAMBDA (HOST TERMTYPE LOGOPTION)
    (AND (EQ \MACHINETYPE \MAIKO)
         (LET ((STR (MAG-LOCAL-SHELL-STREAM TERMTYPE NIL)))
           (AND STR
                (LIST STR STR (QUOTE LOGOPTION) (QUOTE NONE)))))])

(MAG-CODEX-HOST-FILTER
  [LAMBDA (HOST)
    (if (AND (EQ \MACHINETYPE \MAIKO)
             (STRING.EQUAL HOST "CODEX"))
        then (QUOTE (CODEX MAG-CODEX-OPEN)))])

(MAG-CODEX-OPEN
  [LAMBDA (HOST TERMTYPE LOGOPTION)
    (AND (EQ \MACHINETYPE \MAIKO)
         (LET ((STR (MAG-LOCAL-SHELL-STREAM TERMTYPE "medley-codex")))
           (AND STR
                (LIST STR STR (QUOTE LOGOPTION) (QUOTE NONE)))))])

(MAG-SHELL
  [LAMBDA NIL
    (MAG-ENSURE-VTCHAT)
    (CHAT "MSHELL" 'NONE NIL NIL NIL])

(MAG-CODEX
  [LAMBDA NIL
    (MAG-ENSURE-VTCHAT)
    (CHAT "CODEX" 'NONE NIL NIL NIL])
)

[COND
   ((STKPOS 'GREET)
    (SETQ USERGREETFILES NIL)
    [OR (SASSOC "Mag Shell" BackgroundMenuCommands)
        (NCONC1 BackgroundMenuCommands '("Mag Shell" '(MAG-SHELL)
                                                     "Open a local VT100 Unix shell in a CHAT window"))]
    [OR (SASSOC "Mag Codex" BackgroundMenuCommands)
        (NCONC1 BackgroundMenuCommands '("Mag Codex" '(MAG-CODEX)
                                                     "Open Codex in a local VT100 shell without alternate screen"))]
    (SETQ BackgroundMenu NIL)
    (MAG-LAYOUT-WINDOWS)
    (CLOSEF? (INPUT))
    (RETFROM 'GREET]
STOP
