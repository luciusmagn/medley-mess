(DEFINE-FILE-INFO PACKAGE "INTERLISP" READTABLE "INTERLISP" BASE 10)

(FILESLOAD RECORD)

(RPAQQ MAG-GC-RECLAIMMIN 500)

(DEFINEQ

(MAG-GC-CONFIGURE
  [LAMBDA NIL
    (AND (GETD 'RECLAIMMIN)
         (NLSETQ (RECLAIMMIN MAG-GC-RECLAIMMIN)))
    T])

(MAG-EXTRAS-PATH
  [LAMBDA NIL
    (CONCAT (OR (UNIX-GETENV "MEDLEYDIR")
                "/home/mag/src/medley")
            "/greetfiles/MAG-EXTRAS")])

(MAG-LOAD-EXTRAS
  [LAMBDA NIL
    (LOAD (MAG-EXTRAS-PATH) T)
    (MAG-EXTRAS-LOADED-P)])

(MAG-EXTRAS-LOADED-P
  [LAMBDA NIL
    (AND (GETD 'MAG-SHELL)
	         (GETD 'MAG-CODEX)
		         (GETD 'MAG-RUN)
		         (GETD 'MAG-GOPHER)
		         (GETD 'MAG-TELEGRAM)
		         (GETD 'MAG-DEBUG-SHOW)
		         (GETD 'MAG-DEBUG-KEY-PROBE)
		         (GETD 'MAG-DEBUG-RPC-START)
		         (GETD 'MAG-INSTALL-WHO-LINE-BATTERY)
		         (GETD 'MAG-START-DOCS-FILEBROWSER)
		         (GETD 'MAG-TEDIT-MENU)
		         (GETD 'MAG-VTERM-CSI-RESET)
		         (GETD 'MAG-GHOSTTY-REFRESH)
	         (GETD 'MAG-GOPHER-HANDLE-KEY))])

(MAG-APPS-INIT
  [LAMBDA NIL
    (OR (GETD 'Apps.DoInit)
        (LOAD (CONCAT (OR (UNIX-GETENV "MEDLEYDIR")
                          "/home/mag/src/medley")
                      "/greetfiles/APPS-INIT")))
    (AND (GETD 'Apps.DoInit)
         (NLSETQ (Apps.DoInit)))
    (AND (GETD 'Apps.ActivateRooms)
         (NLSETQ (Apps.ActivateRooms T)))
    (AND (GETD 'Apps.InitNotecards)
         (NLSETQ (Apps.InitNotecards T)))])

(MAG-DISPATCH
  [LAMBDA (FN)
    (OR (MAG-EXTRAS-LOADED-P)
        (MAG-LOAD-EXTRAS))
    (COND
      ((GETD FN) (APPLY* FN))
      (T (PROMPTPRINT "Mag extras failed to load")))])

(MAG-DISPATCH-WORKER
  [LAMBDA (FN)
    (MAG-DISPATCH FN)])

(MAG-DISPATCH-ASYNC
  [LAMBDA (FN NAME)
    (ADD.PROCESS (LIST (FUNCTION MAG-DISPATCH-WORKER) (KWOTE FN))
                 'NAME NAME
                 'RESTARTABLE 'NO)])

(MAG-FIND-BUTTON
  [LAMBDA (LABEL)
    (AND (BOUNDP '*ALL-BUTTONS*)
         (for B in *ALL-BUTTONS* thereis
           (AND (OR (AND (GETD 'BUTTON-LABEL)
                         (EQUAL LABEL (BUTTON-LABEL B)))
                    (EQUAL LABEL (WINDOWPROP B 'BUTTON-LABEL)))
                B)))])

(MAG-SHOW-DOC
  [LAMBDA (URL)
    (ShellBrowse URL)])

(MAG-CREATE-BUTTON-IF-MISSING
  [LAMBDA (LABEL FORM X Y)
    (OR (MAG-FIND-BUTTON LABEL)
        (AND (GETD 'CREATE-BUTTON)
             (CREATE-BUTTON FORM LABEL
                            (create POSITION XCOORD _ X YCOORD _ Y))))])

(MAG-CREATE-STARTUP-BUTTONS
  [LAMBDA NIL
    (LET ((X (IDIFFERENCE SCREENWIDTH 140)))
      (MAG-CREATE-BUTTON-IF-MISSING
        "BASICS"
        '(MAG-SHOW-DOC "https://interlisp.org/docs/medley/orientation/")
        X
        (IDIFFERENCE SCREENHEIGHT 280))
      (MAG-CREATE-BUTTON-IF-MISSING
        "PRIMER"
        '(MAG-SHOW-DOC "https://primer.interlisp.org/")
        X
        (IDIFFERENCE SCREENHEIGHT 335))
      (MAG-CREATE-BUTTON-IF-MISSING
        "MANUAL"
        '(MAG-SHOW-DOC "https://interlisp.org/documentation/IRM.pdf")
        X
        (IDIFFERENCE SCREENHEIGHT 390))
      (MAG-CREATE-BUTTON-IF-MISSING
        "ROOMS DOC"
        '(MAG-SHOW-DOC "https://interlisp.org/documentation/ROOMSTECHDESC.pdf")
        X
        (IDIFFERENCE SCREENHEIGHT 445))
      (MAG-CREATE-BUTTON-IF-MISSING
        "NOTES DOC"
        '(MAG-SHOW-DOC "https://interlisp.org/documentation/Notecards-User-Guide-v2.0.pdf")
        X
        (IDIFFERENCE SCREENHEIGHT 500))
      (MAG-CREATE-BUTTON-IF-MISSING
        "ROOMS"
        '(MAG-ACTIVATE-ROOMS)
        X
        (IDIFFERENCE SCREENHEIGHT 610))
      (MAG-CREATE-BUTTON-IF-MISSING
        "NOTECARDS"
        '(MAG-ACTIVATE-NOTECARDS)
        X
        (IDIFFERENCE SCREENHEIGHT 665)))])

(MAG-CALL-PACKAGE-FN
  [LAMBDA (PACKAGE NAME)
    (LET* ((PKG (CL:FIND-PACKAGE PACKAGE))
           (SYM (AND PKG (CL:FIND-SYMBOL NAME PKG))))
      (AND SYM
           (CL:FBOUNDP SYM)
           (CL:FUNCALL SYM)))])

(MAG-ACTIVATE-ROOMS
  [LAMBDA NIL
    (OR (CAR (NLSETQ (MAG-CALL-PACKAGE-FN "ROOMS" "RESET")))
        (PROMPTPRINT "Rooms are not available in this sysout"))])

(MAG-ACTIVATE-NOTECARDS
  [LAMBDA NIL
    (AND (GETD 'NC.SetUpNOTECARDSDIRECTORIES)
         (UNIX-GETENV "NOTECARDSDIR")
         (NLSETQ (NC.SetUpNOTECARDSDIRECTORIES
                   (CONCAT (UNIX-GETENV "NOTECARDSDIR") "/"))))
    (OR (AND (GETD 'NC.BringUpNoteCardsIcon)
             (CAR (NLSETQ
                    (NC.BringUpNoteCardsIcon
                      (create POSITION
                              XCOORD _ (IDIFFERENCE SCREENWIDTH 220)
                              YCOORD _ 80)))))
        (PROMPTPRINT "NoteCards are not available in this sysout"))])

(MAG-BOOT-SHELL
  [LAMBDA NIL
    (MAG-DISPATCH-ASYNC 'MAG-SHELL 'MAG-BOOT-SHELL)
    NIL])

(MAG-BOOT-CODEX
  [LAMBDA NIL
    (MAG-DISPATCH-ASYNC 'MAG-CODEX 'MAG-BOOT-CODEX)
    NIL])

(MAG-BOOT-RUN
  [LAMBDA NIL
    (MAG-DISPATCH-ASYNC 'MAG-RUN 'MAG-BOOT-RUN)
    NIL])

(MAG-BOOT-GOPHER
  [LAMBDA NIL
    (MAG-DISPATCH-ASYNC 'MAG-GOPHER 'MAG-BOOT-GOPHER)
    NIL])

(MAG-BOOT-TELEGRAM
  [LAMBDA NIL
    (MAG-DISPATCH-ASYNC 'MAG-TELEGRAM 'MAG-BOOT-TELEGRAM)
    NIL])

(MAG-BOOT-DEBUG
  [LAMBDA NIL
    (MAG-DISPATCH-ASYNC 'MAG-DEBUG-SHOW 'MAG-BOOT-DEBUG)
    NIL])

(MAG-BOOT-KEYS
  [LAMBDA NIL
    (MAG-DISPATCH-ASYNC 'MAG-DEBUG-KEY-PROBE 'MAG-BOOT-KEYS)
    NIL])

(MAG-LOGOUT
  [LAMBDA NIL
    (LOGOUT)])

(MAG-STARTUP-INIT
  [LAMBDA NIL
    (NLSETQ (MAG-GC-CONFIGURE))
    (NLSETQ (MAG-LOAD-EXTRAS))
    (NLSETQ (MAG-APPS-INIT))
    (AND (GETD 'MAG-INSTALL-WHO-LINE-BATTERY)
         (NLSETQ (MAG-INSTALL-WHO-LINE-BATTERY)))
    (AND (GETD 'MAG-START-DOCS-FILEBROWSER)
         (NLSETQ (MAG-START-DOCS-FILEBROWSER)))
    (AND (GETD 'MAG-WRITE-UTF8-TEXT-FILE)
         (NLSETQ
           (MAG-WRITE-UTF8-TEXT-FILE
             "/tmp/medley-mag-startup.txt"
             (CONCAT "mag startup\n"
                     "rpc-function="
                     (COND ((GETD 'MAG-DEBUG-RPC-START) "yes") (T "no"))
                     "\nmax-command="
                     (MAG-UNIX-HANDLECOMM1 8)
                     "\n"))))
    (AND (GETD 'MAG-DEBUG-RPC-START)
         (NLSETQ (MAG-DEBUG-RPC-START)))
    [OR (SASSOC "Mag Shell" BackgroundMenuCommands)
        (NCONC1 BackgroundMenuCommands '("Mag Shell" '(MAG-BOOT-SHELL)
                                                     "Open a local shell rendered in a Medley window"))]
    [OR (SASSOC "Mag Codex" BackgroundMenuCommands)
        (NCONC1 BackgroundMenuCommands '("Mag Codex" '(MAG-BOOT-CODEX)
                                                     "Open Codex rendered in a Medley window"))]
    [OR (SASSOC "Mag Run..." BackgroundMenuCommands)
        (NCONC1 BackgroundMenuCommands '("Mag Run..." '(MAG-BOOT-RUN)
                                                     "Prompt for a command and render it in a Medley terminal window"))]
    [OR (SASSOC "Mag Gopher" BackgroundMenuCommands)
        (NCONC1 BackgroundMenuCommands '("Mag Gopher" '(MAG-BOOT-GOPHER)
                                                      "Open the gopher client rendered in a Medley window"))]
    [OR (SASSOC "Mag Telegram" BackgroundMenuCommands)
        (NCONC1 BackgroundMenuCommands '("Mag Telegram" '(MAG-BOOT-TELEGRAM)
                                                        "Open the Telegram client rendered in Medley windows"))]
    [OR (SASSOC "Mag Debug" BackgroundMenuCommands)
        (NCONC1 BackgroundMenuCommands '("Mag Debug" '(MAG-BOOT-DEBUG)
                                                     "Show Maiko/Medley Mag debug status"))]
    [OR (SASSOC "Mag Keys" BackgroundMenuCommands)
        (NCONC1 BackgroundMenuCommands '("Mag Keys" '(MAG-BOOT-KEYS)
                                                    "Inspect raw Medley key codes and Mag terminal key ids"))]
    [OR (SASSOC "Mag Logout" BackgroundMenuCommands)
        (NCONC1 BackgroundMenuCommands '("Mag Logout" '(MAG-LOGOUT)
                                                      "Save the Medley virtual memory image and exit"))]
    (SETQ BackgroundMenu NIL)
    T])
)

(NLSETQ (MAG-STARTUP-INIT))

[COND
	   ((STKPOS 'GREET)
	    (SETQ USERGREETFILES NIL)
	    (CLOSEF? (INPUT))
	    (RETFROM 'GREET))]
STOP
