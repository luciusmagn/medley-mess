(MAG-DEBUG-RPC-SHELL-SELF-TEST
  [LAMBDA NIL
    (PROG ((OUT (CL:MAKE-STRING-OUTPUT-STREAM))
           (BUFFER (NCREATE 'VMEMPAGEP))
           (MAXCOMMAND (OR (SUBRCALL UNIX-HANDLECOMM 8) 0))
           CHAN LEN READS CHANGED JOBLEN)
      (MAG-DEBUG-RPC-WRITE-LINE OUT "Mag shell self-test")
      (MAG-DEBUG-RPC-WRITE-LINE OUT (CONCAT "unix-handlecomm-max=" MAXCOMMAND))
      (COND
        ((ILESSP MAXCOMMAND 40)
         (MAG-DEBUG-RPC-WRITE-LINE OUT "status=FAIL command40 unavailable")
         (RETURN (CL:GET-OUTPUT-STREAM-STRING OUT))))
      (MAG-VTERM-ENSURE)
      (SETQ CHAN (FORK-SHELL "xterm-256color" NIL))
      (COND
        ((NULL CHAN)
         (MAG-DEBUG-RPC-WRITE-LINE OUT "status=FAIL fork-shell returned NIL")
         (RETURN (CL:GET-OUTPUT-STREAM-STRING OUT))))
      (MAG-DEBUG-RPC-WRITE-LINE OUT (CONCAT "slot=" CHAN))
      (COND
        ((SUBRCALL UNIX-HANDLECOMM 17 CHAN 24 80)
         (MAG-DEBUG-RPC-WRITE-LINE OUT "ok resize=24x80"))
        (T
         (MAG-DEBUG-RPC-WRITE-LINE OUT "FAIL resize=24x80")))
      (SETQ READS 0)
    READLP
      (COND
        ((IGEQ READS 40)
         (GO AFTERREAD)))
      (SETQ LEN (SUBRCALL UNIX-HANDLECOMM 9 CHAN BUFFER))
      (COND
        ((AND LEN (SMALLP LEN) (IGREATERP LEN 0))
         (MAG-DEBUG-RPC-WRITE-LINE OUT (CONCAT "read-bytes=" LEN))
         (GO AFTERREAD)))
      (SETQ READS (ADD1 READS))
      (BLOCK)
      (GO READLP)
    AFTERREAD
      (COND
        ((OR (NULL LEN) (NOT (SMALLP LEN)) (ILEQ LEN 0))
         (MAG-DEBUG-RPC-WRITE-LINE OUT
           (CONCAT "read-bytes=0 attempts=" READS))))
      (SETQ CHANGED (SUBRCALL UNIX-HANDLECOMM 37 CHAN BUFFER))
      (MAG-DEBUG-RPC-WRITE-LINE
        OUT
        (CONCAT "changed-rows="
                (COND
                  ((AND CHANGED (SMALLP CHANGED)) CHANGED)
                  (CHANGED "non-small")
                  (T "none"))))
      (SETQ JOBLEN (SUBRCALL UNIX-HANDLECOMM 40 CHAN BUFFER))
      (COND
        ((AND JOBLEN (SMALLP JOBLEN) (IGREATERP JOBLEN 0))
         (MAG-DEBUG-RPC-WRITE-LINE OUT "job-report:")
         (MAG-STRING-OUTPUT (MAG-GHOSTTY-BUFFER-STRING BUFFER JOBLEN) OUT))
        (T
         (MAG-DEBUG-RPC-WRITE-LINE OUT "job-report unavailable")))
      (SUBRCALL UNIX-HANDLECOMM 3 CHAN 0)
      (MAG-DEBUG-RPC-WRITE-LINE OUT "status=ok")
      (RETURN (CL:GET-OUTPUT-STREAM-STRING OUT)))])

(MAG-DEBUG-RPC-SHELL-KEY-PROBE
  [LAMBDA NIL
    (PROG ((OUT (CL:MAKE-STRING-OUTPUT-STREAM))
           (BUFFER (NCREATE 'VMEMPAGEP))
           (MAXCOMMAND (OR (SUBRCALL UNIX-HANDLECOMM 8) 0))
           (COMMAND "sh -c 'stty raw -echo; dd bs=1 count=12 2>/dev/null | od -An -tx1 -v'")
           (EXPECTED "1b 5b 41 1b 5b 42 1b 5b 43 1b 5b 44")
           (ALL "")
           CHAN LEN TEXT READS WROTE FAIL)
      (MAG-DEBUG-RPC-WRITE-LINE OUT "Mag shell key probe")
      (MAG-DEBUG-RPC-WRITE-LINE OUT (CONCAT "unix-handlecomm-max=" MAXCOMMAND))
      (COND
        ((ILESSP MAXCOMMAND 25)
         (MAG-DEBUG-RPC-WRITE-LINE OUT "status=FAIL command25 unavailable")
         (RETURN (CL:GET-OUTPUT-STREAM-STRING OUT))))
      (MAG-VTERM-ENSURE)
      (SETQ CHAN (FORK-SHELL "xterm-256color" COMMAND))
      (COND
        ((NULL CHAN)
         (MAG-DEBUG-RPC-WRITE-LINE OUT "status=FAIL fork-shell returned NIL")
         (RETURN (CL:GET-OUTPUT-STREAM-STRING OUT))))
      (MAG-DEBUG-RPC-WRITE-LINE OUT (CONCAT "slot=" CHAN))
      (BLOCK 300)
      (for KEYID in '(1 2 3 4) do
        (SETQ WROTE (SUBRCALL UNIX-HANDLECOMM 25 CHAN KEYID 0 0))
        (MAG-DEBUG-RPC-WRITE-LINE
          OUT
          (CONCAT "sent key-id=" KEYID " wrote=" (OR WROTE "nil"))))
      (SETQ READS 0)
    READLP
      (COND
        ((IGEQ READS 60)
         (GO DONE)))
      (SETQ LEN (SUBRCALL UNIX-HANDLECOMM 9 CHAN BUFFER))
      (COND
        ((AND LEN (SMALLP LEN) (IGREATERP LEN 0))
         (SETQ TEXT (MAG-GHOSTTY-BUFFER-STRING BUFFER LEN))
         (SETQ ALL (CONCAT ALL TEXT))
         (COND
           ((MAG-DEBUG-RPC-CONTAINS-P ALL EXPECTED)
            (GO DONE)))))
      (SETQ READS (ADD1 READS))
      (BLOCK)
      (GO READLP)
    DONE
      (SUBRCALL UNIX-HANDLECOMM 3 CHAN 0)
      (MAG-DEBUG-RPC-WRITE-LINE OUT (CONCAT "raw-output=" ALL))
      (SETQ FAIL
            (MAG-DEBUG-RPC-CHECK
              OUT
              "PTY receives up/down/right/left as CSI A/B/C/D"
              (MAG-DEBUG-RPC-CONTAINS-P ALL EXPECTED)
              FAIL))
      (MAG-DEBUG-RPC-WRITE-LINE
        OUT
        (COND
          (FAIL "status=FAIL")
          (T "status=ok")))
      (RETURN (CL:GET-OUTPUT-STREAM-STRING OUT)))])

