      (LIST "Mag Key Probe"
            "Press keys to inspect raw Medley key codes.  Press q to close."
            ""
            (COND
              (CH (CONCAT "raw=" CH
                          "  high=" (LRSH CH 8)
                          "  low=" (LOGAND CH 255)))
              (T "raw=<none>"))
