(MAG-DEBUG-RPC-TRIM-RIGHT
  [LAMBDA (TEXT)
    (PROG ((END (AND TEXT (NCHARS TEXT)))
           CH)
      (COND
        ((NULL TEXT)
         (RETURN "")))
    LP
      (COND
        ((ILEQ END 0)
         (RETURN "")))
      (SETQ CH (NTHCHARCODE TEXT END))
      (COND
        ((OR (EQ CH 0) (EQ CH 9) (EQ CH 10) (EQ CH 13) (EQ CH 32))
         (SETQ END (SUB1 END))
         (GO LP)))
      (RETURN (SUBSTRING TEXT 1 END)))])

