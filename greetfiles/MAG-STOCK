(DEFINE-FILE-INFO PACKAGE "INTERLISP" READTABLE "INTERLISP" BASE 10)

(FILESLOAD RECORD)
(FILESLOAD CHATDECLS)

(RPAQ? MAG-DOCS-FILEBROWSER-PROCESS NIL)
(RPAQ? MAG-BATTERY-UNIXCOMM-READY NIL)
(RPAQ? MAG-BATTERY-MAXCOMMAND-VALUE NIL)
(RPAQ? MAG-BATTERY-BUFFER NIL)
(RPAQ? MAG-BATTERY-PROCESS NIL)
(RPAQQ MAG-BATTERY-CACHED-TEXT "")
(RPAQQ MAG-BATTERY-UPDATE-INTERVAL-MS 60000)

(DEFINEQ

(MAG-BATTERY-ENSURE-UNIXCOMM
  [LAMBDA NIL
    (COND
      ((NOT MAG-BATTERY-UNIXCOMM-READY)
       (NLSETQ (FILESLOAD UNIXCOMM))
       (SETQ MAG-BATTERY-UNIXCOMM-READY T)))
    MAG-BATTERY-UNIXCOMM-READY])

(MAG-BATTERY-MAXCOMMAND
  [LAMBDA NIL
    (MAG-BATTERY-ENSURE-UNIXCOMM)
    (OR MAG-BATTERY-MAXCOMMAND-VALUE
        (SETQ MAG-BATTERY-MAXCOMMAND-VALUE
              (OR (MAG-UNIX-HANDLECOMM1 8) 0)))])

(MAG-BATTERY-SCRATCH-BUFFER
  [LAMBDA NIL
    (OR MAG-BATTERY-BUFFER
        (SETQ MAG-BATTERY-BUFFER (NCREATE 'VMEMPAGEP)))])

(MAG-BATTERY-AVAILABLEP
  [LAMBDA NIL
    (IGEQ (MAG-BATTERY-MAXCOMMAND) 34)])

(MAG-BATTERY-READ
  [LAMBDA NIL
    (COND
      ((MAG-BATTERY-AVAILABLEP)
       (LET ((BUFFER (MAG-BATTERY-SCRATCH-BUFFER))
             LEN)
         (SETQ LEN (MAG-UNIX-HANDLECOMM2 34 BUFFER))
         (COND
           ((AND LEN (IGREATERP LEN 0))
            (MAG-GHOSTTY-BUFFER-STRING BUFFER LEN))
           (T ""))))
      (T ""))])

(MAG-BATTERY-UPDATE
  [LAMBDA NIL
    (SETQ MAG-BATTERY-CACHED-TEXT (OR (CAR (NLSETQ (MAG-BATTERY-READ))) ""))
    MAG-BATTERY-CACHED-TEXT])

(MAG-BATTERY-LOOP
  [LAMBDA NIL
    (while T do
      (MAG-BATTERY-UPDATE)
      (DISMISS MAG-BATTERY-UPDATE-INTERVAL-MS))])

(MAG-BATTERY-START
  [LAMBDA NIL
    (OR (AND MAG-BATTERY-PROCESS
             (PROCESSP MAG-BATTERY-PROCESS))
        (SETQ MAG-BATTERY-PROCESS
              (ADD.PROCESS (LIST (FUNCTION MAG-BATTERY-LOOP))
                           'NAME
                           'MAG-BATTERY
                           'RESTARTABLE
                           'YES)))
    MAG-BATTERY-PROCESS])

(MAG-WHO-LINE-BATTERY
  [LAMBDA NIL
    (OR MAG-BATTERY-CACHED-TEXT "")])

(MAG-WHO-LINE-BATTERY-ENTRY
  [LAMBDA NIL
    '("Bat" (MAG-WHO-LINE-BATTERY)
      12 NIL NIL "Battery percentage and charging state")])

(MAG-WHO-LINE-DROP-BATTERY
  [LAMBDA (ENTRIES)
    (COND
      ((NULL ENTRIES)
       NIL)
      ((AND (LISTP (CAR ENTRIES))
            (EQUAL (CAAR ENTRIES) "Bat"))
       (MAG-WHO-LINE-DROP-BATTERY (CDR ENTRIES)))
      (T
       (CONS (CAR ENTRIES)
             (MAG-WHO-LINE-DROP-BATTERY (CDR ENTRIES)))))])

(MAG-WHO-LINE-BATTERY-INSTALLED-P
  [LAMBDA NIL
    (AND (BOUNDP '*WHO-LINE-ENTRIES*)
         (SASSOC "Bat" *WHO-LINE-ENTRIES*))])

(MAG-WHO-LINE-BATTERY-STATUS
  [LAMBDA NIL
    (CONCAT "who-line-battery installed="
            (COND ((MAG-WHO-LINE-BATTERY-INSTALLED-P) "yes")
                  (T "no"))
            " value="
            (MAG-WHO-LINE-BATTERY))])

(MAG-INSTALL-WHO-LINE-BATTERY
  [LAMBDA NIL
    (NLSETQ (FILESLOAD WHO-LINE))
    (MAG-BATTERY-UPDATE)
    (MAG-BATTERY-START)
    (AND (BOUNDP '*WHO-LINE-ENTRIES*)
         (LET ((ENTRY (MAG-WHO-LINE-BATTERY-ENTRY))
               ENTRIES
               TAIL)
           (SETQ ENTRIES (MAG-WHO-LINE-DROP-BATTERY *WHO-LINE-ENTRIES*))
           (SETQ TAIL (AND (BOUNDP '*WHO-LINE-TIME-ENTRY*)
                           (MEMB *WHO-LINE-TIME-ENTRY* ENTRIES)))
           (SETQ *WHO-LINE-ENTRIES*
                 (COND
                   (TAIL (APPEND (LDIFF ENTRIES TAIL)
                                 (CONS ENTRY TAIL)))
                   (T (APPEND ENTRIES (LIST ENTRY)))))
           (AND (GETD 'INSTALL-WHO-LINE-OPTIONS)
                (INSTALL-WHO-LINE-OPTIONS))))
    (MAG-WHO-LINE-BATTERY-STATUS)])

(MAG-ACTIVATE-ROOMS
  [LAMBDA NIL
    (MAG-ACTIVATE-ROOMS-INTERNAL)
    (MAG-CREATE-APP-BUTTONS)])

(MAG-ACTIVATE-NOTECARDS
  [LAMBDA NIL
    (MAG-SAFE-ACTIVATE-NOTECARDS NIL)
    (MAG-CREATE-APP-BUTTONS)])

(MAG-CALL-PACKAGE-FN
  [LAMBDA (PACKAGE NAME ARGS)
    (CL:MULTIPLE-VALUE-BIND (SYM STATUS)
        (CL:FIND-SYMBOL NAME PACKAGE)
      (AND SYM
           (CL:FBOUNDP SYM)
           (CL:APPLY SYM ARGS)))])

(MAG-ACTIVATE-ROOMS-INTERNAL
  [LAMBDA NIL
    (OR (AND (BOUNDP 'MAG-ROOMS-ACTIVATED)
             MAG-ROOMS-ACTIVATED)
        (CAR (NLSETQ
               (PROGN
                 (MAG-CALL-PACKAGE-FN "ROOMS" "RESET" NIL)
                 (SETQ MAG-ROOMS-ACTIVATED T)))))])

(MAG-NOTECARDS-DIR
  [LAMBDA NIL
    (OR (UNIX-GETENV 'NOTEFILESDIR)
        (AND (BOUNDP 'LOGINDIR)
             LOGINDIR
             (CONCAT LOGINDIR "notefiles")))])

(MAG-NOTECARDS-DIR-READY
  [LAMBDA NIL
    (LET ((DIR (MAG-NOTECARDS-DIR)))
      (AND DIR
           (CAR (NLSETQ (DIRECTORYNAME DIR)))))])

(MAG-SAFE-ACTIVATE-NOTECARDS
  [LAMBDA (DO-NOT-REFRESH)
    (COND
      ((MAG-NOTECARDS-DIR-READY)
       (CAR (NLSETQ
              (PROGN
                (AND (GETD 'NC.SetUpNOTECARDSDIRECTORIES)
                     (UNIX-GETENV "NOTECARDSDIR")
                     (NC.SetUpNOTECARDSDIRECTORIES
                       (CONCAT (UNIX-GETENV "NOTECARDSDIR") "/")))
                (AND (GETD 'NC.BringUpNoteCardsIcon)
                     (NC.BringUpNoteCardsIcon
                       (create POSITION
                               XCOORD _ (IDIFFERENCE SCREENWIDTH 220)
                               YCOORD _ 80)))
                (SETQ MAG-NOTECARDS-ACTIVATED T)
                (AND (NOT DO-NOT-REFRESH)
                     (MAG-CREATE-APP-BUTTONS))
                T))))
      (T
       NIL))])

(MAG-FIND-BUTTON
  [LAMBDA (LABEL)
    (AND (BOUNDP '*ALL-BUTTONS*)
         (for B in *ALL-BUTTONS* thereis
           (AND (OR (AND (GETD 'BUTTON-LABEL)
                         (EQUAL LABEL (BUTTON-LABEL B)))
                    (EQUAL LABEL (WINDOWPROP B 'BUTTON-LABEL)))
                B)))])

(MAG-STOCK-APPS-INIT
  [LAMBDA NIL
    (MAG-ACTIVATE-ROOMS-INTERNAL)
    (MAG-SAFE-ACTIVATE-NOTECARDS T)
    (MAG-CREATE-APP-BUTTONS)
    (MAG-START-DOCS-FILEBROWSER)
    T])

(MAG-DOCS-FILEBROWSER-PATTERN
  [LAMBDA NIL
    "{DSK}<home>mag>docs>*"])

(MAG-DOCS-FILEBROWSER-REGION
  [LAMBDA NIL
    (CREATEREGION (IPLUS 16 (IQUOTIENT SCREENWIDTH 2))
                  8
                  (IDIFFERENCE (IQUOTIENT SCREENWIDTH 2) 24)
                  (IQUOTIENT (IDIFFERENCE SCREENHEIGHT 48) 2))])

(MAG-DOCS-FILEBROWSER-OPEN-P
  [LAMBDA NIL
    (for W in (OPENWINDOWS) thereis
      (AND (WINDOWPROP W 'MAG-DOCS-FILEBROWSER)
           W))])

(MAG-DOCS-FILEBROWSER-WORKER
  [LAMBDA NIL
    (NLSETQ (FILESLOAD FILEBROWSER))
    (AND (GETD 'MAG-SLIDES-INSTALL-FILEBROWSER-MENU)
         (NLSETQ (MAG-SLIDES-INSTALL-FILEBROWSER-MENU)))
    (LET ((W (FILEBROWSER (MAG-DOCS-FILEBROWSER-PATTERN)
                          NIL
                          (LIST ':TITLE
                                "Docs"
                                ':REGION
                                (MAG-DOCS-FILEBROWSER-REGION)))))
      (AND W (WINDOWPROP W 'MAG-DOCS-FILEBROWSER T))
      W)])

(MAG-START-DOCS-FILEBROWSER
  [LAMBDA NIL
    (OR (MAG-DOCS-FILEBROWSER-OPEN-P)
        (AND MAG-DOCS-FILEBROWSER-PROCESS
             (PROCESSP MAG-DOCS-FILEBROWSER-PROCESS))
        (SETQ MAG-DOCS-FILEBROWSER-PROCESS
              (ADD.PROCESS (LIST (FUNCTION MAG-DOCS-FILEBROWSER-WORKER))
                           'NAME
                           'MAG-DOCS-FILEBROWSER
                           'RESTARTABLE
                           'YES)))])

(MAG-CREATE-APP-BUTTONS
  [LAMBDA NIL
    (NLSETQ (FILESLOAD BUTTONS))
    (AND (GETD 'CREATE-BUTTON)
         (PROGN
           (MAG-CREATE-DOC-BUTTONS)
           (MAG-CREATE-FEATURE-BUTTONS)))])

(MAG-SHOW-DOC
  [LAMBDA (URL)
    (ShellBrowse URL)])

(MAG-CREATE-LABEL
  [LAMBDA (TEXT CENTERX BOTTOMY)
    (LET* ((DS (DSPCREATE))
           (FONT (DSPFONT '(HELVETICA 18 BOLD) DS))
           (SR (STRINGREGION TEXT DS))
           (BMW (fetch (REGION WIDTH) of SR))
           (BMH (IPLUS (fetch (REGION HEIGHT) of SR)
                       (fetch (REGION BOTTOM) of SR)))
           (BM (BITMAPCREATE BMW BMH))
           (POS (create POSITION
                        XCOORD _ (IDIFFERENCE CENTERX (IQUOTIENT BMW 2))
                        YCOORD _ BOTTOMY))
           IW)
      (DSPDESTINATION BM DS)
      (PRIN1 TEXT DS)
      (SETQ IW (ICONW BM BM POS))
      (WINDOWPROP IW 'ICONLABEL TEXT)
      IW)])

(MAG-CREATE-DOC-BUTTONS
  [LAMBDA NIL
    (PROG ((RIGHT 140)
           (Y 225)
           (DY 55)
           DOCS B)
      (SETQ DOCS '(("https://interlisp.org/docs/medley/orientation/" "BASICS")
                   ("https://primer.interlisp.org/" "PRIMER")
                   ("https://interlisp.org/documentation/IRM.pdf" "MANUAL")
                   ("https://interlisp.org/documentation/Notecards-User-Guide-v2.0.pdf" "NOTECARDS")
                   ("https://interlisp.org/documentation/ROOMSTECHDESC.pdf" "ROOMS")))
      (OR (MAG-FIND-BUTTON "BASICS")
          (MAG-CREATE-LABEL "DOCUMENTATION"
                            (IDIFFERENCE SCREENWIDTH
                                         (IDIFFERENCE RIGHT 50))
                            (IDIFFERENCE SCREENHEIGHT Y)))
      (for DOC in DOCS do
        (SETQ Y (IPLUS Y DY))
        (OR (MAG-FIND-BUTTON (CADR DOC))
            (PROGN
              (SETQ B (CREATE-BUTTON (LIST 'MAG-SHOW-DOC (CAR DOC))
                                      (CADR DOC)
                                      (create POSITION
                                              XCOORD _ (IDIFFERENCE SCREENWIDTH RIGHT)
                                              YCOORD _ (IDIFFERENCE SCREENHEIGHT Y))))
              (WINDOWPROP B 'MAG-BUTTON 'DOC))))
      (RETURN T))])

(MAG-CREATE-FEATURE-BUTTONS
  [LAMBDA NIL
    (PROG ((RIGHT 140)
           (Y 555)
           (DY 55)
           ANY)
      (COND
        ((NOT (AND (BOUNDP 'MAG-ROOMS-ACTIVATED) MAG-ROOMS-ACTIVATED))
         (SETQ ANY T)
         (OR (MAG-FIND-BUTTON "ROOMS")
             (CREATE-BUTTON '(MAG-ACTIVATE-ROOMS)
                            "ROOMS"
                            (create POSITION
                                    XCOORD _ (IDIFFERENCE SCREENWIDTH RIGHT)
                                    YCOORD _ (IDIFFERENCE SCREENHEIGHT
                                                          (SETQ Y (IPLUS Y DY))))))))
      (COND
        ((NOT (AND (BOUNDP 'MAG-NOTECARDS-ACTIVATED) MAG-NOTECARDS-ACTIVATED))
         (SETQ ANY T)
         (OR (MAG-FIND-BUTTON "NOTECARDS")
             (CREATE-BUTTON '(MAG-ACTIVATE-NOTECARDS)
                            "NOTECARDS"
                            (create POSITION
                                    XCOORD _ (IDIFFERENCE SCREENWIDTH RIGHT)
                                    YCOORD _ (IDIFFERENCE SCREENHEIGHT
                                                          (SETQ Y (IPLUS Y DY))))))))
      (OR (MAG-FIND-BUTTON "SLIDES")
          (CREATE-BUTTON '(MAG-SLIDES)
                         "SLIDES"
                         (create POSITION
                                 XCOORD _ (IDIFFERENCE SCREENWIDTH RIGHT)
                                 YCOORD _ (IDIFFERENCE SCREENHEIGHT
                                                       (SETQ Y (IPLUS Y DY))))))
      (AND ANY
           (NOT (MAG-FIND-BUTTON "ROOMS"))
           (MAG-CREATE-LABEL "ACTIVATE"
                             (IDIFFERENCE SCREENWIDTH
                                          (IDIFFERENCE RIGHT 50))
                             (IDIFFERENCE SCREENHEIGHT 575)))
      (RETURN T))])
)

STOP
