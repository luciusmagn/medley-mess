         (RETURN (LIST 'TEXT ""))))
      (SETQ TYPE (NTHCHARCODE LINE 1))
      (COND
        ((EQ TYPE 46)
         (RETURN NIL)))
      (SETQ REST (OR (SUBSTRING LINE 2 (NCHARS LINE)) ""))
      (SETQ FIELDS (MAG-GOPHER-SPLIT-TABS REST))
      (SETQ LABEL (OR (CAR FIELDS) ""))
      (SETQ SELECTOR (OR (CADR FIELDS) ""))
             (SETQ ITEMHOST (MAG-GOPHER-NONEMPTY (CADDR FIELDS) HOST))
             (SETQ ITEMPORT (MAG-GOPHER-PARSE-INT (CADDDR FIELDS) PORT))
             (COND
               ((EQ TYPE 105)
                (RETURN (LIST 'TEXT LABEL)))
               ((EQ TYPE 51)
                (RETURN (LIST 'TEXT (CONCAT "ERROR: " LABEL))))
               (T
                (RETURN (LIST 'ITEM LABEL TYPE SELECTOR ITEMHOST ITEMPORT)))))])

