(MAG-GOPHER-RPC-KEY
  [LAMBDA (CH)
    (LET ((WINDOW (MAG-GOPHER-ACTIVE-WINDOW)))
      (COND
        ((NULL WINDOW)
         "No active Mag Gopher window")
        (T
         (MAG-GOPHER-HANDLE-KEY WINDOW CH)
