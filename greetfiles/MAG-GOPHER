(MAG-GOPHER-TEST-ENTRIES
  [LAMBDA (COUNT)
    (PROG ((N 1)
           ENTRIES)
    LP
      (COND
        ((IGREATERP N COUNT)
         (RETURN (MAG-GOPHER-ANNOTATE-LABELS (DREVERSE ENTRIES)))))
      (SETQ ENTRIES
            (CONS (LIST 'ITEM
                        (CONCAT "Test directory entry " N)
                        49
                        (CONCAT "/test/" N)
                        "test.local"
                        70)
                  ENTRIES))
      (SETQ N (ADD1 N))
      (GO LP))])

(MAG-GOPHER-RPC-TEST-PAGE
  [LAMBDA NIL
    (MAG-VTERM-ENSURE)
    (PROG ((WINDOW (MAG-GOPHER-ACTIVE-WINDOW))
           PROC)
      (COND
        ((NULL WINDOW)
         (SETQ WINDOW (MAG-GOPHER))))
      (SETQ MAG-GOPHER-LAST-WINDOW WINDOW)
      (COND
        ((SETQ PROC (WINDOWPROP WINDOW 'MAG-GOPHER-PROCESS NIL))
         (MAG-GOPHER-CLOSE-CHANNEL WINDOW NIL)
         (DEL.PROCESS PROC)))
      (WINDOWPROP WINDOW 'TITLE "Mag Gopher Test")
      (WINDOWPROP WINDOW 'MAG-GOPHER-HOST "test.local")
      (WINDOWPROP WINDOW 'MAG-GOPHER-PORT 70)
      (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTOR "")
      (WINDOWPROP WINDOW 'MAG-GOPHER-TYPE 49)
      (WINDOWPROP WINDOW 'MAG-GOPHER-TOP 0)
      (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTED 1)
      (WINDOWPROP WINDOW 'MAG-GOPHER-HISTORY NIL)
      (WINDOWPROP WINDOW 'MAG-GOPHER-FORWARD NIL)
      (WINDOWPROP WINDOW 'MAG-GOPHER-FIND-TEXT NIL)
      (WINDOWPROP WINDOW 'MAG-GOPHER-STATUS "local test page")
      (WINDOWPROP WINDOW 'MAG-GOPHER-ENTRIES (MAG-GOPHER-TEST-ENTRIES 60))
      (MAG-GOPHER-REPAINT WINDOW)
      (RETURN (MAG-GOPHER-STATE-REPORT)))])

(MAG-GOPHER-RPC-SELF-TEST
  [LAMBDA NIL
    (PROG ((OUT (CL:MAKE-STRING-OUTPUT-STREAM))
           WINDOW VISIBLE JUMP STEP N FAIL EXPECTEDSELECTED EXPECTEDTOP
           SELECTED TOP REPAINTS ENTRYDRAWS DRAWINDEX STATUS VIEWPORTREPORT
           LABELREPORT TYPEREPORT)
      (MAG-GOPHER-RPC-TEST-PAGE)
      (SETQ WINDOW (MAG-GOPHER-ACTIVE-WINDOW))
      (COND
        ((NULL WINDOW)
         (RETURN "FAIL no active Mag Gopher window")))
      (SETQ VISIBLE (MAG-GOPHER-VISIBLE-COUNT WINDOW))
      (SETQ JUMP (MAG-GOPHER-VIEW-JUMP WINDOW))
      (MAG-GOPHER-RPC-WRITE-LINE OUT "Mag Gopher self-test")
      (MAG-GOPHER-RPC-WRITE-LINE OUT (CONCAT "visible=" VISIBLE " jump=" JUMP))
      (SETQ VIEWPORTREPORT (MAG-GOPHER-NATIVE-VIEWPORT-REPORT))
      (COND
        ((STRPOS "status=ok" VIEWPORTREPORT)
         (MAG-GOPHER-RPC-WRITE-LINE OUT "ok native viewport report"))
        (T
         (SETQ FAIL T)
         (MAG-GOPHER-RPC-WRITE-LINE OUT
           (CONCAT "FAIL native viewport report "
                   (OR VIEWPORTREPORT "")))))
      (SETQ LABELREPORT (MAG-GOPHER-NATIVE-LABEL-REPORT))
      (COND
        ((STRPOS "status=ok" LABELREPORT)
         (MAG-GOPHER-RPC-WRITE-LINE OUT "ok native label report"))
        (T
         (SETQ FAIL T)
         (MAG-GOPHER-RPC-WRITE-LINE OUT
           (CONCAT "FAIL native label report "
                   (OR LABELREPORT "")))))
      (SETQ TYPEREPORT (MAG-GOPHER-NATIVE-TYPE-REPORT))
      (COND
        ((STRPOS "status=ok" TYPEREPORT)
         (MAG-GOPHER-RPC-WRITE-LINE OUT "ok native type report"))
        (T
         (SETQ FAIL T)
         (MAG-GOPHER-RPC-WRITE-LINE OUT
           (CONCAT "FAIL native type report "
                   (OR TYPEREPORT "")))))
      (WINDOWPROP WINDOW 'MAG-GOPHER-TOP 0)
      (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTED 1)
      (SETQ STEP (MAG-GOPHER-VIEWPORT-STEP WINDOW VISIBLE))
      (COND
        ((AND (CADDDR STEP)
              (EQ (CAR STEP) JUMP)
              (EQ (CADR STEP) (ADD1 VISIBLE))
              (CADDR STEP))
         (MAG-GOPHER-RPC-WRITE-LINE OUT
           (CONCAT "ok native viewport selected=" (CADR STEP)
                   " top=" (CAR STEP))))
        (T
         (SETQ FAIL T)
         (MAG-GOPHER-RPC-WRITE-LINE OUT
           (CONCAT "FAIL native viewport selected=" (CADR STEP)
                   " top=" (CAR STEP)
                   " native=" (CADDDR STEP)))))
      (COND
        ((AND (EQ (MAG-GOPHER-SPECIAL-KEYID 57344) 4)
              (EQ (MAG-GOPHER-SPECIAL-KEYID 57345) 3)
              (EQ (MAG-GOPHER-SPECIAL-KEYID 57346) 1)
              (EQ (MAG-GOPHER-SPECIAL-KEYID 57347) 2))
         (MAG-GOPHER-RPC-WRITE-LINE OUT
           "ok decoder left=4 right=3 up=1 down=2"))
          (T
           (SETQ FAIL T)
           (MAG-GOPHER-RPC-WRITE-LINE OUT
             (CONCAT "FAIL decoder left=" (MAG-GOPHER-SPECIAL-KEYID 57344)
                     " right=" (MAG-GOPHER-SPECIAL-KEYID 57345)
                     " up=" (MAG-GOPHER-SPECIAL-KEYID 57346)
                     " down=" (MAG-GOPHER-SPECIAL-KEYID 57347)))))
        (WINDOWPROP WINDOW 'MAG-GOPHER-TOP 0)
        (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTED 1)
        (MAG-GOPHER-RESET-DRAW-STATS WINDOW)
        (MAG-GOPHER-HANDLE-KEY WINDOW 57347)
        (SETQ REPAINTS (MAG-GOPHER-DRAW-STAT-VALUE
                         WINDOW 'MAG-GOPHER-REPAINT-COUNT))
        (SETQ ENTRYDRAWS (MAG-GOPHER-DRAW-STAT-VALUE
                           WINDOW 'MAG-GOPHER-ENTRY-DRAW-COUNT))
        (SETQ DRAWINDEX (MAG-GOPHER-DRAW-STAT-VALUE
                          WINDOW 'MAG-GOPHER-DRAW-INDEX-COUNT))
        (SETQ SELECTED (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTED))
        (SETQ TOP (WINDOWPROP WINDOW 'MAG-GOPHER-TOP))
        (COND
          ((AND (EQ SELECTED 2)
                (EQ TOP 0)
                (EQ REPAINTS 0)
                (EQ ENTRYDRAWS 2)
                (EQ DRAWINDEX 2))
           (MAG-GOPHER-RPC-WRITE-LINE OUT
             (CONCAT "ok row-redraw repaints=" REPAINTS
                     " entry-draws=" ENTRYDRAWS
                     " draw-index=" DRAWINDEX)))
          (T
           (SETQ FAIL T)
           (MAG-GOPHER-RPC-WRITE-LINE OUT
             (CONCAT "FAIL row-redraw selected=" SELECTED
                     " top=" TOP
                     " repaints=" REPAINTS
                     " entry-draws=" ENTRYDRAWS
                     " draw-index=" DRAWINDEX))))
        (WINDOWPROP WINDOW 'MAG-GOPHER-TOP 0)
        (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTED 1)
        (MAG-GOPHER-RESET-DRAW-STATS WINDOW)
        (SETQ N 0)
      DOWNLOOP
      (COND
        ((ILESSP N VISIBLE)
         (MAG-GOPHER-HANDLE-KEY WINDOW 57347)
         (SETQ N (ADD1 N))
         (GO DOWNLOOP)))
      (SETQ EXPECTEDSELECTED (ADD1 VISIBLE))
      (SETQ EXPECTEDTOP JUMP)
      (SETQ SELECTED (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTED))
      (SETQ TOP (WINDOWPROP WINDOW 'MAG-GOPHER-TOP))
      (COND
        ((AND (EQ SELECTED EXPECTEDSELECTED)
              (EQ TOP EXPECTEDTOP))
         (MAG-GOPHER-RPC-WRITE-LINE OUT
           (CONCAT "ok down selected=" SELECTED " top=" TOP)))
        (T
         (SETQ FAIL T)
         (MAG-GOPHER-RPC-WRITE-LINE OUT
           (CONCAT "FAIL down selected=" SELECTED " top=" TOP
                   " expected-selected=" EXPECTEDSELECTED
                   " expected-top=" EXPECTEDTOP))))
      (WINDOWPROP WINDOW 'MAG-GOPHER-TOP 0)
      (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTED 2)
      (MAG-GOPHER-HANDLE-KEY WINDOW 57346)
      (SETQ SELECTED (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTED))
      (SETQ TOP (WINDOWPROP WINDOW 'MAG-GOPHER-TOP))
      (COND
        ((AND (EQ SELECTED 1)
              (EQ TOP 0))
         (MAG-GOPHER-RPC-WRITE-LINE OUT
           (CONCAT "ok up selected=" SELECTED " top=" TOP)))
        (T
         (SETQ FAIL T)
         (MAG-GOPHER-RPC-WRITE-LINE OUT
           (CONCAT "FAIL up selected=" SELECTED " top=" TOP
                   " expected-selected=1 expected-top=0"))))
      (WINDOWPROP WINDOW 'MAG-GOPHER-ENTRIES
                  (LIST (LIST 'ITEM "Unsupported local test item"
                              57 "/test/bin" "test.local" 70 "zz")))
      (WINDOWPROP WINDOW 'MAG-GOPHER-TOP 0)
      (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTED 1)
      (WINDOWPROP WINDOW 'MAG-GOPHER-STATUS "before-right")
      (MAG-GOPHER-HANDLE-KEY WINDOW 57345)
      (SETQ STATUS (WINDOWPROP WINDOW 'MAG-GOPHER-STATUS))
      (COND
        ((AND STATUS (STRPOS "Unsupported gopher item type" STATUS))
         (MAG-GOPHER-RPC-WRITE-LINE OUT
           (CONCAT "ok right-open status=" STATUS)))
        (T
         (SETQ FAIL T)
         (MAG-GOPHER-RPC-WRITE-LINE OUT
           (CONCAT "FAIL right-open status=" (OR STATUS "")))))
      (WINDOWPROP WINDOW 'MAG-GOPHER-HISTORY NIL)
      (WINDOWPROP WINDOW 'MAG-GOPHER-FORWARD NIL)
      (WINDOWPROP WINDOW 'MAG-GOPHER-STATUS "before-left")
      (MAG-GOPHER-HANDLE-KEY WINDOW 57344)
      (SETQ STATUS (WINDOWPROP WINDOW 'MAG-GOPHER-STATUS))
      (COND
        ((STREQUAL STATUS "No back history")
         (MAG-GOPHER-RPC-WRITE-LINE OUT
           "ok left-back empty-history"))
        (T
         (SETQ FAIL T)
         (MAG-GOPHER-RPC-WRITE-LINE OUT
           (CONCAT "FAIL left-back status=" (OR STATUS "")))))
      (MAG-GOPHER-RPC-TEST-PAGE)
      (MAG-GOPHER-RPC-WRITE-LINE OUT
        "action-map left=back right=open up=previous down=next")
      (MAG-GOPHER-RPC-WRITE-LINE OUT
        (COND (FAIL "status=FAIL") (T "status=ok")))
      (RETURN (CL:GET-OUTPUT-STREAM-STRING OUT)))])

(MAG-GOPHER-PARSE-INT
  [LAMBDA (STR DEFAULT)
    (PROG ((I 1)
           (N 0)
           (LEN (AND STR (NCHARS STR)))
           CH)
      (COND
        ((OR (NULL STR) (EQ LEN 0))
         (RETURN DEFAULT)))
    LP
      (COND
        ((IGREATERP I LEN)
         (RETURN N)))
      (SETQ CH (NTHCHARCODE STR I))
      (COND
        ((AND (IGEQ CH 48) (ILEQ CH 57))
         (SETQ N (IPLUS (ITIMES N 10) (IDIFFERENCE CH 48)))
          (SETQ I (ADD1 I))
          (GO LP))
        (T (RETURN DEFAULT))))])

(MAG-GOPHER-NONEMPTY
  [LAMBDA (STR DEFAULT)
    (COND
      ((AND STR (IGREATERP (NCHARS STR) 0))
       STR)
      (T DEFAULT))])

(MAG-GOPHER-SPLIT-TABS
  [LAMBDA (STR)
    (PROG ((START 1)
           (POS 1)
           (LEN (NCHARS STR))
           PARTS CH)
    LP
      (COND
        ((IGREATERP POS LEN)
         (RETURN (DREVERSE (CONS (OR (SUBSTRING STR START LEN) "")
                                  PARTS)))))
      (SETQ CH (NTHCHARCODE STR POS))
      (COND
        ((EQ CH 9)
         (SETQ PARTS (CONS (OR (SUBSTRING STR START (SUB1 POS)) "")
                           PARTS))
         (SETQ START (ADD1 POS))))
      (SETQ POS (ADD1 POS))
      (GO LP))])

(MAG-GOPHER-WRITE-CHANNEL-STRING
  [LAMBDA (CHAN STR)
    (PROG ((I 1)
           (LEN (AND STR (NCHARS STR))))
    LP
      (COND
        ((NULL STR)
         (RETURN T))
        ((IGREATERP I LEN)
         (RETURN T))
        ((MAG-VTERM-WRITE-BYTES CHAN
                                  (MAG-VTERM-UTF8-BYTES
                                    (NTHCHARCODE STR I)))
         (SETQ I (ADD1 I))
         (GO LP))
        (T
         (RETURN NIL))))])

(MAG-GOPHER-READ-BUFFER
  [LAMBDA (WINDOW)
    (COND
      (WINDOW
       (OR (WINDOWPROP WINDOW 'MAG-GOPHER-READ-BUFFER)
           (WINDOWPROP WINDOW 'MAG-GOPHER-READ-BUFFER (NCREATE 'VMEMPAGEP))))
      (T
       (NCREATE 'VMEMPAGEP)))])

(MAG-GOPHER-NATIVE-VIEWPORT-AVAILABLEP
  [LAMBDA NIL
    (NLSETQ (FILESLOAD UNIXCOMM))
    (LET ((MAXCOMMAND (SUBRCALL UNIX-HANDLECOMM 8)))
      (AND MAXCOMMAND (IGEQ MAXCOMMAND 43)))])

(MAG-GOPHER-NATIVE-VIEWPORT-REPORT
  [LAMBDA NIL
    (NLSETQ (FILESLOAD UNIXCOMM))
    (LET ((MAXCOMMAND (OR (SUBRCALL UNIX-HANDLECOMM 8) 0)))
      (COND
        ((ILESSP MAXCOMMAND 45)
         "mag-gopher-viewport unavailable: rebuild/restart Maiko with UNIX-HANDLECOMM 45")
        (T
         (LET ((BUFFER (NCREATE 'VMEMPAGEP))
               LEN)
           (SETQ LEN (SUBRCALL UNIX-HANDLECOMM 45 BUFFER))
           (COND
             ((AND LEN (IGREATERP LEN 0))
              (MAG-GHOSTTY-BUFFER-STRING BUFFER LEN))
             (T "mag-gopher-viewport unavailable"))))))])

(MAG-GOPHER-U16-LE
  [LAMBDA (BUFFER OFFSET)
    (IPLUS (\GETBASEBYTE BUFFER OFFSET)
           (ITIMES 256 (\GETBASEBYTE BUFFER (ADD1 OFFSET))))])

(MAG-GOPHER-VIEWPORT-FALLBACK
  [LAMBDA (TOP SELECTED DELTA COUNT VISIBLE JUMP)
    (PROG ((OLDTOP TOP)
           MAXTOP)
      (COND
        ((ILESSP VISIBLE 1)
         (SETQ VISIBLE 1)))
      (COND
        ((ILESSP JUMP 1)
         (SETQ JUMP 1)))
      (COND
        ((ILESSP COUNT 1)
         (SETQ TOP 0)
         (SETQ SELECTED 1))
        (T
         (SETQ SELECTED (IPLUS SELECTED DELTA))
         (COND
           ((ILESSP SELECTED 1)
            (SETQ SELECTED 1))
           ((IGREATERP SELECTED COUNT)
            (SETQ SELECTED COUNT)))
         (SETQ MAXTOP (IMAX 0 (IDIFFERENCE COUNT VISIBLE)))
         (SETQ TOP (IMAX 0 (IMIN MAXTOP TOP)))
         (COND
           ((ILEQ SELECTED TOP)
            (SETQ TOP (IMIN (SUB1 SELECTED)
                            (IDIFFERENCE TOP JUMP))))
           ((IGREATERP SELECTED (IPLUS TOP VISIBLE))
            (SETQ TOP (IMAX (IDIFFERENCE SELECTED VISIBLE)
                            (IPLUS TOP JUMP)))))
         (SETQ TOP (IMAX 0 (IMIN MAXTOP TOP)))))
      (RETURN (LIST TOP SELECTED (NEQ TOP OLDTOP) NIL)))])

(MAG-GOPHER-VIEWPORT-STEP
  [LAMBDA (WINDOW DELTA)
    (PROG ((TOP (OR (WINDOWPROP WINDOW 'MAG-GOPHER-TOP) 0))
           (SELECTED (OR (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTED) 1))
           (COUNT (LENGTH (WINDOWPROP WINDOW 'MAG-GOPHER-ENTRIES)))
           (VISIBLE (MAG-GOPHER-VISIBLE-COUNT WINDOW))
           (JUMP (MAG-GOPHER-VIEW-JUMP WINDOW))
           BUFFER LEN)
      (COND
        ((MAG-GOPHER-NATIVE-VIEWPORT-AVAILABLEP)
         (SETQ BUFFER (MAG-GOPHER-READ-BUFFER WINDOW))
         (SETQ LEN (SUBRCALL UNIX-HANDLECOMM 43 TOP SELECTED DELTA
                              COUNT VISIBLE JUMP BUFFER))
         (COND
           ((AND LEN (IGEQ LEN 9))
            (RETURN (LIST (MAG-GOPHER-U16-LE BUFFER 0)
                          (MAG-GOPHER-U16-LE BUFFER 4)
                          (NEQ (\GETBASEBYTE BUFFER 8) 0)
                          T))))))
      (RETURN (MAG-GOPHER-VIEWPORT-FALLBACK TOP SELECTED DELTA
                                            COUNT VISIBLE JUMP)))])

(MAG-GOPHER-UNSTUFF-LINE
  [LAMBDA (LINE)
    (COND
      ((AND LINE
            (IGREATERP (NCHARS LINE) 1)
            (EQ (NTHCHARCODE LINE 1) 46)
            (EQ (NTHCHARCODE LINE 2) 46))
       (SUBSTRING LINE 2))
      (T LINE))])

(MAG-GOPHER-CONTINUATION-BYTEP
  [LAMBDA (BYTE)
    (AND (IGEQ BYTE 128)
         (ILEQ BYTE 191))])

(MAG-GOPHER-DECODE-LINE
  [LAMBDA (LINE)
    (PROG ((OUT (CL:MAKE-STRING-OUTPUT-STREAM))
           (I 1)
           (LEN (AND LINE (NCHARS LINE)))
           BYTE B2 B3 B4 CODE)
      (COND
        ((NULL LINE)
         (RETURN "")))
    LP
      (COND
        ((IGREATERP I LEN)
         (RETURN (CL:GET-OUTPUT-STREAM-STRING OUT))))
      (SETQ BYTE (NTHCHARCODE LINE I))
      (COND
        ((ILESSP BYTE 128)
         (CL:WRITE-CHAR (CL:CODE-CHAR BYTE) OUT)
         (SETQ I (ADD1 I)))
        ((AND (IGEQ BYTE 194)
              (ILEQ BYTE 223)
              (ILEQ (ADD1 I) LEN)
              (MAG-GOPHER-CONTINUATION-BYTEP
                (SETQ B2 (NTHCHARCODE LINE (ADD1 I)))))
         (SETQ CODE (IPLUS (LLSH (LOGAND BYTE 31) 6)
                           (LOGAND B2 63)))
         (CL:WRITE-CHAR (CL:CODE-CHAR CODE) OUT)
         (SETQ I (IPLUS I 2)))
        ((AND (IGEQ BYTE 224)
              (ILEQ BYTE 239)
              (ILEQ (IPLUS I 2) LEN)
              (MAG-GOPHER-CONTINUATION-BYTEP
                (SETQ B2 (NTHCHARCODE LINE (ADD1 I))))
              (MAG-GOPHER-CONTINUATION-BYTEP
                (SETQ B3 (NTHCHARCODE LINE (IPLUS I 2))))
              (OR (NEQ BYTE 224) (IGEQ B2 160))
              (OR (NEQ BYTE 237) (ILESSP B2 160)))
         (SETQ CODE (IPLUS (LLSH (LOGAND BYTE 15) 12)
                           (LLSH (LOGAND B2 63) 6)
                           (LOGAND B3 63)))
         (CL:WRITE-CHAR (CL:CODE-CHAR CODE) OUT)
         (SETQ I (IPLUS I 3)))
        ((AND (IGEQ BYTE 240)
              (ILEQ BYTE 244)
              (ILEQ (IPLUS I 3) LEN)
              (MAG-GOPHER-CONTINUATION-BYTEP
                (SETQ B2 (NTHCHARCODE LINE (ADD1 I))))
              (MAG-GOPHER-CONTINUATION-BYTEP
                (SETQ B3 (NTHCHARCODE LINE (IPLUS I 2))))
              (MAG-GOPHER-CONTINUATION-BYTEP
                (SETQ B4 (NTHCHARCODE LINE (IPLUS I 3))))
              (OR (NEQ BYTE 240) (IGEQ B2 144))
              (OR (NEQ BYTE 244) (ILESSP B2 144)))
         (SETQ CODE (IPLUS (LLSH (LOGAND BYTE 7) 18)
                           (LLSH (LOGAND B2 63) 12)
                           (LLSH (LOGAND B3 63) 6)
                           (LOGAND B4 63)))
         (CL:WRITE-CHAR (CL:CODE-CHAR CODE) OUT)
         (SETQ I (IPLUS I 4)))
        (T
         (CL:WRITE-CHAR (CL:CODE-CHAR BYTE) OUT)
         (SETQ I (ADD1 I))))
      (GO LP))])

(MAG-GOPHER-CLEAN-LINE
  [LAMBDA (LINE)
    (MAG-GOPHER-DECODE-LINE (MAG-GOPHER-UNSTUFF-LINE LINE))])

(MAG-GOPHER-CLOSE-CHANNEL
  [LAMBDA (WINDOW CHAN)
    (LET ((ACTIVE (AND WINDOW (WINDOWPROP WINDOW 'MAG-GOPHER-CHANNEL NIL))))
      (COND
         (ACTIVE (SUBRCALL UNIX-HANDLECOMM 3 ACTIVE 0))
         (CHAN (SUBRCALL UNIX-HANDLECOMM 3 CHAN 0))))])

(MAG-GOPHER-FETCH-RAW
  [LAMBDA (HOST PORT SELECTOR WINDOW)
    (PROG (CHAN CH LINES OUT LINE SEEN SPINS BUFFER LEN I)
      (SETQ CHAN (SUBRCALL UNIX-HANDLECOMM 21
                            (\DTEST HOST 'ONED-ARRAY)
                            (\DTEST PORT 'SMALLP)))
      (COND
        ((NULL CHAN)
         (RETURN (LIST (LIST 'ERROR (CONCAT "Could not connect to "
                                            HOST ":" PORT))))))
      (AND WINDOW (WINDOWPROP WINDOW 'MAG-GOPHER-CHANNEL CHAN))
      (SETQ OUT (CL:MAKE-STRING-OUTPUT-STREAM))
      (SETQ BUFFER (MAG-GOPHER-READ-BUFFER WINDOW))
      (SETQ SPINS 0)
      (COND
        ((NOT (AND (MAG-GOPHER-WRITE-CHANNEL-STRING CHAN SELECTOR)
                   (MAG-VTERM-WRITE-BYTES CHAN '(13 10))))
         (MAG-GOPHER-CLOSE-CHANNEL WINDOW CHAN)
         (RETURN (LIST (LIST 'ERROR "Could not write gopher request")))))
    LP
      (SETQ LEN (SUBRCALL UNIX-HANDLECOMM 9 CHAN BUFFER))
      (COND
        ((EQ LEN T)
         (SETQ SPINS (ADD1 SPINS))
         (COND
           ((IGREATERP SPINS 5000)
            (MAG-GOPHER-CLOSE-CHANNEL WINDOW CHAN)
            (RETURN (LIST (LIST 'ERROR "Timed out reading gopher response")))))
         (BLOCK)
         (GO LP))
        ((NULL LEN)
         (COND
                    (SEEN
                     (SETQ LINE (CL:GET-OUTPUT-STREAM-STRING OUT))
                     (COND
                       ((NOT (STREQUAL LINE "."))
                        (SETQ LINES
                              (CONS (MAG-GOPHER-CLEAN-LINE LINE)
                                    LINES))))))
                  (MAG-GOPHER-CLOSE-CHANNEL WINDOW CHAN)
                  (RETURN (DREVERSE LINES)))
        (T
         (SETQ SPINS 0)
         (SETQ I 0)))
    BYTES
      (COND
        ((IGEQ I LEN)
         (GO LP)))
      (SETQ CH (\GETBASEBYTE BUFFER I))
      (SETQ I (ADD1 I))
      (COND
        ((EQ CH 10)
         (SETQ LINE (CL:GET-OUTPUT-STREAM-STRING OUT))
         (SETQ OUT (CL:MAKE-STRING-OUTPUT-STREAM))
         (SETQ SEEN NIL)
                  (COND
                    ((STREQUAL LINE ".")
                     (MAG-GOPHER-CLOSE-CHANNEL WINDOW CHAN)
                     (RETURN (DREVERSE LINES)))
                    (T
                     (SETQ LINES (CONS (MAG-GOPHER-CLEAN-LINE LINE)
                                        LINES))
                     (GO BYTES))))
        ((EQ CH 13)
         (SETQ SEEN T)
         (GO BYTES))
        (T
         (CL:WRITE-CHAR (CL:CODE-CHAR (LOGAND CH 255)) OUT)
         (SETQ SEEN T)
         (GO BYTES))))])

