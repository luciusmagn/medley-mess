(MAG-GOPHER-SPECIAL-KEYID
  [LAMBDA (CH)
    (MAG-VTERM-SPECIAL-KEYID CH)])

(MAG-GOPHER-HANDLE-SPECIAL-KEY
  [LAMBDA (WINDOW CH)
    (LET ((KEYID (MAG-GOPHER-SPECIAL-KEYID CH)))
      (COND
        ((EQ KEYID 1)
         (MAG-GOPHER-MOVE-SELECTION WINDOW -1)
         T)
        ((EQ KEYID 2)
         (MAG-GOPHER-MOVE-SELECTION WINDOW 1)
         T)
        ((EQ KEYID 3)
         (MAG-GOPHER-OPEN-ENTRY WINDOW (MAG-GOPHER-SELECTED-ENTRY WINDOW))
         T)
        ((EQ KEYID 4)
         (MAG-GOPHER-BACK WINDOW)
         T)
        ((EQ KEYID 5)
         (MAG-GOPHER-HOME WINDOW)
         T)
        ((EQ KEYID 7)
         (MAG-GOPHER-SCROLL WINDOW (IMINUS (MAG-GOPHER-VISIBLE-COUNT WINDOW)))
         T)
        ((EQ KEYID 8)
         (MAG-GOPHER-SCROLL WINDOW (MAG-GOPHER-VISIBLE-COUNT WINDOW))
         T)
        (T NIL)))])

(MAG-GOPHER-CANCEL-LABEL-PREFIX
  [LAMBDA (WINDOW)
    (COND
      ((WINDOWPROP WINDOW 'MAG-GOPHER-LABEL-PREFIX)
       (WINDOWPROP WINDOW 'MAG-GOPHER-LABEL-PREFIX NIL)
       (MAG-GOPHER-DRAW-STATUS-LINE WINDOW)
       T)
      (T NIL))])

(MAG-GOPHER-HANDLE-LABEL-CHAR
  [LAMBDA (WINDOW CH)
    (PROG ((LOW (MAG-GOPHER-LOWER-LETTER CH))
           (PREFIX (WINDOWPROP WINDOW 'MAG-GOPHER-LABEL-PREFIX))
           NEXT INDEX)
      (COND
        ((NULL LOW)
         (RETURN NIL)))
      (SETQ NEXT (CONCAT (OR PREFIX "") (MAG-GOPHER-CHAR-STRING LOW)))
      (SETQ INDEX (MAG-GOPHER-LABEL-INDEX WINDOW NEXT))
      (COND
        (INDEX
         (WINDOWPROP WINDOW 'MAG-GOPHER-LABEL-PREFIX NIL)
         (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTED INDEX)
         (MAG-GOPHER-ENSURE-SELECTION-VISIBLE WINDOW)
         (MAG-GOPHER-OPEN-ENTRY WINDOW (MAG-GOPHER-ENTRY-AT WINDOW INDEX))
         (RETURN T))
        ((MAG-GOPHER-LABEL-PREFIX-P WINDOW NEXT)
         (WINDOWPROP WINDOW 'MAG-GOPHER-LABEL-PREFIX NEXT)
         (MAG-GOPHER-DRAW-STATUS-LINE WINDOW)
         (RETURN T))
        (PREFIX
         (WINDOWPROP WINDOW 'MAG-GOPHER-LABEL-PREFIX NIL)
         (WINDOWPROP WINDOW 'MAG-GOPHER-STATUS (CONCAT "No label " NEXT))
         (MAG-GOPHER-DRAW-STATUS-LINE WINDOW)
         (RETURN T))
        (T
         (RETURN NIL))))])

(MAG-GOPHER-HANDLE-KEY
  [LAMBDA (WINDOW CH)
    (PROG NIL
      (MAG-GOPHER-RECORD-KEY CH)
      (COND
        ((AND (WINDOWPROP WINDOW 'MAG-GOPHER-LABEL-PREFIX)
              (FMEMB CH '(7 8 27 127)))
         (RETURN (MAG-GOPHER-CANCEL-LABEL-PREFIX WINDOW)))
        ((MAG-GOPHER-HANDLE-SPECIAL-KEY WINDOW CH)
         (RETURN T))
        ((MAG-GOPHER-HANDLE-LABEL-CHAR WINDOW CH)
         (RETURN T)))
      (RETURN
        (SELECTQ CH
      ((10 13)
       (MAG-GOPHER-OPEN-ENTRY WINDOW (MAG-GOPHER-SELECTED-ENTRY WINDOW)))
      ((8 127)
       (MAG-GOPHER-SCROLL WINDOW (IMINUS (MAG-GOPHER-VISIBLE-COUNT WINDOW))))
      (32
       (MAG-GOPHER-SCROLL WINDOW (MAG-GOPHER-VISIBLE-COUNT WINDOW)))
      ((47 115)
       (MAG-GOPHER-SEARCH-SELECTED WINDOW))
      ((98 104)
       (MAG-GOPHER-BACK WINDOW))
      (70
       (MAG-GOPHER-FORWARD WINDOW))
      ((103 72)
       (MAG-GOPHER-HOME WINDOW))
      (106
       (MAG-GOPHER-MOVE-SELECTION WINDOW 1))
      (107
       (MAG-GOPHER-MOVE-SELECTION WINDOW -1))
      (111
       (MAG-GOPHER-PROMPT-OPEN WINDOW))
               (117
                (MAG-GOPHER-SHOW-URL WINDOW))
               (99
                (MAG-GOPHER-COPY-URL WINDOW))
               (121
                (MAG-GOPHER-COPY-ITEM-URL WINDOW))
               (112
                (MAG-GOPHER-COPY-PAGE WINDOW))
               (119
                (MAG-GOPHER-SAVE-PAGE WINDOW))
               (100
                (MAG-GOPHER-SAVE-SELECTED WINDOW))
               (118
                (MAG-GOPHER-VIEW-SELECTED-AS-TEXT WINDOW))
               (63
       (MAG-GOPHER-HELP WINDOW))
      (113
       (CLOSEW WINDOW))
      (102
       (MAG-GOPHER-FIND-PROMPT WINDOW))
      (110
       (MAG-GOPHER-FIND-AGAIN WINDOW))
      ((7 27 120)
       (MAG-GOPHER-CANCEL-LOAD WINDOW))
      (114
       (MAG-GOPHER-RELOAD WINDOW))
      NIL)))])

(MAG-GOPHER-TYPEIN
  [LAMBDA (WINDOW)
    (PROG (CH)
      (while (WINDOWPROP WINDOW 'MAG-GOPHER-RUNNING)
        do (OR (TTY.PROCESSP)
               (\WAIT.FOR.TTY))
           (COND
             ((\SYSBUFP)
              (do (SETQ CH (MTOUCODE (\GETKEY)))
                  (MAG-GOPHER-HANDLE-KEY WINDOW CH)
                repeatwhile (\SYSBUFP))))
           (BLOCK))
      (BLOCK))])

(MAG-GOPHER-BUTTONFN
  [LAMBDA (WINDOW)
    (TOTOPW WINDOW)
    (COND
      ((PROCESSP (WINDOWPROP WINDOW 'PROCESS))
       (TTY.PROCESS (WINDOWPROP WINDOW 'PROCESS))))
    (COND
      ((LASTMOUSESTATE MIDDLE)
       (MAG-GOPHER-MENU WINDOW))
      ((LASTMOUSESTATE LEFT)
       (MAG-GOPHER-OPEN-ENTRY WINDOW (MAG-GOPHER-CLICKED-ENTRY WINDOW))))])

(MAG-GOPHER-RESHAPEFN
  [LAMBDA (WINDOW OLDIMAGE IMAGEREGION OLDSCREENREGION)
    (RESHAPEBYREPAINTFN WINDOW OLDIMAGE IMAGEREGION)
    (MAG-GOPHER-REPAINT WINDOW)])

(MAG-GOPHER-CLOSEFN
  [LAMBDA (WINDOW)
    (PROG ((PROC (WINDOWPROP WINDOW 'MAG-GOPHER-PROCESS NIL)))
      (AND (EQ MAG-GOPHER-LAST-WINDOW WINDOW)
           (SETQ MAG-GOPHER-LAST-WINDOW NIL))
      (WINDOWPROP WINDOW 'MAG-GOPHER-RUNNING NIL)
      (MAG-GOPHER-CLOSE-CHANNEL WINDOW NIL)
      (AND PROC (DEL.PROCESS PROC))
      (COND
        ((SETQ PROC (WINDOWPROP WINDOW 'PROCESS NIL))
         (DEL.PROCESS PROC))))])

(MAG-GOPHER
  [LAMBDA NIL
    (MAG-VTERM-ENSURE)
    (PROG ((WINDOW (CREATEW (MAG-CHAT-REGION) "Mag Gopher"))
           INPROC)
      (WINDOWPROP WINDOW 'MAG-GOPHER-STATE T)
      (WINDOWPROP WINDOW 'MAG-GOPHER-RUNNING T)
      (WINDOWPROP WINDOW 'BUTTONEVENTFN (FUNCTION MAG-GOPHER-BUTTONFN))
      (WINDOWPROP WINDOW 'RIGHTBUTTONFN NIL)
      (WINDOWPROP WINDOW 'WINDOWENTRYFN 'GIVE.TTY.PROCESS)
	      (WINDOWPROP WINDOW 'RESHAPEFN (FUNCTION MAG-GOPHER-RESHAPEFN))
	      (WINDOWADDPROP WINDOW 'CLOSEFN (FUNCTION MAG-GOPHER-CLOSEFN))
	      (MODERNWINDOW WINDOW)
      (MAG-WINDOW-SET-BACKGROUND WINDOW)
	      (SETQ MAG-GOPHER-LAST-WINDOW WINDOW)
	      (SETQ INPROC (ADD.PROCESS (LIST (FUNCTION MAG-GOPHER-TYPEIN) WINDOW)
                                'NAME 'MAG-GOPHER-TYPEIN))
      (WINDOWPROP WINDOW 'PROCESS INPROC)
      (TTY.PROCESS INPROC)
      (MAG-GOPHER-START-LOAD WINDOW "gopher.floodgap.com" 70 "" 49 NIL)
      (RETURN WINDOW))])

(MAG-GOPHER-APPLY-BACKGROUND-OPEN-WINDOWS
  [LAMBDA NIL
    (for W in (OPENWINDOWS) do
      (AND (WINDOWPROP W 'MAG-GOPHER-STATE)
           (OPENWP W)
           (CAR (NLSETQ (MAG-GOPHER-REPAINT W)))))
    T])
)

(NLSETQ (MAG-GOPHER-APPLY-BACKGROUND-OPEN-WINDOWS))

