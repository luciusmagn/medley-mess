      ((AND (IGEQ CH 97) (ILEQ CH 102))
       (IPLUS 10 (IDIFFERENCE CH 97)))
      (T NIL))])

(MAG-GOPHER-PERCENT-BYTE
  [LAMBDA (STR I LEN)
    (PROG (HI LO)
      (COND
        ((AND (ILEQ (IPLUS I 2) LEN)
              (EQ (NTHCHARCODE STR I) 37)
              (NEQ (SETQ HI (MAG-GOPHER-HEX-DIGIT
                               (NTHCHARCODE STR (ADD1 I))))
                   NIL)
              (NEQ (SETQ LO (MAG-GOPHER-HEX-DIGIT
                               (NTHCHARCODE STR (IPLUS I 2))))
                   NIL))
         (RETURN (IPLUS (ITIMES 16 HI) LO)))
        (T
         (RETURN NIL))))])

(MAG-GOPHER-WRITE-PERCENT-LITERAL
