      (PRIN1 (CONCAT HOST ":" PORT) WINDOW)
      (DSPFONT PLAIN WINDOW)
      (PRIN1 "  /" WINDOW)
      (PRIN1 SELECTOR WINDOW)
      (DSPFONT PLAIN WINDOW))])

(MAG-GOPHER-DRAW-STATUS-LINE
  [LAMBDA (WINDOW)
    (LET ((PLAIN (DSPFONT NIL WINDOW))
          (BOLD (MAG-GOPHER-BOLD-FONT WINDOW))
          (Y (MAG-WINDOW-ROW-Y WINDOW 1))
          PREFIX STATUS)
      (MAG-WINDOW-CLEAR-LINE WINDOW 1)
      (MOVETO 8 Y WINDOW)
      (DSPFONT BOLD WINDOW)
      (PRIN1 "Keys " WINDOW)
      (DSPFONT PLAIN WINDOW)
      (MAG-GOPHER-DRAW-HINT WINDOW BOLD PLAIN "aa" "open")
      (MAG-GOPHER-DRAW-HINT WINDOW BOLD PLAIN "arrows/j/k" "move")
      (MAG-GOPHER-DRAW-HINT WINDOW BOLD PLAIN "RET/right" "open")
      (MAG-GOPHER-DRAW-HINT WINDOW BOLD PLAIN "left/b" "back")
      (MAG-GOPHER-DRAW-HINT WINDOW BOLD PLAIN "SPC/BS" "page")
      (MAG-GOPHER-DRAW-HINT WINDOW BOLD PLAIN "/" "find")
      (MAG-GOPHER-DRAW-HINT WINDOW BOLD PLAIN "q" "close")
      (SETQ PREFIX (WINDOWPROP WINDOW 'MAG-GOPHER-LABEL-PREFIX))
      (COND
        (PREFIX
         (DSPFONT BOLD WINDOW)
         (PRIN1 "label " WINDOW)
         (DSPFONT PLAIN WINDOW)
         (PRIN1 (CONCAT PREFIX "  ") WINDOW)))
      (SETQ STATUS (WINDOWPROP WINDOW 'MAG-GOPHER-STATUS))
      (COND
        (STATUS
         (DSPFONT BOLD WINDOW)
         (PRIN1 "status " WINDOW)
         (DSPFONT PLAIN WINDOW)
         (PRIN1 STATUS WINDOW)))
      (DSPFONT PLAIN WINDOW))])

(MAG-GOPHER-SET-STATUS
  [LAMBDA (WINDOW STATUS)
    (WINDOWPROP WINDOW 'MAG-GOPHER-STATUS STATUS)
    (AND (OPENWP WINDOW)
         (MAG-GOPHER-DRAW-STATUS-LINE WINDOW))
    STATUS])

(MAG-GOPHER-DRAW-DIVIDER
  [LAMBDA (WINDOW)
    (LET ((Y (IPLUS (MAG-WINDOW-ROW-BOTTOM WINDOW 2)
                    (IQUOTIENT (MAG-WINDOW-LINEHEIGHT WINDOW) 2)))
          (WIDTH (IMAX 1 (IDIFFERENCE (WINDOWPROP WINDOW 'WIDTH) 16))))
      (MAG-WINDOW-CLEAR-LINE WINDOW 2)
      (BLTSHADE BLACKSHADE WINDOW 8 Y WIDTH 1 'REPLACE))])

(MAG-GOPHER-DRAW-CHROME
  [LAMBDA (WINDOW HOST PORT SELECTOR)
    (MAG-GOPHER-DRAW-STAT WINDOW 'MAG-GOPHER-CHROME-DRAW-COUNT)
    (MAG-GOPHER-DRAW-HEADER WINDOW HOST PORT SELECTOR)
    (MAG-GOPHER-DRAW-STATUS-LINE WINDOW)
    (MAG-GOPHER-DRAW-DIVIDER WINDOW)])

(MAG-GOPHER-TYPE-CHAR
  [LAMBDA (TYPE)
    (LET ((OUT (CL:MAKE-STRING-OUTPUT-STREAM)))
      (CL:WRITE-CHAR (CL:CODE-CHAR (OR TYPE 49)) OUT)
      (CL:GET-OUTPUT-STREAM-STRING OUT))])

(MAG-GOPHER-HEX-CHAR
  [LAMBDA (N)
    (COND
      ((ILESSP N 10)
       (IPLUS 48 N))
      (T (IPLUS 55 N)))])

(MAG-GOPHER-URL-SAFE-BYTEP
  [LAMBDA (BYTE)
    (OR (AND (IGEQ BYTE 48) (ILEQ BYTE 57))
        (AND (IGEQ BYTE 65) (ILEQ BYTE 90))
        (AND (IGEQ BYTE 97) (ILEQ BYTE 122))
        (EQ BYTE 45)
        (EQ BYTE 46)
        (EQ BYTE 95)
        (EQ BYTE 126))])

(MAG-GOPHER-WRITE-PERCENT-BYTE
  [LAMBDA (OUT BYTE)
    (CL:WRITE-CHAR (CL:CODE-CHAR 37) OUT)
    (CL:WRITE-CHAR (CL:CODE-CHAR (MAG-GOPHER-HEX-CHAR (LRSH BYTE 4))) OUT)
    (CL:WRITE-CHAR (CL:CODE-CHAR (MAG-GOPHER-HEX-CHAR (LOGAND BYTE 15))) OUT)])

(MAG-GOPHER-URL-ENCODE
  [LAMBDA (TEXT)
    (PROG ((OUT (CL:MAKE-STRING-OUTPUT-STREAM))
           BYTES)
      (COND
        ((NULL TEXT)
         (RETURN "")))
      (for I from 1 to (NCHARS TEXT) do
        (SETQ BYTES (MAG-VTERM-UTF8-BYTES (NTHCHARCODE TEXT I)))
        (for BYTE in BYTES do
          (COND
            ((MAG-GOPHER-URL-SAFE-BYTEP BYTE)
             (CL:WRITE-CHAR (CL:CODE-CHAR BYTE) OUT))
            (T
             (MAG-GOPHER-WRITE-PERCENT-BYTE OUT BYTE)))))
      (RETURN (CL:GET-OUTPUT-STREAM-STRING OUT)))])

(MAG-GOPHER-BUILD-URL
  [LAMBDA (HOST PORT TYPE SELECTOR)
    (CONCAT "gopher://"
            (OR HOST "")
            ":"
            (OR PORT 70)
            "/"
            (MAG-GOPHER-TYPE-CHAR (OR TYPE 49))
            (MAG-GOPHER-URL-ENCODE (OR SELECTOR "")))])

(MAG-GOPHER-CURRENT-URL
  [LAMBDA (WINDOW)
    (MAG-GOPHER-BUILD-URL (WINDOWPROP WINDOW 'MAG-GOPHER-HOST)
                          (WINDOWPROP WINDOW 'MAG-GOPHER-PORT)
                          (WINDOWPROP WINDOW 'MAG-GOPHER-TYPE)
                          (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTOR))])

(MAG-GOPHER-ENTRY-URL
  [LAMBDA (ENTRY)
    (AND ENTRY
         (EQ (CAR ENTRY) 'ITEM)
         (MAG-GOPHER-BUILD-URL (CAR (CDDDDR ENTRY))
                               (CADR (CDDDDR ENTRY))
                               (CADDR ENTRY)
                               (CADDDR ENTRY)))])

(MAG-GOPHER-SHOW-URL
  [LAMBDA (WINDOW)
    (MAG-GOPHER-SET-STATUS WINDOW (MAG-GOPHER-CURRENT-URL WINDOW))])

(MAG-GOPHER-COPY-URL
  [LAMBDA (WINDOW)
    (LET ((URL (MAG-GOPHER-CURRENT-URL WINDOW))
          COPIED)
      (COND
        ((MAG-CLIPBOARD-PUT URL)
         (SETQ COPIED T)
         (MAG-GOPHER-SET-STATUS WINDOW (CONCAT "Copied " URL)))
        (T
         (SETQ COPIED NIL)
         (MAG-GOPHER-SET-STATUS WINDOW
                                "Clipboard copy failed (install xclip?)")))
      COPIED)])

(MAG-GOPHER-COPY-ITEM-URL
  [LAMBDA (WINDOW)
    (LET ((URL (MAG-GOPHER-ENTRY-URL (MAG-GOPHER-SELECTED-ENTRY WINDOW)))
          COPIED)
      (COND
        ((AND URL (MAG-CLIPBOARD-PUT URL))
         (SETQ COPIED T)
         (MAG-GOPHER-SET-STATUS WINDOW (CONCAT "Copied item " URL)))
        (URL
         (SETQ COPIED NIL)
         (MAG-GOPHER-SET-STATUS WINDOW
                     "Clipboard copy failed (install xclip?)"))
        (T
         (SETQ COPIED NIL)
         (MAG-GOPHER-SET-STATUS WINDOW
                     "Selected line has no gopher URL")))
      COPIED)])

(MAG-GOPHER-PAGE-TEXT
  [LAMBDA (WINDOW)
    (PROG ((OUT (CL:MAKE-STRING-OUTPUT-STREAM))
           (ENTRIES (WINDOWPROP WINDOW 'MAG-GOPHER-ENTRIES))
           LINE)
    LP
      (COND
        ((NULL ENTRIES)
         (RETURN (CL:GET-OUTPUT-STREAM-STRING OUT))))
      (SETQ LINE (MAG-GOPHER-ENTRY-TEXT (CAR ENTRIES)))
      (MAG-STRING-OUTPUT LINE OUT)
      (SETQ ENTRIES (CDR ENTRIES))
      (AND ENTRIES (CL:WRITE-CHAR (CL:CODE-CHAR 10) OUT))
      (GO LP))])

(MAG-GOPHER-COPY-PAGE
  [LAMBDA (WINDOW)
    (LET ((TEXT (MAG-GOPHER-PAGE-TEXT WINDOW))
          COPIED)
      (COND
        ((AND TEXT (MAG-CLIPBOARD-PUT TEXT))
         (SETQ COPIED T)
         (MAG-GOPHER-SET-STATUS WINDOW
                     (CONCAT "Copied " (NCHARS TEXT) " chars of page text")))
        (T
         (SETQ COPIED NIL)
         (MAG-GOPHER-SET-STATUS WINDOW
                     "Clipboard copy failed (install xclip?)")))
      COPIED)])

(MAG-GOPHER-WRITE-TEXT-FILE
  [LAMBDA (PATH TEXT)
    (MAG-WRITE-UTF8-TEXT-FILE PATH TEXT)])

(MAG-GOPHER-SAVE-PAGE
  [LAMBDA (WINDOW)
    (LET ((PATH (MAG-PROMPT-LINE "save gopher page file" NIL))
          (TEXT (MAG-GOPHER-PAGE-TEXT WINDOW)))
      (COND
        ((AND PATH (MAG-GOPHER-WRITE-TEXT-FILE PATH TEXT))
         (MAG-GOPHER-SET-STATUS WINDOW
                     (CONCAT "Saved " (NCHARS TEXT) " chars to " PATH)))
        (PATH
         (MAG-GOPHER-SET-STATUS WINDOW
                     (CONCAT "Could not save to " PATH)))))])

(MAG-GOPHER-SAVE-RAW-RESOURCE
  [LAMBDA (HOST PORT SELECTOR PATH WINDOW)
    (PROG (CHAN STREAM BUFFER LEN I SPINS COUNT)
      (COND
        ((OR (NULL PATH) (EQ (NCHARS PATH) 0))
         (RETURN (LIST NIL "No output file"))))
      (SETQ STREAM (CAR (NLSETQ (OPENSTREAM PATH 'OUTPUT 'NEW))))
      (COND
        ((NULL STREAM)
         (RETURN (LIST NIL (CONCAT "Could not open " PATH)))))
      (SETQ CHAN (SUBRCALL UNIX-HANDLECOMM 21
                            (\DTEST HOST 'ONED-ARRAY)
                            (\DTEST PORT 'SMALLP)))
      (COND
        ((NULL CHAN)
         (CLOSEF STREAM)
         (RETURN (LIST NIL (CONCAT "Could not connect to " HOST ":" PORT)))))
      (AND WINDOW (WINDOWPROP WINDOW 'MAG-GOPHER-CHANNEL CHAN))
      (SETQ BUFFER (MAG-GOPHER-READ-BUFFER WINDOW))
      (COND
        ((NOT (AND (MAG-GOPHER-WRITE-CHANNEL-STRING CHAN SELECTOR)
                   (MAG-VTERM-WRITE-BYTES CHAN '(13 10))))
         (MAG-GOPHER-CLOSE-CHANNEL WINDOW CHAN)
         (CLOSEF STREAM)
         (RETURN (LIST NIL "Could not write gopher request"))))
      (SETQ SPINS 0)
      (SETQ COUNT 0)
    RAWREAD
      (SETQ LEN (SUBRCALL UNIX-HANDLECOMM 9 CHAN BUFFER))
      (COND
        ((EQ LEN T)
         (SETQ SPINS (ADD1 SPINS))
         (COND
           ((IGREATERP SPINS 5000)
            (MAG-GOPHER-CLOSE-CHANNEL WINDOW CHAN)
            (CLOSEF STREAM)
            (RETURN (LIST NIL "Timed out reading gopher response"))))
         (BLOCK)
         (GO RAWREAD))
        ((NULL LEN)
         (MAG-GOPHER-CLOSE-CHANNEL WINDOW CHAN)
         (CLOSEF STREAM)
         (RETURN (LIST T COUNT)))
        (T
         (SETQ SPINS 0)
         (SETQ I 0)))
    BYTES
      (COND
        ((IGEQ I LEN)
         (GO RAWREAD)))
      (BOUT STREAM (\GETBASEBYTE BUFFER I))
      (SETQ COUNT (ADD1 COUNT))
      (SETQ I (ADD1 I))
      (GO BYTES))])

(MAG-GOPHER-SAVE-ENTRY
  [LAMBDA (WINDOW ENTRY PATH)
    (PROG (RESULT)
      (COND
        ((OR (NULL ENTRY) (NEQ (CAR ENTRY) 'ITEM))
         (MAG-GOPHER-SET-STATUS WINDOW "Selected line is not downloadable")
         (RETURN NIL)))
      (SETQ RESULT (MAG-GOPHER-SAVE-RAW-RESOURCE
                     (CAR (CDDDDR ENTRY))
                     (CADR (CDDDDR ENTRY))
                     (CADDDR ENTRY)
                     PATH
                     WINDOW))
      (COND
        ((CAR RESULT)
         (MAG-GOPHER-SET-STATUS WINDOW
                     (CONCAT "Downloaded " (CADR RESULT) " bytes to " PATH))
         (RETURN T))
        (T
         (MAG-GOPHER-SET-STATUS WINDOW (CADR RESULT))
         (RETURN NIL))))])

(MAG-GOPHER-SAVE-SELECTED
  [LAMBDA (WINDOW)
    (MAG-GOPHER-SAVE-ENTRY WINDOW
                           (MAG-GOPHER-SELECTED-ENTRY WINDOW)
                           (MAG-PROMPT-LINE "download selected gopher item file" NIL))])

(MAG-GOPHER-VIEW-ENTRY-AS-TEXT
  [LAMBDA (WINDOW ENTRY)
    (COND
      ((AND ENTRY (EQ (CAR ENTRY) 'ITEM))
       (MAG-GOPHER-START-LOAD WINDOW
                              (CAR (CDDDDR ENTRY))
                              (CADR (CDDDDR ENTRY))
                              (CADDDR ENTRY)
                              48
                              T))
      (T
       (MAG-GOPHER-SET-STATUS WINDOW "Selected line is not a gopher item")
       NIL))])

(MAG-GOPHER-VIEW-SELECTED-AS-TEXT
  [LAMBDA (WINDOW)
    (MAG-GOPHER-VIEW-ENTRY-AS-TEXT WINDOW
                                   (MAG-GOPHER-SELECTED-ENTRY WINDOW))])

(MAG-GOPHER-CLAMP-SELECTION
  [LAMBDA (WINDOW)
    (PROG ((COUNT (LENGTH (WINDOWPROP WINDOW 'MAG-GOPHER-ENTRIES)))
           (SELECTED (OR (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTED) 1)))
      (COND
        ((ILESSP COUNT 1)
         (SETQ SELECTED 1))
        ((ILESSP SELECTED 1)
         (SETQ SELECTED 1))
        ((IGREATERP SELECTED COUNT)
         (SETQ SELECTED COUNT)))
      (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTED SELECTED)
      (RETURN SELECTED))])

(MAG-GOPHER-ENSURE-SELECTION-VISIBLE
  [LAMBDA (WINDOW)
    (LET ((STEP (MAG-GOPHER-VIEWPORT-STEP WINDOW 0)))
      (WINDOWPROP WINDOW 'MAG-GOPHER-TOP (CAR STEP))
      (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTED (CADR STEP)))])

(MAG-GOPHER-SELECTED-ENTRY
  [LAMBDA (WINDOW)
    (LET ((ENTRIES (WINDOWPROP WINDOW 'MAG-GOPHER-ENTRIES))
          (SELECTED (MAG-GOPHER-CLAMP-SELECTION WINDOW)))
      (AND ENTRIES (CAR (NTH ENTRIES SELECTED))))])

(MAG-GOPHER-MOVE-SELECTION
  [LAMBDA (WINDOW DELTA)
    (PROG ((OLDSELECTED (MAG-GOPHER-CLAMP-SELECTION WINDOW))
           (OLDTOP (OR (WINDOWPROP WINDOW 'MAG-GOPHER-TOP) 0))
           STEP NEWSELECTED NEWTOP REPAINT)
      (SETQ STEP (MAG-GOPHER-VIEWPORT-STEP WINDOW DELTA))
      (SETQ NEWTOP (CAR STEP))
      (SETQ NEWSELECTED (CADR STEP))
      (SETQ REPAINT (CADDR STEP))
      (WINDOWPROP WINDOW 'MAG-GOPHER-TOP NEWTOP)
      (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTED NEWSELECTED)
      (COND
        (REPAINT
         (MAG-GOPHER-REPAINT WINDOW))
        ((NEQ OLDSELECTED NEWSELECTED)
         (MAG-GOPHER-DRAW-INDEX WINDOW OLDSELECTED)
         (MAG-GOPHER-DRAW-INDEX WINDOW NEWSELECTED))))])

(MAG-GOPHER-FIND-FROM
  [LAMBDA (WINDOW NEEDLE START)
    (PROG ((ENTRIES (WINDOWPROP WINDOW 'MAG-GOPHER-ENTRIES))
           (COUNT (LENGTH (WINDOWPROP WINDOW 'MAG-GOPHER-ENTRIES)))
           (INDEX (OR START 1))
           ENTRY TEXT)
      (COND
        ((OR (NULL NEEDLE) (EQ (NCHARS NEEDLE) 0))
         (RETURN NIL)))
      (COND
        ((ILESSP INDEX 1)
         (SETQ INDEX 1)))
    LP
      (COND
        ((IGREATERP INDEX COUNT)
         (RETURN NIL)))
      (SETQ ENTRY (CAR (NTH ENTRIES INDEX)))
      (SETQ TEXT (AND ENTRY (MAG-GOPHER-ENTRY-TEXT ENTRY)))
      (COND
        ((AND TEXT (STRPOS NEEDLE TEXT))
         (RETURN INDEX)))
      (SETQ INDEX (ADD1 INDEX))
      (GO LP))])

(MAG-GOPHER-FIND-TEXT
  [LAMBDA (WINDOW NEEDLE START)
    (PROG ((COUNT (LENGTH (WINDOWPROP WINDOW 'MAG-GOPHER-ENTRIES)))
           INDEX)
      (COND
        ((OR (NULL NEEDLE) (EQ (NCHARS NEEDLE) 0))
         (MAG-GOPHER-SET-STATUS WINDOW "No find text")
         (RETURN NIL)))
      (WINDOWPROP WINDOW 'MAG-GOPHER-FIND-TEXT NEEDLE)
      (SETQ INDEX (MAG-GOPHER-FIND-FROM WINDOW NEEDLE (OR START 1)))
      (COND
        ((NULL INDEX)
         (SETQ INDEX (MAG-GOPHER-FIND-FROM WINDOW NEEDLE 1))))
      (COND
        (INDEX
         (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTED INDEX)
         (MAG-GOPHER-ENSURE-SELECTION-VISIBLE WINDOW)
         (WINDOWPROP WINDOW 'MAG-GOPHER-STATUS
                     (CONCAT "Found " NEEDLE " at " INDEX "/" COUNT))
         (MAG-GOPHER-REPAINT WINDOW)
         (RETURN INDEX))
        (T
         (MAG-GOPHER-SET-STATUS WINDOW
                     (CONCAT "Not found: " NEEDLE))
         (RETURN NIL))))])

(MAG-GOPHER-FIND-PROMPT
  [LAMBDA (WINDOW)
    (LET ((NEEDLE (MAG-PROMPT-LINE "find in gopher page"
                                   (WINDOWPROP WINDOW 'MAG-GOPHER-FIND-TEXT))))
      (AND NEEDLE
           (MAG-GOPHER-FIND-TEXT WINDOW NEEDLE
                                 (ADD1 (MAG-GOPHER-CLAMP-SELECTION WINDOW)))))])

(MAG-GOPHER-FIND-AGAIN
  [LAMBDA (WINDOW)
    (LET ((NEEDLE (WINDOWPROP WINDOW 'MAG-GOPHER-FIND-TEXT)))
      (COND
        ((AND NEEDLE (IGREATERP (NCHARS NEEDLE) 0))
         (MAG-GOPHER-FIND-TEXT WINDOW NEEDLE
                               (ADD1 (MAG-GOPHER-CLAMP-SELECTION WINDOW))))
        (T
         (MAG-GOPHER-FIND-PROMPT WINDOW))))])

(MAG-GOPHER-REPAINT
  [LAMBDA (WINDOW)
    (PROG ((HOST (OR (WINDOWPROP WINDOW 'MAG-GOPHER-HOST) ""))
           (PORT (OR (WINDOWPROP WINDOW 'MAG-GOPHER-PORT) 70))
           (SELECTOR (OR (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTOR) ""))
           (ENTRIES (OR (WINDOWPROP WINDOW 'MAG-GOPHER-ENTRIES)
                        (LIST (LIST 'TEXT "Loading..."))))
           (TOP (OR (WINDOWPROP WINDOW 'MAG-GOPHER-TOP) 0))
             (VISIBLE (MAG-GOPHER-VISIBLE-COUNT WINDOW))
             SELECTED
             (N 1)
             (DRAWN 0))
        (MAG-GOPHER-DRAW-STAT WINDOW 'MAG-GOPHER-REPAINT-COUNT)
        (SETQ SELECTED (MAG-GOPHER-CLAMP-SELECTION WINDOW))
        (MAG-WINDOW-CLEAR WINDOW)
        (MAG-GOPHER-DRAW-CHROME WINDOW HOST PORT SELECTOR)
        (for ENTRY in ENTRIES do
          (COND
            ((AND (IGEQ N (ADD1 TOP)) (ILESSP DRAWN VISIBLE))
             (MAG-GOPHER-DRAW-ENTRY-LINE WINDOW (IPLUS 3 DRAWN)
                                        ENTRY (EQ N SELECTED))
             (SETQ DRAWN (ADD1 DRAWN))))
          (SETQ N (ADD1 N))))])

(MAG-GOPHER-DRAW-INDEX
  [LAMBDA (WINDOW INDEX)
    (PROG ((TOP (OR (WINDOWPROP WINDOW 'MAG-GOPHER-TOP) 0))
           (VISIBLE (MAG-GOPHER-VISIBLE-COUNT WINDOW))
           ROW ENTRY SELECTED)
      (COND
        ((OR (ILEQ INDEX TOP)
             (IGREATERP INDEX (IPLUS TOP VISIBLE)))
         (RETURN NIL)))
        (SETQ ROW (IPLUS 3 (IDIFFERENCE INDEX (ADD1 TOP))))
        (SETQ ENTRY (MAG-GOPHER-ENTRY-AT WINDOW INDEX))
        (SETQ SELECTED (EQ INDEX (MAG-GOPHER-CLAMP-SELECTION WINDOW)))
        (MAG-GOPHER-DRAW-STAT WINDOW 'MAG-GOPHER-DRAW-INDEX-COUNT)
        (COND
        (ENTRY
         (MAG-GOPHER-DRAW-ENTRY-LINE WINDOW ROW ENTRY SELECTED)
         (RETURN T))
        (T
         (MAG-WINDOW-CLEAR-LINE WINDOW ROW)
         (RETURN NIL))))])

(MAG-GOPHER-MAX-TOP
  [LAMBDA (WINDOW)
    (IMAX 0 (IDIFFERENCE (LENGTH (WINDOWPROP WINDOW 'MAG-GOPHER-ENTRIES))
                         (MAG-GOPHER-VISIBLE-COUNT WINDOW)))])

(MAG-GOPHER-SCROLL
  [LAMBDA (WINDOW DELTA)
    (WINDOWPROP WINDOW 'MAG-GOPHER-TOP
                (IMAX 0 (IMIN (MAG-GOPHER-MAX-TOP WINDOW)
                              (IPLUS (OR (WINDOWPROP WINDOW 'MAG-GOPHER-TOP) 0)
                                      DELTA))))
    (MAG-GOPHER-REPAINT WINDOW)])

(MAG-GOPHER-LOAD
  [LAMBDA (WINDOW HOST PORT SELECTOR TYPE)
    (PROG (RAW ENTRIES RESTORE)
      (SETQ RAW (MAG-GOPHER-FETCH-RAW HOST PORT SELECTOR WINDOW))
      (COND
        ((AND RAW (EQ (CAAR RAW) 'ERROR))
         (SETQ ENTRIES RAW)
         (WINDOWPROP WINDOW 'MAG-GOPHER-STATUS (CADAR RAW)))
        ((EQ TYPE 48)
         (SETQ ENTRIES (MAG-GOPHER-BUILD-TEXT RAW))
         (WINDOWPROP WINDOW 'MAG-GOPHER-STATUS
                     (CONCAT (LENGTH ENTRIES) " text lines")))
        (T
         (SETQ ENTRIES (MAG-GOPHER-ANNOTATE-LABELS
                         (MAG-GOPHER-BUILD-DIRECTORY RAW HOST PORT)))
         (WINDOWPROP WINDOW 'MAG-GOPHER-STATUS
                     (CONCAT (LENGTH ENTRIES) " directory entries"))))
      (WINDOWPROP WINDOW 'MAG-GOPHER-ENTRIES ENTRIES)
      (SETQ RESTORE (WINDOWPROP WINDOW 'MAG-GOPHER-RESTORE-STATE NIL))
      (COND
        (RESTORE
         (WINDOWPROP WINDOW 'MAG-GOPHER-TOP
                     (OR (CAR RESTORE) 0))
         (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTED
                     (OR (CADR RESTORE) 1))))
      (MAG-GOPHER-CLAMP-SELECTION WINDOW)
      (MAG-GOPHER-ENSURE-SELECTION-VISIBLE WINDOW)
      (WINDOWPROP WINDOW 'MAG-GOPHER-PROCESS NIL)
      (AND (OPENWP WINDOW)
           (MAG-GOPHER-REPAINT WINDOW)))])

(MAG-GOPHER-CURRENT-STATE
  [LAMBDA (WINDOW)
    (AND (WINDOWPROP WINDOW 'MAG-GOPHER-HOST)
         (LIST (WINDOWPROP WINDOW 'MAG-GOPHER-HOST)
               (WINDOWPROP WINDOW 'MAG-GOPHER-PORT)
               (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTOR)
               (WINDOWPROP WINDOW 'MAG-GOPHER-TYPE)
               (WINDOWPROP WINDOW 'MAG-GOPHER-TOP)
               (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTED)))])

(MAG-GOPHER-LOAD-STATE
  [LAMBDA (WINDOW STATE)
    (AND STATE
         (PROGN
           (MAG-GOPHER-START-LOAD WINDOW
                                  (CAR STATE)
                                  (CADR STATE)
                                  (CADDR STATE)
                                  (CADDDR STATE)
                                  NIL)
           (WINDOWPROP WINDOW 'MAG-GOPHER-RESTORE-STATE
                       (LIST (OR (CAR (CDDDDR STATE)) 0)
                             (OR (CADR (CDDDDR STATE)) 1)))
           (MAG-GOPHER-REPAINT WINDOW)))])

(MAG-GOPHER-START-LOAD
  [LAMBDA (WINDOW HOST PORT SELECTOR TYPE PUSH)
    (PROG (OLDSTATE PROC)
      (COND
        ((SETQ PROC (WINDOWPROP WINDOW 'MAG-GOPHER-PROCESS NIL))
         (MAG-GOPHER-CLOSE-CHANNEL WINDOW NIL)
         (DEL.PROCESS PROC)))
      (SETQ OLDSTATE (MAG-GOPHER-CURRENT-STATE WINDOW))
      (COND
        ((AND PUSH OLDSTATE)
         (WINDOWPROP WINDOW 'MAG-GOPHER-HISTORY
                     (CONS OLDSTATE
                                    (WINDOWPROP WINDOW 'MAG-GOPHER-HISTORY)))
         (WINDOWPROP WINDOW 'MAG-GOPHER-FORWARD NIL)))
      (WINDOWPROP WINDOW 'MAG-GOPHER-HOST HOST)
      (WINDOWPROP WINDOW 'MAG-GOPHER-PORT PORT)
      (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTOR (OR SELECTOR ""))
      (WINDOWPROP WINDOW 'MAG-GOPHER-TYPE TYPE)
      (WINDOWPROP WINDOW 'MAG-GOPHER-TOP 0)
      (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTED 1)
      (WINDOWPROP WINDOW 'MAG-GOPHER-FIND-TEXT NIL)
      (WINDOWPROP WINDOW 'MAG-GOPHER-STATUS "loading...")
      (WINDOWPROP WINDOW 'MAG-GOPHER-ENTRIES (LIST (LIST 'TEXT "Loading...")))
      (WINDOWPROP WINDOW 'TITLE (CONCAT "Mag Gopher  " HOST ":" PORT))
      (MAG-GOPHER-REPAINT WINDOW)
      (SETQ PROC (ADD.PROCESS (LIST (FUNCTION MAG-GOPHER-LOAD)
                                    WINDOW HOST PORT (OR SELECTOR "") TYPE)
                              'NAME 'MAG-GOPHER-LOAD))
      (WINDOWPROP WINDOW 'MAG-GOPHER-PROCESS PROC))])

(MAG-GOPHER-CANCEL-LOAD
  [LAMBDA (WINDOW)
    (PROG ((PROC (WINDOWPROP WINDOW 'MAG-GOPHER-PROCESS NIL)))
      (MAG-GOPHER-CLOSE-CHANNEL WINDOW NIL)
      (COND
        (PROC
         (DEL.PROCESS PROC)
         (WINDOWPROP WINDOW 'MAG-GOPHER-STATUS "cancelled")
         (WINDOWPROP WINDOW 'MAG-GOPHER-ENTRIES
                     (LIST (LIST 'TEXT "Load cancelled.")))
         (MAG-GOPHER-CLAMP-SELECTION WINDOW)
         (MAG-GOPHER-REPAINT WINDOW)
         (RETURN T))
        (T
         (MAG-GOPHER-SET-STATUS WINDOW "No load in progress")
         (RETURN NIL))))])

(MAG-GOPHER-BACK
  [LAMBDA (WINDOW)
    (LET ((HISTORY (WINDOWPROP WINDOW 'MAG-GOPHER-HISTORY))
          (CURRENT (MAG-GOPHER-CURRENT-STATE WINDOW)))
      (COND
        (HISTORY
         (AND CURRENT
              (WINDOWPROP WINDOW 'MAG-GOPHER-FORWARD
                          (CONS CURRENT
                                (WINDOWPROP WINDOW 'MAG-GOPHER-FORWARD))))
         (WINDOWPROP WINDOW 'MAG-GOPHER-HISTORY (CDR HISTORY))
         (MAG-GOPHER-LOAD-STATE WINDOW (CAR HISTORY)))
        (T
         (MAG-GOPHER-SET-STATUS WINDOW "No back history")
         NIL)))])

(MAG-GOPHER-FORWARD
  [LAMBDA (WINDOW)
    (LET ((FORWARD (WINDOWPROP WINDOW 'MAG-GOPHER-FORWARD))
          (CURRENT (MAG-GOPHER-CURRENT-STATE WINDOW)))
      (COND
        (FORWARD
         (AND CURRENT
              (WINDOWPROP WINDOW 'MAG-GOPHER-HISTORY
                          (CONS CURRENT
                                (WINDOWPROP WINDOW 'MAG-GOPHER-HISTORY))))
         (WINDOWPROP WINDOW 'MAG-GOPHER-FORWARD (CDR FORWARD))
         (MAG-GOPHER-LOAD-STATE WINDOW (CAR FORWARD)))
        (T
         (MAG-GOPHER-SET-STATUS WINDOW "No forward history")
         NIL)))])

(MAG-GOPHER-SEARCH-SELECTOR
  [LAMBDA (ENTRY QUERY)
    (AND ENTRY
         QUERY
         (IGREATERP (NCHARS QUERY) 0)
         (CONCAT (CADDDR ENTRY) (MAG-GOPHER-CHAR-STRING 9) QUERY))])

(MAG-GOPHER-SEARCH-ENTRY
  [LAMBDA (WINDOW ENTRY QUERY)
    (LET ((SELECTOR (MAG-GOPHER-SEARCH-SELECTOR ENTRY QUERY)))
      (AND SELECTOR
           (MAG-GOPHER-START-LOAD WINDOW
                                  (CAR (CDDDDR ENTRY))
                                  (CADR (CDDDDR ENTRY))
                                  SELECTOR
                                  49
                                  T)))])

(MAG-GOPHER-PROMPT-SEARCH
  [LAMBDA (WINDOW ENTRY)
    (LET ((QUERY (MAG-PROMPT-LINE "search query" NIL)))
      (AND QUERY (MAG-GOPHER-SEARCH-ENTRY WINDOW ENTRY QUERY)))])

(MAG-GOPHER-SEARCH-SELECTED
  [LAMBDA (WINDOW)
    (LET ((ENTRY (MAG-GOPHER-SELECTED-ENTRY WINDOW)))
      (COND
        ((AND ENTRY (EQ (CAR ENTRY) 'ITEM) (EQ (CADDR ENTRY) 55))
         (MAG-GOPHER-PROMPT-SEARCH WINDOW ENTRY))
        (T
         (MAG-GOPHER-SET-STATUS WINDOW "Select a FIND item before searching"))))])

(MAG-GOPHER-OPEN-ENTRY
  [LAMBDA (WINDOW ENTRY)
    (COND
      ((AND ENTRY (EQ (CAR ENTRY) 'ITEM))
       (SELECTQ (CADDR ENTRY)
                  ((48 49)
                   (MAG-GOPHER-START-LOAD WINDOW
                                          (CAR (CDDDDR ENTRY))
                                          (CADR (CDDDDR ENTRY))
                                          (CADDDR ENTRY)
                                          (CADDR ENTRY)
                                          T))
                  (55
                   (MAG-GOPHER-PROMPT-SEARCH WINDOW ENTRY))
                  (104
                   (COND
                     ((EQ (STRPOS "URL:gopher://" (CADDDR ENTRY)) 1)
                      (MAG-GOPHER-OPEN-SPEC WINDOW (SUBSTRING (CADDDR ENTRY) 5)))
                     (T
                      (MAG-GOPHER-SET-STATUS WINDOW
                                  (CONCAT "HTML/link target: "
                                          (CADDDR ENTRY))))))
         (105 NIL)
         (PROGN
           (MAG-GOPHER-SET-STATUS WINDOW
                       (CONCAT "Unsupported gopher item type "
                                        (MAG-GOPHER-TYPE-TAG (CADDR ENTRY))
                                        "; use v to view as text or d to download"))))))])

(MAG-GOPHER-INDEX-FROM-Y
  [LAMBDA (WINDOW Y)
    (LET* ((LINEHEIGHT (MAG-GOPHER-LINEHEIGHT WINDOW))
           (ROW (IQUOTIENT (IDIFFERENCE (WINDOWPROP WINDOW 'HEIGHT)
                                        Y)
                           LINEHEIGHT)))
      (IPLUS (OR (WINDOWPROP WINDOW 'MAG-GOPHER-TOP) 0)
             (IDIFFERENCE ROW 3)))])

(MAG-GOPHER-CLICKED-ENTRY
  [LAMBDA (WINDOW)
    (LET ((INDEX (MAG-GOPHER-INDEX-FROM-Y WINDOW (LASTMOUSEY WINDOW)))
          (COUNT (LENGTH (WINDOWPROP WINDOW 'MAG-GOPHER-ENTRIES))))
      (AND (IGREATERP INDEX 0)
           (ILEQ INDEX COUNT)
           (PROGN
             (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTED INDEX)
             (MAG-GOPHER-ENSURE-SELECTION-VISIBLE WINDOW)
             (MAG-GOPHER-SELECTED-ENTRY WINDOW))))])

(MAG-GOPHER-OPEN-SPEC
  [LAMBDA (WINDOW SPEC)
    (PROG (WORK SLASH HOSTPORT COLON HOST PORT RAWSELECTOR SELECTOR TYPE TYPECHAR)
      (COND
        ((OR (NULL SPEC) (EQ (NCHARS SPEC) 0))
         (RETURN NIL)))
      (SETQ WORK (COND
                   ((EQ (STRPOS "URL:gopher://" SPEC) 1)
                    (SUBSTRING SPEC 14))
                   ((EQ (STRPOS "gopher://" SPEC) 1)
                    (SUBSTRING SPEC 10))
                   (T SPEC)))
      (SETQ SLASH (STRPOS "/" WORK))
      (SETQ HOSTPORT (COND
                       (SLASH (SUBSTRING WORK 1 (SUB1 SLASH)))
                       (T WORK)))
      (SETQ RAWSELECTOR (COND
                          (SLASH (OR (SUBSTRING WORK (ADD1 SLASH)) ""))
                          (T "")))
      (SETQ TYPE 49)
      (COND
                 ((AND (IGREATERP (NCHARS RAWSELECTOR) 0)
                       (SETQ TYPECHAR
                             (MAG-GOPHER-TYPE-FROM-CHAR (NTHCHARCODE RAWSELECTOR 1))))
                  (SETQ TYPE TYPECHAR)
                  (SETQ SELECTOR (COND
                                   ((IGREATERP (NCHARS RAWSELECTOR) 1)
                                    (MAG-GOPHER-URL-DECODE
                                      (OR (SUBSTRING RAWSELECTOR 2) "")))
                                   (T ""))))
                 (T
                  (SETQ SELECTOR (MAG-GOPHER-URL-DECODE RAWSELECTOR))))
      (SETQ COLON (STRPOS ":" HOSTPORT))
      (SETQ HOST (COND
                   (COLON (SUBSTRING HOSTPORT 1 (SUB1 COLON)))
                   (T HOSTPORT)))
      (COND
        ((OR (NULL HOST) (EQ (NCHARS HOST) 0))
         (MAG-GOPHER-SET-STATUS WINDOW "Missing gopher host")
         (RETURN NIL)))
      (SETQ PORT (COND
                   (COLON (MAG-GOPHER-PARSE-INT (SUBSTRING HOSTPORT (ADD1 COLON)) 70))
                   (T 70)))
      (MAG-GOPHER-START-LOAD WINDOW HOST PORT SELECTOR TYPE T))])

(MAG-GOPHER-HOME
  [LAMBDA (WINDOW)
    (MAG-GOPHER-START-LOAD WINDOW "gopher.floodgap.com" 70 "" 49 T)])

(MAG-GOPHER-PROMPT-OPEN
  [LAMBDA (WINDOW)
    (LET ((SPEC (MAG-PROMPT-LINE "gopher://host[:port]/selector" NIL)))
      (AND SPEC (MAG-GOPHER-OPEN-SPEC WINDOW SPEC)))])

