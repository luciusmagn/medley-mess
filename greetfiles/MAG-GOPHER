(MAG-GOPHER-URL-DECODE
  [LAMBDA (STR)
    (PROG ((OUT (CL:MAKE-STRING-OUTPUT-STREAM))
           (I 1)
           (LEN (AND STR (NCHARS STR)))
           CH BYTE B2 B3 B4 CODE)
      (COND
        ((NULL STR)
         (RETURN "")))
    LP
      (COND
        ((IGREATERP I LEN)
         (RETURN (CL:GET-OUTPUT-STREAM-STRING OUT))))
      (SETQ CH (NTHCHARCODE STR I))
      (COND
        ((AND (EQ CH 37)
              (NEQ (SETQ BYTE (MAG-GOPHER-PERCENT-BYTE STR I LEN)) NIL))
         (COND
           ((ILESSP BYTE 128)
            (CL:WRITE-CHAR (CL:CODE-CHAR BYTE) OUT))
           ((AND (IGEQ BYTE 194)
                 (ILEQ BYTE 223)
                 (NEQ (SETQ B2 (MAG-GOPHER-PERCENT-BYTE
                                  STR (IPLUS I 3) LEN))
                      NIL)
                 (IGEQ B2 128)
                 (ILEQ B2 191))
            (SETQ CODE (IPLUS (LLSH (LOGAND BYTE 31) 6)
                              (LOGAND B2 63)))
            (CL:WRITE-CHAR (CL:CODE-CHAR CODE) OUT)
            (SETQ I (IPLUS I 3)))
           ((AND (IGEQ BYTE 224)
                 (ILEQ BYTE 239)
                 (NEQ (SETQ B2 (MAG-GOPHER-PERCENT-BYTE
                                  STR (IPLUS I 3) LEN))
                      NIL)
                 (NEQ (SETQ B3 (MAG-GOPHER-PERCENT-BYTE
                                  STR (IPLUS I 6) LEN))
                      NIL)
                 (IGEQ B2 128)
                 (ILEQ B2 191)
                 (IGEQ B3 128)
                 (ILEQ B3 191)
                 (OR (NEQ BYTE 224) (IGEQ B2 160))
                 (OR (NEQ BYTE 237) (ILESSP B2 160)))
            (SETQ CODE (IPLUS (LLSH (LOGAND BYTE 15) 12)
                              (LLSH (LOGAND B2 63) 6)
                              (LOGAND B3 63)))
            (CL:WRITE-CHAR (CL:CODE-CHAR CODE) OUT)
            (SETQ I (IPLUS I 6)))
           ((AND (IGEQ BYTE 240)
                 (ILEQ BYTE 244)
                 (NEQ (SETQ B2 (MAG-GOPHER-PERCENT-BYTE
                                  STR (IPLUS I 3) LEN))
                      NIL)
                 (NEQ (SETQ B3 (MAG-GOPHER-PERCENT-BYTE
                                  STR (IPLUS I 6) LEN))
                      NIL)
                 (NEQ (SETQ B4 (MAG-GOPHER-PERCENT-BYTE
                                  STR (IPLUS I 9) LEN))
                      NIL)
                 (IGEQ B2 128)
                 (ILEQ B2 191)
                 (IGEQ B3 128)
                 (ILEQ B3 191)
                 (IGEQ B4 128)
                 (ILEQ B4 191)
                 (OR (NEQ BYTE 240) (IGEQ B2 144))
                 (OR (NEQ BYTE 244) (ILESSP B2 144)))
            (SETQ CODE (IPLUS (LLSH (LOGAND BYTE 7) 18)
                              (LLSH (LOGAND B2 63) 12)
                              (LLSH (LOGAND B3 63) 6)
                              (LOGAND B4 63)))
            (CL:WRITE-CHAR (CL:CODE-CHAR CODE) OUT)
            (SETQ I (IPLUS I 9)))
           (T
            (MAG-GOPHER-WRITE-PERCENT-LITERAL OUT STR I)))
         (SETQ I (IPLUS I 3))
         (GO LP))
        (T
         (CL:WRITE-CHAR (CL:CODE-CHAR CH) OUT)
         (SETQ I (ADD1 I))
         (GO LP))))])

