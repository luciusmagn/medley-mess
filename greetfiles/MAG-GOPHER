(DEFINE-FILE-INFO PACKAGE "INTERLISP" READTABLE "INTERLISP" BASE 10)

(FILESLOAD RECORD)
(FILESLOAD CHATDECLS)
(RPAQQ MAG-GOPHER-KEY-LOG-ENTRIES NIL)
(RPAQ? MAG-GOPHER-LAST-WINDOW NIL)

(DEFINEQ

(MAG-GOPHER-LINEHEIGHT
  [LAMBDA (WINDOW)
    (MAG-WINDOW-LINEHEIGHT WINDOW)])

(MAG-GOPHER-DRAW-LINE
  [LAMBDA (WINDOW ROW TEXT)
    (MAG-WINDOW-DRAW-LINE WINDOW ROW TEXT)])

(MAG-GOPHER-DRAW-STAT
  [LAMBDA (WINDOW PROP)
    (AND WINDOW
         (WINDOWPROP WINDOW PROP
                     (ADD1 (OR (WINDOWPROP WINDOW PROP) 0))))])

(MAG-GOPHER-DRAW-STAT-VALUE
  [LAMBDA (WINDOW PROP)
    (OR (AND WINDOW (WINDOWPROP WINDOW PROP)) 0)])

(MAG-GOPHER-RESET-DRAW-STATS
  [LAMBDA (WINDOW)
    (AND WINDOW
         (PROGN
           (WINDOWPROP WINDOW 'MAG-GOPHER-REPAINT-COUNT 0)
           (WINDOWPROP WINDOW 'MAG-GOPHER-ENTRY-DRAW-COUNT 0)
           (WINDOWPROP WINDOW 'MAG-GOPHER-DRAW-INDEX-COUNT 0)
           (WINDOWPROP WINDOW 'MAG-GOPHER-CHROME-DRAW-COUNT 0)))
    WINDOW])

(MAG-GOPHER-DRAW-STATS-LINE
  [LAMBDA (WINDOW)
    (CONCAT "repaints=" (MAG-GOPHER-DRAW-STAT-VALUE
                          WINDOW 'MAG-GOPHER-REPAINT-COUNT)
            " entry-draws=" (MAG-GOPHER-DRAW-STAT-VALUE
                              WINDOW 'MAG-GOPHER-ENTRY-DRAW-COUNT)
            " draw-index=" (MAG-GOPHER-DRAW-STAT-VALUE
                             WINDOW 'MAG-GOPHER-DRAW-INDEX-COUNT)
            " chrome-draws=" (MAG-GOPHER-DRAW-STAT-VALUE
                               WINDOW 'MAG-GOPHER-CHROME-DRAW-COUNT))])

(MAG-GOPHER-VISIBLE-COUNT
  [LAMBDA (WINDOW)
    (IMAX 1 (IQUOTIENT (IDIFFERENCE (WINDOWPROP WINDOW 'HEIGHT) 48)
                       (MAG-GOPHER-LINEHEIGHT WINDOW)))])

(MAG-GOPHER-VIEW-JUMP
  [LAMBDA (WINDOW)
    (IMIN 10 (MAG-GOPHER-VISIBLE-COUNT WINDOW))])

(MAG-GOPHER-KEY-LOG-TRIM
  [LAMBDA (ENTRIES COUNT)
    (COND
      ((OR (NULL ENTRIES) (ILEQ COUNT 0))
       NIL)
      (T
       (CONS (CAR ENTRIES)
             (MAG-GOPHER-KEY-LOG-TRIM (CDR ENTRIES) (SUB1 COUNT)))))])

(MAG-GOPHER-RECORD-KEY
  [LAMBDA (CH)
    (LET ((KEYID (MAG-GOPHER-SPECIAL-KEYID CH)))
      (SETQ MAG-GOPHER-KEY-LOG-ENTRIES
            (CONS (LIST CH KEYID)
                  (MAG-GOPHER-KEY-LOG-TRIM MAG-GOPHER-KEY-LOG-ENTRIES 23)))
      CH)])

(MAG-GOPHER-KEY-LOG-LINE
  [LAMBDA (OUT ENTRY)
    (LET ((CH (CAR ENTRY))
          (KEYID (CADR ENTRY)))
      (MAG-STRING-OUTPUT
        (CONCAT "raw=" CH
                " high=" (LRSH CH 8)
                " low=" (LOGAND CH 255)
                " key-id=" (OR KEYID "none"))
        OUT)
      (CL:WRITE-CHAR (CL:CODE-CHAR 10) OUT))])

(MAG-GOPHER-KEY-LOG-REPORT
  [LAMBDA NIL
    (LET ((OUT (CL:MAKE-STRING-OUTPUT-STREAM)))
      (MAG-STRING-OUTPUT "Mag Gopher key log (newest first)" OUT)
      (CL:WRITE-CHAR (CL:CODE-CHAR 10) OUT)
      (COND
        (MAG-GOPHER-KEY-LOG-ENTRIES
         (for ENTRY in MAG-GOPHER-KEY-LOG-ENTRIES do
           (MAG-GOPHER-KEY-LOG-LINE OUT ENTRY)))
        (T
         (MAG-STRING-OUTPUT "no keys recorded" OUT)
         (CL:WRITE-CHAR (CL:CODE-CHAR 10) OUT)))
      (CL:GET-OUTPUT-STREAM-STRING OUT))])

(MAG-GOPHER-RPC-WRITE-LINE
  [LAMBDA (OUT TEXT)
    (MAG-STRING-OUTPUT (OR TEXT "") OUT)
    (CL:WRITE-CHAR (CL:CODE-CHAR 10) OUT)])

(MAG-GOPHER-ACTIVE-WINDOW
  [LAMBDA NIL
    (AND MAG-GOPHER-LAST-WINDOW
         (OPENWP MAG-GOPHER-LAST-WINDOW)
         MAG-GOPHER-LAST-WINDOW)])

(MAG-GOPHER-STATE-REPORT
  [LAMBDA NIL
    (LET ((WINDOW (MAG-GOPHER-ACTIVE-WINDOW)))
      (COND
        ((NULL WINDOW)
         "No active Mag Gopher window")
        (T
         (LET ((OUT (CL:MAKE-STRING-OUTPUT-STREAM))
               (ENTRIES (WINDOWPROP WINDOW 'MAG-GOPHER-ENTRIES)))
           (MAG-GOPHER-RPC-WRITE-LINE OUT "Mag Gopher state")
           (MAG-GOPHER-RPC-WRITE-LINE
             OUT (CONCAT "host=" (OR (WINDOWPROP WINDOW 'MAG-GOPHER-HOST) "")
                         " port=" (OR (WINDOWPROP WINDOW 'MAG-GOPHER-PORT) "")
                         " selector=" (OR (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTOR) "")))
             (MAG-GOPHER-RPC-WRITE-LINE
               OUT (CONCAT "top=" (OR (WINDOWPROP WINDOW 'MAG-GOPHER-TOP) 0)
                           " selected=" (OR (WINDOWPROP WINDOW 'MAG-GOPHER-SELECTED) 0)
                           " visible=" (MAG-GOPHER-VISIBLE-COUNT WINDOW)
                           " line-height=" (MAG-GOPHER-LINEHEIGHT WINDOW)
                           " baseline-pad=" (MAG-WINDOW-BASELINE-PAD-VALUE)
                           " count=" (LENGTH ENTRIES)))
             (MAG-GOPHER-RPC-WRITE-LINE
               OUT (MAG-GOPHER-DRAW-STATS-LINE WINDOW))
             (MAG-GOPHER-RPC-WRITE-LINE
               OUT (CONCAT "history=" (LENGTH (WINDOWPROP WINDOW 'MAG-GOPHER-HISTORY))
                           " forward=" (LENGTH (WINDOWPROP WINDOW 'MAG-GOPHER-FORWARD))
                           " status=" (OR (WINDOWPROP WINDOW 'MAG-GOPHER-STATUS) "")))
             (CL:GET-OUTPUT-STREAM-STRING OUT)))))])

(MAG-GOPHER-DRAW-STATS-REPORT
  [LAMBDA NIL
    (LET ((WINDOW (MAG-GOPHER-ACTIVE-WINDOW)))
      (COND
        ((NULL WINDOW)
         "No active Mag Gopher window")
        (T
         (MAG-GOPHER-DRAW-STATS-LINE WINDOW))))])

(MAG-GOPHER-RPC-RESET-DRAW-STATS
  [LAMBDA NIL
    (LET ((WINDOW (MAG-GOPHER-ACTIVE-WINDOW)))
      (COND
        ((NULL WINDOW)
         "No active Mag Gopher window")
        (T
         (MAG-GOPHER-RESET-DRAW-STATS WINDOW)
         (MAG-GOPHER-DRAW-STATS-LINE WINDOW))))])

(MAG-GOPHER-RPC-CLOSE-ACTIVE
  [LAMBDA NIL
    (LET ((WINDOW (MAG-GOPHER-ACTIVE-WINDOW)))
      (COND
        ((NULL WINDOW)
         "No active Mag Gopher window")
        (T
         (CLOSEW WINDOW)
