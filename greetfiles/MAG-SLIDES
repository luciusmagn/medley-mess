(MAG-SLIDES-NTH-ITEM
  [LAMBDA (ITEMS INDEX)
    (COND
      ((OR (NULL ITEMS) (ILESSP INDEX 0))
       NIL)
      ((EQ INDEX 0)
       (CAR ITEMS))
      (T
       (MAG-SLIDES-NTH-ITEM (CDR ITEMS) (SUB1 INDEX))))])

(MAG-SLIDES-NTH-SLIDE
  [LAMBDA (SLIDES INDEX)
    (COND
      ((OR (NULL SLIDES) (ILEQ INDEX 0))
       NIL)
      ((EQ INDEX 1)
       (CAR SLIDES))
      (T
       (MAG-SLIDES-NTH-SLIDE (CDR SLIDES) (SUB1 INDEX))))])

(MAG-SLIDES-CURRENT-SLIDE
  [LAMBDA (WINDOW)
    (LET ((STATE (MAG-SLIDES-STATE WINDOW)))
      (MAG-SLIDES-NTH-SLIDE (MAG-SLIDES-STATE-SLIDES STATE)
                            (MAG-SLIDES-STATE-INDEX STATE)))])

(MAG-SLIDES-EFFECTIVE-LAYOUT
  [LAMBDA (SLIDE INDEX)
    (OR (MAG-SLIDES-SLIDE-LAYOUT SLIDE)
        (COND ((EQ INDEX 1) 'TITLE)
              (T 'BODY)))])

(MAG-SLIDES-BULLET-LINE-P
  [LAMBDA (LINE)
    (MAG-SLIDES-PREFIX-P "* " LINE)])

(MAG-SLIDES-BULLET-TEXT
  [LAMBDA (LINE)
    (MAG-SLIDES-DROP-PREFIX LINE 2)])

(MAG-SLIDES-SLIDE-REVEAL-COUNT
  [LAMBDA (SLIDE)
    (PROG ((LINES (AND SLIDE (MAG-SLIDES-SLIDE-BODY SLIDE)))
           (COUNT 0))
    LP
      (COND
        ((NULL LINES)
         (RETURN COUNT)))
      (AND (MAG-SLIDES-BULLET-LINE-P (CAR LINES))
           (SETQ COUNT (ADD1 COUNT)))
      (SETQ LINES (CDR LINES))
      (GO LP))])

(MAG-SLIDES-SHELL-QUOTE
  [LAMBDA (TEXT)
    (PROG ((I 1)
           (LEN (AND TEXT (NCHARS TEXT)))
           (OUT "'")
           CH)
      (COND
        ((NULL TEXT)
         (RETURN "''")))
    LP
      (COND
        ((IGREATERP I LEN)
         (RETURN (CONCAT OUT "'"))))
      (SETQ CH (NTHCHARCODE TEXT I))
      (COND
        ((EQ CH 39)
         (RETURN NIL))
        (T
         (SETQ OUT (CONCAT OUT (SUBSTRING TEXT I I)))))
      (SETQ I (ADD1 I))
      (GO LP))])

(MAG-SLIDES-BITMAP-SOURCE-P
  [LAMBDA (PATH)
    (OR (MAG-SLIDES-SUFFIX-P ".magbitmap" PATH)
        (MAG-SLIDES-SUFFIX-P ".bitmap" PATH)
        (MAG-SLIDES-SUFFIX-P ".BITMAP" PATH))])

(MAG-SLIDES-PREPARE-FILE-IMAGES
  [LAMBDA (SOURCE)
    (PROG (QSOURCE COMMAND)
      (COND
        ((NULL SOURCE)
         (RETURN NIL)))
      (SETQ QSOURCE (MAG-SLIDES-SHELL-QUOTE SOURCE))
      (COND
        ((NULL QSOURCE)
         (PROMPTPRINT "Mag Slides source path cannot contain single quotes")
         (RETURN NIL)))
      (SETQ COMMAND
            (CONCAT MAG-SLIDES-EXPORT-COMMAND
                    " prepare "
                    QSOURCE
                    " >/tmp/mag-slides-prepare.log 2>&1"))
      (NLSETQ (ShellCommand COMMAND))
      (RETURN T))])

(MAG-SLIDES-IMAGE-BITMAP-PATH
  [LAMBDA (IMAGE)
    (COND
      ((MAG-SLIDES-BITMAP-SOURCE-P IMAGE)
       IMAGE)
      (T (CONCAT IMAGE ".magbitmap")))])

(MAG-SLIDES-CONVERT-IMAGE
  [LAMBDA (IMAGE)
    (PROG ((BITMAP-PATH (MAG-SLIDES-IMAGE-BITMAP-PATH IMAGE))
           QIMAGE QBITMAP COMMAND)
      (COND
        ((OR (NULL IMAGE) (EQ (NCHARS IMAGE) 0))
         (RETURN NIL))
        ((MAG-SLIDES-BITMAP-SOURCE-P IMAGE)
         (RETURN IMAGE))
        ((INFILEP BITMAP-PATH)
         (RETURN BITMAP-PATH)))
      (SETQ QIMAGE (MAG-SLIDES-SHELL-QUOTE IMAGE))
      (SETQ QBITMAP (MAG-SLIDES-SHELL-QUOTE BITMAP-PATH))
      (COND
        ((OR (NULL QIMAGE) (NULL QBITMAP))
         (PROMPTPRINT "Mag Slides image paths cannot contain single quotes")
         (RETURN NIL)))
      (SETQ COMMAND
            (CONCAT MAG-SLIDES-EXPORT-COMMAND
                    " convert-image "
                    QIMAGE
                    " "
                    QBITMAP
                    " --max-width "
                    MAG-SLIDES-IMAGE-MAX-WIDTH
                    " --max-height "
                    MAG-SLIDES-IMAGE-MAX-HEIGHT
                    " >/tmp/mag-slides-convert.log 2>&1"))
      (NLSETQ (ShellCommand COMMAND))
      (COND
        ((INFILEP BITMAP-PATH)
         (RETURN BITMAP-PATH))
        (T
         (PROMPTPRINT (CONCAT "Mag Slides image conversion failed: " IMAGE))
         (RETURN NIL))))])

(MAG-SLIDES-READ-BITMAP-FILE
  [LAMBDA (PATH)
    (PROG (STREAM BITMAP)
      (SETQ STREAM (CAR (NLSETQ (OPENSTREAM PATH 'INPUT 'OLD))))
      (COND
        ((NULL STREAM)
         (RETURN NIL)))
      (SETQ BITMAP (CAR (NLSETQ (READBITMAP STREAM))))
      (CLOSEF STREAM)
      (RETURN BITMAP))])

(MAG-SLIDES-IMAGE-BITMAP
  [LAMBDA (IMAGE)
    (PROG ((PATH (MAG-SLIDES-CONVERT-IMAGE IMAGE))
           CELL BITMAP)
      (COND
        ((NULL PATH)
         (RETURN NIL)))
      (SETQ CELL (SASSOC PATH MAG-SLIDES-IMAGE-CACHE))
      (COND
        ((AND CELL (CDR CELL))
         (RETURN (CDR CELL))))
      (SETQ BITMAP (MAG-SLIDES-READ-BITMAP-FILE PATH))
      (AND BITMAP
           (SETQ MAG-SLIDES-IMAGE-CACHE
                 (CONS (CONS PATH BITMAP) MAG-SLIDES-IMAGE-CACHE)))
      (RETURN BITMAP))])

(MAG-SLIDES-CLEAR-IMAGE-CACHE
  [LAMBDA NIL
    (SETQ MAG-SLIDES-IMAGE-CACHE NIL)])

(MAG-SLIDES-DRAW-TOP
  [LAMBDA (WINDOW X YTOP FONT TEXT LEADING)
    (PROG (HEIGHT DESCENT BASELINE)
      (COND
        ((OR (NULL FONT) (NULL TEXT))
         (RETURN YTOP)))
      (SETQ HEIGHT (FONTPROP FONT 'HEIGHT))
      (SETQ DESCENT (OR (FONTPROP FONT 'DESCENT) 0))
      (SETQ BASELINE (IDIFFERENCE YTOP (IDIFFERENCE HEIGHT DESCENT)))
      (DSPFONT FONT WINDOW)
      (MOVETO X BASELINE WINDOW)
      (PRIN1 TEXT WINDOW)
      (RETURN (IDIFFERENCE YTOP (IPLUS HEIGHT (OR LEADING 0)))))])

(MAG-SLIDES-WORDS
  [LAMBDA (TEXT)
    (PROG ((I 1)
           (LEN (AND TEXT (NCHARS TEXT)))
           (START NIL)
           (WORDS NIL)
           CH)
      (COND
        ((OR (NULL TEXT) (EQ LEN 0))
         (RETURN NIL)))
    LP
      (COND
        ((IGREATERP I LEN)
         (AND START
              (SETQ WORDS (CONS (SUBSTRING TEXT START LEN) WORDS)))
         (RETURN (DREVERSE WORDS))))
      (SETQ CH (NTHCHARCODE TEXT I))
      (COND
        ((MAG-SLIDES-SPACE-CHAR-P CH)
         (AND START
              (PROGN
                (SETQ WORDS (CONS (SUBSTRING TEXT START (SUB1 I)) WORDS))
                (SETQ START NIL))))
        ((NULL START)
         (SETQ START I)))
      (SETQ I (ADD1 I))
      (GO LP))])

(MAG-SLIDES-WORD-GAP
  [LAMBDA (FONT)
    (IMAX 18 (IQUOTIENT (STRINGWIDTH "M" FONT) 2))])

(MAG-SLIDES-WORDS-WIDTH
  [LAMBDA (TEXT FONT)
    (PROG ((WORDS (MAG-SLIDES-WORDS TEXT))
           (GAP (MAG-SLIDES-WORD-GAP FONT))
           (WIDTH 0)
           FIRST)
      (SETQ FIRST T)
    LP
      (COND
        ((NULL WORDS)
         (RETURN WIDTH)))
      (COND
        (FIRST (SETQ FIRST NIL))
        (T (SETQ WIDTH (IPLUS WIDTH GAP))))
      (SETQ WIDTH (IPLUS WIDTH (STRINGWIDTH (CAR WORDS) FONT)))
      (SETQ WORDS (CDR WORDS))
      (GO LP))])

(MAG-SLIDES-DRAW-TOP-WORDS
  [LAMBDA (WINDOW X YTOP FONT TEXT LEADING)
    (PROG ((WORDS (MAG-SLIDES-WORDS TEXT))
           (GAP (MAG-SLIDES-WORD-GAP FONT))
           HEIGHT DESCENT BASELINE)
      (COND
        ((OR (NULL FONT) (NULL TEXT))
         (RETURN YTOP)))
      (SETQ HEIGHT (FONTPROP FONT 'HEIGHT))
      (SETQ DESCENT (OR (FONTPROP FONT 'DESCENT) 0))
      (SETQ BASELINE (IDIFFERENCE YTOP (IDIFFERENCE HEIGHT DESCENT)))
      (DSPFONT FONT WINDOW)
    LP
      (COND
        ((NULL WORDS)
         (RETURN (IDIFFERENCE YTOP (IPLUS HEIGHT (OR LEADING 0))))))
      (MOVETO X BASELINE WINDOW)
      (PRIN1 (CAR WORDS) WINDOW)
      (SETQ X (IPLUS X (STRINGWIDTH (CAR WORDS) FONT) GAP))
      (SETQ WORDS (CDR WORDS))
      (GO LP))])

(MAG-SLIDES-CENTER-X
  [LAMBDA (WINDOW FONT TEXT)
    (IMAX MAG-SLIDES-MARGIN-X
          (IQUOTIENT (IDIFFERENCE (WINDOWPROP WINDOW 'WIDTH)
                                  (STRINGWIDTH (OR TEXT "") FONT))
                     2))])

(MAG-SLIDES-DRAW-TOP-CENTER
  [LAMBDA (WINDOW YTOP FONT TEXT LEADING)
    (MAG-SLIDES-DRAW-TOP WINDOW
                         (MAG-SLIDES-CENTER-X WINDOW FONT TEXT)
                         YTOP
                         FONT
                         TEXT
                         LEADING)])

(MAG-SLIDES-CENTER-X-WORDS
  [LAMBDA (WINDOW FONT TEXT)
    (IMAX MAG-SLIDES-MARGIN-X
          (IQUOTIENT (IDIFFERENCE (WINDOWPROP WINDOW 'WIDTH)
                                  (MAG-SLIDES-WORDS-WIDTH (OR TEXT "") FONT))
                     2))])

(MAG-SLIDES-DRAW-TOP-CENTER-WORDS
  [LAMBDA (WINDOW YTOP FONT TEXT LEADING)
    (MAG-SLIDES-DRAW-TOP-WORDS WINDOW
                               (MAG-SLIDES-CENTER-X-WORDS WINDOW FONT TEXT)
                               YTOP
                               FONT
                               TEXT
                               LEADING)])

(MAG-SLIDES-DRAW-FOOTER
  [LAMBDA (WINDOW SLIDE INDEX COUNT)
    (PROG ((FONT (MAG-SLIDES-FOOTER-FONT))
           (META (MAG-SLIDES-SLIDE-META SLIDE))
           (PAGE (CONCAT INDEX "/" COUNT))
           X)
      (COND
        ((NULL FONT)
         (RETURN NIL)))
      (DSPFONT FONT WINDOW)
      (AND META
           (PROGN
             (MOVETO MAG-SLIDES-MARGIN-X MAG-SLIDES-FOOTER-Y WINDOW)
             (PRIN1 META WINDOW)))
      (SETQ X (IDIFFERENCE (WINDOWPROP WINDOW 'WIDTH)
                           (IPLUS MAG-SLIDES-MARGIN-X
                                  (STRINGWIDTH PAGE FONT))))
      (MOVETO X MAG-SLIDES-FOOTER-Y WINDOW)
      (PRIN1 PAGE WINDOW)
      T)])

(MAG-SLIDES-TABLE-LINE-P
  [LAMBDA (LINE)
    (AND LINE
         (IGREATERP (NCHARS LINE) 1)
         (EQ (NTHCHARCODE LINE 1) 124))])

(MAG-SLIDES-SPLIT-TABLE-LINE
  [LAMBDA (LINE)
    (PROG ((I 1)
           (START 1)
           (LEN (NCHARS LINE))
           (FIELDS NIL)
           PART)
    LP
      (COND
        ((IGREATERP I LEN)
         (AND (ILEQ START LEN)
              (SETQ FIELDS
                    (CONS (MAG-SLIDES-TRIM (SUBSTRING LINE START LEN))
                          FIELDS)))
         (RETURN (DREVERSE FIELDS))))
      (COND
        ((EQ (NTHCHARCODE LINE I) 124)
         (AND (IGREATERP I START)
              (PROGN
                (SETQ PART (SUBSTRING LINE START (SUB1 I)))
                (SETQ FIELDS (CONS (MAG-SLIDES-TRIM PART) FIELDS))))
         (SETQ START (ADD1 I))))
      (SETQ I (ADD1 I))
      (GO LP))])

(MAG-SLIDES-TAKE-TABLE
  [LAMBDA (LINES)
    (PROG ((ROWS NIL))
    LP
      (COND
        ((AND LINES (MAG-SLIDES-TABLE-LINE-P (CAR LINES)))
         (SETQ ROWS (CONS (MAG-SLIDES-SPLIT-TABLE-LINE (CAR LINES)) ROWS))
         (SETQ LINES (CDR LINES))
         (GO LP)))
      (RETURN (CONS (DREVERSE ROWS) LINES)))])

(MAG-SLIDES-MAX-COLS
  [LAMBDA (ROWS)
    (PROG ((MAX 0))
    LP
      (COND
        ((NULL ROWS)
         (RETURN MAX)))
      (SETQ MAX (IMAX MAX (LENGTH (CAR ROWS))))
      (SETQ ROWS (CDR ROWS))
      (GO LP))])

(MAG-SLIDES-DRAW-TABLE-GRID
  [LAMBDA (WINDOW LEFT RIGHT TOP BOTTOM COLWIDTH COLS)
    (PROG ((I 0) X)
      (DRAWLINE LEFT TOP RIGHT TOP 1 'PAINT WINDOW)
      (DRAWLINE LEFT BOTTOM RIGHT BOTTOM 1 'PAINT WINDOW)
    LP
      (COND
        ((IGREATERP I COLS)
         (RETURN T)))
      (SETQ X (COND
                ((EQ I COLS) RIGHT)
                (T (IPLUS LEFT (ITIMES I COLWIDTH)))))
      (DRAWLINE X TOP X BOTTOM 1 'PAINT WINDOW)
      (SETQ I (ADD1 I))
      (GO LP))])

(MAG-SLIDES-DRAW-TABLE-CELLS
  [LAMBDA (WINDOW ROW FONT LEFT BOTTOM COLWIDTH COLS)
    (PROG ((I 0)
           (HEIGHT (FONTPROP FONT 'HEIGHT))
           (DESCENT (OR (FONTPROP FONT 'DESCENT) 0))
           X TEXT BASELINE)
      (DSPFONT FONT WINDOW)
      (SETQ BASELINE (IPLUS BOTTOM MAG-SLIDES-TABLE-PAD-Y DESCENT))
    LP
      (COND
        ((IGEQ I COLS)
         (RETURN T)))
      (SETQ TEXT (MAG-SLIDES-NTH-ITEM ROW I))
      (AND TEXT
           (PROGN
             (SETQ X (IPLUS LEFT (ITIMES I COLWIDTH) MAG-SLIDES-TABLE-PAD-X))
             (MOVETO X BASELINE WINDOW)
             (PRIN1 TEXT WINDOW)))
      (SETQ I (ADD1 I))
      (GO LP))])

(MAG-SLIDES-DRAW-TABLE
  [LAMBDA (WINDOW ROWS YTOP FONT)
    (PROG ((COLS (MAG-SLIDES-MAX-COLS ROWS))
           (WIDTH (IDIFFERENCE (WINDOWPROP WINDOW 'WIDTH)
                               (ITIMES 2 MAG-SLIDES-MARGIN-X)))
           COLWIDTH ROWHEIGHT LEFT RIGHT TOP BOTTOM)
      (COND
        ((OR (NULL ROWS) (ILEQ COLS 0) (NULL FONT))
         (RETURN YTOP)))
      (SETQ LEFT MAG-SLIDES-MARGIN-X)
      (SETQ RIGHT (IPLUS LEFT WIDTH))
      (SETQ COLWIDTH (IQUOTIENT WIDTH COLS))
      (SETQ ROWHEIGHT (IPLUS (FONTPROP FONT 'HEIGHT)
                             (ITIMES 2 MAG-SLIDES-TABLE-PAD-Y)))
    LP
      (COND
        ((NULL ROWS)
         (RETURN (IDIFFERENCE YTOP MAG-SLIDES-TABLE-GAP))))
      (SETQ TOP YTOP)
      (SETQ BOTTOM (IDIFFERENCE TOP ROWHEIGHT))
      (MAG-SLIDES-DRAW-TABLE-GRID WINDOW LEFT RIGHT TOP BOTTOM COLWIDTH COLS)
      (MAG-SLIDES-DRAW-TABLE-CELLS WINDOW (CAR ROWS) FONT LEFT BOTTOM COLWIDTH COLS)
      (SETQ YTOP BOTTOM)
      (SETQ ROWS (CDR ROWS))
      (GO LP))])

(MAG-SLIDES-ADVANCE-BODY-Y
  [LAMBDA (YTOP FONT LEADING)
    (IDIFFERENCE YTOP (IPLUS (FONTPROP FONT 'HEIGHT) (OR LEADING 0)))])

(MAG-SLIDES-DRAW-BULLET-DOT
  [LAMBDA (WINDOW YTOP FONT)
    (PROG ((SIZE MAG-SLIDES-BULLET-DOT-SIZE)
           (HEIGHT (FONTPROP FONT 'HEIGHT))
           X Y EDGE MID)
      (SETQ X (IPLUS MAG-SLIDES-MARGIN-X MAG-SLIDES-BULLET-DOT-X))
      (SETQ Y (IDIFFERENCE YTOP (IQUOTIENT (IPLUS HEIGHT SIZE) 2)))
      (SETQ EDGE (IMAX 2 (IQUOTIENT SIZE 4)))
      (SETQ MID (IDIFFERENCE SIZE (ITIMES 2 EDGE)))
      (BLTSHADE BLACKSHADE WINDOW (IPLUS X EDGE) Y MID EDGE 'REPLACE)
      (BLTSHADE BLACKSHADE WINDOW X (IPLUS Y EDGE) SIZE MID 'REPLACE)
      (BLTSHADE BLACKSHADE WINDOW (IPLUS X EDGE) (IPLUS Y EDGE MID) MID EDGE 'REPLACE)
      T)])

(MAG-SLIDES-DRAW-BULLET-LINE
  [LAMBDA (WINDOW LINE YTOP FONT)
    (MAG-SLIDES-DRAW-BULLET-DOT WINDOW YTOP FONT)
    (MAG-SLIDES-DRAW-TOP WINDOW
                         (IPLUS MAG-SLIDES-MARGIN-X MAG-SLIDES-BULLET-INDENT)
                         YTOP
                         FONT
                         (MAG-SLIDES-BULLET-TEXT LINE)
                         MAG-SLIDES-BULLET-LEADING)])

(MAG-SLIDES-DRAW-BODY-LINES
  [LAMBDA (WINDOW LINES YTOP REVEAL)
    (PROG ((FONT (MAG-SLIDES-BODY-FONT))
           (SEEN 0)
           TABLE LINE)
    LP
      (COND
        ((NULL LINES)
         (RETURN YTOP)))
      (SETQ LINE (CAR LINES))
      (COND
        ((MAG-SLIDES-TABLE-LINE-P LINE)
         (SETQ TABLE (MAG-SLIDES-TAKE-TABLE LINES))
         (SETQ YTOP (MAG-SLIDES-DRAW-TABLE WINDOW (CAR TABLE) YTOP FONT))
         (SETQ LINES (CDR TABLE)))
        ((MAG-SLIDES-BULLET-LINE-P LINE)
         (SETQ SEEN (ADD1 SEEN))
         (SETQ YTOP
               (COND
                 ((ILEQ SEEN REVEAL)
                  (MAG-SLIDES-DRAW-BULLET-LINE WINDOW LINE YTOP FONT))
                 (T
                  (MAG-SLIDES-ADVANCE-BODY-Y YTOP FONT MAG-SLIDES-BULLET-LEADING))))
         (SETQ LINES (CDR LINES)))
        (T
         (SETQ YTOP
               (MAG-SLIDES-DRAW-TOP WINDOW
                                    MAG-SLIDES-MARGIN-X
                                    YTOP
                                    FONT
                                    LINE
                                    MAG-SLIDES-BODY-LEADING))
         (SETQ LINES (CDR LINES))))
      (GO LP))])

(MAG-SLIDES-DRAW-TITLE-SLIDE
  [LAMBDA (WINDOW SLIDE INDEX COUNT)
    (PROG ((TITLE-FONT (MAG-SLIDES-TITLE-FONT))
           (SUBTITLE-FONT (MAG-SLIDES-SUBTITLE-FONT))
           YTOP)
      (SETQ YTOP (IDIFFERENCE (WINDOWPROP WINDOW 'HEIGHT)
                              (IPLUS MAG-SLIDES-TOP-MARGIN 120)))
      (SETQ YTOP
            (MAG-SLIDES-DRAW-TOP-CENTER-WORDS WINDOW
                                              YTOP
                                              TITLE-FONT
                                              (MAG-SLIDES-SLIDE-TITLE SLIDE)
                                              42))
      (AND (MAG-SLIDES-SLIDE-SUBTITLE SLIDE)
           (MAG-SLIDES-DRAW-TOP-CENTER WINDOW
                                       YTOP
                                       SUBTITLE-FONT
                                       (MAG-SLIDES-SLIDE-SUBTITLE SLIDE)
                                       0))
      (MAG-SLIDES-DRAW-FOOTER WINDOW SLIDE INDEX COUNT))])

(MAG-SLIDES-DRAW-NORMAL-SLIDE
  [LAMBDA (WINDOW SLIDE INDEX COUNT REVEAL)
    (PROG ((TITLE-FONT (MAG-SLIDES-TITLE-FONT))
           YTOP)
      (SETQ YTOP (IDIFFERENCE (WINDOWPROP WINDOW 'HEIGHT)
                              MAG-SLIDES-TOP-MARGIN))
      (SETQ YTOP
            (MAG-SLIDES-DRAW-TOP-WORDS WINDOW
                                       MAG-SLIDES-MARGIN-X
                                       YTOP
                                       TITLE-FONT
                                       (MAG-SLIDES-SLIDE-TITLE SLIDE)
                                       MAG-SLIDES-BODY-GAP))
      (MAG-SLIDES-DRAW-BODY-LINES WINDOW
                                  (MAG-SLIDES-SLIDE-BODY SLIDE)
                                  YTOP
                                  REVEAL)
      (MAG-SLIDES-DRAW-FOOTER WINDOW SLIDE INDEX COUNT))])

(MAG-SLIDES-DRAW-BITMAP-FIT
  [LAMBDA (WINDOW BITMAP LEFT RIGHT TOP BOTTOM)
    (PROG ((WIDTH (BITMAPWIDTH BITMAP))
           (HEIGHT (BITMAPHEIGHT BITMAP))
           (FRAME-WIDTH (IDIFFERENCE RIGHT LEFT))
           (FRAME-HEIGHT (IDIFFERENCE TOP BOTTOM))
           X Y)
      (COND
        ((OR (NULL BITMAP)
             (IGREATERP WIDTH FRAME-WIDTH)
             (IGREATERP HEIGHT FRAME-HEIGHT))
         (RETURN NIL)))
      (SETQ X (IPLUS LEFT (IQUOTIENT (IDIFFERENCE FRAME-WIDTH WIDTH) 2)))
      (SETQ Y (IPLUS BOTTOM (IQUOTIENT (IDIFFERENCE FRAME-HEIGHT HEIGHT) 2)))
      (BITBLT BITMAP 0 0 WINDOW X Y WIDTH HEIGHT 'INPUT 'PAINT)
      (RETURN T))])

(MAG-SLIDES-DRAW-IMAGE-FRAME
  [LAMBDA (WINDOW TOP BOTTOM IMAGE)
    (PROG ((LEFT MAG-SLIDES-MARGIN-X)
           (RIGHT (IDIFFERENCE (WINDOWPROP WINDOW 'WIDTH) MAG-SLIDES-MARGIN-X))
           (FONT (MAG-SLIDES-BODY-FONT))
           MIDY TEXT BITMAP)
      (MAG-WINDOW-FILL-REGION WINDOW
        (CREATEREGION LEFT
                      BOTTOM
                      (IDIFFERENCE RIGHT LEFT)
                      (IDIFFERENCE TOP BOTTOM)))
      (DRAWLINE LEFT TOP RIGHT TOP 2 'PAINT WINDOW)
      (DRAWLINE LEFT BOTTOM RIGHT BOTTOM 2 'PAINT WINDOW)
      (DRAWLINE LEFT TOP LEFT BOTTOM 2 'PAINT WINDOW)
      (DRAWLINE RIGHT TOP RIGHT BOTTOM 2 'PAINT WINDOW)
      (SETQ BITMAP (MAG-SLIDES-IMAGE-BITMAP IMAGE))
      (COND
        ((AND BITMAP
              (MAG-SLIDES-DRAW-BITMAP-FIT WINDOW BITMAP LEFT RIGHT TOP BOTTOM))
         T)
        (T
         (SETQ TEXT (CONCAT "image: " (OR IMAGE "not set")))
         (SETQ MIDY (IQUOTIENT (IPLUS TOP BOTTOM) 2))
         (DSPFONT FONT WINDOW)
         (MOVETO (MAG-SLIDES-CENTER-X WINDOW FONT TEXT) MIDY WINDOW)
         (PRIN1 TEXT WINDOW)))
      T)])

(MAG-SLIDES-DRAW-IMAGE-SLIDE
  [LAMBDA (WINDOW SLIDE INDEX COUNT REVEAL)
    (PROG ((TITLE-FONT (MAG-SLIDES-TITLE-FONT))
           YTOP FRAME-TOP FRAME-BOTTOM)
      (SETQ YTOP (IDIFFERENCE (WINDOWPROP WINDOW 'HEIGHT)
                              MAG-SLIDES-TOP-MARGIN))
      (SETQ YTOP
            (MAG-SLIDES-DRAW-TOP-WORDS WINDOW
                                       MAG-SLIDES-MARGIN-X
                                       YTOP
                                       TITLE-FONT
                                       (MAG-SLIDES-SLIDE-TITLE SLIDE)
                                       MAG-SLIDES-BODY-GAP))
      (SETQ FRAME-TOP YTOP)
      (SETQ FRAME-BOTTOM (IPLUS MAG-SLIDES-FOOTER-Y 80))
      (MAG-SLIDES-DRAW-IMAGE-FRAME WINDOW
                                   FRAME-TOP
                                   FRAME-BOTTOM
                                   (MAG-SLIDES-SLIDE-IMAGE SLIDE))
      (MAG-SLIDES-DRAW-BODY-LINES WINDOW
                                  (MAG-SLIDES-SLIDE-BODY SLIDE)
                                  (IDIFFERENCE FRAME-BOTTOM 35)
                                  REVEAL)
      (MAG-SLIDES-DRAW-FOOTER WINDOW SLIDE INDEX COUNT))])

(MAG-SLIDES-REFRESH
  [LAMBDA (WINDOW)
    (PROG ((STATE (MAG-SLIDES-STATE WINDOW))
           SLIDES INDEX COUNT SLIDE LAYOUT REVEAL)
      (MAG-WINDOW-CLEAR WINDOW)
      (SETQ SLIDES (MAG-SLIDES-STATE-SLIDES STATE))
      (SETQ INDEX (MAG-SLIDES-STATE-INDEX STATE))
      (SETQ REVEAL (MAG-SLIDES-STATE-REVEAL STATE))
      (SETQ COUNT (LENGTH SLIDES))
      (SETQ SLIDE (MAG-SLIDES-CURRENT-SLIDE WINDOW))
      (SETQ LAYOUT (AND SLIDE (MAG-SLIDES-EFFECTIVE-LAYOUT SLIDE INDEX)))
      (COND
        ((NULL SLIDE)
         (MAG-WINDOW-DRAW-LINES WINDOW '("No slides loaded")))
        ((EQ LAYOUT 'TITLE)
         (MAG-SLIDES-DRAW-TITLE-SLIDE WINDOW SLIDE INDEX COUNT))
        ((EQ LAYOUT 'IMAGE)
         (MAG-SLIDES-DRAW-IMAGE-SLIDE WINDOW SLIDE INDEX COUNT REVEAL))
        (T
         (MAG-SLIDES-DRAW-NORMAL-SLIDE WINDOW SLIDE INDEX COUNT REVEAL)))
      T)])

(MAG-SLIDES-GOTO-WITH-REVEAL
  [LAMBDA (WINDOW INDEX REVEAL)
    (PROG ((STATE (MAG-SLIDES-STATE WINDOW))
           SLIDES SOURCE COUNT SLIDE MAXREVEAL)
      (SETQ SLIDES (MAG-SLIDES-STATE-SLIDES STATE))
      (SETQ SOURCE (MAG-SLIDES-STATE-SOURCE STATE))
      (SETQ COUNT (LENGTH SLIDES))
      (SETQ INDEX (IMAX 1 (IMIN COUNT INDEX)))
      (SETQ SLIDE (MAG-SLIDES-NTH-SLIDE SLIDES INDEX))
      (SETQ MAXREVEAL (MAG-SLIDES-SLIDE-REVEAL-COUNT SLIDE))
      (SETQ REVEAL (IMAX 0 (IMIN MAXREVEAL (OR REVEAL 0))))
      (MAG-SLIDES-SET-STATE WINDOW SLIDES INDEX SOURCE REVEAL)
      (MAG-SLIDES-REFRESH WINDOW))])

(MAG-SLIDES-GOTO
  [LAMBDA (WINDOW INDEX)
    (MAG-SLIDES-GOTO-WITH-REVEAL WINDOW INDEX 0)])

(MAG-SLIDES-NEXT
  [LAMBDA (WINDOW)
    (PROG ((STATE (MAG-SLIDES-STATE WINDOW))
           SLIDES INDEX SOURCE SLIDE REVEAL MAXREVEAL)
      (SETQ SLIDES (MAG-SLIDES-STATE-SLIDES STATE))
      (SETQ INDEX (MAG-SLIDES-STATE-INDEX STATE))
      (SETQ SOURCE (MAG-SLIDES-STATE-SOURCE STATE))
      (SETQ SLIDE (MAG-SLIDES-NTH-SLIDE SLIDES INDEX))
      (SETQ REVEAL (MAG-SLIDES-STATE-REVEAL STATE))
      (SETQ MAXREVEAL (MAG-SLIDES-SLIDE-REVEAL-COUNT SLIDE))
      (COND
        ((ILESSP REVEAL MAXREVEAL)
         (MAG-SLIDES-SET-STATE WINDOW SLIDES INDEX SOURCE (ADD1 REVEAL))
         (MAG-SLIDES-REFRESH WINDOW))
        (T
         (MAG-SLIDES-GOTO-WITH-REVEAL WINDOW (ADD1 INDEX) 0))))])

(MAG-SLIDES-PREV
  [LAMBDA (WINDOW)
    (PROG ((STATE (MAG-SLIDES-STATE WINDOW))
           SLIDES INDEX SOURCE REVEAL PREVSLIDE)
      (SETQ SLIDES (MAG-SLIDES-STATE-SLIDES STATE))
      (SETQ INDEX (MAG-SLIDES-STATE-INDEX STATE))
      (SETQ SOURCE (MAG-SLIDES-STATE-SOURCE STATE))
      (SETQ REVEAL (MAG-SLIDES-STATE-REVEAL STATE))
      (COND
        ((IGREATERP REVEAL 0)
         (MAG-SLIDES-SET-STATE WINDOW SLIDES INDEX SOURCE (SUB1 REVEAL))
         (MAG-SLIDES-REFRESH WINDOW))
        (T
         (SETQ PREVSLIDE (MAG-SLIDES-NTH-SLIDE SLIDES (SUB1 INDEX)))
         (MAG-SLIDES-GOTO-WITH-REVEAL WINDOW
                                      (SUB1 INDEX)
                                      (MAG-SLIDES-SLIDE-REVEAL-COUNT PREVSLIDE)))))])

(MAG-SLIDES-RELOAD
  [LAMBDA (WINDOW)
    (PROG ((STATE (MAG-SLIDES-STATE WINDOW))
           SOURCE SLIDES INDEX REVEAL)
      (SETQ SOURCE (MAG-SLIDES-STATE-SOURCE STATE))
      (COND
        ((NULL SOURCE)
         (RETURN (MAG-SLIDES-REFRESH WINDOW))))
      (MAG-SLIDES-PREPARE-FILE-IMAGES SOURCE)
      (SETQ SLIDES (CAR (NLSETQ (MAG-SLIDES-READ-FILE SOURCE))))
      (COND
        ((NULL SLIDES)
         (PROMPTPRINT (CONCAT "Could not reload " SOURCE))
         (RETURN NIL)))
      (SETQ INDEX (IMIN (MAG-SLIDES-STATE-INDEX STATE) (LENGTH SLIDES)))
      (SETQ REVEAL (MAG-SLIDES-STATE-REVEAL STATE))
      (MAG-SLIDES-CLEAR-IMAGE-CACHE)
      (MAG-SLIDES-SET-STATE WINDOW SLIDES INDEX SOURCE REVEAL)
      (MAG-SLIDES-GOTO-WITH-REVEAL WINDOW INDEX REVEAL))])

(MAG-SLIDES-DEFAULT-PDF-PATH
  [LAMBDA (SOURCE)
    (CONCAT SOURCE ".pdf")])

(MAG-SLIDES-EXPORT-PDF-FILE
  [LAMBDA (SOURCE)
    (PROG ((PDF (AND SOURCE (MAG-SLIDES-DEFAULT-PDF-PATH SOURCE)))
           QSOURCE QPDF COMMAND)
      (COND
        ((NULL SOURCE)
         (PROMPTPRINT "Mag Slides has no source file to export")
         (RETURN NIL)))
      (SETQ QSOURCE (MAG-SLIDES-SHELL-QUOTE SOURCE))
      (SETQ QPDF (MAG-SLIDES-SHELL-QUOTE PDF))
      (COND
        ((OR (NULL QSOURCE) (NULL QPDF))
         (PROMPTPRINT "Mag Slides export paths cannot contain single quotes")
         (RETURN NIL)))
      (SETQ COMMAND
            (CONCAT "setsid "
                    MAG-SLIDES-EXPORT-COMMAND
                    " export "
                    QSOURCE
                    " "
                    QPDF
                    " >/tmp/mag-slides-export.log 2>&1 &"))
      (NLSETQ (ShellCommand COMMAND))
      (PROMPTPRINT (CONCAT "Mag Slides PDF export started: " PDF))
      (RETURN PDF))])

(MAG-SLIDES-EXPORT-PDF
  [LAMBDA (WINDOW)
    (LET ((STATE (MAG-SLIDES-STATE WINDOW)))
      (MAG-SLIDES-EXPORT-PDF-FILE (MAG-SLIDES-STATE-SOURCE STATE)))])

(MAG-SLIDES-HELP
  [LAMBDA (WINDOW)
    (MAG-WINDOW-DRAW-LINES
      WINDOW
      '("Mag Slides"
        ""
        "Source format:"
        "  --- separates slides"
        "  @layout title | body | image"
        "  # title"
        "  ## subtitle or @subtitle text"
        "  @meta footer text in the lower-left corner"
        "  @image /path/to/file imports a native 1-bit bitmap"
        "  - bullet point"
        "  | cell | cell | draws a simple table"
        ""
        "Fonts:"
        "  Title: TimesRomanD 72"
        "  Title subtitle: Classic 48"
        "  Body bullets: TimesRoman 36"
        "  Footer/page number: TimesRoman 18"
        ""
        "Keys: right/down/space/n reveal or next, left/up/backspace/p previous, r reload, q close"
        "Menu: Export PDF renders through Medley screenshots into source.mag.pdf"))])

(MAG-SLIDES-MENU
  [LAMBDA (WINDOW)
    (SELECTQ (MENU (create MENU
             ITEMS _ '(("Next" NEXT "Advance one slide")
                       ("Previous" PREV "Go back one slide")
                       ("Reload" RELOAD "Reload source file")
                       ("Export PDF" EXPORT "Render the deck to a PDF")
                       ("Help" HELP "Show Mag Slides controls")
                       ("Close" CLOSE "Close this presentation"))))
      (NEXT (MAG-SLIDES-NEXT WINDOW))
      (PREV (MAG-SLIDES-PREV WINDOW))
      (RELOAD (MAG-SLIDES-RELOAD WINDOW))
      (EXPORT (MAG-SLIDES-EXPORT-PDF WINDOW))
      (HELP (MAG-SLIDES-HELP WINDOW))
      (CLOSE (CLOSEW WINDOW))
      NIL)])

(MAG-SLIDES-HANDLE-SPECIAL-KEY
  [LAMBDA (WINDOW CH)
    (LET ((KEYID (AND (GETD 'MAG-VTERM-SPECIAL-KEYID)
                      (MAG-VTERM-SPECIAL-KEYID CH))))
      (COND
        ((EQ KEYID 1)
         (MAG-SLIDES-PREV WINDOW)
         T)
        ((EQ KEYID 2)
         (MAG-SLIDES-NEXT WINDOW)
         T)
        ((EQ KEYID 3)
         (MAG-SLIDES-NEXT WINDOW)
         T)
        ((EQ KEYID 4)
         (MAG-SLIDES-PREV WINDOW)
         T)
        ((EQ KEYID 7)
         (MAG-SLIDES-PREV WINDOW)
         T)
        ((EQ KEYID 8)
         (MAG-SLIDES-NEXT WINDOW)
         T)
        (T NIL)))])

(MAG-SLIDES-HANDLE-KEY
  [LAMBDA (WINDOW CH)
    (OR (MAG-SLIDES-HANDLE-SPECIAL-KEY WINDOW CH)
        (SELECTQ CH
          ((10 13 32 110)
           (MAG-SLIDES-NEXT WINDOW))
          ((8 127 112)
           (MAG-SLIDES-PREV WINDOW))
          (114
           (MAG-SLIDES-RELOAD WINDOW))
          ((63 104)
           (MAG-SLIDES-HELP WINDOW))
          ((27 113)
           (CLOSEW WINDOW))
          NIL))])

(MAG-SLIDES-TYPEIN
  [LAMBDA (WINDOW)
    (PROG (CH)
      (while (WINDOWPROP WINDOW 'MAG-SLIDES-RUNNING)
        do (OR (TTY.PROCESSP)
               (\WAIT.FOR.TTY))
           (COND
             ((\SYSBUFP)
              (do (SETQ CH (MTOUCODE (\GETKEY)))
                  (MAG-SLIDES-HANDLE-KEY WINDOW CH)
                repeatwhile (\SYSBUFP))))
           (BLOCK))
      (BLOCK))])

(MAG-SLIDES-BUTTONFN
  [LAMBDA (WINDOW)
    (TOTOPW WINDOW)
    (COND
      ((PROCESSP (WINDOWPROP WINDOW 'PROCESS))
       (TTY.PROCESS (WINDOWPROP WINDOW 'PROCESS))))
    (COND
      ((LASTMOUSESTATE MIDDLE)
       (MAG-SLIDES-MENU WINDOW))
      ((LASTMOUSESTATE RIGHT)
       (MAG-SLIDES-REFRESH WINDOW))
      ((LASTMOUSESTATE LEFT)
       T))])

(MAG-SLIDES-RESHAPEFN
  [LAMBDA (WINDOW OLDIMAGE IMAGEREGION OLDSCREENREGION)
    (RESHAPEBYREPAINTFN WINDOW OLDIMAGE IMAGEREGION)
    (MAG-SLIDES-REFRESH WINDOW)])

(MAG-SLIDES-CLOSEFN
  [LAMBDA (WINDOW)
    (PROG ((PROC (WINDOWPROP WINDOW 'PROCESS NIL)))
      (AND (EQ MAG-SLIDES-LAST-WINDOW WINDOW)
           (SETQ MAG-SLIDES-LAST-WINDOW NIL))
      (WINDOWPROP WINDOW 'MAG-SLIDES-RUNNING NIL)
      (AND PROC (DEL.PROCESS PROC)))])

(MAG-SLIDES-OPEN
  [LAMBDA (SLIDES SOURCE)
    (MAG-VTERM-ENSURE)
    (PROG (WINDOW INPROC)
      (MAG-SLIDES-CLEAR-IMAGE-CACHE)
      (AND MAG-SLIDES-LAST-WINDOW
           (OPENWP MAG-SLIDES-LAST-WINDOW)
           (NLSETQ (CLOSEW MAG-SLIDES-LAST-WINDOW)))
      (SETQ WINDOW (CREATEW (CREATEREGION 0
                                           0
                                           SCREENWIDTH
                                           SCREENHEIGHT)
                             "Mag Slides"))
      (MAG-SLIDES-SET-STATE WINDOW SLIDES 1 SOURCE 0)
      (WINDOWPROP WINDOW 'MAG-SLIDES-RUNNING T)
      (WINDOWPROP WINDOW 'BUTTONEVENTFN (FUNCTION MAG-SLIDES-BUTTONFN))
      (WINDOWPROP WINDOW 'RIGHTBUTTONFN NIL)
      (WINDOWPROP WINDOW 'WINDOWENTRYFN 'GIVE.TTY.PROCESS)
      (WINDOWPROP WINDOW 'RESHAPEFN (FUNCTION MAG-SLIDES-RESHAPEFN))
      (WINDOWADDPROP WINDOW 'CLOSEFN (FUNCTION MAG-SLIDES-CLOSEFN))
      (MODERNWINDOW WINDOW)
      (MAG-WINDOW-SET-BACKGROUND WINDOW)
      (SETQ MAG-SLIDES-LAST-WINDOW WINDOW)
      (SETQ INPROC (ADD.PROCESS (LIST (FUNCTION MAG-SLIDES-TYPEIN) WINDOW)
                                'NAME 'MAG-SLIDES-TYPEIN))
      (WINDOWPROP WINDOW 'PROCESS INPROC)
      (TTY.PROCESS INPROC)
      (MAG-SLIDES-REFRESH WINDOW)
      (TOTOPW WINDOW)
      (RETURN WINDOW))])

(MAG-SLIDES-OPEN-FILE
  [LAMBDA (PATH)
    (PROG (SLIDES)
      (MAG-SLIDES-PREPARE-FILE-IMAGES PATH)
      (SETQ SLIDES (CAR (NLSETQ (MAG-SLIDES-READ-FILE PATH))))
      (COND
        (SLIDES
         (RETURN (MAG-SLIDES-OPEN SLIDES PATH)))
        (T
         (PROMPTPRINT (CONCAT "Could not read " PATH ", opening demo"))
         (RETURN (MAG-SLIDES-OPEN (MAG-SLIDES-DEMO-SLIDES) NIL)))))])

(MAG-SLIDES-DEMO
  [LAMBDA NIL
    (MAG-SLIDES-OPEN (MAG-SLIDES-DEMO-SLIDES) NIL)])

(MAG-SLIDES-FB-COMMAND
  [LAMBDA (BROWSER KEY ITEM MENU OPTION)
    (PROG (FILES PATH)
      (SETQ FILES (AND (GETD 'FB.SELECTEDFILES)
                       (FB.SELECTEDFILES BROWSER)))
      (COND
        ((NULL FILES)
         (AND (GETD 'FB.PROMPTWPRINT)
              (FB.PROMPTWPRINT BROWSER "No slide file selected"))
         (RETURN NIL)))
      (SETQ PATH (AND (GETD 'FB.FETCHFILENAME)
                      (FB.FETCHFILENAME (CAR FILES))))
      (COND
        (PATH
         (MAG-SLIDES-OPEN-FILE PATH)
         (AND (GETD 'FB.PROMPTWPRINT)
              (FB.PROMPTWPRINT BROWSER "Opened " PATH)))
        (T
         (AND (GETD 'FB.PROMPTWPRINT)
              (FB.PROMPTWPRINT BROWSER "Could not read selected filename")))))])

(MAG-SLIDES-FB-EXPORT-COMMAND
  [LAMBDA (BROWSER KEY ITEM MENU OPTION)
    (PROG (FILES PATH PDF)
      (SETQ FILES (AND (GETD 'FB.SELECTEDFILES)
                       (FB.SELECTEDFILES BROWSER)))
      (COND
        ((NULL FILES)
         (AND (GETD 'FB.PROMPTWPRINT)
              (FB.PROMPTWPRINT BROWSER "No slide file selected"))
         (RETURN NIL)))
      (SETQ PATH (AND (GETD 'FB.FETCHFILENAME)
                      (FB.FETCHFILENAME (CAR FILES))))
      (COND
        (PATH
         (SETQ PDF (MAG-SLIDES-EXPORT-PDF-FILE PATH))
         (AND (GETD 'FB.PROMPTWPRINT)
              (FB.PROMPTWPRINT BROWSER
                               (CONCAT "Exporting PDF "
                                       (OR PDF "")))))
        (T
         (AND (GETD 'FB.PROMPTWPRINT)
              (FB.PROMPTWPRINT BROWSER "Could not read selected filename")))))])

(MAG-SLIDES-FILEBROWSER-MENU-ITEM
  [LAMBDA NIL
    '(|Slides| MAG-SLIDES-FB-COMMAND
      "Open selected file as a Mag Slides presentation"
      (SUBITEMS ("Present Selected" MAG-SLIDES-FB-COMMAND
                 "Open selected file as a Mag Slides presentation")
                ("Export PDF" MAG-SLIDES-FB-EXPORT-COMMAND
                 "Render selected deck to PDF through Medley screenshots")))])

(MAG-SLIDES-INSTALL-FILEBROWSER-MENU
  [LAMBDA NIL
    (AND (BOUNDP 'FB.MENU.ITEMS)
         (NOT (SASSOC '|Slides| FB.MENU.ITEMS))
         (SETQ FB.MENU.ITEMS
               (APPEND FB.MENU.ITEMS
                       (LIST (MAG-SLIDES-FILEBROWSER-MENU-ITEM)))))
    (AND (BOUNDP 'FB.MENU.ITEMS)
         (SASSOC '|Slides| FB.MENU.ITEMS))])

(MAG-SLIDES
  [LAMBDA NIL
    (LET ((PATH (MAG-PROMPT-LINE "slides file (blank for demo)"
                                 MAG-SLIDES-DEFAULT-PATH)))
      (COND
        ((OR (NULL PATH) (EQ (NCHARS PATH) 0))
         (MAG-SLIDES-DEMO))
        (T
         (MAG-SLIDES-OPEN-FILE PATH))))])

)

(NLSETQ (MAG-SLIDES-INSTALL-FILEBROWSER-MENU))

STOP
