(MAG-SLIDES-STATE
  [LAMBDA (WINDOW)
    (WINDOWPROP WINDOW 'MAG-SLIDES-STATE)])

(MAG-SLIDES-STATE-SLIDES
  [LAMBDA (STATE)
    (CAR STATE)])

(MAG-SLIDES-STATE-INDEX
  [LAMBDA (STATE)
    (CADR STATE)])

(MAG-SLIDES-STATE-SOURCE
  [LAMBDA (STATE)
    (CADDR STATE)])

(MAG-SLIDES-STATE-REVEAL
  [LAMBDA (STATE)
    (OR (CAR (CDDDR STATE)) 0)])

(MAG-SLIDES-SET-STATE
