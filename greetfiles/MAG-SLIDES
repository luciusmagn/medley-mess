(MAG-SLIDES-BUILD-SLIDE
  [LAMBDA (TITLE SUBTITLE BODY META LAYOUT IMAGE)
    (LIST (OR TITLE "")
          SUBTITLE
          (DREVERSE BODY)
          META
          LAYOUT
          IMAGE)])

(MAG-SLIDES-PREFIX-P
  [LAMBDA (PREFIX TEXT)
    (AND PREFIX
         TEXT
         (IGEQ (NCHARS TEXT) (NCHARS PREFIX))
         (STREQUAL PREFIX (SUBSTRING TEXT 1 (NCHARS PREFIX))))])

(MAG-SLIDES-SUFFIX-P
  [LAMBDA (SUFFIX TEXT)
    (AND SUFFIX
         TEXT
         (IGEQ (NCHARS TEXT) (NCHARS SUFFIX))
         (STREQUAL SUFFIX
                   (SUBSTRING TEXT
                              (ADD1 (IDIFFERENCE (NCHARS TEXT)
                                                  (NCHARS SUFFIX)))
                              (NCHARS TEXT))))])

(MAG-SLIDES-DROP-PREFIX
  [LAMBDA (TEXT N)
    (COND
      ((AND TEXT (IGREATERP (NCHARS TEXT) N))
       (SUBSTRING TEXT (ADD1 N) (NCHARS TEXT)))
      (T ""))])

(MAG-SLIDES-SPACE-CHAR-P
  [LAMBDA (CH)
    (OR (EQ CH 32) (EQ CH 9))])

(MAG-SLIDES-TRIM
  [LAMBDA (TEXT)
    (PROG ((START 1)
           (END (AND TEXT (NCHARS TEXT))))
      (COND
        ((OR (NULL TEXT) (EQ END 0))
         (RETURN "")))
    LEFT
      (COND
        ((AND (ILEQ START END)
              (MAG-SLIDES-SPACE-CHAR-P (NTHCHARCODE TEXT START)))
         (SETQ START (ADD1 START))
         (GO LEFT)))
    RIGHT
      (COND
        ((AND (ILEQ START END)
              (MAG-SLIDES-SPACE-CHAR-P (NTHCHARCODE TEXT END)))
         (SETQ END (SUB1 END))
         (GO RIGHT)))
      (COND
        ((IGREATERP START END)
         (RETURN ""))
        (T (RETURN (SUBSTRING TEXT START END)))))])

(MAG-SLIDES-BLANK-P
  [LAMBDA (TEXT)
    (PROG ((I 1)
           (LEN (AND TEXT (NCHARS TEXT)))
           CH)
      (COND
        ((OR (NULL TEXT) (EQ LEN 0))
         (RETURN T)))
    LP
      (COND
        ((IGREATERP I LEN)
         (RETURN T)))
      (SETQ CH (NTHCHARCODE TEXT I))
      (COND
        ((NOT (MAG-SLIDES-SPACE-CHAR-P CH))
         (RETURN NIL)))
      (SETQ I (ADD1 I))
      (GO LP))])

(MAG-SLIDES-LAYOUT-SYMBOL
  [LAMBDA (TEXT)
    (COND
      ((NULL TEXT) NIL)
      ((STRING-EQUAL TEXT "title") 'TITLE)
      ((STRING-EQUAL TEXT "body") 'BODY)
      ((STRING-EQUAL TEXT "image") 'IMAGE)
      (T (MKATOM (U-CASE TEXT))))])

(MAG-SLIDES-FINISH-PENDING
  [LAMBDA (SLIDES TITLE SUBTITLE BODY META LAYOUT IMAGE)
    (COND
      ((OR TITLE SUBTITLE BODY META LAYOUT IMAGE)
       (CONS (MAG-SLIDES-BUILD-SLIDE TITLE SUBTITLE BODY META LAYOUT IMAGE)
             SLIDES))
      (T SLIDES))])

(MAG-SLIDES-READ-FILE
  [LAMBDA (PATH)
    (PROG ((SLIDES NIL)
           (TITLE NIL)
           (SUBTITLE NIL)
           (BODY NIL)
           (META NIL)
           (LAYOUT NIL)
           (IMAGE NIL)
           LINE)
      (CL:WITH-OPEN-FILE (STREAM PATH)
        (while (SETQ LINE (CL:READ-LINE STREAM NIL NIL))
          do
          (COND
            ((STREQUAL LINE "---")
             (SETQ SLIDES
                   (MAG-SLIDES-FINISH-PENDING SLIDES TITLE SUBTITLE BODY META LAYOUT IMAGE))
             (SETQ TITLE NIL)
             (SETQ SUBTITLE NIL)
             (SETQ BODY NIL)
             (SETQ META NIL)
             (SETQ LAYOUT NIL)
             (SETQ IMAGE NIL))
            ((MAG-SLIDES-PREFIX-P "@layout " LINE)
             (SETQ LAYOUT (MAG-SLIDES-LAYOUT-SYMBOL
                             (MAG-SLIDES-TRIM (MAG-SLIDES-DROP-PREFIX LINE 8)))))
            ((MAG-SLIDES-PREFIX-P "@image " LINE)
             (SETQ IMAGE (MAG-SLIDES-TRIM (MAG-SLIDES-DROP-PREFIX LINE 7)))
             (SETQ LAYOUT 'IMAGE))
            ((MAG-SLIDES-PREFIX-P "@meta " LINE)
             (SETQ META (MAG-SLIDES-DROP-PREFIX LINE 6)))
            ((MAG-SLIDES-PREFIX-P "@footer " LINE)
             (SETQ META (MAG-SLIDES-DROP-PREFIX LINE 8)))
            ((MAG-SLIDES-PREFIX-P "@subtitle " LINE)
             (SETQ SUBTITLE (MAG-SLIDES-DROP-PREFIX LINE 10)))
            ((MAG-SLIDES-PREFIX-P "## " LINE)
             (SETQ SUBTITLE (MAG-SLIDES-DROP-PREFIX LINE 3)))
            ((MAG-SLIDES-PREFIX-P "# " LINE)
             (SETQ TITLE (MAG-SLIDES-DROP-PREFIX LINE 2)))
            ((MAG-SLIDES-PREFIX-P "- " LINE)
             (SETQ BODY
                   (CONS (CONCAT "* " (MAG-SLIDES-DROP-PREFIX LINE 2))
                         BODY)))
            ((MAG-SLIDES-BLANK-P LINE)
             NIL)
            (T
             (SETQ BODY (CONS LINE BODY))))))
      (SETQ SLIDES
            (MAG-SLIDES-FINISH-PENDING SLIDES TITLE SUBTITLE BODY META LAYOUT IMAGE))
      (RETURN (DREVERSE SLIDES)))])

