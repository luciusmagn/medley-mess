(DEFINE-FILE-INFO PACKAGE "INTERLISP" READTABLE "INTERLISP" BASE 10)

(FILESLOAD RECORD)

(RPAQ? MAG-TEDIT-AUTOSAVE-PROCESS NIL)
(RPAQQ MAG-TEDIT-AUTOSAVE-INTERVAL-MS 60000)
(RPAQ? MAG-TEDIT-STYLE-MENU NIL)

(DEFINEQ

(MAG-TEDIT-CLEAR-PANE
  [LAMBDA (PANE PBOTTOM)
    (CL:UNLESS PBOTTOM
      (SETQ PBOTTOM (PANEBOTTOM PANE)))
    (MAG-WINDOW-SET-BACKGROUND PANE)
    (MAG-WINDOW-FILL-REGION
      PANE
      (CREATEREGION
        0
        PBOTTOM
        (PANEWIDTH PANE)
        (IDIFFERENCE (fetch (REGION PTOP) of (PANEREGION PANE))
                     PBOTTOM)))])

(MAG-TEDIT-INSTALL-BACKGROUND
  [LAMBDA NIL
    (AND (GETD '\TEDIT.CLEARPANE)
         (NOT (GETD 'MAG-TEDIT-ORIGINAL-CLEAR-PANE))
         (PUTD 'MAG-TEDIT-ORIGINAL-CLEAR-PANE
               (GETD '\TEDIT.CLEARPANE)
               T))
    (AND (GETD 'MAG-TEDIT-CLEAR-PANE)
         (PUTD '\TEDIT.CLEARPANE
               (GETD 'MAG-TEDIT-CLEAR-PANE)
               T))
    T])

(MAG-TEDIT-APPLY-BACKGROUND-OPEN-WINDOWS
  [LAMBDA NIL
    (for W in (OPENWINDOWS) do
      (AND (WINDOWPROP W 'TEXTSTREAM)
           (CAR
             (NLSETQ
               (PROGN
                 (MAG-WINDOW-SET-BACKGROUND W)
                 (AND (GETD '\TEDIT.REPAINTFN)
                      (\TEDIT.REPAINTFN W NIL)))))))
    T])

(MAG-TEDIT-CHAR-LOOKS
  [LAMBDA (STYLE)
    (SELECTQ STYLE
      (HEADING1 '(FAMILY TIMESROMAN SIZE 18 WEIGHT BOLD SLOPE REGULAR
                         USERINFO (MAG-TEDIT HEADING1)))
      (HEADING2 '(FAMILY TIMESROMAN SIZE 16 WEIGHT BOLD SLOPE REGULAR
                         USERINFO (MAG-TEDIT HEADING2)))
      (HEADING3 '(FAMILY TIMESROMAN SIZE 14 WEIGHT BOLD SLOPE REGULAR
                         USERINFO (MAG-TEDIT HEADING3)))
      (CODE '(FAMILY GACHA SIZE 10 WEIGHT MEDIUM SLOPE REGULAR
                     USERINFO (MAG-TEDIT CODE)))
      (NORMAL '(FAMILY TIMESROMAN SIZE 10 WEIGHT MEDIUM SLOPE REGULAR
                       UNDERLINE OFF STRIKEOUT OFF OVERLINE OFF
                       USERINFO (MAG-TEDIT NORMAL)))
      (BOLD '(WEIGHT BOLD))
      (ITALIC '(SLOPE ITALIC))
      (PLAIN '(FAMILY TIMESROMAN SIZE 10 WEIGHT MEDIUM SLOPE REGULAR
                      UNDERLINE OFF STRIKEOUT OFF OVERLINE OFF
                      USERINFO NIL))
      NIL)])

(MAG-TEDIT-PARA-LOOKS
  [LAMBDA (STYLE)
    (SELECTQ STYLE
      (HEADING1 '(USERINFO (MAG-TEDIT HEADING1) HEADINGKEEP ON
                   PARALEADING 8 POSTPARALEADING 4))
      (HEADING2 '(USERINFO (MAG-TEDIT HEADING2) HEADINGKEEP ON
                   PARALEADING 6 POSTPARALEADING 3))
      (HEADING3 '(USERINFO (MAG-TEDIT HEADING3) HEADINGKEEP ON
                   PARALEADING 4 POSTPARALEADING 2))
      (CODE '(USERINFO (MAG-TEDIT CODE) PARALEADING 2 POSTPARALEADING 2))
      (NORMAL '(USERINFO (MAG-TEDIT NORMAL) HEADINGKEEP OFF
                 PARALEADING 0 POSTPARALEADING 0))
      (PLAIN '(USERINFO NIL HEADINGKEEP OFF
                PARALEADING 0 POSTPARALEADING 0))
      NIL)])

(MAG-TEDIT-APPLY-STYLE
  [LAMBDA (TSTREAM STYLE)
    (SETQ TSTREAM (TEXTSTREAM TSTREAM))
    (LET ((CHARLOOKS (MAG-TEDIT-CHAR-LOOKS STYLE))
          (PARALOOKS (MAG-TEDIT-PARA-LOOKS STYLE)))
      (AND CHARLOOKS
           (TEDIT.LOOKS TSTREAM CHARLOOKS NIL NIL))
      (AND PARALOOKS
           (GETD 'TEDIT.PARALOOKS)
           (TEDIT.PARALOOKS TSTREAM PARALOOKS NIL NIL))
      TSTREAM)])

(MAG-TEDIT-STYLE-MENU
  [LAMBDA NIL
    (OR MAG-TEDIT-STYLE-MENU
        (SETQ MAG-TEDIT-STYLE-MENU
	              (create MENU
	                      TITLE _ "Mag TEdit"
	                      ITEMS _ '(("Heading 1" 'HEADING1 "Apply heading level 1")
	                                ("Heading 2" 'HEADING2 "Apply heading level 2")
	                                ("Heading 3" 'HEADING3 "Apply heading level 3")
	                                ("Normal text" 'NORMAL "Apply normal body text")
	                                (Code 'CODE "Apply monospace code style")
	                                (Bold 'BOLD "Make selection bold")
	                                (Italic 'ITALIC "Make selection italic")
	                                (Plain 'PLAIN "Reset to plain Times Roman 10pt")
	                                ("Save now" 'SAVE "Save this document"))
	                      CENTERFLG _ T)))])

(MAG-TEDIT-MENU
  [LAMBDA (TSTREAM)
    (LET ((ITEM (MENU (MAG-TEDIT-STYLE-MENU))))
      (SELECTQ ITEM
        (SAVE (MAG-TEDIT-SAVE-STREAM TSTREAM))
        ((HEADING1 HEADING2 HEADING3 NORMAL CODE BOLD ITALIC PLAIN)
         (MAG-TEDIT-APPLY-STYLE TSTREAM ITEM))
        NIL))])

(MAG-TEDIT-STREAM-FILENAME
  [LAMBDA (TSTREAM)
    (OR (CAR (NLSETQ (\TEDIT.LIKELY.FILENAME TSTREAM NIL)))
        (CAR (NLSETQ (\TEDIT.FILENAME TSTREAM))))])

(MAG-TEDIT-STREAM-DIRTYP
  [LAMBDA (TSTREAM)
    (CAR (NLSETQ (TEDIT.STREAMCHANGEDP TSTREAM NIL)))])

(MAG-TEDIT-SAVE-STREAM
  [LAMBDA (TSTREAM)
    (SETQ TSTREAM (TEXTSTREAM TSTREAM))
    (LET ((FILE (MAG-TEDIT-STREAM-FILENAME TSTREAM)))
      (AND FILE
           (NEQ FILE "")
           (CAR (NLSETQ (TEDIT.PUT TSTREAM FILE NIL NIL NIL T)))))])

(MAG-TEDIT-AUTOSAVE-ONE
  [LAMBDA (TSTREAM)
    (AND TSTREAM
         (CAR (NLSETQ
                (PROGN
                  (SETQ TSTREAM (TEXTSTREAM TSTREAM))
                  (AND (MAG-TEDIT-STREAM-DIRTYP TSTREAM)
                       (MAG-TEDIT-SAVE-STREAM TSTREAM))))))])

(MAG-TEDIT-AUTOSAVE-OPEN-WINDOWS
  [LAMBDA NIL
    (LET (COUNT TSTREAM)
      (for W in (OPENWINDOWS) do
        (SETQ TSTREAM (WINDOWPROP W 'TEXTSTREAM))
        (AND TSTREAM
             (MAG-TEDIT-AUTOSAVE-ONE TSTREAM)
             (SETQ COUNT (ADD1 (OR COUNT 0)))))
      (OR COUNT 0))])

(MAG-TEDIT-AUTOSAVE-LOOP
  [LAMBDA NIL
    (while T do
      (DISMISS MAG-TEDIT-AUTOSAVE-INTERVAL-MS)
      (NLSETQ (MAG-TEDIT-AUTOSAVE-OPEN-WINDOWS)))])

(MAG-TEDIT-AUTOSAVE-START
  [LAMBDA NIL
    (OR (AND MAG-TEDIT-AUTOSAVE-PROCESS
             (PROCESSP MAG-TEDIT-AUTOSAVE-PROCESS))
        (SETQ MAG-TEDIT-AUTOSAVE-PROCESS
              (ADD.PROCESS (LIST (FUNCTION MAG-TEDIT-AUTOSAVE-LOOP))
                           'NAME
                           'MAG-TEDIT-AUTOSAVE
                           'RESTARTABLE
                           'YES)))
    MAG-TEDIT-AUTOSAVE-PROCESS])

(MAG-TEDIT-INSTALL
  [LAMBDA NIL
    (OR (GETD 'TEDIT)
        (FILESLOAD TEDIT))
    (SETQ MAG-TEDIT-STYLE-MENU NIL)
    (AND (GETD 'TEDIT.REMOVE.MENUITEM)
         (TEDIT.REMOVE.MENUITEM TEDIT.DEFAULT.MENU 'Mag% Looks))
    (AND (GETD 'TEDIT.ADD.MENUITEM)
         (TEDIT.ADD.MENUITEM
           TEDIT.DEFAULT.MENU
           '(Mag% Looks 'MAG-TEDIT-MENU
             "Quick styles and autosave helpers"
             (SUBITEMS (Mag% Looks 'MAG-TEDIT-MENU
                                   "Open Mag heading/body/code menu")))))
    (MAG-TEDIT-INSTALL-BACKGROUND)
    (MAG-TEDIT-APPLY-BACKGROUND-OPEN-WINDOWS)
    (MAG-TEDIT-AUTOSAVE-START)
    T])
)

(NLSETQ (MAG-TEDIT-INSTALL))

STOP
