(DEFINE-FILE-INFO PACKAGE "INTERLISP" READTABLE "INTERLISP" BASE 10)

(FILESLOAD RECORD)

(RPAQ? MAG-TEDIT-AUTOSAVE-PROCESS NIL)
(RPAQQ MAG-TEDIT-AUTOSAVE-INTERVAL-MS 60000)
(RPAQ? MAG-TEDIT-STYLE-MENU NIL)
(RPAQ? MAG-TEDIT-LOOKS-WINDOW NIL)
(RPAQQ MAG-TEDIT-LOOKS-ACTION-START-ROW 5)

(DEFINEQ

(MAG-TEDIT-CLEAR-PANE
  [LAMBDA (PANE PBOTTOM)
    (MAG-WINDOW-SET-BACKGROUND PANE)])

(MAG-TEDIT-INSTALL-BACKGROUND
  [LAMBDA NIL
    (AND (GETD 'MAG-TEDIT-ORIGINAL-CLEAR-PANE)
         (PUTD '\TEDIT.CLEARPANE
               (GETD 'MAG-TEDIT-ORIGINAL-CLEAR-PANE)
               T))
    T])

(MAG-TEDIT-APPLY-BACKGROUND-OPEN-WINDOWS
  [LAMBDA NIL
    (for W in (OPENWINDOWS) do
      (AND (WINDOWPROP W 'TEXTSTREAM)
           (CAR
             (NLSETQ
               (PROGN
                 (MAG-WINDOW-SET-BACKGROUND W)
                 (AND (GETD '\TEDIT.REPAINTFN)
                      (\TEDIT.REPAINTFN W NIL)))))))
    T])

(MAG-TEDIT-CHAR-LOOKS
  [LAMBDA (STYLE)
    (SELECTQ STYLE
      (HEADING1 '(FAMILY TIMESROMAN SIZE 18 WEIGHT BOLD SLOPE REGULAR
                         USERINFO (MAG-TEDIT HEADING1)))
      (HEADING2 '(FAMILY TIMESROMAN SIZE 16 WEIGHT BOLD SLOPE REGULAR
                         USERINFO (MAG-TEDIT HEADING2)))
      (HEADING3 '(FAMILY TIMESROMAN SIZE 14 WEIGHT BOLD SLOPE REGULAR
                         USERINFO (MAG-TEDIT HEADING3)))
      (CODE '(FAMILY GACHA SIZE 10 WEIGHT MEDIUM SLOPE REGULAR
                     USERINFO (MAG-TEDIT CODE)))
      (NORMAL '(FAMILY TIMESROMAN SIZE 10 WEIGHT MEDIUM SLOPE REGULAR
                       UNDERLINE OFF STRIKEOUT OFF OVERLINE OFF
                       USERINFO (MAG-TEDIT NORMAL)))
      (BOLD '(WEIGHT BOLD))
      (ITALIC '(SLOPE ITALIC))
      (PLAIN '(FAMILY TIMESROMAN SIZE 10 WEIGHT MEDIUM SLOPE REGULAR
                      UNDERLINE OFF STRIKEOUT OFF OVERLINE OFF
                      USERINFO NIL))
      NIL)])

(MAG-TEDIT-PARA-LOOKS
  [LAMBDA (STYLE)
    (SELECTQ STYLE
      (HEADING1 '(USERINFO (MAG-TEDIT HEADING1) HEADINGKEEP ON
                   PARALEADING 8 POSTPARALEADING 4))
      (HEADING2 '(USERINFO (MAG-TEDIT HEADING2) HEADINGKEEP ON
                   PARALEADING 6 POSTPARALEADING 3))
      (HEADING3 '(USERINFO (MAG-TEDIT HEADING3) HEADINGKEEP ON
                   PARALEADING 4 POSTPARALEADING 2))
      (CODE '(USERINFO (MAG-TEDIT CODE) PARALEADING 2 POSTPARALEADING 2))
      (NORMAL '(USERINFO (MAG-TEDIT NORMAL) HEADINGKEEP OFF
                 PARALEADING 0 POSTPARALEADING 0))
      (PLAIN '(USERINFO NIL HEADINGKEEP OFF
                PARALEADING 0 POSTPARALEADING 0))
      NIL)])

(MAG-TEDIT-APPLY-STYLE
  [LAMBDA (TSTREAM STYLE)
    (SETQ TSTREAM (TEXTSTREAM TSTREAM))
    (LET ((CHARLOOKS (MAG-TEDIT-CHAR-LOOKS STYLE))
          (PARALOOKS (MAG-TEDIT-PARA-LOOKS STYLE)))
      (AND CHARLOOKS
           (TEDIT.LOOKS TSTREAM CHARLOOKS NIL NIL))
      (AND PARALOOKS
           (GETD 'TEDIT.PARALOOKS)
           (TEDIT.PARALOOKS TSTREAM PARALOOKS NIL NIL))
      TSTREAM)])

(MAG-TEDIT-STYLE-MENU
  [LAMBDA NIL
    (OR MAG-TEDIT-STYLE-MENU
        (SETQ MAG-TEDIT-STYLE-MENU
	              (create MENU
	                      TITLE _ "Mag TEdit"
	                      ITEMS _ '(("Heading 1" 'HEADING1 "Apply heading level 1")
	                                ("Heading 2" 'HEADING2 "Apply heading level 2")
	                                ("Heading 3" 'HEADING3 "Apply heading level 3")
	                                ("Normal text" 'NORMAL "Apply normal body text")
	                                (Code 'CODE "Apply monospace code style")
	                                (Bold 'BOLD "Make selection bold")
	                                (Italic 'ITALIC "Make selection italic")
	                                (Plain 'PLAIN "Reset to plain Times Roman 10pt")
	                                ("Save now" 'SAVE "Save this document"))
	                      CENTERFLG _ T)))])

(MAG-TEDIT-LOOKS-ACTIONS
  [LAMBDA NIL
    '(("Heading 1" HEADING1)
      ("Heading 2" HEADING2)
      ("Heading 3" HEADING3)
      ("Normal text" NORMAL)
      ("Code" CODE)
      ("Bold" BOLD)
      ("Italic" ITALIC)
      ("Plain" PLAIN)
      ("Save now" SAVE))])

(MAG-TEDIT-LOOKS-ACTION-LINES
  [LAMBDA (ACTIONS)
    (COND
      ((NULL ACTIONS)
       NIL)
      (T
       (CONS (CONCAT "  " (CAAR ACTIONS))
             (MAG-TEDIT-LOOKS-ACTION-LINES (CDR ACTIONS)))))])

(MAG-TEDIT-LOOKS-TARGET-LINE
  [LAMBDA (WINDOW)
    (COND
      ((WINDOWPROP WINDOW 'MAG-TEDIT-STREAM)
       "Target: current TEdit stream")
      (T
       "Target: none; reopen from a TEdit menu"))])

(MAG-TEDIT-LOOKS-LINES
  [LAMBDA (WINDOW)
    (APPEND
      (LIST "Mag Looks"
            "Left-click a style; palette stays open."
            (MAG-TEDIT-LOOKS-TARGET-LINE WINDOW)
            (OR (WINDOWPROP WINDOW 'MAG-TEDIT-LOOKS-STATUS)
                "Status: ready")
            "")
      (MAG-TEDIT-LOOKS-ACTION-LINES (MAG-TEDIT-LOOKS-ACTIONS)))])

(MAG-TEDIT-LOOKS-DRAW
  [LAMBDA (WINDOW)
    (MAG-WINDOW-DRAW-LINES WINDOW (MAG-TEDIT-LOOKS-LINES WINDOW))])

(MAG-TEDIT-LOOKS-REGION
  [LAMBDA NIL
    (LET ((WIDTH 260)
          (HEIGHT 215))
      (CREATEREGION (IMAX 8 (IDIFFERENCE SCREENWIDTH (IPLUS WIDTH 16)))
                    8
                    WIDTH
                    HEIGHT))])

(MAG-TEDIT-LOOKS-MOUSE-ROW
  [LAMBDA (WINDOW)
    (LET ((LINEHEIGHT (MAG-WINDOW-LINEHEIGHT WINDOW)))
      (IQUOTIENT (IDIFFERENCE (WINDOWPROP WINDOW 'HEIGHT)
                              (LASTMOUSEY WINDOW))
                 LINEHEIGHT))])

(MAG-TEDIT-LOOKS-NTH-ACTION
  [LAMBDA (ACTIONS INDEX)
    (COND
      ((OR (NULL ACTIONS)
           (ILESSP INDEX 0))
       NIL)
      ((ZEROP INDEX)
       (CAR ACTIONS))
      (T
       (MAG-TEDIT-LOOKS-NTH-ACTION (CDR ACTIONS) (SUB1 INDEX))))])

(MAG-TEDIT-LOOKS-ITEM-FROM-MOUSE
  [LAMBDA (WINDOW)
    (LET ((INDEX (IDIFFERENCE (MAG-TEDIT-LOOKS-MOUSE-ROW WINDOW)
                              MAG-TEDIT-LOOKS-ACTION-START-ROW)))
      (MAG-TEDIT-LOOKS-NTH-ACTION (MAG-TEDIT-LOOKS-ACTIONS) INDEX))])

(MAG-TEDIT-LOOKS-APPLY-ITEM
  [LAMBDA (WINDOW ITEM)
    (LET ((TSTREAM (WINDOWPROP WINDOW 'MAG-TEDIT-STREAM))
          (LABEL (CAR ITEM))
          (ACTION (CADR ITEM))
          RESULT)
      (COND
        ((NULL TSTREAM)
         (WINDOWPROP WINDOW 'MAG-TEDIT-LOOKS-STATUS
                     "Status: no TEdit target")
         (FLASHWINDOW WINDOW))
        (T
         (SETQ RESULT
               (CAR
                 (NLSETQ
                   (SELECTQ ACTION
                     (SAVE (MAG-TEDIT-SAVE-STREAM TSTREAM))
                     ((HEADING1 HEADING2 HEADING3 NORMAL CODE BOLD ITALIC PLAIN)
                      (MAG-TEDIT-APPLY-STYLE TSTREAM ACTION))
                     NIL))))
         (WINDOWPROP WINDOW 'MAG-TEDIT-LOOKS-STATUS
                     (CONCAT "Last: " LABEL))
         (MAG-TEDIT-LOOKS-DRAW WINDOW)
         RESULT)))])

(MAG-TEDIT-LOOKS-BUTTONFN
  [LAMBDA (WINDOW)
    (TOTOPW WINDOW)
    (COND
      ((LASTMOUSESTATE RIGHT)
       (DOWINDOWCOM WINDOW))
      ((LASTMOUSESTATE LEFT)
       (LET ((ITEM (MAG-TEDIT-LOOKS-ITEM-FROM-MOUSE WINDOW)))
         (AND ITEM
              (MAG-TEDIT-LOOKS-APPLY-ITEM WINDOW ITEM)))))])

(MAG-TEDIT-LOOKS-RESHAPEFN
  [LAMBDA (WINDOW OLDIMAGE IMAGEREGION OLDSCREENREGION)
    (RESHAPEBYREPAINTFN WINDOW OLDIMAGE IMAGEREGION)
    (MAG-TEDIT-LOOKS-DRAW WINDOW)])

(MAG-TEDIT-LOOKS-CLOSEFN
  [LAMBDA (WINDOW)
    (AND (EQ MAG-TEDIT-LOOKS-WINDOW WINDOW)
         (SETQ MAG-TEDIT-LOOKS-WINDOW NIL))])

(MAG-TEDIT-LOOKS-OPEN
  [LAMBDA (TSTREAM)
    (PROG (WINDOW)
      (SETQ TSTREAM (CAR (NLSETQ (TEXTSTREAM TSTREAM))))
      (SETQ WINDOW (AND MAG-TEDIT-LOOKS-WINDOW
                        (OPENWP MAG-TEDIT-LOOKS-WINDOW)
                        MAG-TEDIT-LOOKS-WINDOW))
      (COND
        ((NULL WINDOW)
         (SETQ WINDOW (CREATEW (MAG-TEDIT-LOOKS-REGION) "Mag Looks"))
         (SETQ MAG-TEDIT-LOOKS-WINDOW WINDOW)
         (WINDOWPROP WINDOW 'MAG-TEDIT-LOOKS T)
         (WINDOWPROP WINDOW 'BUTTONEVENTFN (FUNCTION MAG-TEDIT-LOOKS-BUTTONFN))
         (WINDOWPROP WINDOW 'RIGHTBUTTONFN (FUNCTION DOWINDOWCOM))
         (WINDOWPROP WINDOW 'RESHAPEFN (FUNCTION MAG-TEDIT-LOOKS-RESHAPEFN))
         (WINDOWADDPROP WINDOW 'CLOSEFN (FUNCTION MAG-TEDIT-LOOKS-CLOSEFN))
         (MODERNWINDOW WINDOW)))
      (WINDOWPROP WINDOW 'MAG-TEDIT-STREAM TSTREAM)
      (WINDOWPROP WINDOW 'MAG-TEDIT-LOOKS-STATUS
                  "Status: ready")
      (TOTOPW WINDOW)
      (MAG-WINDOW-SET-BACKGROUND WINDOW)
      (MAG-TEDIT-LOOKS-DRAW WINDOW)
      (RETURN WINDOW))])

(MAG-TEDIT-MENU
  [LAMBDA (TSTREAM)
    (MAG-TEDIT-LOOKS-OPEN TSTREAM)])

(MAG-TEDIT-STREAM-FILENAME
  [LAMBDA (TSTREAM)
    (OR (CAR (NLSETQ (\TEDIT.LIKELY.FILENAME TSTREAM NIL)))
        (CAR (NLSETQ (\TEDIT.FILENAME TSTREAM))))])

(MAG-TEDIT-STREAM-DIRTYP
  [LAMBDA (TSTREAM)
    (CAR (NLSETQ (TEDIT.STREAMCHANGEDP TSTREAM NIL)))])

(MAG-TEDIT-SAVE-STREAM
  [LAMBDA (TSTREAM)
    (SETQ TSTREAM (TEXTSTREAM TSTREAM))
    (LET ((FILE (MAG-TEDIT-STREAM-FILENAME TSTREAM)))
      (AND FILE
           (NEQ FILE "")
           (CAR (NLSETQ (TEDIT.PUT TSTREAM FILE NIL NIL NIL T)))))])

(MAG-TEDIT-AUTOSAVE-ONE
  [LAMBDA (TSTREAM)
    (AND TSTREAM
         (CAR (NLSETQ
                (PROGN
                  (SETQ TSTREAM (TEXTSTREAM TSTREAM))
                  (AND (MAG-TEDIT-STREAM-DIRTYP TSTREAM)
                       (MAG-TEDIT-SAVE-STREAM TSTREAM))))))])

(MAG-TEDIT-AUTOSAVE-OPEN-WINDOWS
  [LAMBDA NIL
    (LET (COUNT TSTREAM)
      (for W in (OPENWINDOWS) do
        (SETQ TSTREAM (WINDOWPROP W 'TEXTSTREAM))
        (AND TSTREAM
             (MAG-TEDIT-AUTOSAVE-ONE TSTREAM)
             (SETQ COUNT (ADD1 (OR COUNT 0)))))
      (OR COUNT 0))])

(MAG-TEDIT-AUTOSAVE-LOOP
  [LAMBDA NIL
    (while T do
      (DISMISS MAG-TEDIT-AUTOSAVE-INTERVAL-MS)
      (NLSETQ (MAG-TEDIT-AUTOSAVE-OPEN-WINDOWS)))])

(MAG-TEDIT-AUTOSAVE-START
  [LAMBDA NIL
    (OR (AND MAG-TEDIT-AUTOSAVE-PROCESS
             (PROCESSP MAG-TEDIT-AUTOSAVE-PROCESS))
        (SETQ MAG-TEDIT-AUTOSAVE-PROCESS
              (ADD.PROCESS (LIST (FUNCTION MAG-TEDIT-AUTOSAVE-LOOP))
                           'NAME
                           'MAG-TEDIT-AUTOSAVE
                           'RESTARTABLE
                           'YES)))
    MAG-TEDIT-AUTOSAVE-PROCESS])

(MAG-TEDIT-INSTALL
  [LAMBDA NIL
    (OR (GETD 'TEDIT)
        (FILESLOAD TEDIT))
    (SETQ MAG-TEDIT-STYLE-MENU NIL)
    (AND (GETD 'TEDIT.REMOVE.MENUITEM)
         (TEDIT.REMOVE.MENUITEM TEDIT.DEFAULT.MENU 'Mag% Looks))
    (AND (GETD 'TEDIT.ADD.MENUITEM)
         (TEDIT.ADD.MENUITEM
           TEDIT.DEFAULT.MENU
           '(Mag% Looks 'MAG-TEDIT-MENU
             "Open persistent Mag Looks palette"
             (SUBITEMS (Mag% Looks 'MAG-TEDIT-MENU
                                   "Open persistent Mag Looks palette")))))
    (MAG-TEDIT-INSTALL-BACKGROUND)
    (MAG-TEDIT-APPLY-BACKGROUND-OPEN-WINDOWS)
    (MAG-TEDIT-AUTOSAVE-START)
    T])
)

(NLSETQ (MAG-TEDIT-INSTALL))

STOP
