(DEFINE-FILE-INFO PACKAGE "INTERLISP" READTABLE "INTERLISP" BASE 10)

(FILESLOAD RECORD)

(RPAQ? MAG-TEDIT-AUTOSAVE-PROCESS NIL)
(RPAQQ MAG-TEDIT-AUTOSAVE-INTERVAL-MS 60000)
(RPAQ? MAG-TEDIT-STYLE-MENU NIL)
(RPAQ? MAG-TEDIT-LOOKS-WINDOW NIL)
(RPAQQ MAG-TEDIT-LOOKS-WIDTH 340)
(RPAQQ MAG-TEDIT-LOOKS-HEIGHT 250)
(RPAQQ MAG-TEDIT-LOOKS-MARGIN 10)
(RPAQQ MAG-TEDIT-LOOKS-TITLE-HEIGHT 22)
(RPAQQ MAG-TEDIT-LOOKS-STATUS-HEIGHT 18)
(RPAQQ MAG-TEDIT-LOOKS-BUTTON-HEIGHT 32)
(RPAQQ MAG-TEDIT-LOOKS-BUTTON-GAP 7)
(RPAQQ MAG-TEDIT-LOOKS-COLUMN-GAP 8)

(DEFINEQ

(MAG-TEDIT-CLEAR-PANE
  [LAMBDA (PANE PBOTTOM)
    (MAG-WINDOW-SET-BACKGROUND PANE)])

(MAG-TEDIT-INSTALL-BACKGROUND
  [LAMBDA NIL
    (AND (GETD 'MAG-TEDIT-ORIGINAL-CLEAR-PANE)
         (PUTD '\TEDIT.CLEARPANE
               (GETD 'MAG-TEDIT-ORIGINAL-CLEAR-PANE)
               T))
    T])

(MAG-TEDIT-APPLY-BACKGROUND-OPEN-WINDOWS
  [LAMBDA NIL
    (for W in (OPENWINDOWS) do
      (AND (WINDOWPROP W 'TEXTSTREAM)
           (CAR
             (NLSETQ
               (PROGN
                 (MAG-WINDOW-SET-BACKGROUND W)
                 (AND (GETD '\TEDIT.REPAINTFN)
                      (\TEDIT.REPAINTFN W NIL)))))))
    T])

(MAG-TEDIT-CHAR-LOOKS
  [LAMBDA (STYLE)
    (SELECTQ STYLE
      (HEADING1 '(FAMILY TIMESROMAN SIZE 18 WEIGHT BOLD SLOPE REGULAR
                         USERINFO (MAG-TEDIT HEADING1)))
      (HEADING2 '(FAMILY TIMESROMAN SIZE 16 WEIGHT BOLD SLOPE REGULAR
                         USERINFO (MAG-TEDIT HEADING2)))
      (HEADING3 '(FAMILY TIMESROMAN SIZE 14 WEIGHT BOLD SLOPE REGULAR
                         USERINFO (MAG-TEDIT HEADING3)))
      (CODE '(FAMILY GACHA SIZE 10 WEIGHT MEDIUM SLOPE REGULAR
                     USERINFO (MAG-TEDIT CODE)))
      (NORMAL '(FAMILY TIMESROMAN SIZE 10 WEIGHT MEDIUM SLOPE REGULAR
                       UNDERLINE OFF STRIKEOUT OFF OVERLINE OFF
                       USERINFO (MAG-TEDIT NORMAL)))
      (BOLD '(WEIGHT BOLD))
      (ITALIC '(SLOPE ITALIC))
      (PLAIN '(FAMILY TIMESROMAN SIZE 10 WEIGHT MEDIUM SLOPE REGULAR
                      UNDERLINE OFF STRIKEOUT OFF OVERLINE OFF
                      USERINFO NIL))
      NIL)])

(MAG-TEDIT-PARA-LOOKS
  [LAMBDA (STYLE)
    (SELECTQ STYLE
      (HEADING1 '(USERINFO (MAG-TEDIT HEADING1) HEADINGKEEP ON
                   PARALEADING 8 POSTPARALEADING 4))
      (HEADING2 '(USERINFO (MAG-TEDIT HEADING2) HEADINGKEEP ON
                   PARALEADING 6 POSTPARALEADING 3))
      (HEADING3 '(USERINFO (MAG-TEDIT HEADING3) HEADINGKEEP ON
                   PARALEADING 4 POSTPARALEADING 2))
      (CODE '(USERINFO (MAG-TEDIT CODE) PARALEADING 2 POSTPARALEADING 2))
      (NORMAL '(USERINFO (MAG-TEDIT NORMAL) HEADINGKEEP OFF
                 PARALEADING 0 POSTPARALEADING 0))
      (PLAIN '(USERINFO NIL HEADINGKEEP OFF
                PARALEADING 0 POSTPARALEADING 0))
      NIL)])

(MAG-TEDIT-APPLY-STYLE
  [LAMBDA (TSTREAM STYLE)
    (SETQ TSTREAM (TEXTSTREAM TSTREAM))
    (LET ((CHARLOOKS (MAG-TEDIT-CHAR-LOOKS STYLE))
          (PARALOOKS (MAG-TEDIT-PARA-LOOKS STYLE)))
      (AND CHARLOOKS
           (TEDIT.LOOKS TSTREAM CHARLOOKS NIL NIL))
      (AND PARALOOKS
           (GETD 'TEDIT.PARALOOKS)
           (TEDIT.PARALOOKS TSTREAM PARALOOKS NIL NIL))
      TSTREAM)])

(MAG-TEDIT-STYLE-MENU
  [LAMBDA NIL
    (OR MAG-TEDIT-STYLE-MENU
        (SETQ MAG-TEDIT-STYLE-MENU
	              (create MENU
	                      TITLE _ "Mag TEdit"
	                      ITEMS _ '(("Heading 1" 'HEADING1 "Apply heading level 1")
	                                ("Heading 2" 'HEADING2 "Apply heading level 2")
	                                ("Heading 3" 'HEADING3 "Apply heading level 3")
	                                ("Normal text" 'NORMAL "Apply normal body text")
	                                (Code 'CODE "Apply monospace code style")
	                                (Bold 'BOLD "Make selection bold")
	                                (Italic 'ITALIC "Make selection italic")
	                                (Plain 'PLAIN "Reset to plain Times Roman 10pt")
	                                ("Save now" 'SAVE "Save this document"))
	                      CENTERFLG _ T)))])

(MAG-TEDIT-LOOKS-ACTIONS
  [LAMBDA NIL
    '(("Heading 1" HEADING1)
      ("Heading 2" HEADING2)
      ("Heading 3" HEADING3)
      ("Normal text" NORMAL)
      ("Code" CODE)
      ("Bold" BOLD)
      ("Italic" ITALIC)
      ("Plain" PLAIN)
      ("Save now" SAVE))])

(MAG-TEDIT-LOOKS-BOLD-FONT
  [LAMBDA (WINDOW)
    (OR (WINDOWPROP WINDOW 'MAG-TEDIT-LOOKS-BOLD-FONT)
        (LET ((FONT (DSPFONT NIL WINDOW)))
          (WINDOWPROP WINDOW 'MAG-TEDIT-LOOKS-BOLD-FONT
                      (OR (CAR (NLSETQ
                                 (FONTCREATE (OR (FONTPROP FONT 'FAMILY)
                                                 'GACHA)
                                             (OR (FONTPROP FONT 'SIZE) 10)
                                             'BOLD)))
                          FONT))))])

(MAG-TEDIT-LOOKS-REGION
  [LAMBDA NIL
    (LET ((WIDTH MAG-TEDIT-LOOKS-WIDTH)
          (HEIGHT MAG-TEDIT-LOOKS-HEIGHT))
      (CREATEREGION (IMAX 8 (IDIFFERENCE SCREENWIDTH (IPLUS WIDTH 16)))
                    8
                    WIDTH
                    HEIGHT))])

(MAG-TEDIT-LOOKS-RESHAPE-FOR-LAYOUT
  [LAMBDA (WINDOW)
    (AND WINDOW
         (OR (NEQ (WINDOWPROP WINDOW 'WIDTH) MAG-TEDIT-LOOKS-WIDTH)
             (NEQ (WINDOWPROP WINDOW 'HEIGHT) MAG-TEDIT-LOOKS-HEIGHT))
         (LET ((REGION (WINDOWREGION WINDOW)))
           (SHAPEW WINDOW
                   (create REGION using REGION
                           WIDTH _ MAG-TEDIT-LOOKS-WIDTH
                           HEIGHT _ MAG-TEDIT-LOOKS-HEIGHT))))])

(MAG-TEDIT-LOOKS-CONTENT-WIDTH
  [LAMBDA (WINDOW)
    (IDIFFERENCE (WINDOWPROP WINDOW 'WIDTH)
                 (ITIMES 2 MAG-TEDIT-LOOKS-MARGIN))])

(MAG-TEDIT-LOOKS-BUTTON-WIDTH
  [LAMBDA (WINDOW)
    (IQUOTIENT
      (IDIFFERENCE (MAG-TEDIT-LOOKS-CONTENT-WIDTH WINDOW)
                   MAG-TEDIT-LOOKS-COLUMN-GAP)
      2)])

(MAG-TEDIT-LOOKS-FIRST-BUTTON-TOP
  [LAMBDA (WINDOW)
    (IDIFFERENCE (WINDOWPROP WINDOW 'HEIGHT)
                 (IPLUS MAG-TEDIT-LOOKS-MARGIN
                        MAG-TEDIT-LOOKS-TITLE-HEIGHT
                        MAG-TEDIT-LOOKS-BUTTON-GAP))])

(MAG-TEDIT-LOOKS-BUTTON-RECT
  [LAMBDA (WINDOW INDEX)
    (LET* ((ROW (COND ((EQ INDEX 8) 4)
                      (T (IQUOTIENT INDEX 2))))
           (COL (COND ((EQ INDEX 8) 0)
                      (T (IREMAINDER INDEX 2))))
           (BW (MAG-TEDIT-LOOKS-BUTTON-WIDTH WINDOW))
           (X (IPLUS MAG-TEDIT-LOOKS-MARGIN
                     (ITIMES COL
                             (IPLUS BW MAG-TEDIT-LOOKS-COLUMN-GAP))))
           (W (COND ((EQ INDEX 8)
                     (MAG-TEDIT-LOOKS-CONTENT-WIDTH WINDOW))
                    (T BW)))
           (TOP (IDIFFERENCE
                  (MAG-TEDIT-LOOKS-FIRST-BUTTON-TOP WINDOW)
                  (ITIMES ROW
                          (IPLUS MAG-TEDIT-LOOKS-BUTTON-HEIGHT
                                 MAG-TEDIT-LOOKS-BUTTON-GAP))))
           (Y (IDIFFERENCE TOP MAG-TEDIT-LOOKS-BUTTON-HEIGHT)))
      (LIST X Y W MAG-TEDIT-LOOKS-BUTTON-HEIGHT))])

(MAG-TEDIT-LOOKS-DRAW-BOX
  [LAMBDA (WINDOW X Y WIDTH HEIGHT)
    (MAG-WINDOW-FILL-REGION WINDOW (CREATEREGION X Y WIDTH HEIGHT))
    (BLTSHADE BLACKSHADE WINDOW X Y WIDTH 2 'REPLACE)
    (BLTSHADE BLACKSHADE WINDOW X Y 2 HEIGHT 'REPLACE)
    (BLTSHADE BLACKSHADE WINDOW X (IDIFFERENCE (IPLUS Y HEIGHT) 2)
              WIDTH 2 'REPLACE)
    (BLTSHADE BLACKSHADE WINDOW (IDIFFERENCE (IPLUS X WIDTH) 2)
              Y 2 HEIGHT 'REPLACE)
    (BLTSHADE BLACKSHADE WINDOW (IPLUS X 4) (IPLUS Y 4)
              (IMAX 1 (IDIFFERENCE WIDTH 8)) 1 'REPLACE)])

(MAG-TEDIT-LOOKS-DRAW-CENTERED-LABEL
  [LAMBDA (WINDOW LABEL X Y WIDTH HEIGHT)
    (LET* ((PLAIN (DSPFONT NIL WINDOW))
           (BOLD (MAG-TEDIT-LOOKS-BOLD-FONT WINDOW))
           (TEXTWIDTH (STRINGWIDTH LABEL BOLD))
           (FONTHEIGHT (FONTPROP BOLD 'HEIGHT))
           (DESCENT (OR (FONTPROP BOLD 'DESCENT) 0))
           (TX (IPLUS X (IQUOTIENT (IMAX 0 (IDIFFERENCE WIDTH TEXTWIDTH))
                                    2)))
           (TY (IPLUS Y
                      (IQUOTIENT (IMAX 0 (IDIFFERENCE HEIGHT FONTHEIGHT))
                                 2)
                      DESCENT)))
      (DSPFONT BOLD WINDOW)
      (MOVETO TX TY WINDOW)
      (PRIN1 LABEL WINDOW)
      (DSPFONT PLAIN WINDOW))])

(MAG-TEDIT-LOOKS-DRAW-BUTTON
  [LAMBDA (WINDOW ITEM INDEX)
    (LET ((RECT (MAG-TEDIT-LOOKS-BUTTON-RECT WINDOW INDEX)))
      (MAG-TEDIT-LOOKS-DRAW-BOX WINDOW
                                (CAR RECT)
                                (CADR RECT)
                                (CADDR RECT)
                                (CADDDR RECT))
      (MAG-TEDIT-LOOKS-DRAW-CENTERED-LABEL WINDOW
                                           (CAR ITEM)
                                           (CAR RECT)
                                           (CADR RECT)
                                           (CADDR RECT)
                                           (CADDDR RECT)))])

(MAG-TEDIT-LOOKS-DRAW-BUTTONS
  [LAMBDA (WINDOW ACTIONS INDEX)
    (COND
      ((NULL ACTIONS)
       T)
      (T
       (MAG-TEDIT-LOOKS-DRAW-BUTTON WINDOW (CAR ACTIONS) INDEX)
       (MAG-TEDIT-LOOKS-DRAW-BUTTONS WINDOW (CDR ACTIONS) (ADD1 INDEX))))])

(MAG-TEDIT-LOOKS-STATUS-TEXT
  [LAMBDA (WINDOW)
    (OR (WINDOWPROP WINDOW 'MAG-TEDIT-LOOKS-STATUS)
        (COND
          ((WINDOWPROP WINDOW 'MAG-TEDIT-STREAM)
           "Ready")
          (T "No TEdit target")))])

(MAG-TEDIT-LOOKS-DRAW-TITLE
  [LAMBDA (WINDOW)
    (LET* ((PLAIN (DSPFONT NIL WINDOW))
           (BOLD (MAG-TEDIT-LOOKS-BOLD-FONT WINDOW))
           (Y (IDIFFERENCE (WINDOWPROP WINDOW 'HEIGHT)
                           (IPLUS MAG-TEDIT-LOOKS-MARGIN 7))))
      (DSPFONT BOLD WINDOW)
      (MOVETO MAG-TEDIT-LOOKS-MARGIN Y WINDOW)
      (PRIN1 "Mag Looks" WINDOW)
      (DSPFONT PLAIN WINDOW)
      (BLTSHADE BLACKSHADE WINDOW
                MAG-TEDIT-LOOKS-MARGIN
                (IDIFFERENCE (MAG-TEDIT-LOOKS-FIRST-BUTTON-TOP WINDOW) 1)
                (MAG-TEDIT-LOOKS-CONTENT-WIDTH WINDOW)
                1
                'REPLACE))])

(MAG-TEDIT-LOOKS-DRAW-STATUS
  [LAMBDA (WINDOW)
    (LET ((TEXT (MAG-TEDIT-LOOKS-STATUS-TEXT WINDOW))
          (Y (IPLUS MAG-TEDIT-LOOKS-MARGIN
                    (OR (FONTPROP (DSPFONT NIL WINDOW) 'DESCENT) 0))))
      (MOVETO MAG-TEDIT-LOOKS-MARGIN Y WINDOW)
      (PRIN1 TEXT WINDOW))])

(MAG-TEDIT-LOOKS-DRAW
  [LAMBDA (WINDOW)
    (MAG-WINDOW-CLEAR WINDOW)
    (MAG-TEDIT-LOOKS-DRAW-TITLE WINDOW)
    (MAG-TEDIT-LOOKS-DRAW-BUTTONS WINDOW
                                  (MAG-TEDIT-LOOKS-ACTIONS)
                                  0)
    (MAG-TEDIT-LOOKS-DRAW-STATUS WINDOW)])

(MAG-TEDIT-LOOKS-NTH-ACTION
  [LAMBDA (ACTIONS INDEX)
    (COND
      ((OR (NULL ACTIONS)
           (ILESSP INDEX 0))
       NIL)
      ((ZEROP INDEX)
       (CAR ACTIONS))
      (T
       (MAG-TEDIT-LOOKS-NTH-ACTION (CDR ACTIONS) (SUB1 INDEX))))])

(MAG-TEDIT-LOOKS-ITEM-FROM-MOUSE
  [LAMBDA (WINDOW)
    (PROG ((X (LASTMOUSEX WINDOW))
           (Y (LASTMOUSEY WINDOW))
           (MARGIN MAG-TEDIT-LOOKS-MARGIN)
           (BH MAG-TEDIT-LOOKS-BUTTON-HEIGHT)
           (GAP MAG-TEDIT-LOOKS-BUTTON-GAP)
           BW TOP DIST ROW WITHIN COL INDEX)
      (SETQ BW (MAG-TEDIT-LOOKS-BUTTON-WIDTH WINDOW))
      (SETQ TOP (MAG-TEDIT-LOOKS-FIRST-BUTTON-TOP WINDOW))
      (SETQ DIST (IDIFFERENCE TOP Y))
      (COND
        ((OR (ILESSP X MARGIN)
             (IGREATERP X (IPLUS MARGIN
                                  (MAG-TEDIT-LOOKS-CONTENT-WIDTH WINDOW)))
             (ILESSP DIST 0))
         (RETURN NIL)))
      (SETQ ROW (IQUOTIENT DIST (IPLUS BH GAP)))
      (SETQ WITHIN (IREMAINDER DIST (IPLUS BH GAP)))
      (COND
        ((OR (IGREATERP ROW 4)
             (IGEQ WITHIN BH))
         (RETURN NIL)))
      (COND
        ((EQ ROW 4)
         (SETQ INDEX 8))
        ((ILESSP X (IPLUS MARGIN BW))
         (SETQ COL 0)
         (SETQ INDEX (ITIMES ROW 2)))
        ((IGREATERP X (IPLUS MARGIN BW MAG-TEDIT-LOOKS-COLUMN-GAP))
         (SETQ COL 1)
         (SETQ INDEX (ADD1 (ITIMES ROW 2))))
        (T
         (RETURN NIL)))
      (RETURN (MAG-TEDIT-LOOKS-NTH-ACTION (MAG-TEDIT-LOOKS-ACTIONS)
                                          INDEX)))])

(MAG-TEDIT-LOOKS-APPLY-ITEM
  [LAMBDA (WINDOW ITEM)
    (LET ((TSTREAM (WINDOWPROP WINDOW 'MAG-TEDIT-STREAM))
          (LABEL (CAR ITEM))
          (ACTION (CADR ITEM))
          RESULT)
      (COND
        ((NULL TSTREAM)
         (WINDOWPROP WINDOW 'MAG-TEDIT-LOOKS-STATUS
                     "No TEdit target")
         (FLASHWINDOW WINDOW))
        (T
         (SETQ RESULT
               (CAR
                 (NLSETQ
                   (SELECTQ ACTION
                     (SAVE (MAG-TEDIT-SAVE-STREAM TSTREAM))
                     ((HEADING1 HEADING2 HEADING3 NORMAL CODE BOLD ITALIC PLAIN)
                      (MAG-TEDIT-APPLY-STYLE TSTREAM ACTION))
                     NIL))))
         (WINDOWPROP WINDOW 'MAG-TEDIT-LOOKS-STATUS
                     (CONCAT "Applied: " LABEL))
         (MAG-TEDIT-LOOKS-DRAW WINDOW)
         RESULT)))])

(MAG-TEDIT-LOOKS-BUTTONFN
  [LAMBDA (WINDOW)
    (TOTOPW WINDOW)
    (COND
      ((LASTMOUSESTATE RIGHT)
       (DOWINDOWCOM WINDOW))
      ((LASTMOUSESTATE LEFT)
       (LET ((ITEM (MAG-TEDIT-LOOKS-ITEM-FROM-MOUSE WINDOW)))
         (AND ITEM
              (MAG-TEDIT-LOOKS-APPLY-ITEM WINDOW ITEM)))))])

(MAG-TEDIT-LOOKS-RESHAPEFN
  [LAMBDA (WINDOW OLDIMAGE IMAGEREGION OLDSCREENREGION)
    (RESHAPEBYREPAINTFN WINDOW OLDIMAGE IMAGEREGION)
    (MAG-TEDIT-LOOKS-DRAW WINDOW)])

(MAG-TEDIT-LOOKS-CLOSEFN
  [LAMBDA (WINDOW)
    (AND (EQ MAG-TEDIT-LOOKS-WINDOW WINDOW)
         (SETQ MAG-TEDIT-LOOKS-WINDOW NIL))])

(MAG-TEDIT-LOOKS-OPEN
  [LAMBDA (TSTREAM)
    (PROG (WINDOW)
      (SETQ TSTREAM (CAR (NLSETQ (TEXTSTREAM TSTREAM))))
      (SETQ WINDOW (AND MAG-TEDIT-LOOKS-WINDOW
                        (OPENWP MAG-TEDIT-LOOKS-WINDOW)
                        MAG-TEDIT-LOOKS-WINDOW))
      (COND
        ((NULL WINDOW)
         (SETQ WINDOW (CREATEW (MAG-TEDIT-LOOKS-REGION) "Mag Looks"))
         (SETQ MAG-TEDIT-LOOKS-WINDOW WINDOW)
         (WINDOWPROP WINDOW 'MAG-TEDIT-LOOKS T)
         (WINDOWPROP WINDOW 'BUTTONEVENTFN (FUNCTION MAG-TEDIT-LOOKS-BUTTONFN))
         (WINDOWPROP WINDOW 'RIGHTBUTTONFN (FUNCTION DOWINDOWCOM))
         (WINDOWPROP WINDOW 'RESHAPEFN (FUNCTION MAG-TEDIT-LOOKS-RESHAPEFN))
         (WINDOWADDPROP WINDOW 'CLOSEFN (FUNCTION MAG-TEDIT-LOOKS-CLOSEFN))
         (MODERNWINDOW WINDOW)))
      (MAG-TEDIT-LOOKS-RESHAPE-FOR-LAYOUT WINDOW)
      (WINDOWPROP WINDOW 'MAG-TEDIT-STREAM TSTREAM)
      (WINDOWPROP WINDOW 'MAG-TEDIT-LOOKS-STATUS
                  "Ready")
      (TOTOPW WINDOW)
      (MAG-WINDOW-SET-BACKGROUND WINDOW)
      (MAG-TEDIT-LOOKS-DRAW WINDOW)
      (RETURN WINDOW))])

(MAG-TEDIT-MENU
  [LAMBDA (TSTREAM)
    (MAG-TEDIT-LOOKS-OPEN TSTREAM)])

(MAG-TEDIT-STREAM-FILENAME
  [LAMBDA (TSTREAM)
    (OR (CAR (NLSETQ (\TEDIT.LIKELY.FILENAME TSTREAM NIL)))
        (CAR (NLSETQ (\TEDIT.FILENAME TSTREAM))))])

(MAG-TEDIT-STREAM-DIRTYP
  [LAMBDA (TSTREAM)
    (CAR (NLSETQ (TEDIT.STREAMCHANGEDP TSTREAM NIL)))])

(MAG-TEDIT-SAVE-STREAM
  [LAMBDA (TSTREAM)
    (SETQ TSTREAM (TEXTSTREAM TSTREAM))
    (LET ((FILE (MAG-TEDIT-STREAM-FILENAME TSTREAM)))
      (AND FILE
           (NEQ FILE "")
           (CAR (NLSETQ (TEDIT.PUT TSTREAM FILE NIL NIL NIL T)))))])

(MAG-TEDIT-AUTOSAVE-ONE
  [LAMBDA (TSTREAM)
    (AND TSTREAM
         (CAR (NLSETQ
                (PROGN
                  (SETQ TSTREAM (TEXTSTREAM TSTREAM))
                  (AND (MAG-TEDIT-STREAM-DIRTYP TSTREAM)
                       (MAG-TEDIT-SAVE-STREAM TSTREAM))))))])

(MAG-TEDIT-AUTOSAVE-OPEN-WINDOWS
  [LAMBDA NIL
    (LET (COUNT TSTREAM)
      (for W in (OPENWINDOWS) do
        (SETQ TSTREAM (WINDOWPROP W 'TEXTSTREAM))
        (AND TSTREAM
             (MAG-TEDIT-AUTOSAVE-ONE TSTREAM)
             (SETQ COUNT (ADD1 (OR COUNT 0)))))
      (OR COUNT 0))])

(MAG-TEDIT-AUTOSAVE-LOOP
  [LAMBDA NIL
    (while T do
      (DISMISS MAG-TEDIT-AUTOSAVE-INTERVAL-MS)
      (NLSETQ (MAG-TEDIT-AUTOSAVE-OPEN-WINDOWS)))])

(MAG-TEDIT-AUTOSAVE-START
  [LAMBDA NIL
    (OR (AND MAG-TEDIT-AUTOSAVE-PROCESS
             (PROCESSP MAG-TEDIT-AUTOSAVE-PROCESS))
        (SETQ MAG-TEDIT-AUTOSAVE-PROCESS
              (ADD.PROCESS (LIST (FUNCTION MAG-TEDIT-AUTOSAVE-LOOP))
                           'NAME
                           'MAG-TEDIT-AUTOSAVE
                           'RESTARTABLE
                           'YES)))
    MAG-TEDIT-AUTOSAVE-PROCESS])

(MAG-TEDIT-INSTALL
  [LAMBDA NIL
    (OR (GETD 'TEDIT)
        (FILESLOAD TEDIT))
    (SETQ MAG-TEDIT-STYLE-MENU NIL)
    (AND (GETD 'TEDIT.REMOVE.MENUITEM)
         (TEDIT.REMOVE.MENUITEM TEDIT.DEFAULT.MENU 'Mag% Looks))
    (AND (GETD 'TEDIT.ADD.MENUITEM)
         (TEDIT.ADD.MENUITEM
           TEDIT.DEFAULT.MENU
           '(Mag% Looks 'MAG-TEDIT-MENU
             "Open persistent Mag Looks palette"
             (SUBITEMS (Mag% Looks 'MAG-TEDIT-MENU
                                   "Open persistent Mag Looks palette")))))
    (MAG-TEDIT-INSTALL-BACKGROUND)
    (MAG-TEDIT-APPLY-BACKGROUND-OPEN-WINDOWS)
    (MAG-TEDIT-AUTOSAVE-START)
    T])
)

(NLSETQ (MAG-TEDIT-INSTALL))

STOP
