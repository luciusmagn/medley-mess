(MAG-UNIX-HANDLECOMM7
  [LAMBDA (A B C D E F G)
    (CL:FUNCALL
      (OR MAG-UNIX-HANDLECOMM7-FN
          (SETQ MAG-UNIX-HANDLECOMM7-FN
                (CL:COMPILE NIL
                            '(LAMBDA (A B C D E F G)
                               ((OPCODES SUBRCALL 117 7) A B C D E F G)))))
      A
      B
      C
      D
      E
      F
      G)])

(MAG-UNIX-HANDLECOMM8
  [LAMBDA (A B C D E F G H)
    (CL:FUNCALL
      (OR MAG-UNIX-HANDLECOMM8-FN
          (SETQ MAG-UNIX-HANDLECOMM8-FN
                (CL:COMPILE NIL
                            '(LAMBDA (A B C D E F G H)
                               ((OPCODES SUBRCALL 117 8) A B C D E F G H)))))
      A
      B
      C
      D
      E
      F
      G
      H)])

(MAG-ACME-BACKGROUND-RGB
  [LAMBDA NIL
    (OR MAG-ACME-BACKGROUND-RGB-CACHE
        (SETQ MAG-ACME-BACKGROUND-RGB-CACHE
              (create RGB RED _ 255 GREEN _ 255 BLUE _ 232)))])

(MAG-WINDOW-COLOR-BITS
  [LAMBDA NIL
    (OR (CAR (NLSETQ (BITSPERPIXEL (COLORSCREENBITMAP))))
        (CAR (NLSETQ (BITSPERPIXEL (SCREENBITMAP))))
        8)])

(MAG-WINDOW-MONO-P
  [LAMBDA NIL
    (ILEQ (MAG-WINDOW-COLOR-BITS) 1)])

(MAG-ACME-BACKGROUND-SLOT
  [LAMBDA NIL
    (LET ((MAXCOLOR (MAXIMUMCOLOR (MAG-WINDOW-COLOR-BITS))))
      (COND
        ((ILESSP MAXCOLOR 2)
         NIL)
        (T
         (IMIN MAG-ACME-BACKGROUND-COLOR-SLOT MAXCOLOR))))])

(MAG-INSTALL-ACME-BACKGROUND-COLOR
  [LAMBDA NIL
    (LET ((SLOT (MAG-ACME-BACKGROUND-SLOT)))
      (AND SLOT
           (CAR
             (NLSETQ
               (PROGN
                 (SCREENCOLORMAPENTRY SLOT (MAG-ACME-BACKGROUND-RGB))
                 SLOT)))))])

(MAG-WINDOW-BACKGROUND
  [LAMBDA NIL
    (COND
      ((MAG-WINDOW-MONO-P)
       WHITESHADE)
      (MAG-WINDOW-BACKGROUND-CACHE)
      (T
       (SETQ MAG-WINDOW-BACKGROUND-CACHE
             (OR (CAR
                   (NLSETQ
                     (COLORNUMBERP (MAG-ACME-BACKGROUND-RGB)
                                   (MAG-WINDOW-COLOR-BITS)
                                   T)))
                 (MAG-INSTALL-ACME-BACKGROUND-COLOR)
                 WHITESHADE))))])

(MAG-WINDOW-BACKGROUND-REPORT
  [LAMBDA NIL
    (CONCAT "bits=" (MAG-WINDOW-COLOR-BITS)
            " mono=" (COND ((MAG-WINDOW-MONO-P) "yes") (T "no"))
            " background=" (MAG-WINDOW-BACKGROUND))])

(MAG-WINDOW-SET-BACKGROUND
  [LAMBDA (WINDOW)
    (AND WINDOW
         (LET ((BG (MAG-WINDOW-BACKGROUND))
               (DSP (WINDOWPROP WINDOW 'DSP)))
           (NLSETQ (DSPTEXTURE BG WINDOW))
           (AND DSP (NLSETQ (DSPTEXTURE BG DSP)))
           (NLSETQ (DSPBACKCOLOR BG WINDOW))
           (AND DSP (NLSETQ (DSPBACKCOLOR BG DSP)))
           BG))])

(MAG-WINDOW-FILL-REGION
  [LAMBDA (WINDOW REGION)
    (AND WINDOW
         REGION
         (CAR
           (NLSETQ
             (LET ((DSP (OR (WINDOWPROP WINDOW 'DSP) WINDOW))
                   (BG (MAG-WINDOW-BACKGROUND)))
               (MAG-WINDOW-SET-BACKGROUND WINDOW)
               (DSPFILL REGION
                        BG
                        'REPLACE
                        DSP)
               T))))])

(MAG-WINDOW-CLEAR
  [LAMBDA (WINDOW)
    (COND
      ((NULL WINDOW)
       NIL)
      ((CAR
         (NLSETQ
           (LET ((REGION (DSPCLIPPINGREGION NIL WINDOW)))
             (MAG-WINDOW-FILL-REGION WINDOW REGION)
             T)))
       T)
      (T
       (CLEARW WINDOW)
       NIL))])

(MAG-WINDOW-BASELINE-PAD-VALUE
  [LAMBDA NIL
    (COND
      ((AND (BOUNDP 'MAG-WINDOW-BASELINE-PAD)
            (SMALLP MAG-WINDOW-BASELINE-PAD)
            (IGREATERP MAG-WINDOW-BASELINE-PAD -1))
       MAG-WINDOW-BASELINE-PAD)
      (T 1))])

(MAG-CHAT-REGION
  [LAMBDA NIL
    (CREATEREGION 8 8 (IQUOTIENT (IDIFFERENCE SCREENWIDTH 16) 2)
                  (IQUOTIENT (IDIFFERENCE SCREENHEIGHT 48) 2))])

(MAG-CHAT-CREATE-WINDOW
  [LAMBDA (TITLE)
    (CREATEW (COND
               (MAG-CHAT-AUTO-PLACE (MAG-CHAT-REGION))
               (T NIL))
             TITLE)])

(MAG-VTERM-ENSURE
  [LAMBDA NIL
    (FILESLOAD UNIXCOMM)
    (FILESLOAD UNIXCHAT)
    (FILESLOAD CHATDECLS)
    (FILESLOAD CHATTERMINAL)
    (FILESLOAD COLOR)
    (NLSETQ (FILESLOAD UNIXUTILS))
    (NLSETQ (FILESLOAD CLIPBOARD))
    (SETQ CHAT.FONT NIL)])

(MAG-WINDOW-LINEHEIGHT
  [LAMBDA (WINDOW)
    (IPLUS (FONTPROP (DSPFONT NIL WINDOW) 'HEIGHT)
           (MAG-WINDOW-BASELINE-PAD-VALUE))])

(MAG-WINDOW-DRAW-LINE
  [LAMBDA (WINDOW ROW TEXT)
    (LET ((Y (MAG-WINDOW-ROW-Y WINDOW ROW)))
      (MOVETO 8 Y WINDOW)
      (PRIN1 (OR TEXT "") WINDOW))])

(MAG-WINDOW-ROW-BOTTOM
  [LAMBDA (WINDOW ROW)
    (LET* ((HEIGHT (WINDOWPROP WINDOW 'HEIGHT))
           (LINEHEIGHT (MAG-WINDOW-LINEHEIGHT WINDOW)))
      (IMAX 0 (IDIFFERENCE HEIGHT
                            (IPLUS 8 (ITIMES (ADD1 ROW) LINEHEIGHT)))))])

(MAG-WINDOW-ROW-Y
  [LAMBDA (WINDOW ROW)
    (IPLUS (MAG-WINDOW-ROW-BOTTOM WINDOW ROW)
           (OR (FONTPROP (DSPFONT NIL WINDOW) 'DESCENT) 0)
           (MAG-WINDOW-BASELINE-PAD-VALUE))])

(MAG-WINDOW-CLEAR-LINE
  [LAMBDA (WINDOW ROW)
    (LET ((Y (MAG-WINDOW-ROW-BOTTOM WINDOW ROW))
          (LINEHEIGHT (MAG-WINDOW-LINEHEIGHT WINDOW)))
      (MAG-WINDOW-FILL-REGION
        WINDOW
        (CREATEREGION 0 Y (WINDOWPROP WINDOW 'WIDTH) LINEHEIGHT)))])

(MAG-WINDOW-DRAW-LINES
  [LAMBDA (WINDOW LINES)
    (PROG ((ROW 0))
      (MAG-WINDOW-CLEAR WINDOW)
    LP
      (COND
        ((NULL LINES)
         (RETURN T)))
      (MAG-WINDOW-DRAW-LINE WINDOW ROW (CAR LINES))
      (SETQ ROW (ADD1 ROW))
      (SETQ LINES (CDR LINES))
      (GO LP))])

(MAG-CLIPBOARD-AVAILABLEP
  [LAMBDA NIL
    (OR (STRPOS "darwin" (OR (UNIX-GETENV "OSTYPE") ""))
        (CAR (NLSETQ (ShellWhich "xclip"))))])

(MAG-CLIPBOARD-GET
  [LAMBDA NIL
    (MAG-VTERM-ENSURE)
    (COND
      ((MAG-CLIPBOARD-AVAILABLEP)
       (CAR (NLSETQ (GETCLIPBOARD))))
      (T NIL))])

(MAG-CLIPBOARD-PUT
  [LAMBDA (TEXT)
    (MAG-VTERM-ENSURE)
    (AND TEXT
         (MAG-CLIPBOARD-AVAILABLEP)
         (NLSETQ (PUTCLIPBOARD TEXT NIL)))])

(MAG-PROMPT-LINE
  [LAMBDA (PROMPT DEFAULT)
    (PROMPTFORWORD PROMPT DEFAULT NIL PROMPTWINDOW NIL 'TTY
                   (CHARCODE (EOL ESCAPE LF TAB)))])

)

(MOVD 'NU\TOTOPWDS '\TOTOPWDS)

STOP
