(DEFINE-FILE-INFO PACKAGE "INTERLISP" READTABLE "INTERLISP" BASE 10)

(FILESLOAD RECORD)
(FILESLOAD CHATDECLS)
(FILESLOAD COLOR)
(RPAQQ MAG-WINDOW-BASELINE-PAD 1)
(RPAQQ MAG-ACME-BACKGROUND-COLOR-SLOT 250)
(RPAQ? MAG-ACME-BACKGROUND-RGB-CACHE NIL)
(RPAQ? MAG-WINDOW-BACKGROUND-CACHE NIL)
(RPAQ? MAG-CHAT-AUTO-PLACE NIL)
(RPAQ? MAG-WINDOW-DRAW-TOP-DEPTH 0)
(RPAQ? MAG-UNIX-HANDLECOMM1-FN NIL)
(RPAQ? MAG-UNIX-HANDLECOMM2-FN NIL)
(RPAQ? MAG-UNIX-HANDLECOMM3-FN NIL)
(RPAQ? MAG-UNIX-HANDLECOMM4-FN NIL)
(RPAQ? MAG-UNIX-HANDLECOMM5-FN NIL)
(RPAQ? MAG-UNIX-HANDLECOMM6-FN NIL)
(RPAQ? MAG-UNIX-HANDLECOMM7-FN NIL)
(RPAQ? MAG-UNIX-HANDLECOMM8-FN NIL)

(DEFINEQ

(NU\TOTOPWDS
  [LAMBDA (DS NOTOTOPFNFLG)
    (PROG (WINDOW)
      (RETURN
        (AND (FMEMB (DSPDESTINATION NIL DS)
                    \SCREENBITMAPS)
             (COND
               (NOTOTOPFNFLG
                (TOTOPW (WFROMDS DS)
                        NOTOTOPFNFLG))
               ((AND (SETQ WINDOW (WFROMDS DS T))
                     (WINDOWPROP WINDOW 'RAISEONACCESS))
                (TOTOPW WINDOW NOTOTOPFNFLG))))))])

(MAG-WINDOW-DRAW-TOP-BEGIN
  [LAMBDA (WINDOW)
    (PROG (STACK SCREEN)
      (SETQ MAG-WINDOW-DRAW-TOP-DEPTH
            (ADD1 (OR MAG-WINDOW-DRAW-TOP-DEPTH 0)))
      (COND
        ((OR (NULL WINDOW)
             (NOT (OPENWP WINDOW))
             (WINDOWPROP WINDOW 'RAISEONACCESS)
             (TOPWP WINDOW)
             (IGREATERP MAG-WINDOW-DRAW-TOP-DEPTH 1))
         (RETURN NIL)))
      (SETQ SCREEN (fetch (WINDOW SCREEN) of WINDOW))
      (SETQ STACK (OPENWINDOWS SCREEN))
      (TOTOPW WINDOW T)
      (RETURN STACK))])

(MAG-WINDOW-DRAW-TOP-END
  [LAMBDA (STACK)
    (PROG NIL
      (AND STACK
           (for W in STACK do
             (AND W
                  (OPENWP W)
                  (CAR (NLSETQ (TOTOPW W T))))))
      (SETQ MAG-WINDOW-DRAW-TOP-DEPTH
            (IMAX 0 (SUB1 (OR MAG-WINDOW-DRAW-TOP-DEPTH 1))))
      (RETURN T))])

(MAG-UNIX-HANDLECOMM1
  [LAMBDA (A)
    (CL:FUNCALL
      (OR MAG-UNIX-HANDLECOMM1-FN
          (SETQ MAG-UNIX-HANDLECOMM1-FN
                (CL:COMPILE NIL
                            '(LAMBDA (A)
                               ((OPCODES SUBRCALL 117 1) A)))))
      A)])

(MAG-UNIX-HANDLECOMM2
  [LAMBDA (A B)
    (CL:FUNCALL
      (OR MAG-UNIX-HANDLECOMM2-FN
          (SETQ MAG-UNIX-HANDLECOMM2-FN
                (CL:COMPILE NIL
                            '(LAMBDA (A B)
                               ((OPCODES SUBRCALL 117 2) A B)))))
      A
      B)])

(MAG-UNIX-HANDLECOMM3
  [LAMBDA (A B C)
    (CL:FUNCALL
      (OR MAG-UNIX-HANDLECOMM3-FN
          (SETQ MAG-UNIX-HANDLECOMM3-FN
                (CL:COMPILE NIL
                            '(LAMBDA (A B C)
                               ((OPCODES SUBRCALL 117 3) A B C)))))
