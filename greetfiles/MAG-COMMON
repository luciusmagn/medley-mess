(MAG-UNIX-HANDLECOMM6
  [LAMBDA (A B C D E F)
    (CL:FUNCALL
      (OR MAG-UNIX-HANDLECOMM6-FN
          (SETQ MAG-UNIX-HANDLECOMM6-FN
                (CL:COMPILE NIL
                            '(LAMBDA (A B C D E F)
                               ((OPCODES SUBRCALL 117 6) A B C D E F)))))
      A
      B
      C
      D
      E
