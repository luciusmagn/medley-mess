#!/bin/sh
set -e

if [ -f "$HOME/.guix-profile/etc/profile" ]; then
    # Maiko was built against libraries from the user Guix profile.
    . "$HOME/.guix-profile/etc/profile"
fi

export MEDLEYDIR="${MEDLEYDIR:-$HOME/src/medley}"
export MAIKODIR="${MAIKODIR:-$HOME/src/maiko}"
export NOTECARDSDIR="${NOTECARDSDIR:-$HOME/src/notecards}"
export NOTEFILESSRC="${NOTEFILESSRC:-$NOTECARDSDIR/notefiles}"
export NOTEFILESDIR="${NOTEFILESDIR:-$HOME/notefiles}"
export LOGINDIR="${LOGINDIR:-$HOME/.local/share/medley-logindir}"
export LDEKBDTYPE="${LDEKBDTYPE:-X}"
export DISPLAY="${DISPLAY:-:0}"
export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
export PATH="/run/privileged/bin:/run/setuid-programs:$HOME/.local/bin:$HOME/.guix-profile/bin:$PATH"
mkdir -p "$NOTEFILESDIR"
mkdir -p "$LOGINDIR"
unset TERMINFO
export TERMINFO_DIRS="/run/current-system/profile/share/terminfo:$HOME/.guix-profile/share/terminfo:${TERMINFO_DIRS:-}"

MAG_MEDLEY_GEOMETRY="${MAG_MEDLEY_GEOMETRY:-1920x1040}"
MAG_MEDLEY_SCREENSIZE="${MAG_MEDLEY_SCREENSIZE:-$MAG_MEDLEY_GEOMETRY}"
MAG_MEDLEY_MEMORY_MB="${MAG_MEDLEY_MEMORY_MB:-256}"
MAG_MEDLEY_TITLE="${MAG_MEDLEY_TITLE:-Medley Interlisp}"
MAG_MEDLEY_FOREGROUND="${MAG_MEDLEY_FOREGROUND:-rgb:00/00/00}"
MAG_MEDLEY_BACKGROUND="${MAG_MEDLEY_BACKGROUND:-rgb:ff/ff/e8}"
MAG_MEDLEY_CURSOR_COLOR="${MAG_MEDLEY_CURSOR_COLOR:-rgb:00/00/00}"
MAG_MEDLEY_GREET_FILE="${MAG_MEDLEY_GREET_FILE:-$MEDLEYDIR/greetfiles/MAG-NOGREET}"

case "$MAG_MEDLEY_MEMORY_MB" in
    ''|*[!0-9]*)
        echo "MAG_MEDLEY_MEMORY_MB must be a positive integer, got: $MAG_MEDLEY_MEMORY_MB" >&2
        exit 2
        ;;
esac

# The MAG startup file must run as the actual greetfile. Loading it later
# through Exec typeahead leaves the greetfile STOP outside the GREET stack and
# steadily grows the GC collision-link table while idle.
unset MAIKO_STARTUP_TYPEAHEAD_FILE
unset MAIKO_STARTUP_TYPEAHEAD_DELAY

exec "$MEDLEYDIR/medley" \
    --config - \
    --apps \
    --interlisp \
    --noscroll \
    --geometry "$MAG_MEDLEY_GEOMETRY" \
    --screensize "$MAG_MEDLEY_SCREENSIZE" \
    --mem "$MAG_MEDLEY_MEMORY_MB" \
    --title "$MAG_MEDLEY_TITLE" \
    --logindir "$LOGINDIR" \
    --maikodir "$MAIKODIR" \
    --greet "$MAG_MEDLEY_GREET_FILE" \
    "$@" \
    -- \
    -fg "$MAG_MEDLEY_FOREGROUND" \
    -bg "$MAG_MEDLEY_BACKGROUND" \
    -cursorColor "$MAG_MEDLEY_CURSOR_COLOR"
